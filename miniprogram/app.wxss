page { background: #f5f6f3; color: #141414; }
.card { background: #fff; border-radius: 16px; margin: 16rpx; overflow: hidden; }
.pad { padding: 24rpx; }
.cover { width: 100%; height: 320rpx; background: #d8f3dc; }
.title { font-size: 32rpx; font-weight: 650; }
.muted { color: #7a7d74; font-size: 24rpx; }
.label { margin: 12rpx 32rpx 0; color: #6b705c; font-size: 24rpx; }
.price { color: #bc4749; font-weight: 700; }
.tag { display: inline-block; background: #eef8c8; color: #3d5a1f; border-radius: 999rpx; padding: 4rpx 14rpx; font-size: 22rpx; margin-right: 8rpx; }
.btn { background: #c6f24a; color: #141414; text-align: center; border-radius: 999rpx; padding: 20rpx; margin: 16rpx; }
.btn.ghost { background: #fff; color: #141414; border: 1px solid #eceee8; }
.btn.clay { background: #bc4749; }
button.btn {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 600;
}
button.btn::after { border: none; }
.row { display: flex; justify-content: space-between; align-items: center; }
.chip { display: inline-block; padding: 10rpx 22rpx; border: 1px solid #eceee8; border-radius: 999rpx; margin: 8rpx; background: #fff; font-size: 24rpx; }
.chip.on { background: #c6f24a; color: #141414; border-color: #c6f24a; font-weight: 700; }
.chips { padding: 8rpx 8rpx 0; }
.progress { height: 12rpx; background: #eee; border-radius: 99rpx; overflow: hidden; margin: 12rpx 0; }
.bar { height: 100%; background: #2d6a4f; }
.seat-map { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 12rpx 0; }
.seat-front { font-size: 22rpx; color: #6b705c; }
.seat-row { display: flex; align-items: center; gap: 10rpx; }
.seat { width: 64rpx; height: 64rpx; border-radius: 12rpx; border: 1px solid #e6dfd2; background: #fff; text-align: center; line-height: 64rpx; font-size: 22rpx; }
.seat.taken { background: #d8f3dc; color: #6b705c; }
.seat.on { background: #2d6a4f; color: #fff; }
.weather { margin: 16rpx 0 0; padding: 16rpx 16rpx 8rpx; background: #eef6ff; border-radius: 12rpx; font-size: 24rpx; }
.wx-chart { width: 100%; height: 280rpx; display: block; margin-top: 8rpx; }
.stars { color: #c9a227; letter-spacing: 2rpx; font-size: 24rpx; }
.star-pick { display: flex; gap: 8rpx; padding: 8rpx 8rpx 16rpx; }
.star { font-size: 44rpx; color: #d8d2c2; }
.star.on { color: #c9a227; }
.play-tag { display: inline-block; color: #fff; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: 24rpx; margin: 8rpx; }
.offer-chip { display: inline-block; color: #fff; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: 24rpx; margin: 8rpx; }
.offer-chip.inline { margin-right: 8rpx; font-size: 20rpx; padding: 2rpx 10rpx; }
.offer-chip.publish { background: #c9a227; color: #1b4332; }
.price-origin { color: #6b705c; text-decoration: line-through; margin-right: 8rpx; font-weight: 400; }
.input { background: #fff; border: 1px solid #e6dfd2; border-radius: 12rpx; padding: 18rpx; margin: 12rpx 16rpx; }
.radio-row { display: flex; gap: 36rpx; padding: 16rpx 24rpx; }
.radio-item { display: flex; align-items: center; gap: 8rpx; font-size: 28rpx; }
.nav-link { color: #2d6a4f; font-size: 24rpx; }
.guide-hit { margin-top: 8rpx; color: #2d6a4f; font-size: 24rpx; }
.seat.locked { background: #ece8df; color: #8a8578; }
.pay-paid { color: #2d6a4f; }
.pay-unpaid { color: #bc4749; }
.hero-swipe { height: 360rpx; }
.hourly { white-space: nowrap; margin-top: 12rpx; }
.hour { display: inline-block; width: 140rpx; margin-right: 12rpx; background: #fff; border-radius: 12rpx; padding: 8rpx; font-size: 22rpx; text-align: center; white-space: pre-wrap; }
.chain-line { font-size: 26rpx; }
.cal { display: flex; gap: 8rpx; padding: 8rpx 16rpx 16rpx; overflow-x: auto; }
.cal-day { min-width: 88rpx; padding: 12rpx 8rpx; border: 1px solid #e6dfd2; border-radius: 12rpx; text-align: center; background: #fff; }
.cal-day.on { border-color: #c6f24a; background: #c6f24a; }
.cal-n { font-weight: 700; color: #1b4332; }
.faq-item { padding: 12rpx 0; border-bottom: 1px dashed #e6dfd2; }
.faq-item:last-child { border-bottom: 0; }
.guide-row { display: flex; gap: 20rpx; align-items: center; }
.guide-face {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #d8f3dc;
  color: #1b4332;
  text-align: center;
  line-height: 88rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.album-grid,
.moments-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}
.album-img,
.moments-cell image {
  width: 100%;
  height: 100%;
  display: block;
}
.moments-cell,
.moments-add {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: #f3f3f3;
  overflow: hidden;
}
.moments-cell image {
  position: absolute;
  inset: 0;
}
.moments-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: 32rpx;
  z-index: 1;
}
.moments-add {
  background: #f4f4f4;
}
.moments-plus {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8c8c8;
  font-size: 72rpx;
  font-weight: 200;
  line-height: 1;
}
.moments-hint { padding: 0 24rpx 16rpx; }
.kind-grid { display: flex; gap: 12rpx; padding: 0 16rpx 16rpx; }
.act-kind {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e6dfd2;
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: 24rpx;
}
.act-kind.on { border-color: #c6f24a; background: #c6f24a; }
.act-kind .emoji { font-size: 36rpx; }
.feed-search {
  margin: 16rpx 24rpx 8rpx;
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}
.feed-ph {
  width: 200rpx;
  height: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #6b7a5c;
}
.fact-list { margin-top: 16rpx; }
.fact-row { display: flex; gap: 16rpx; align-items: flex-start; margin-top: 12rpx; }
.fact-k { width: 72rpx; font-size: 22rpx; color: #7a7d74; padding-top: 4rpx; flex-shrink: 0; }
.fact-v { flex: 1; font-size: 28rpx; font-weight: 650; }
.trust-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.trust-chip {
  font-size: 22rpx;
  background: #eef8c8;
  color: #3d5a1f;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.ticket-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #141414;
  color: #fff;
}
.ticket-card.wait { background: #3d5a1f; }
.ticket-card.posted { background: #3a1848; }
.ticket-card .muted { color: rgba(255,255,255,.72); }
.ticket-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.ticket-actions .btn { flex: 1; margin: 0; }
.enroll-dock {
  position: sticky;
  bottom: 0;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(20,20,20,.08);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.enroll-bar { display: flex; align-items: center; gap: 20rpx; }
.enroll-price { flex: 1; }
.enroll-price .strong { font-size: 36rpx; font-weight: 700; }
.dock-cta { margin: 0; min-width: 42%; }
.home-seg {
  display: flex;
  margin: 8rpx 24rpx 16rpx;
  padding: 6rpx;
  background: #fff;
  border: 1px solid #e6e4dc;
  border-radius: 999rpx;
}
.home-seg-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
  color: #7a7d74;
}
.home-seg-btn.on {
  background: #c6f24a;
  color: #141414;
}
.trip-hint {
  margin: 0 16rpx 8rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.trip-hint-title { font-size: 26rpx; font-weight: 700; }
.catalog-lead { padding: 0 24rpx 8rpx; }
.catalog-row {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 24rpx 16rpx;
}
.card .catalog-row {
  margin-left: 0;
  margin-right: 0;
}
.catalog-row .tool-btn {
  flex: 1;
  text-align: center;
  border-radius: 999rpx;
  padding: 12rpx 16rpx;
  font-weight: 700;
}
.tool-btn.ghost-line {
  background: #fff;
  color: #141414;
  border: 1px solid #e6e4dc;
}
.feed-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 24rpx 16rpx;
}
.feed-toolbar .hint { font-size: 26rpx; font-weight: 700; }
.feed-toolbar .tools { display: flex; align-items: center; gap: 16rpx; }
.tool-btn { font-size: 26rpx; color: #7a7d74; }
.tool-btn.play {
  background: #c6f24a;
  color: #141414;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-weight: 700;
}
.feed-card {
  margin: 0 16rpx 16rpx;
  padding: 16rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  gap: 20rpx;
}
.feed-cover {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e8ece6;
  flex-shrink: 0;
}
.feed-cover image { width: 200rpx; height: 200rpx; display: block; }
.feed-boarded {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 8rpx 10rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(transparent, rgba(0,0,0,.66));
}
.feed-body { flex: 1; min-width: 0; }
.feed-when { font-size: 22rpx; color: #7a7d74; }
.feed-title { font-size: 30rpx; font-weight: 750; margin-top: 4rpx; }
.feed-host { font-size: 22rpx; color: #7a7d74; margin-top: 4rpx; }
.feed-tagline {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #3d5a1f;
  background: #eef8c8;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feed-price { margin-top: 8rpx; font-size: 22rpx; color: #7a7d74; }
.feed-price .strong { font-size: 28rpx; font-weight: 700; color: #141414; margin-right: 8rpx; }
.tiny { font-size: 20rpx; }
