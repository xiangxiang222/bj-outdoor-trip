page {
  --ui-scale: 1;
  --primary: #5b3b8c;
  --primary-soft: #efeaf7;
  --surface: #ffffff;
  --radius: 28rpx;
  width: 100%;
  overflow-x: hidden;
  background-color: var(--bg, #f6f5f8);
  background-image: none;
  color: var(--ink, #24222a);
  font-family: var(--font, "PingFang SC", "Noto Sans SC", sans-serif);
  font-size: calc(28rpx * var(--ui-scale));
  line-height: 1.55;
}
button, input, textarea { font-size: inherit; }
.card { background: var(--card, #fff); border-radius: 28rpx; margin: 20rpx 28rpx; overflow: hidden; }
.pad { padding: 28rpx; }
.cover { width: 100%; height: 360rpx; background: #e6e1ee; }
.title { font-size: calc(32rpx * var(--ui-scale)); font-weight: 650; line-height: 1.45; }
.muted { color: var(--muted, #8a8692); font-size: calc(0.75rem * var(--ui-scale)); }
.label { margin: 12rpx 32rpx 0; color: #6b705c; font-size: calc(24rpx * var(--ui-scale)); }
.price { color: #c46b4d; font-weight: 700; }
.tag { display: inline-block; background: #efeaf7; color: #5b3b8c; border-radius: 999rpx; padding: 4rpx 14rpx; font-size: calc(22rpx * var(--ui-scale)); margin-right: 8rpx; }
.btn {
  box-sizing: border-box;
  text-align: center;
  border-radius: 999rpx;
  padding: 22rpx 28rpx;
  margin: 20rpx 28rpx;
  color: #fff;
  background: #5b3b8c;
  border: 1rpx solid transparent;
  font-weight: 600;
  line-height: 1.5;
}
.btn.ghost {
  background: var(--card, #fff);
  color: #5b3b8c;
  border: 1rpx solid #ded6e9;
  box-shadow: none;
}
.btn.clay { background: #5b3b8c; color: #fff; border: 0; box-shadow: none; }
button.btn {
  font-size: calc(28rpx * var(--ui-scale));
  line-height: 1.4;
  font-weight: 600;
}
button.btn::after { border: none; }
.row { display: flex; justify-content: space-between; align-items: center; }
.chip { display: inline-flex; align-items: center; box-sizing: border-box; min-height: 68rpx; padding: 0 24rpx; border: 1px solid #eeecf2; border-radius: 16rpx; margin: 6rpx; background: #fff; font-size: calc(24rpx * var(--ui-scale)); line-height: 1.2; }
.chip.on { font-weight: 650; color: #5b3b8c; background: #efeaf7; border-color: #e4dbef; box-shadow: none; }
.chips { padding: 8rpx 8rpx 0; }
.progress { height: 12rpx; background: #eee; border-radius: 99rpx; overflow: hidden; margin: 12rpx 0; }
.bar { height: 100%; background: #5b3b8c; }
.progress.low .bar { background: #c46b4d; }
.seat-map { display: flex; flex-direction: column; align-items: center; gap: 12rpx; padding: 12rpx 0; }
.seat-front { font-size: calc(22rpx * var(--ui-scale)); color: #6b705c; }
.seat-row { display: flex; align-items: center; gap: 10rpx; }
.seat { width: 88rpx; height: 88rpx; border-radius: 12rpx; border: 1px solid #e9e5ef; background: #fff; text-align: center; line-height: 88rpx; font-size: calc(22rpx * var(--ui-scale)); }
.seat.taken { background: #e6ddf0; color: #6b705c; }
.seat.on { background: #5b3b8c; color: #fff; }
.weather { margin: 16rpx 0 0; padding: 16rpx 16rpx 8rpx; background: #eef6ff; border-radius: 12rpx; font-size: calc(24rpx * var(--ui-scale)); }
.wx-chart { width: 100%; height: 280rpx; display: block; margin-top: 8rpx; }
.stars { color: #c9a227; letter-spacing: 2rpx; font-size: calc(24rpx * var(--ui-scale)); }
.review-virtual { margin-left: 8rpx; padding: 0 10rpx; border-radius: 999rpx; background: #fff3e0; color: #b86e00; font-size: calc(20rpx * var(--ui-scale)); font-weight: 600; }
.star-pick { display: flex; gap: 8rpx; padding: 8rpx 8rpx 16rpx; }
.star { font-size: calc(44rpx * var(--ui-scale)); color: #d8d2c2; }
.star.on { color: #c9a227; }
.play-tag { display: inline-block; color: #fff; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: calc(24rpx * var(--ui-scale)); margin: 8rpx; }
.offer-chip { display: inline-block; color: #fff; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: calc(24rpx * var(--ui-scale)); margin: 8rpx; }
.offer-chip.inline { margin-right: 8rpx; font-size: calc(20rpx * var(--ui-scale)); padding: 2rpx 10rpx; }
.offer-chip.publish { background: #c9a227; color: #5b3b8c; }
.price-origin { color: #6b705c; text-decoration: line-through; margin-right: 8rpx; font-weight: 400; }
.input { background: #fff; border: 1px solid #e9e5ef; border-radius: 12rpx; padding: 18rpx; margin: 12rpx 28rpx; }
.radio-row { display: flex; gap: 36rpx; padding: 16rpx 24rpx; }
.radio-item { display: flex; align-items: center; gap: 8rpx; font-size: calc(28rpx * var(--ui-scale)); }
.nav-link { color: #5b3b8c; font-size: calc(24rpx * var(--ui-scale)); }
.field-error { margin: 0 32rpx 12rpx; color: #c46b4d; font-size: calc(24rpx * var(--ui-scale)); line-height: 1.4; }
.load-row { display: flex; align-items: center; justify-content: center; gap: 16rpx; }
.spinner { width: 36rpx; height: 36rpx; border: 4rpx solid #eeecf2; border-top-color: #5b3b8c; border-radius: 50%; animation: spin 0.8s linear infinite; flex: none; }
@keyframes spin { to { transform: rotate(360deg); } }
.guide-hit { margin-top: 8rpx; color: #5b3b8c; font-size: calc(24rpx * var(--ui-scale)); }
.seat.locked { background: #ece8df; color: #8a8578; }
.pay-paid { color: #5b3b8c; }
.pay-unpaid { color: #c46b4d; }
.hero-swipe { height: var(--hero-h, 360rpx); }
.cover, .hero-swipe, .story-img { display: var(--media, block); }
.hourly { white-space: nowrap; margin-top: 12rpx; }
.hour { display: inline-block; width: 140rpx; margin-right: 12rpx; background: #fff; border-radius: 12rpx; padding: 8rpx; font-size: calc(22rpx * var(--ui-scale)); text-align: center; white-space: pre-wrap; }
.chain-line { font-size: calc(26rpx * var(--ui-scale)); }
.payer-list { margin-top: 12rpx; }
.payer-title { font-weight: 700; font-size: calc(28rpx * var(--ui-scale)); }
.payer-row { display: flex; justify-content: space-between; align-items: center; gap: 16rpx; padding: 12rpx 0; border-top: 1px dashed #e9e5ef; font-size: calc(26rpx * var(--ui-scale)); }
.payer-amt { color: #5b3b8c; font-weight: 700; }
.cal { display: flex; width: 100%; max-width: 100%; box-sizing: border-box; gap: 8rpx; padding: 8rpx 16rpx 16rpx; overflow-x: auto; }
.cal-day { min-width: 88rpx; padding: 12rpx 8rpx; border: 1px solid #e9e5ef; border-radius: 12rpx; text-align: center; background: #fff; }
.cal-day.on { font-weight: 650; color: #5b3b8c; background: #efeaf7; border-color: #e4dbef; box-shadow: none; }
.cal-n { font-weight: 700; color: #5b3b8c; }
.faq-item { padding: 12rpx 0; border-bottom: 1px dashed #e9e5ef; }
.faq-item:last-child { border-bottom: 0; }
.guide-row { display: flex; gap: 20rpx; align-items: center; }
.guide-face {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #e6ddf0;
  color: #5b3b8c;
  text-align: center;
  line-height: 88rpx;
  font-weight: 700;
  flex-shrink: 0;
}
.album-grid,
.moments-grid {
  display: var(--media-grid, grid);
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
  padding: 0 24rpx;
  margin-bottom: 16rpx;
}
.album-img,
.moments-cell image {
  width: 100%;
  height: 100%;
  display: block;
}
.moments-cell,
.moments-add {
  position: relative;
  width: 100%;
  padding-bottom: 100%;
  background: #f3f3f3;
  overflow: hidden;
}
.moments-cell image {
  position: absolute;
  inset: 0;
}
.moments-del {
  position: absolute;
  top: 0;
  right: 0;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  font-size: calc(32rpx * var(--ui-scale));
  z-index: 1;
}
.moments-add {
  background: #f4f4f4;
}
.moments-plus {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #c8c8c8;
  font-size: calc(72rpx * var(--ui-scale));
  font-weight: 200;
  line-height: 1;
}
.moments-hint { padding: 0 24rpx 16rpx; }
.kind-grid { display: flex; gap: 12rpx; padding: 0 16rpx 16rpx; }
.act-kind {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e9e5ef;
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: calc(24rpx * var(--ui-scale));
}
.act-kind.on { font-weight: 650; color: #5b3b8c; background: #efeaf7; border-color: #e4dbef; box-shadow: none; }
.act-kind .emoji { font-size: calc(36rpx * var(--ui-scale)); }
.feed-search {
  margin: 16rpx 24rpx 8rpx;
  padding: 16rpx 28rpx;
  background: #fff;
  border-radius: 999rpx;
  font-size: calc(28rpx * var(--ui-scale));
}
.feed-ph {
  width: 220rpx;
  height: 236rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(48rpx * var(--ui-scale));
  font-weight: 700;
  color: #6b7a5c;
}
.fact-list { margin-top: 16rpx; }
.fact-row { display: flex; gap: 16rpx; align-items: flex-start; margin-top: 12rpx; }
.fact-k { width: 72rpx; font-size: calc(22rpx * var(--ui-scale)); color: #8a8692; padding-top: 4rpx; flex-shrink: 0; }
.fact-v { flex: 1; font-size: calc(28rpx * var(--ui-scale)); font-weight: 650; }
.trust-row { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.trust-chip {
  font-size: calc(22rpx * var(--ui-scale));
  background: #efeaf7;
  color: #5b3b8c;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
}
.ticket-card {
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #24222a;
  color: #fff;
}
.ticket-card.wait { background: #5b3b8c; }
.ticket-card.posted { background: #3a1848; }
.ticket-card .muted { color: rgba(255,255,255,.72); }
.ticket-actions { display: flex; gap: 16rpx; margin-top: 16rpx; }
.ticket-actions .btn { flex: 1; margin: 0; }
.enroll-dock {
  position: sticky;
  bottom: 0;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(20,20,20,.08);
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
}
.enroll-bar { display: flex; align-items: center; gap: 20rpx; }
.enroll-price { flex: 1; }
.enroll-price .strong { font-size: calc(36rpx * var(--ui-scale)); font-weight: 700; }
.dock-cta { margin: 0; min-width: 42%; }
.tab-pad {
  height: calc(140rpx + constant(safe-area-inset-bottom));
  height: calc(140rpx + env(safe-area-inset-bottom));
}
.home-seg {
  display: flex;
  margin: 8rpx 24rpx 16rpx;
  padding: 6rpx;
  background: #fff;
  border: 1px solid #e6e4dc;
  border-radius: 999rpx;
}
.home-seg-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx;
  border-radius: 999rpx;
  font-weight: 700;
  color: #8a8692;
}
.home-seg-btn.on { font-weight: 650; color: #5b3b8c; background: #efeaf7; border-color: #e4dbef; box-shadow: none; }
.trip-hint {
  margin: 0 16rpx 8rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.trip-hint-title { font-size: calc(26rpx * var(--ui-scale)); font-weight: 700; }
.catalog-lead { padding: 0 24rpx 8rpx; }
.catalog-row {
  display: flex;
  gap: 16rpx;
  margin: 8rpx 24rpx 16rpx;
}
.card .catalog-row {
  margin-left: 0;
  margin-right: 0;
}
.catalog-row .tool-btn {
  flex: 1;
  text-align: center;
  border-radius: 999rpx;
  padding: 12rpx 16rpx;
  font-weight: 700;
}
.tool-btn.ghost-line {
  background: #fff;
  color: #24222a;
  border: 1px solid #e6e4dc;
}
.feed-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  padding: 8rpx 24rpx 16rpx;
}
.feed-toolbar .hint { font-size: calc(26rpx * var(--ui-scale)); font-weight: 700; }
.feed-toolbar .tools { display: flex; align-items: center; gap: 16rpx; }
.tool-btn { font-size: calc(26rpx * var(--ui-scale)); color: #8a8692; }
.tool-btn.play { font-weight: 650; border-radius: 999rpx; padding: 10rpx 22rpx; color: #5b3b8c; background: #efeaf7; border-color: #e4dbef; box-shadow: none; }
.feed-card {
  margin: 0 28rpx 20rpx;
  padding: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  gap: 20rpx;
}
.feed-cover {
  position: relative;
  width: 220rpx;
  height: 236rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: #e8ece6;
  flex-shrink: 0;
}
.feed-cover image { width: 220rpx; height: 236rpx; display: block; }
.feed-boarded {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  padding: 8rpx 10rpx;
  font-size: calc(20rpx * var(--ui-scale));
  font-weight: 700;
  color: #fff;
  background: linear-gradient(transparent, rgba(0,0,0,.66));
}
.feed-body { flex: 1; min-width: 0; }
.feed-when { font-size: calc(22rpx * var(--ui-scale)); color: #8a8692; }
.feed-title { font-size: calc(30rpx * var(--ui-scale)); font-weight: 650; margin-top: 6rpx; line-height: 1.5; }
.trip-kind {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  height: 36rpx;
  padding: 0 12rpx 0 8rpx;
  margin-right: 8rpx;
  border-radius: 999rpx;
  font-size: calc(22rpx * var(--ui-scale));
  font-weight: 750;
  line-height: 36rpx;
  color: #fff;
  vertical-align: middle;
}
.trip-kind-ico {
  width: 18rpx;
  height: 18rpx;
  background: currentColor;
  opacity: 0.92;
}
.trip-kind.official { background: #5b3b8c; }
.trip-kind.official .trip-kind-ico { clip-path: polygon(18% 100%, 18% 12%, 88% 32%, 18% 48%); }
.trip-kind.individual { background: #5b3b8c; }
.trip-kind.individual .trip-kind-ico { border-radius: 50%; }
.trip-kind.company { background: #1d4e89; }
.trip-kind.company .trip-kind-ico { clip-path: polygon(12% 100%, 12% 42%, 38% 42%, 38% 18%, 88% 18%, 88% 100%); }
.trip-kind.campus { background: #70508f; }
.trip-kind.campus .trip-kind-ico { clip-path: polygon(50% 6%, 96% 32%, 50% 52%, 4% 32%); }
.trip-kind.activity { background: #9a3412; }
.feed-host { font-size: calc(22rpx * var(--ui-scale)); color: #8a8692; margin-top: 4rpx; }
.feed-tagline {
  margin-top: 8rpx;
  font-size: calc(22rpx * var(--ui-scale));
  color: #5b3b8c;
  background: #efeaf7;
  border-radius: 12rpx;
  padding: 6rpx 12rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.feed-price { margin-top: 8rpx; font-size: calc(22rpx * var(--ui-scale)); color: #8a8692; }
.feed-price .strong { font-size: calc(28rpx * var(--ui-scale)); font-weight: 700; color: #c46b4d; margin-right: 8rpx; }
.tiny { font-size: calc(20rpx * var(--ui-scale)); }

/* Shared interface language: quiet surfaces, clear actions, readable trip facts. */
button[disabled] { opacity: .5; }
.btn:active { opacity: .85; }
.input { background: var(--card, #fff); color: var(--ink, #24222a); min-height: 56rpx; }
.progress { background: #eee9f4; height: 10rpx; }
.trip-kind { font-weight: 500; font-size: calc(20rpx * var(--ui-scale)); }
.trip-kind.official { background: #5b3b8c; }
.trip-kind.individual { background: #678174; }
.trip-kind.company { background: #5a7191; }
.trip-kind.campus { background: #80649d; }
.feed-tagline { color: #77628e; background: #f4f0f9; border-radius: 8rpx; }
.feed-card { border: 1rpx solid rgba(69, 45, 101, .035); }
.feed-when { font-size: calc(21rpx * var(--ui-scale)); }
.feed-price .strong { font-size: calc(34rpx * var(--ui-scale)); }
.section-kicker { color: #8c769f; font-size: 18rpx; letter-spacing: 4rpx; font-weight: 600; }
.section-title { font-size: calc(40rpx * var(--ui-scale)); line-height: 1.3; font-weight: 650; color: var(--ink, #24222a); }
.page-heading { padding: 36rpx 32rpx 24rpx; }
.page-heading .section-title { margin-top: 10rpx; }
.page-heading .muted { margin-top: 12rpx; line-height: 1.65; }
