<wxs src="../../utils/locale.wxs" module="tr" />
<view class="live-pulse {{rows.length > 1 ? 'is-rows' : ''}} {{flush ? 'is-flush' : ''}}" wx:if="{{visible}}">
  <block wx:if="{{rows.length}}">
    <view class="live-pulse-main" wx:for="{{rows}}" wx:key="lane" bindtap="goRow" data-lane="{{item.lane}}">
      <view class="live-pulse-face">{{tr.t(item.face, lang)}}</view>
      <view class="live-pulse-text">{{tr.t(item.text, lang)}}</view>
      <view class="live-pulse-now" wx:if="{{item.lane == 0 && watchingText}}">{{tr.t(watchingText, lang)}}</view>
    </view>
  </block>
  <block wx:else>
    <view class="live-pulse-main" bindtap="go">
      <view class="live-pulse-face">{{tr.t(face, lang)}}</view>
      <view class="live-pulse-text">{{tr.t(line, lang)}}</view>
    </view>
    <view class="live-pulse-now" wx:if="{{watchingText && items.length}}">{{tr.t(watchingText, lang)}}</view>
  </block>
</view>
