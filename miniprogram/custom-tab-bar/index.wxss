.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1rpx solid #eceee8;
  z-index: 100;
}
.item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a7d74;
}
.item.on { color: #6b2178; font-weight: 600; }
.item image { width: 48rpx; height: 48rpx; margin-bottom: 4rpx; }
