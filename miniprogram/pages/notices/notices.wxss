.notice-page{padding:28rpx 28rpx 70rpx;color:#292630;--notice-purple:#5b3b8c;--notice-muted:#92909b;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB",sans-serif}
.notice-heading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:12rpx 4rpx 32rpx}.notice-eyebrow{font-size:18rpx;font-weight:600;letter-spacing:4rpx;color:#9b8bab}.notice-title{margin-top:12rpx;font-size:44rpx;font-weight:650;letter-spacing:1rpx}.notice-subtitle{margin-top:10rpx;font-size:24rpx;color:var(--notice-muted)}.notice-read-all{flex-shrink:0;font-size:24rpx;color:var(--notice-purple);padding:20rpx 14rpx}.notice-read-all.disabled{opacity:.4}
.notice-tabs{display:flex;gap:8rpx;padding:8rpx;margin-bottom:28rpx;background:#eeebf3;border-radius:22rpx}.notice-tab{display:flex;flex:1;align-items:center;justify-content:center;gap:10rpx;padding:18rpx 8rpx;font-size:27rpx;color:#8e8798;border-radius:16rpx}.notice-tab text{font-size:21rpx;min-width:24rpx}.notice-tab.selected{color:var(--notice-purple);background:white;font-weight:600;box-shadow:0 3rpx 9rpx rgba(61,42,87,.05)}
.notice-card{display:flex;gap:22rpx;margin:0 0 18rpx;padding:28rpx 26rpx;background:white;border:1rpx solid #efedf3;border-radius:28rpx}.notice-symbol{flex-shrink:0;width:68rpx;height:68rpx;border-radius:20rpx;background:#f4f1f8;display:flex;align-items:center;justify-content:center}.notice-symbol view{width:32rpx;height:24rpx;border:2rpx solid #a395b6;border-radius:5rpx;position:relative;overflow:hidden}.notice-symbol view::before{content:"";position:absolute;left:6rpx;top:-13rpx;width:18rpx;height:22rpx;border:2rpx solid #a395b6;transform:rotate(45deg)}.is-unread .notice-symbol{background:#eee6f7}.is-unread .notice-symbol view,.is-unread .notice-symbol view::before{border-color:var(--notice-purple)}.notice-content{flex:1;min-width:0}.notice-card-heading{display:flex;align-items:center;gap:14rpx;justify-content:space-between}.notice-card-title{font-size:29rpx;line-height:1.5;font-weight:600}.notice-dot{flex-shrink:0;width:12rpx;height:12rpx;border-radius:50%;background:var(--notice-purple)}.notice-body{margin-top:10rpx;font-size:25rpx;line-height:1.75;color:#807b89;overflow-wrap:anywhere}.notice-meta{display:flex;justify-content:space-between;gap:12rpx;margin-top:20rpx;color:#aaa5b1;font-size:20rpx}.notice-meta text:last-child{flex-shrink:0}.is-unread .notice-meta text:last-child{color:#8a70aa}
.notice-empty{text-align:center;padding:85rpx 35rpx;color:#a09aa9;font-size:25rpx;line-height:1.8}.notice-empty .notice-symbol{margin:0 auto 26rpx;width:96rpx;height:96rpx;border-radius:30rpx}.notice-empty-title{color:#746b80;font-size:29rpx;margin-bottom:14rpx;font-weight:500}.notice-error{border-radius:20rpx;background:#fff;padding:24rpx;margin-bottom:20rpx;font-size:24rpx;color:#8e7f9f}.notice-error view{color:var(--notice-purple);margin-top:16rpx}.notice-more{text-align:center;color:var(--notice-purple);padding:24rpx;font-size:25rpx}.notice-end{text-align:center;padding:28rpx;color:#b2aabd;font-size:22rpx}
