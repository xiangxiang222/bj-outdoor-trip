<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="brand-box {{textMode ? 'is-text-mode' : ''}}">
  <swiper class="brand-hero" autoplay circular interval="6000" bindchange="onHeroChange">
    <swiper-item wx:for="{{home.brand.slides}}" wx:key="title" bindtap="goSlide" data-id="{{item.routeId}}">
      <image class="brand-img" src="{{item.url}}" mode="aspectFill" />
    </swiper-item>
    <swiper-item wx:if="{{!home.brand.slides.length}}"><image class="brand-img" src="{{mediaBase}}/covers/R01.jpg" mode="aspectFill" /></swiper-item>
  </swiper>
  <view class="hero-shade"></view>
  <view class="home-brand" style="padding-top:{{statusBarHeight + 12}}px">
    <image class="home-brand-logo" src="{{mediaBase}}/logo.jpg" mode="aspectFit" />
    <view><view class="home-brand-name">{{tr.t('同行者众', lang)}}</view><view class="home-brand-en">TOGETHER, INTO THE WILD</view></view>
  </view>
  <view class="brand-cap" bindtap="goCurrentSlide">
    <view class="home-eyebrow">{{tr.t('离城市近一点 · 离自然更近一点', lang)}}</view>
    <view class="home-kicker">{{tr.t('在山野，遇见爱', lang)}}</view>
    <view class="home-lead">{{tr.t('和同频的人，一起出发。', lang)}}</view>
  </view>
  <view class="hero-counter" wx:if="{{home.brand.slides.length}}">0{{heroIndex + 1}} <text>/ 0{{home.brand.slides.length}}</text></view>
</view>

<view class="discovery-card">
  <view class="search-card-top"><text class="departure-city">{{tr.t('北京出发', lang)}}</text><text class="search-card-hint">{{tr.t('下一站，去哪里', lang)}}</text></view>
  <view class="search-input-row"><view class="search-line-icon"></view><input class="feed-search" placeholder="{{tr.t(searchHint, lang)}}" value="{{query}}" bindinput="onQuery" bindconfirm="explore" confirm-type="search" /></view>
  <view class="search-context"><text>{{tr.t('周边短途', lang)}}</text><text>{{tr.t('高校跨校 · 跨学院', lang)}}</text><text>{{tr.t('企业团队', lang)}}</text></view>
  <view class="btn search-cta" bindtap="explore">{{tr.t('发现我的下一程', lang)}}<text> →</text></view>
  <view class="search-trust">{{tr.t('正规线路 · 透明费用 · 专业领队', lang)}}</view>
</view>

<view class="quick-entries">
  <view class="quick-entry" bindtap="showRoutes"><view class="quick-icon route"><view></view></view><text>{{tr.t('精选线路', lang)}}</text><text class="quick-note">{{tr.t('山野灵感', lang)}}</text></view>
  <view class="quick-entry" bindtap="goPublish" data-kind="campus"><view class="quick-icon campus"><view></view></view><text>{{tr.t('高校同行', lang)}}</text><text class="quick-note">{{tr.t('跨校跨学院', lang)}}</text></view>
  <view class="quick-entry" bindtap="goPublish" data-kind="company"><view class="quick-icon company"><view></view></view><text>{{tr.t('企业团建', lang)}}</text><text class="quick-note">{{tr.t('一起凝聚', lang)}}</text></view>
  <view class="quick-entry" bindtap="goStudent"><view class="quick-icon pass"><view></view></view><text>{{tr.t('校园认证', lang)}}</text><text class="quick-note">{{tr.t('解锁学生价', lang)}}</text></view>
</view>

<view class="trip-hint" wx:if="{{upcoming}}" bindtap="goUpcoming">
  <view><view class="muted">{{tr.t('下一段旅程，已在路上', lang)}}</view><view class="trip-hint-title">{{tr.t(upcoming.startDate, lang)}} · {{tr.t(upcoming.title, lang)}}</view></view>
  <text class="trip-hint-arrow">›</text>
</view>
<view class="campus-card" bindtap="quickHost" data-kind="campus">
  <view class="campus-badge">{{tr.t('校', lang)}}</view>
  <view class="campus-card-copy"><view class="campus-title">{{tr.t('青春同行，不止同校', lang)}}</view><view class="muted">{{tr.t('发现跨校与跨学院的旅程', lang)}}</view></view>
  <view class="campus-cta">{{tr.t('看校园团', lang)}} ›</view>
</view>
<view class="explore-heading" id="explore"><view><view class="section-kicker">FIND YOUR NEXT JOURNEY</view><view class="section-title">{{tr.t('总有一程，心之所向', lang)}}</view></view></view>
<view class="home-seg">
  <view class="home-seg-btn {{view=='trips'?'on':''}}" bindtap="setView" data-view="trips">{{tr.t('即将出发', lang)}}</view>
  <view class="home-seg-btn {{view=='routes'?'on':''}}" bindtap="setView" data-view="routes">{{tr.t('精选线路', lang)}}</view>
</view>
<block wx:if="{{view=='trips'}}">
<scroll-view scroll-x class="city-bar">
  <view class="chip {{!city?'on':''}}" bindtap="clearCity">{{tr.t('热门', lang)}}</view>
  <view class="chip {{city==item.name?'on':''}}" wx:for="{{home.cities}}" wx:key="name" bindtap="setCity" data-name="{{item.name}}">{{tr.t(item.name, lang)}}</view>
</scroll-view>
<scroll-view scroll-x class="city-bar">
  <view class="chip {{!tag?'on':''}}" bindtap="clearTag">{{tr.t('全部玩法', lang)}}</view>
  <view class="chip {{tag==item.name?'on':''}}" wx:for="{{home.tags}}" wx:key="id" bindtap="setTag" data-name="{{item.name}}">{{tr.t(item.name, lang)}}</view>
</scroll-view>
<view class="feed-toolbar">
  <view class="hint">{{tr.t('找到同频的旅伴', lang)}}</view>
  <view class="tools">
    <view class="tool-btn" bindtap="cycleSort">{{tr.t(sortText, lang)}}</view>
    <view class="tool-btn" bindtap="toggleFold" data-key="extra">{{tr.t(fold.extra ? '收起' : '筛选', lang)}}</view>
  </view>
</view>

<block wx:if="{{fold.extra}}">
  <scroll-view scroll-x class="city-bar">
    <view class="chip {{!hostKind?'on':''}}" bindtap="clearHost">{{tr.t('全部团', lang)}}</view>
    <view class="chip {{hostKind=='official'?'on':''}}" bindtap="setHost" data-kind="official">{{tr.t('官方', lang)}}</view>
    <view class="chip {{hostKind=='company'?'on':''}}" bindtap="setHost" data-kind="company">{{tr.t('公司', lang)}}</view>
    <view class="chip {{hostKind=='campus'?'on':''}}" bindtap="setHost" data-kind="campus">{{tr.t('高校', lang)}}</view>
    <view class="chip {{hostKind=='individual'?'on':''}}" bindtap="setHost" data-kind="individual">{{tr.t('个人', lang)}}</view>
  </scroll-view>
  <scroll-view scroll-x class="city-bar" wx:if="{{hostKind=='company' && hostCompanies.length}}">
    <view class="chip {{!companyName?'on':''}}" bindtap="clearCompany">{{tr.t('全部公司', lang)}}</view>
    <view class="chip {{companyName==item?'on':''}}" wx:for="{{hostCompanies}}" wx:key="*this" bindtap="setCompany" data-name="{{item}}">{{tr.t(item, lang)}}</view>
  </scroll-view>
  <scroll-view scroll-x class="city-bar" wx:if="{{hostKind=='campus' && hostSchools.length}}">
    <view class="chip {{!school?'on':''}}" bindtap="clearSchool">{{tr.t('全部高校', lang)}}</view>
    <view class="chip {{school==item?'on':''}}" wx:for="{{hostSchools}}" wx:key="*this" bindtap="setSchool" data-name="{{item}}">{{tr.t(item, lang)}}</view>
  </scroll-view>
  <scroll-view scroll-x class="cal">
    <view class="cal-day {{date==item.date?'on':''}}" wx:for="{{calendar}}" wx:key="date" bindtap="setDate" data-date="{{item.date}}">
      <view class="muted tiny">{{tr.t(item.w, lang)}}</view>
      <view class="cal-n">{{tr.t(item.n, lang)}}</view>
      <view class="muted tiny">{{tr.t(item.count ? item.count + '团' : '—', lang)}}</view>
    </view>
  </scroll-view>
  <view class="chips">
    <view class="chip {{monthKey==item.key && monthPicked?'on':''}}" wx:for="{{home.months}}" wx:key="key" bindtap="pickMonth" data-key="{{item.key}}">{{tr.t(item.label, lang)}}</view>
  </view>
  <view class="month-grid" wx:if="{{monthPicked}}">
    <view class="month-cell {{date==item.date?'on':''}}" wx:for="{{monthDays}}" wx:key="date" bindtap="setDate" data-date="{{item.date}}">{{tr.t(item.label, lang)}}</view>
  </view>
  <view class="chips">
    <view class="chip {{festivalKey==item.key?'on':''}}" wx:for="{{home.festivals}}" wx:key="key" bindtap="setFestival" data-key="{{item.key}}">{{tr.t(item.name, lang)}}</view>
  </view>
  <view class="chips">
    <view class="offer-chip" wx:for="{{offers}}" wx:key="key" style="background:{{item.color}}" bindtap="setOffer" data-key="{{item.key}}">{{tr.t(item.label, lang)}}</view>
  </view>
</block>

<view class="picked" wx:if="{{picked.length}}">
  <view class="picked-chip" wx:for="{{picked}}" wx:key="key" bindtap="clearPick" data-key="{{item.key}}">{{tr.t(item.label, lang)}} ×</view>
</view>

<view class="publish-entry" bindtap="goPublish">
  <view class="publish-entry-copy">
    <view class="publish-entry-title">{{tr.t('这一程，由你发起', lang)}}</view>
    <view class="publish-entry-sub">{{tr.t('个人 · 企业 · 高校，一站式发团', lang)}}</view>
  </view>
  <view class="publish-entry-go">{{tr.t('发起组团', lang)}}</view>
</view>
<view class="feed-card" wx:for="{{groups}}" wx:key="id" bindtap="goGroup" data-id="{{item.id}}">
  <view class="feed-cover">
    <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load />
    <view wx:else class="feed-ph">{{tr.t(item.coverMark, lang)}}</view>
    <view class="feed-boarded">{{tr.t(item.boarded, lang)}}</view>
  </view>
  <view class="feed-body">
    <view class="feed-when">{{tr.t(item.feedWhen, lang)}} · {{tr.t(item.city, lang)}}</view>
    <view class="feed-title"><view class="trip-kind {{item.kind || 'individual'}}"><view class="trip-kind-ico"></view>{{tr.t(item.kindLabel || '个人', lang)}}</view> <text class="offer-chip inline" wx:if="{{item.private}}" style="background:#4c1d95">{{tr.t(item.privateLabel || '口令团', lang)}}</text> {{tr.t(item.route.title, lang)}}</view>
    <view class="feed-host">{{tr.t(item.host, lang)}}</view>
    <view class="feed-tagline" wx:if="{{item.tagline}}">{{tr.t(item.tagline, lang)}}</view>
    <view class="feed-price" wx:if="{{item.free}}">{{tr.t('免费', lang)}}</view>
    <view class="feed-price" wx:else>
      <text class="strong">¥{{tr.t(item.quote.originPrice, lang)}}</text>
      <text> {{tr.t('会员 ¥', lang)}}{{tr.t(item.quote.memberPrice, lang)}}</text>
    </view>
  </view>
</view>
<view wx:if="{{loading && !groups.length}}" class="card">
  <view class="pad load-row"><view class="spinner"></view><text class="muted">{{tr.t('正在加载近期的团…', lang)}}</text></view>
</view>
<view wx:elif="{{!groups.length}}" class="card">
  <view class="pad">
    <view class="title">{{tr.t('还没有符合条件的团', lang)}}</view>
    <view class="muted">{{tr.t('过审的团会出现在这里。也可以先看官方线路。', lang)}}</view>
    <view class="catalog-row" style="margin-top:16rpx">
      <view class="tool-btn ghost-line" catchtap="setView" data-view="routes">{{tr.t('先看线路', lang)}}</view>
      <view class="tool-btn play" catchtap="goPublish">{{tr.t('去发团', lang)}}</view>
    </view>
  </view>
</view>
</block>

<block wx:else>
  <view class="muted catalog-lead">{{tr.t('官方线路。点进去看介绍，有排期就能报，没有可以自己开一团。', lang)}}</view>
  <scroll-view scroll-x class="city-bar">
    <view class="chip {{routeDays==0?'on':''}}" bindtap="setRouteDays" data-d="0">{{tr.t('全部天数', lang)}}</view>
    <view class="chip {{routeDays==1?'on':''}}" bindtap="setRouteDays" data-d="1">{{tr.t('1日', lang)}}</view>
    <view class="chip {{routeDays==2?'on':''}}" bindtap="setRouteDays" data-d="2">{{tr.t('2日', lang)}}</view>
    <view class="chip {{routeDays==3?'on':''}}" bindtap="setRouteDays" data-d="3">{{tr.t('3日', lang)}}</view>
    <view class="chip {{routeDays=='multi'?'on':''}}" bindtap="setRouteDays" data-d="multi">{{tr.t('多日', lang)}}</view>
  </scroll-view>
  <scroll-view scroll-x class="city-bar">
    <view class="chip {{routeTag==''?'on':''}}" bindtap="setRouteTag" data-c="">{{tr.t('全部玩法', lang)}}</view>
    <view class="play-tag" wx:for="{{routeTags}}" wx:key="id" style="background:{{item.color}};opacity:{{routeTag==item.name || routeTag=='' ? 1 : 0.45}}" bindtap="setRouteTag" data-c="{{item.name}}">{{tr.t(item.name, lang)}}</view>
  </scroll-view>
  <load-row wx:if="{{routeLoading && !routeList.length}}" />
  <view wx:elif="{{routeErr}}" class="muted pad">{{tr.t(routeErr, lang)}}</view>
  <view class="card" wx:for="{{routeList}}" wx:key="id" bindtap="goRoute" data-id="{{item.id}}">
    <image class="cover" src="{{item.cover}}" mode="aspectFill" />
    <view class="pad">
      <view class="title">{{tr.t(item.title, lang)}}</view>
      <view class="muted">{{tr.t(item.region, lang)}} · {{tr.t(item.days, lang)}}{{tr.t('日 ·', lang)}} {{tr.t(item.difficulty, lang)}}</view>
      <view class="price">
        <text wx:if="{{item.fromPrice > item.memberFromPrice}}" class="price-origin">¥{{tr.t(item.fromPrice, lang)}}</text>
        ¥{{tr.t(item.memberFromPrice || item.fromPrice, lang)}} {{tr.t('起', lang)}}
      </view>
    </view>
  </view>
  <view wx:if="{{!routeLoading && !routeList.length && !routeErr}}" class="muted pad">{{tr.t('没有匹配的线路', lang)}}</view>
  <view class="card" bindtap="goRouteApply">
    <view class="pad">
      <view class="title">{{tr.t('申请收录线路', lang)}}</view>
      <view class="muted">{{tr.t('留下联系方式，通过后会出现在线路目录', lang)}}</view>
    </view>
  </view>
</block>
<view class="home-foot muted" bindtap="goOfficial">{{tr.t('客服与规则', lang)}}</view>
<view class="tab-pad"></view>
