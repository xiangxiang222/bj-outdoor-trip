<swiper class="brand-hero" autoplay circular interval="4000" bindchange="onHeroChange">
  <swiper-item wx:for="{{home.brand.slides}}" wx:key="title" bindtap="goSlide" data-id="{{item.routeId}}">
    <image class="brand-img" src="{{item.url}}" mode="aspectFill" />
  </swiper-item>
</swiper>
<view class="brand-cap" bindtap="goCurrentSlide">
  <view class="home-kicker">{{home.brand.lead || '在山野，遇见爱'}}</view>
</view>
<view class="campus-card">
  <view>
    <view class="campus-title">学生认证后走学生价</view>
    <view class="muted">部分团仅限高校，周末进山先看好集合点。</view>
  </view>
  <view class="campus-cta" bindtap="goStudent">去认证</view>
</view>
<view class="trip-hint" wx:if="{{upcoming}}" bindtap="goUpcoming">
  <view>
    <text class="muted">即将出行</text>
    <text class="trip-hint-title"> {{upcoming.startDate}} · {{upcoming.title}}</text>
  </view>
  <text class="muted">行程 ›</text>
</view>

<input class="feed-search" placeholder="{{searchHint}}" value="{{query}}" bindinput="onQuery" confirm-type="search" />

<view class="home-seg">
  <view class="home-seg-btn {{view=='trips'?'on':''}}" bindtap="setView" data-view="trips">团</view>
  <view class="home-seg-btn {{view=='routes'?'on':''}}" bindtap="setView" data-view="routes">线路</view>
</view>

<block wx:if="{{view=='trips'}}">
<scroll-view scroll-x class="city-bar">
  <view class="chip {{!city?'on':''}}" bindtap="clearCity">热门</view>
  <view class="chip {{city==item.name?'on':''}}" wx:for="{{home.cities}}" wx:key="name" bindtap="setCity" data-name="{{item.name}}">{{item.name}}</view>
</scroll-view>
<scroll-view scroll-x class="city-bar">
  <view class="chip {{!tag?'on':''}}" bindtap="clearTag">全部玩法</view>
  <view class="chip {{tag==item.name?'on':''}}" wx:for="{{home.tags}}" wx:key="id" bindtap="setTag" data-name="{{item.name}}">{{item.name}}</view>
</scroll-view>

<view class="feed-toolbar">
  <view class="hint">看看最近都在忙什么</view>
  <view class="tools">
    <view class="tool-btn" bindtap="cycleSort">{{sortText}}</view>
    <view class="tool-btn" bindtap="toggleFold" data-key="extra">{{fold.extra ? '收起' : '筛选'}}</view>
    <view class="tool-btn play" bindtap="goPublish">发团</view>
  </view>
</view>

<block wx:if="{{fold.extra}}">
  <scroll-view scroll-x class="cal">
    <view class="cal-day {{date==item.date?'on':''}}" wx:for="{{calendar}}" wx:key="date" bindtap="setDate" data-date="{{item.date}}">
      <view class="muted tiny">{{item.w}}</view>
      <view class="cal-n">{{item.n}}</view>
      <view class="muted tiny">{{item.count ? item.count + '团' : '—'}}</view>
    </view>
  </scroll-view>
  <view class="chips">
    <view class="chip {{monthKey==item.key && monthPicked?'on':''}}" wx:for="{{home.months}}" wx:key="key" bindtap="pickMonth" data-key="{{item.key}}">{{item.label}}</view>
  </view>
  <view class="month-grid" wx:if="{{monthPicked}}">
    <view class="month-cell {{date==item.date?'on':''}}" wx:for="{{monthDays}}" wx:key="date" bindtap="setDate" data-date="{{item.date}}">{{item.label}}</view>
  </view>
  <view class="chips">
    <view class="chip {{festivalKey==item.key?'on':''}}" wx:for="{{home.festivals}}" wx:key="key" bindtap="setFestival" data-key="{{item.key}}">{{item.name}}</view>
  </view>
  <view class="chips">
    <view class="offer-chip" wx:for="{{offers}}" wx:key="key" style="background:{{item.color}}" bindtap="setOffer" data-key="{{item.key}}">{{item.label}}</view>
  </view>
</block>

<view class="picked" wx:if="{{picked.length}}">
  <view class="picked-chip" wx:for="{{picked}}" wx:key="key" bindtap="clearPick" data-key="{{item.key}}">{{item.label}} ×</view>
</view>

<view class="feed-card" wx:for="{{groups}}" wx:key="id" bindtap="goGroup" data-id="{{item.id}}">
  <view class="feed-cover">
    <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
    <view wx:else class="feed-ph">{{item.coverMark}}</view>
    <view class="feed-boarded">{{item.boarded}}</view>
  </view>
  <view class="feed-body">
    <view class="feed-when">{{item.feedWhen}} · {{item.city}}</view>
    <view class="feed-title">{{item.route.title}}</view>
    <view class="feed-host">{{item.host}}</view>
    <view class="feed-tagline" wx:if="{{item.tagline}}">{{item.tagline}}</view>
    <view class="feed-price" wx:if="{{item.free}}">免费</view>
    <view class="feed-price" wx:else>
      <text class="strong">¥{{item.quote.originPrice}}</text>
      <text> 会员 ¥{{item.quote.memberPrice}}</text>
    </view>
  </view>
</view>
<view wx:if="{{!groups.length}}" class="card">
  <view class="pad">
    <view class="title">还没有符合条件的团</view>
    <view class="muted">过审的团会出现在这里。也可以先看官方线路。</view>
    <view class="catalog-row" style="margin-top:16rpx">
      <view class="tool-btn ghost-line" catchtap="setView" data-view="routes">先看线路</view>
      <view class="tool-btn play" catchtap="goPublish">去发团</view>
    </view>
  </view>
</view>
</block>

<block wx:else>
  <view class="muted catalog-lead">官方线路。点进去看介绍，有排期就能报，没有可以自己开一团。</view>
  <scroll-view scroll-x class="city-bar">
    <view class="chip {{routeDays==0?'on':''}}" bindtap="setRouteDays" data-d="0">全部天数</view>
    <view class="chip {{routeDays==1?'on':''}}" bindtap="setRouteDays" data-d="1">1日</view>
    <view class="chip {{routeDays==2?'on':''}}" bindtap="setRouteDays" data-d="2">2日</view>
    <view class="chip {{routeDays==3?'on':''}}" bindtap="setRouteDays" data-d="3">3日</view>
    <view class="chip {{routeDays=='multi'?'on':''}}" bindtap="setRouteDays" data-d="multi">多日</view>
  </scroll-view>
  <scroll-view scroll-x class="city-bar">
    <view class="chip {{routeTag==''?'on':''}}" bindtap="setRouteTag" data-c="">全部玩法</view>
    <view class="play-tag" wx:for="{{routeTags}}" wx:key="id" style="background:{{item.color}};opacity:{{routeTag==item.name || routeTag=='' ? 1 : 0.45}}" bindtap="setRouteTag" data-c="{{item.name}}">{{item.name}}</view>
  </scroll-view>
  <view wx:if="{{routeErr}}" class="muted pad">{{routeErr}}</view>
  <view class="card" wx:for="{{routeList}}" wx:key="id" bindtap="goRoute" data-id="{{item.id}}">
    <image class="cover" src="{{item.cover}}" mode="aspectFill" />
    <view class="pad">
      <view class="title">{{item.title}}</view>
      <view class="muted">{{item.region}} · {{item.days}}日 · {{item.difficulty}}</view>
      <view class="price">
        <text wx:if="{{item.fromPrice > item.memberFromPrice}}" class="price-origin">¥{{item.fromPrice}}</text>
        ¥{{item.memberFromPrice || item.fromPrice}} 起
      </view>
    </view>
  </view>
  <view wx:if="{{!routeList.length}}" class="muted pad">没有匹配的线路</view>
</block>
<view class="home-foot muted" bindtap="goOfficial">客服与规则</view>
