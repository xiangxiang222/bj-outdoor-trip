<swiper class="brand-hero" autoplay circular interval="4000">
  <swiper-item wx:for="{{home.brand.slides}}" wx:key="title">
    <image class="brand-img" src="{{item.url}}" mode="aspectFill" />
  </swiper-item>
</swiper>
<view class="brand-cap">
  <view class="home-lead">{{home.brand.lead || '在山野，遇见爱'}}</view>
</view>
<view class="card" wx:if="{{upcoming}}" bindtap="goUpcoming">
  <view class="pad">
    <view class="muted">即将出行 · 看行程</view>
    <view class="title">{{upcoming.title}}</view>
    <view class="muted">{{upcoming.startDate}} · {{upcoming.meetupPoint}} {{upcoming.meetupTime}}</view>
  </view>
</view>

<view class="pad" style="padding-bottom:0"><view class="title">去哪儿玩？</view></view>
<scroll-view scroll-x class="city-bar">
  <view class="chip {{city==item.name?'on':''}}" wx:for="{{home.cities}}" wx:key="name" bindtap="setCity" data-name="{{item.name}}">{{item.name}}</view>
</scroll-view>

<view class="pad" style="padding-bottom:0"><view class="title">哪天玩？</view></view>
<view class="fold" bindtap="toggleFold" data-key="days">最近十五天 {{fold.days ? '收起' : '展开'}}</view>
<view class="cal" wx:if="{{fold.days}}">
  <view class="cal-day {{date==item.date?'on':''}}" wx:for="{{calendar}}" wx:key="date" bindtap="setDate" data-date="{{item.date}}">
    <view class="cal-n">{{item.label}}</view>
    <view class="muted">{{item.count ? item.count + '团' : '—'}}</view>
  </view>
</view>
<view class="fold" bindtap="toggleFold" data-key="month">按月选择 {{fold.month ? '收起' : '展开'}}</view>
<block wx:if="{{fold.month}}">
  <view class="chips">
    <view class="chip {{monthKey==item.key?'on':''}}" wx:for="{{home.months}}" wx:key="key" bindtap="pickMonth" data-key="{{item.key}}">{{item.label}}</view>
  </view>
  <view class="month-grid">
    <view class="month-cell {{date==item.date?'on':''}}" wx:for="{{monthDays}}" wx:key="date" bindtap="setDate" data-date="{{item.date}}">{{item.label}}</view>
  </view>
</block>
<view class="fold" bindtap="toggleFold" data-key="fest">按节日 {{fold.fest ? '收起' : '展开'}}</view>
<block wx:if="{{fold.fest}}">
  <view class="chips">
    <view class="chip {{festivalKey==item.key?'on':''}}" wx:for="{{home.festivals}}" wx:key="key" bindtap="setFestival" data-key="{{item.key}}">{{item.name}}</view>
  </view>
</block>

<view class="pad" style="padding-bottom:0"><view class="title">想怎么玩？</view></view>
<view class="chips">
  <view class="chip {{tag==item.name?'on':''}}" wx:for="{{home.tags}}" wx:key="id" bindtap="setTag" data-name="{{item.name}}">{{item.name}}</view>
</view>

<view class="picked" wx:if="{{picked.length}}">
  <view class="picked-chip" wx:for="{{picked}}" wx:key="key" bindtap="clearPick" data-key="{{item.key}}">{{item.label}} ×</view>
</view>

<view class="chips">
  <view class="offer-chip" wx:for="{{offers}}" wx:key="key" style="background:{{item.color}}" bindtap="setOffer" data-key="{{item.key}}">{{item.label}}</view>
  <view class="offer-chip publish" bindtap="goPublish">发团</view>
</view>

<view class="card" wx:for="{{groups}}" wx:key="id" bindtap="goGroup" data-id="{{item.id}}">
  <image wx:if="{{item.route.cover}}" class="cover" src="{{item.route.cover}}" mode="aspectFill" style="height:280rpx" />
  <view class="pad">
    <view class="row">
      <text class="title">{{item.route.title}}</text>
      <text class="tag">{{item.startDate}}</text>
    </view>
    <view class="muted">{{item.city}} · 余 {{item.remain}} 座</view>
    <view class="prices">
      <text>原价 ¥{{item.quote.originPrice}}</text>
      <text>会员 ¥{{item.quote.memberPrice}}</text>
      <text>学生 ¥{{item.quote.studentPrice}}</text>
    </view>
  </view>
</view>
<view wx:if="{{!groups.length}}" class="card" bindtap="goPublish">
  <view class="pad">
    <view class="title">还没有符合条件的团</view>
    <view class="muted">发一个新团，审核通过后会出现在这里。</view>
  </view>
</view>

<view class="cta" bindtap="goMember">会员注册</view>
<view class="cta" bindtap="goLottery">抽奖 · 报名前可抽一次</view>
<view class="cta" bindtap="goOfficial">联系我们</view>
<view class="cta" bindtap="goFeedback">功能建议与找 BUG</view>
