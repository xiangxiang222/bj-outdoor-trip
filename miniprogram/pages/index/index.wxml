<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<import src="../../templates/route-catalog.wxml" />
<view class="home-page {{homeDark ? 'is-dark' : ''}} {{textMode ? 'is-text-mode' : ''}}" bindtouchstart="cancelExplore">
<view class="brand-box" style="--home-nav-height:{{statusBarHeight + navHeight}}px">
<view class="home-nav" style="padding-top:{{statusBarHeight}}px">
  <view class="home-brand" style="height:{{navHeight}}px;padding-right:{{navRight}}px">
    <image class="home-brand-logo" src="/images/home/brand-mark.png" mode="aspectFit" />
    <view class="home-brand-copy"><view class="home-brand-name">{{tr.t('同行者众', lang)}}</view><view class="home-brand-en">{{tr.t('在山野，遇见爱', lang)}}</view></view>
  </view>
</view>
  <swiper class="brand-hero" current="{{heroIndex}}" autoplay circular interval="6000" bindchange="onHeroChange">
    <swiper-item wx:for="{{heroSlides}}" wx:key="url" bindtap="goSlide" data-id="{{item.routeId}}">
      <image wx:if="{{!item.imageBroken}}" class="brand-img" src="{{item.url}}" mode="aspectFill" binderror="onHeroError" data-index="{{index}}" />
    </swiper-item>
  </swiper>
  <view class="hero-shade"></view>
  <view class="hero-side-fade"></view>
  <view class="brand-cap">
    <view class="home-eyebrow">{{tr.t('离城市近一点 · 离自然更近一点', lang)}}</view>
    <view class="home-kicker" aria-label="{{tr.t('在山野，遇见爱', lang)}}"><text>{{tr.t('在山野，', lang)}}</text><text>{{tr.t('遇见爱', lang)}}</text></view>
    <view class="home-lead">{{tr.t('和同频的人，一起出发。', lang)}}</view>
    <view class="hero-discover" bindtap="discoverJourney" aria-role="button">{{tr.t('发现下一程', lang)}}<text aria-hidden="true">↗</text></view>
  </view>
  <view class="hero-dots" wx:if="{{heroSlides.length > 1}}"><view wx:for="{{heroSlides}}" wx:key="url" class="hero-dot {{heroIndex == index ? 'selected' : ''}}" bindtap="selectHero" data-index="{{index}}" aria-role="button" aria-label="{{tr.t('切换风景', lang)}} {{index + 1}}"><view></view></view></view>
</view>

<view class="discovery-card">
  <view class="search-card-top"><text class="search-caption">{{tr.t('下一程，想去哪里', lang)}}</text><text class="departure-city">{{tr.t('从北京出发', lang)}}</text></view>
  <view class="search-input-row"><view class="search-line-icon" aria-hidden="true"></view><input class="feed-search" placeholder="{{tr.t(searchHint, lang)}}" value="{{query}}" bindinput="onQuery" bindconfirm="discoverTrips" confirm-type="search" /></view>
  <view class="search-date" bindtap="openDepartureDates" aria-role="button" aria-label="{{tr.t('选择出发日期', lang)}}"><view class="departure-calendar-icon" aria-hidden="true"></view><text>{{tr.t(departurePreset == 'any' ? '出发日期不限' : departureLabel, lang)}}</text><view class="departure-down" aria-hidden="true"></view></view>
  <view class="search-cta" bindtap="discoverTrips" aria-role="button">{{tr.t('寻找我的山野', lang)}}<text aria-hidden="true">→</text></view>
  <view class="search-hot"><text class="search-hot-label">{{tr.t('热门', lang)}}</text><text wx:for="{{hotWords}}" wx:key="*this" bindtap="searchDestination" data-keyword="{{item}}">{{tr.t(item, lang)}}</text></view>
</view>

<view class="discovery-ai-entry" bindtap="goDiscover" aria-label="{{tr.t('说说你想怎么玩',lang)}}">
  <view class="discovery-ai-mark" aria-hidden="true"><view></view><view></view></view>
  <view class="discovery-ai-copy"><view>{{tr.t('说说你想怎么玩',lang)}}</view><text>{{tr.t('时间、预算和偏好，一起说清楚',lang)}}</text></view>
  <text class="discovery-ai-arrow" aria-hidden="true">→</text>
</view>

<view class="quick-entries">
  <view class="quick-entry" bindtap="showRoutes"><view class="quick-icon route"><image src="/images/home/mountain.svg" mode="aspectFit" /></view><text>{{tr.t('精选线路', lang)}}</text><text class="quick-note">{{tr.t('山野灵感', lang)}}</text></view>
  <view class="quick-entry" bindtap="quickHost" data-kind="campus"><view class="quick-icon campus"><image src="/images/home/school.svg" mode="aspectFit" /></view><text>{{tr.t('高校同行', lang)}}</text><text class="quick-note">{{tr.t('发现跨校旅程', lang)}}</text></view>
  <view class="quick-entry" bindtap="quickHost" data-kind="company"><view class="quick-icon company"><image src="/images/home/building.svg" mode="aspectFit" /></view><text>{{tr.t('企业团建', lang)}}</text><text class="quick-note">{{tr.t('寻找团队出行', lang)}}</text></view>
  <view class="quick-entry" bindtap="goGuides"><view class="quick-icon companions"><image src="/images/home/people.svg" mode="aspectFit" /></view><text>{{tr.t('专业领队', lang)}}</text><text class="quick-note">{{tr.t('认识带路的人', lang)}}</text></view>
</view>

<view class="destination-section" wx:if="{{destinations.length}}">
  <view class="home-section-heading"><view><view class="section-title">{{tr.t('走出日常，自然会有答案', lang)}}</view></view><text class="destination-caption" bindtap="showRoutes">{{tr.t('更多灵感', lang)}} ↗</text></view>
  <view class="destination-grid">
    <view class="destination-card {{routePreference==item.preference?'selected':''}}" wx:for="{{destinations}}" wx:key="preference" bindtap="discoverInspiration" data-preference="{{item.preference}}" aria-role="button" aria-pressed="{{routePreference==item.preference}}">
      <image class="destination-photo" src="{{item.photo}}" mode="aspectFill" lazy-load />
      <view class="destination-shade"></view><view class="destination-tag">{{tr.t(item.preferenceName, lang)}}</view>
      <view class="destination-copy"><view class="destination-name">{{tr.t(item.name, lang)}}</view><view class="destination-en">{{item.en}}</view><view class="destination-note">{{tr.t(item.copy, lang)}}</view></view>
    </view>
  </view>
</view>

<view class="campus-card {{campusDark ? 'is-dark' : ''}}" bindtap="goStudent" hover-class="campus-pressed" aria-label="{{tr.t('校园认证', lang)}}">
  <view class="campus-ridge" aria-hidden="true"></view>
  <view class="campus-pass" aria-hidden="true">
    <view class="campus-pass-back"></view>
    <view class="campus-pass-face"><view class="campus-pass-mountain"></view><view class="campus-pass-lines"></view><view class="campus-pass-stamp"></view></view>
  </view>
  <view class="campus-card-copy">
    <view class="campus-eyebrow">{{tr.t('校园礼遇', lang)}}<view></view></view>
    <view class="campus-title">{{tr.t('让青春，多一种出发', lang)}}</view>
    <view class="campus-card-footer"><text class="campus-note">{{tr.t('认证校园身份，发现专属旅程', lang)}}</text><view class="campus-cta">{{tr.t(campusAction, lang)}}<text>↗</text></view></view>
  </view>
</view>
<view class="trip-hint" wx:if="{{upcoming}}" bindtap="goUpcoming">
  <view><view class="muted">{{tr.t('下一段旅程，已在路上', lang)}}</view><view class="trip-hint-title">{{tr.t(upcoming.startDate, lang)}} · {{tr.t(upcoming.title, lang)}}</view></view>
  <text class="trip-hint-arrow">›</text>
</view>
<view class="home-seg" id="explore">
  <view class="home-seg-btn {{view=='trips'?'on':''}}" bindtap="setView" data-view="trips">{{tr.t('即将出发', lang)}}</view>
  <view class="home-seg-btn {{view=='routes'?'on':''}}" bindtap="setView" data-view="routes">{{tr.t('精选线路', lang)}}</view>
</view>
<block wx:if="{{view=='trips'}}">
<view class="departure-time-bar {{campusDark?'is-dark':''}}" aria-label="{{tr.t('按出发时间选团',lang)}}">
  <view class="departure-bar-heading"><view>{{tr.t('什么时候出发',lang)}}</view><text>{{tr.t('选个日子，去透透气',lang)}}</text></view>
  <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="departure-shortcut-scroll"><view class="departure-shortcut-row">
    <button class="departure-time-chip {{departurePreset=='any'?'on':''}}" bindtap="setDeparturePreset" data-key="any" aria-pressed="{{departurePreset=='any'}}">{{tr.t('不限日期',lang)}}</button>
    <button class="departure-time-chip {{departurePreset=='weekend'?'on':''}}" bindtap="setDeparturePreset" data-key="weekend" aria-pressed="{{departurePreset=='weekend'}}">{{tr.t('本周末',lang)}}</button>
    <button class="departure-time-chip {{departurePreset=='nextweekend'?'on':''}}" bindtap="setDeparturePreset" data-key="nextweekend" aria-pressed="{{departurePreset=='nextweekend'}}">{{tr.t('下周末',lang)}}</button>
    <button class="departure-time-chip departure-calendar-trigger {{departurePreset=='custom'?'on':''}}" bindtap="openDepartureDates" aria-label="{{tr.t('选择出发日期',lang)}}"><view class="departure-calendar-icon" aria-hidden="true"></view><text>{{tr.t(departurePreset=='custom'?departureLabel:'选日期',lang)}}</text><view class="departure-down" aria-hidden="true"></view></button>
  </view></scroll-view>
</view>
<scroll-view scroll-x class="city-bar">
  <view class="chip {{!city?'on':''}}" bindtap="clearCity">{{tr.t('热门', lang)}}</view>
  <view class="chip {{city==item.name?'on':''}}" wx:for="{{home.cities}}" wx:key="name" bindtap="setCity" data-name="{{item.name}}">{{tr.t(item.name, lang)}}</view>
</scroll-view>
<scroll-view scroll-x class="city-bar">
  <view class="chip {{!tag?'on':''}}" bindtap="clearTag">{{tr.t('全部玩法', lang)}}</view>
  <view class="chip {{tag==item.name?'on':''}}" wx:for="{{home.tags}}" wx:key="id" bindtap="setTag" data-name="{{item.name}}">{{tr.t(item.name, lang)}}</view>
</scroll-view>
<view class="feed-toolbar">
  <view class="hint">{{tr.t('找到同频的旅伴', lang)}}</view>
  <view class="tools">
    <view class="tool-btn" bindtap="cycleSort">{{tr.t(sortText, lang)}}</view>
    <view class="tool-btn" bindtap="toggleFold" data-key="extra">{{tr.t(fold.extra ? '收起' : '更多筛选', lang)}}</view>
  </view>
</view>

<scroll-view scroll-x class="city-bar">
  <view class="chip {{!hostKind?'on':''}}" bindtap="clearHost">{{tr.t('全部团', lang)}}</view>
  <view class="chip {{hostKind=='official'?'on':''}}" bindtap="setHost" data-kind="official">{{tr.t('官方', lang)}}</view>
  <view class="chip {{hostKind=='company'?'on':''}}" bindtap="setHost" data-kind="company">{{tr.t('公司', lang)}}</view>
  <view class="chip {{hostKind=='campus'?'on':''}}" bindtap="setHost" data-kind="campus">{{tr.t('高校', lang)}}</view>
  <view class="chip {{hostKind=='individual'?'on':''}}" bindtap="setHost" data-kind="individual">{{tr.t('个人', lang)}}</view>
</scroll-view>

<view class="departure-extra-panel" wx:if="{{fold.extra}}">
  <view class="departure-extra-title">{{tr.t('优惠与范围',lang)}}</view>
  <scroll-view scroll-x class="city-bar" wx:if="{{hostKind=='company' && hostCompanies.length}}">
    <view class="chip {{!companyName?'on':''}}" bindtap="clearCompany">{{tr.t('全部公司', lang)}}</view>
    <view class="chip {{companyName==item?'on':''}}" wx:for="{{hostCompanies}}" wx:key="*this" bindtap="setCompany" data-name="{{item}}">{{tr.t(item, lang)}}</view>
  </scroll-view>
  <scroll-view scroll-x class="city-bar" wx:if="{{hostKind=='campus' && hostSchools.length}}">
    <view class="chip {{!school?'on':''}}" bindtap="clearSchool">{{tr.t('全部高校', lang)}}</view>
    <view class="chip {{school==item?'on':''}}" wx:for="{{hostSchools}}" wx:key="*this" bindtap="setSchool" data-name="{{item}}">{{tr.t(item, lang)}}</view>
  </scroll-view>
  <view class="chips filter-options">
    <view class="offer-chip" wx:for="{{offers}}" wx:key="key" style="background:{{item.color}};opacity:{{offerFilter && offerFilter!=item.key?0.45:1}}" bindtap="setOffer" data-key="{{item.key}}">{{tr.t(item.label, lang)}}</view>
  </view>
</view>

<view class="picked" wx:if="{{picked.length}}">
  <view class="picked-chip" wx:for="{{picked}}" wx:key="key" bindtap="clearPick" data-key="{{item.key}}">{{tr.t(item.label, lang)}} ×</view>
</view>

<view class="feed-card" wx:for="{{groups}}" wx:key="id" bindtap="goGroup" data-id="{{item.id}}">
  <view class="feed-cover">
    <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" lazy-load />
    <view wx:else class="feed-ph">{{tr.t(item.coverMark, lang)}}</view>
    <view class="feed-boarded">{{tr.t(item.boarded, lang)}}</view>
  </view>
  <view class="feed-body">
    <view class="feed-when">{{tr.t(item.feedWhen, lang)}} · {{tr.t(item.city, lang)}}</view>
    <view class="feed-title">{{tr.t(item.route.title, lang)}}</view>
    <view class="feed-badges"><view class="trip-kind {{item.kind || 'individual'}}"><view class="trip-kind-ico"></view>{{tr.t(item.kindLabel || '个人', lang)}}</view> <text class="offer-chip inline" wx:if="{{item.private}}" style="background:#4c1d95">{{tr.t(item.privateLabel || '口令团', lang)}}</text></view>
    <view class="feed-host">{{tr.t(item.host, lang)}}</view>
    <view class="feed-tagline" wx:if="{{item.tagline}}">{{tr.t(item.tagline, lang)}}</view>
    <view class="feed-price" wx:if="{{item.free}}">{{tr.t('免费', lang)}}</view>
    <view class="feed-price" wx:else>
      <text class="strong">¥{{tr.t(item.quote.originPrice, lang)}}</text>
      <text> {{tr.t('会员 ¥', lang)}}{{tr.t(item.quote.memberPrice, lang)}}</text>
    </view>
  </view>
</view>
<view wx:if="{{loading && !groups.length}}" class="card">
  <view class="pad load-row"><view class="spinner"></view><text class="muted">{{tr.t('正在加载近期的团…', lang)}}</text></view>
</view>
<view wx:elif="{{!groups.length}}" class="card">
  <view class="pad">
    <view class="title">{{tr.t('还没有符合条件的团', lang)}}</view>
    <view class="muted">{{tr.t('过审的团会出现在这里。也可以先看官方线路。', lang)}}</view>
    <button wx:if="{{departurePreset!='any'}}" class="departure-clear-empty" bindtap="clearDepartureTime">{{tr.t('清除时间条件',lang)}}</button>
    <view class="catalog-row" style="margin-top:16rpx">
      <view class="tool-btn ghost-line" catchtap="setView" data-view="routes">{{tr.t('先看线路', lang)}}</view>
      <view class="tool-btn play" catchtap="goPublish">{{tr.t('去发团', lang)}}</view>
    </view>
  </view>
</view>
</block>

<block wx:else>
  <view class="rt-catalog {{routeDark?'is-dark':''}} {{textMode?'is-text-mode':''}}">
    <view class="rt-intro"><view class="rt-eyebrow">CURATED OUTDOOR JOURNEYS</view><view class="rt-heading">{{tr.t('选一条线，走进山野', lang)}}</view><view class="rt-lead">{{tr.t('先看风景与安排，再选择适合自己的出发。', lang)}}</view></view>
    <view class="rt-active" wx:if="{{routePicked.length}}" aria-role="group" aria-label="{{tr.t('当前线路筛选', lang)}}">
      <view class="rt-active-head"><text>{{tr.t('已选条件', lang)}}</text><button bindtap="clearRouteFilters">{{tr.t('清空筛选', lang)}}</button></view>
      <view class="rt-active-chips"><button wx:for="{{routePicked}}" wx:key="key" bindtap="clearRouteFilter" data-key="{{item.key}}" aria-label="{{tr.t('移除筛选', lang)}} {{tr.t(item.type, lang)}} {{tr.t(item.value, lang)}}"><text>{{tr.t(item.type, lang)}}：</text><text>{{tr.t(item.value, lang)}}</text><text aria-hidden="true">×</text></button></view>
    </view>
    <view wx:else class="rt-all">{{tr.t('全部线路', lang)}}</view>
    <template is="route-preferences" data="{{preference:routePreference,options:routePrimaryPreferences,more:routeMorePreferences,expanded:routeMoreOpen,total:routePreferenceTotal,loading:routePreferenceLoading,err:routePreferenceErr,scrollInto:routePreferenceScroll,lang:lang}}" />
    <scroll-view scroll-x class="rt-filter-scroll"><view class="rt-filter-row">
      <button class="rt-filter {{routeDays==0?'on':''}}" bindtap="setRouteDays" data-d="0">{{tr.t('全部天数', lang)}}</button>
      <button class="rt-filter {{routeDays==1?'on':''}}" bindtap="setRouteDays" data-d="1">{{tr.t('1日', lang)}}</button>
      <button class="rt-filter {{routeDays==2?'on':''}}" bindtap="setRouteDays" data-d="2">{{tr.t('2日', lang)}}</button>
      <button class="rt-filter {{routeDays==3?'on':''}}" bindtap="setRouteDays" data-d="3">{{tr.t('3日', lang)}}</button>
      <button class="rt-filter {{routeDays=='multi'?'on':''}}" bindtap="setRouteDays" data-d="multi">{{tr.t('4日及以上', lang)}}</button>
    </view></scroll-view>
    <template is="route-modes" data="{{count:routeList.length,modes:routeModes,mode:routeMode,loading:routeLoading,lang:lang}}" />
    <load-row wx:if="{{routeLoading && !routeList.length}}" />
    <view wx:if="{{routeErr}}" class="rt-error"><view><view class="rt-error-title">{{tr.t(routeErrCode=='ROUTE_PREFERENCE_UNAVAILABLE' ? '所选偏好已不可用' : '线路加载失败', lang)}}</view><view wx:if="{{routeErrCode=='ROUTE_PREFERENCE_UNAVAILABLE'}}">{{tr.t('该出游偏好不存在或已停用，请重新选择', lang)}}</view><view class="rt-error-note" wx:elif="{{routeList.length}}">{{tr.t('已保留上次内容，可重新加载。', lang)}}</view></view><button wx:if="{{routeErrCode=='ROUTE_PREFERENCE_UNAVAILABLE'}}" class="rt-retry" bindtap="clearRouteFilter" data-key="preference">{{tr.t('重新选择偏好', lang)}}</button><button wx:else class="rt-retry" bindtap="loadRoutes">{{tr.t('重新加载', lang)}}</button></view>
    <template is="route-cards" data="{{rows:routeList,mode:routeMode,lang:lang}}" />
    <view wx:if="{{!routeLoading && !routeList.length && !routeErr}}" class="rt-empty"><view class="rt-empty-title">{{tr.t('没有匹配的线路', lang)}}</view><view>{{tr.t('试试调整或清空筛选条件。', lang)}}</view><button wx:if="{{routePreference}}" class="rt-clear" bindtap="clearRouteFilter" data-key="preference">{{tr.t('取消偏好', lang)}}</button><button wx:if="{{query}}" class="rt-clear" bindtap="clearRouteFilter" data-key="q">{{tr.t('清除关键词', lang)}}</button><button wx:if="{{routePicked.length}}" class="rt-clear" bindtap="clearRouteFilters">{{tr.t('清空筛选', lang)}}</button></view>
    <button class="rt-apply" bindtap="goRouteApply"><view><view class="rt-apply-title">{{tr.t('有一条私藏路线？', lang)}}</view><view class="rt-apply-note">{{tr.t('申请收录，把喜欢的山野分享给同行。', lang)}}</view></view><text class="rt-apply-arrow" aria-hidden="true">↗</text></button>
  </view>
</block>
<view class="organizer-section">
  <view class="home-section-heading"><view><view class="section-title">{{tr.t('和熟悉的人，去新的地方', lang)}}</view></view></view>
  <view class="organizer-grid">
    <view class="organizer-link" bindtap="goPublish" data-kind="campus"><view class="organizer-icon campus"><image src="/images/home/school.svg" mode="aspectFit" /></view><view class="organizer-copy"><view>{{tr.t('高校出行', lang)}}</view><text>{{tr.t('跨校同行，一起看世界', lang)}}</text></view><text class="organizer-arrow" aria-hidden="true">›</text></view>
    <view class="organizer-link" bindtap="goPublish" data-kind="company"><view class="organizer-icon company"><image src="/images/home/building.svg" mode="aspectFit" /></view><view class="organizer-copy"><view>{{tr.t('企业团建', lang)}}</view><text>{{tr.t('让团队，在山野相聚', lang)}}</text></view><text class="organizer-arrow" aria-hidden="true">›</text></view>
  </view>
  <view class="publish-entry" bindtap="goPublish">
    <view class="publish-entry-copy"><view class="publish-entry-title">{{tr.t('这一程，由你发起', lang)}}</view><view class="publish-entry-sub">{{tr.t('个人 · 企业 · 高校，一站式发团', lang)}}</view></view>
    <view class="publish-entry-go">{{tr.t('创建行程', lang)}}<text aria-hidden="true">↗</text></view>
  </view>
</view>
<view class="home-foot" bindtap="goOfficial">{{tr.t('客服与规则', lang)}}<text aria-hidden="true"> ↗</text></view>

<view wx:if="{{departureSheet}}" class="departure-mask {{campusDark?'is-dark':''}}" bindtap="closeDepartureDates" catchtouchmove="departureNoop">
  <view class="departure-sheet" catchtap="departureNoop" aria-role="dialog" aria-label="{{tr.t('选择出发日期',lang)}}">
    <view class="departure-sheet-handle" aria-hidden="true"></view>
    <view class="departure-sheet-head"><view><view class="departure-eyebrow">MAKE TIME FOR THE WILD</view><view class="departure-sheet-title">{{tr.t('哪天出发，刚刚好',lang)}}</view></view><button class="departure-close" bindtap="closeDepartureDates" aria-label="{{tr.t('关闭日期选择',lang)}}">×</button></view>
    <view class="departure-sheet-sub">{{tr.t('按出发日期筛选，团数随其他条件更新',lang)}}</view>
    <scroll-view scroll-y enhanced class="departure-sheet-body">
      <view class="departure-month-head"><button class="departure-month-arrow prev" disabled="{{!departureCanPrev}}" bindtap="moveDepartureMonth" data-offset="-1" aria-label="{{tr.t('上个月',lang)}}"><view></view></button><view class="departure-month-label">{{departureMonth}}</view><button class="departure-month-arrow" disabled="{{!departureCanNext}}" bindtap="moveDepartureMonth" data-offset="1" aria-label="{{tr.t('下个月',lang)}}"><view></view></button></view>
      <view class="departure-weekdays"><text wx:for="{{departureWeekdays}}" wx:key="*this">{{tr.t(item,lang)}}</text></view>
      <view class="departure-calendar-grid">
        <view wx:for="{{departureCells}}" wx:key="key" class="departure-day-wrap">
          <button wx:if="{{item.date}}" class="departure-day {{item.disabled?'past':''}} {{draftDate==item.date?'on':''}} {{draftMode=='month' && draftMonthKey==departureMonth && !item.disabled?'in-month':''}}" disabled="{{item.disabled}}" bindtap="selectDepartureDay" data-date="{{item.date}}" aria-label="{{item.date}} {{tr.t(item.count?item.count+'个团':'暂无团期',lang)}}" aria-pressed="{{draftDate==item.date}}"><view>{{item.label}}</view><text wx:if="{{!item.disabled && item.count}}">{{item.count}}{{tr.t('团',lang)}}</text><text wx:else class="departure-day-empty">·</text></button>
        </view>
      </view>
      <button class="departure-full-month {{draftMode=='month' && draftMonthKey==departureMonth?'on':''}}" bindtap="selectDepartureMonth"><view class="departure-option-dot" aria-hidden="true"></view><text>{{tr.t('这个月都可以',lang)}}</text><text class="departure-full-month-count">{{departureMonthCount}} {{tr.t('个团',lang)}}</text></button>
      <view class="departure-festivals" wx:if="{{departureFestivals.length}}"><view class="departure-festival-title">{{tr.t('假期出发',lang)}}</view><view class="departure-festival-row"><button class="departure-festival {{draftMode=='festival' && draftFestivalKey==item.key?'on':''}}" wx:for="{{departureFestivals}}" wx:key="key" data-key="{{item.key}}" bindtap="selectDepartureFestival">{{tr.t(item.name,lang)}}</button></view></view>
    </scroll-view>
    <view class="departure-sheet-foot"><view class="departure-draft-label">{{tr.t(draftLabel,lang)}}</view><view class="departure-sheet-actions"><button class="departure-reset" bindtap="resetDepartureDraft">{{tr.t('不限日期',lang)}}</button><button class="departure-apply" bindtap="applyDepartureDates">{{tr.t('查看',lang)}} {{departureDraftCount}} {{tr.t('个团',lang)}}<text aria-hidden="true">↗</text></button></view></view>
  </view>
</view>
<view class="tab-pad"></view>
</view>
