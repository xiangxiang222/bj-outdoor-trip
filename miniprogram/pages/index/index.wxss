@import "../../styles/route-catalog.wxss";

.home-page {
  --home-primary:#593e84; --home-soft:#efeaf7; --home-input:#f6f5f8; --home-accent:#ba594b;
  min-height:100vh; background:var(--bg,#f5f5f7); color:var(--ink,#29262e);
}
.home-page.is-dark { --home-primary:#d6b9f2; --home-soft:#30263d; --home-input:#252429; --home-accent:#e1a18f; }
.rt-active { margin:0 0 24rpx; padding:20rpx; border:1rpx solid var(--rt-line); border-radius:18rpx; background:var(--rt-paper); }
.rt-active-head { display:flex; align-items:center; justify-content:space-between; gap:16rpx; color:var(--rt-muted); font-size:calc(23rpx * var(--ui-scale,1)); }
.rt-catalog .rt-active-head button { flex:none; padding:10rpx 0 10rpx 14rpx; color:var(--rt-purple); font-size:inherit; }
.rt-active-chips { display:flex; flex-wrap:wrap; gap:12rpx; margin-top:12rpx; }
.rt-catalog .rt-active-chips button { display:flex; align-items:center; max-width:100%; padding:14rpx 18rpx; border-radius:12rpx; color:var(--rt-purple); background:var(--rt-soft); font-size:calc(23rpx * var(--ui-scale,1)); line-height:1.5; text-align:left; }
.rt-active-chips button > text:first-child,.rt-active-chips button > text:last-child { flex:none; }
.rt-active-chips button > text:nth-child(2) { min-width:0; overflow-wrap:anywhere; }
.rt-active-chips button > text:last-child { margin-left:14rpx; }
.rt-all { margin:0 4rpx 20rpx; color:var(--rt-muted); font-size:calc(23rpx * var(--ui-scale,1)); }
.home-nav { position:absolute; z-index:4; top:0; left:0; right:0; box-sizing:border-box; }
.home-brand { display:flex; align-items:center; gap:12rpx; min-width:0; padding-left:32rpx; padding-bottom:4rpx; box-sizing:border-box; }
.home-brand-logo { flex:none; width:64rpx; height:64rpx; border:2rpx solid rgba(255,255,255,.65); border-radius:50%; background:#f4f1f7; box-sizing:border-box; }
.home-brand-copy { flex:1; min-width:0; }
.home-brand-name { color:#fff; font-size:28rpx; line-height:1.25; font-weight:700; text-shadow:0 1rpx 6rpx rgba(15,25,19,.35); }
.home-brand-en { margin-top:5rpx; color:rgba(255,255,255,.82); font-size:18rpx; line-height:1.3; text-shadow:0 1rpx 4rpx rgba(15,25,19,.3); }
.brand-box { position:relative; min-height:650rpx; overflow:hidden; background:linear-gradient(145deg,#60765e,#303d38 65%,#474153); }
.brand-hero,.brand-hero swiper-item,.brand-img { width:100%; height:100%; }
.brand-hero { position:absolute; inset:0; display:var(--media,block); }
.brand-img { display:block; }
.hero-shade { position:absolute; z-index:0; inset:0; pointer-events:none; background:linear-gradient(90deg,rgba(14,24,17,.24),rgba(14,24,17,0) 78%),linear-gradient(180deg,rgba(15,25,19,.52),rgba(22,24,36,.08) 32%,rgba(24,22,36,.44) 72%,rgba(24,22,36,.36)); }
.hero-side-fade {
  position:absolute; z-index:1; inset:0; pointer-events:none;
  background:linear-gradient(180deg,rgba(var(--hero-surface-rgb,246,245,248),0) 74%,var(--bg,#f5f5f7) 100%),radial-gradient(ellipse at bottom left,rgba(var(--hero-surface-rgb,246,245,248),.22),rgba(var(--hero-surface-rgb,246,245,248),0) 58%),radial-gradient(ellipse at bottom right,rgba(var(--hero-surface-rgb,246,245,248),.22),rgba(var(--hero-surface-rgb,246,245,248),0) 58%);
}
.brand-cap { position:relative; z-index:2; padding:calc(var(--home-nav-height,68px) + 40rpx) 46rpx 160rpx; color:#fff; text-shadow:0 2rpx 4rpx rgba(22,24,36,.28); pointer-events:none; }
.home-eyebrow { font-size:calc(23rpx * var(--ui-scale)); line-height:1.6; color:rgba(255,255,255,.9); }
.home-kicker { margin-top:22rpx; font-size:calc(64rpx * var(--ui-scale)); font-weight:650; line-height:1.25; }
.home-kicker > text { display:inline-block; max-width:100%; }
.home-lead { margin-top:16rpx; color:rgba(255,255,255,.86); font-size:calc(26rpx * var(--ui-scale)); line-height:1.7; }
.hero-discover { display:inline-flex; align-items:center; gap:14rpx; margin-top:18rpx; min-height:44px; color:#fff; font-size:calc(26rpx * var(--ui-scale)); font-weight:600; pointer-events:auto; }
.hero-discover text { font-size:32rpx; font-weight:400; }
.hero-dots { position:absolute; z-index:2; right:24rpx; bottom:96rpx; display:flex; align-items:center; }
.hero-dot { display:flex; align-items:center; justify-content:center; min-width:32px; min-height:44px; padding:0 1rpx; }
.hero-dot > view { width:11rpx; height:11rpx; border-radius:50%; background:rgba(255,255,255,.55); }
.hero-dot.selected { min-width:32px; }
.hero-dot.selected > view { width:34rpx; border-radius:8rpx; background:#fff; }

.discovery-card { position:relative; z-index:3; margin:-96rpx 30rpx 0; padding:32rpx; border-radius:32rpx; background:var(--card,#fff); box-shadow:0 12rpx 46rpx rgba(47,37,59,.07); }
.search-card-top { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12rpx 18rpx; margin-bottom:24rpx; }
.search-caption { font-size:calc(28rpx * var(--ui-scale)); line-height:1.5; font-weight:650; }
.departure-city { color:var(--muted,#85828a); font-size:calc(19rpx * var(--ui-scale)); line-height:1.5; }
.search-input-row { display:flex; align-items:center; gap:19rpx; min-height:44px; padding:0 24rpx; border-radius:16rpx; background:var(--home-input); box-sizing:border-box; }
.search-line-icon { flex:none; position:relative; width:26rpx; height:26rpx; margin-right:5rpx; border:3rpx solid var(--home-primary); border-radius:50%; box-sizing:border-box; }
.search-line-icon::after { content:''; position:absolute; right:-9rpx; bottom:-4rpx; width:12rpx; height:3rpx; border-radius:2rpx; background:var(--home-primary); transform:rotate(45deg); }
.feed-search { flex:1; min-width:0; height:76rpx; margin:0; padding:0; border:0; border-radius:0; color:var(--ink,#29262e); background:transparent; font-size:calc(23rpx * var(--ui-scale)); }
.search-date { display:flex; align-items:center; gap:16rpx; min-height:44px; margin-top:18rpx; padding:12rpx 23rpx; border-radius:14rpx; box-sizing:border-box; color:var(--muted,#85808d); background:var(--home-input); font-size:calc(23rpx * var(--ui-scale)); line-height:1.5; }
.search-date .departure-calendar-icon { width:27rpx; height:27rpx; margin-right:4rpx; color:var(--home-primary); }
.search-date > text { flex:1; min-width:0; }
.search-date .departure-down { margin-left:auto; }
.search-cta { display:flex; align-items:center; justify-content:center; gap:18rpx; margin-top:18rpx; min-height:44px; padding:17rpx 24rpx; box-sizing:border-box; border-radius:16rpx; background:#593e84; color:#fff; font-size:calc(25rpx * var(--ui-scale)); line-height:1.5; font-weight:550; }
.search-cta text { font-size:32rpx; font-weight:400; }
.search-hot { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx 28rpx; margin-top:19rpx; color:var(--muted,#7f778a); font-size:calc(19rpx * var(--ui-scale)); line-height:1.6; }
.search-hot > text { padding:4rpx 0; }
.search-hot-label { opacity:.65; }
.discovery-ai-entry { display:flex; align-items:center; gap:17rpx; margin:22rpx 36rpx 0; padding:21rpx 22rpx; box-sizing:border-box; border:1rpx solid var(--line,#e8e6eb); border-radius:20rpx; background:var(--card,#fff); color:var(--home-primary); }
.discovery-ai-copy { flex:1; min-width:0; }
.discovery-ai-copy > view { font-size:calc(23rpx * var(--ui-scale)); font-weight:550; line-height:1.5; }
.discovery-ai-copy > text { display:block; margin-top:4rpx; color:var(--muted,#85828a); font-size:calc(18rpx * var(--ui-scale)); line-height:1.6; }
.discovery-ai-mark { position:relative; width:42rpx; height:42rpx; flex:none; }
.discovery-ai-mark > view { position:absolute; left:0; top:0; width:30rpx; height:25rpx; border:2rpx solid; border-radius:8rpx; }
.discovery-ai-mark > view + view { left:11rpx; top:14rpx; background:var(--card,#fff); }
.discovery-ai-arrow { font-size:34rpx; font-weight:300; }
.quick-entries { display:flex; align-items:flex-start; gap:12rpx; margin:0 36rpx; padding:42rpx 0 36rpx; border-bottom:1rpx solid var(--line,#e8e6eb); }
.quick-entry { flex:1; min-width:0; display:flex; flex-direction:column; align-items:center; color:var(--ink,#29262e); font-size:calc(23rpx * var(--ui-scale)); font-weight:550; }
.quick-entry > text { max-width:100%; text-align:center; line-height:1.5; }
.quick-entry .quick-note { margin-top:5rpx; color:var(--muted,#85828a); font-size:calc(20rpx * var(--ui-scale)); line-height:1.5; font-weight:400; }
.quick-icon { display:flex; align-items:center; justify-content:center; flex:none; width:76rpx; height:76rpx; margin-bottom:13rpx; border-radius:23rpx; background:#ede7f6; }
.quick-icon image { display:block; width:46rpx; height:46rpx; }
.quick-icon.campus { background:#eaf0e5; }
.quick-icon.company { background:#f4eee4; }
.quick-icon.companions { background:#e9f0f5; }
.home-page.is-dark .quick-icon { opacity:.88; }
.home-section-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin-bottom:23rpx; }
.home-section-heading > view { flex:1; min-width:0; }
.home-page .section-title { color:var(--ink,#29262e); font-size:calc(29rpx * var(--ui-scale)); font-weight:650; line-height:1.5; }
.destination-section { padding:34rpx 36rpx 28rpx; }
.destination-caption { flex:none; color:var(--home-primary); font-size:calc(18rpx * var(--ui-scale)); line-height:1.5; }
.destination-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:16rpx; }
.destination-card { position:relative; min-width:0; min-height:310rpx; overflow:hidden; border-radius:22rpx; color:#fff; background:#364934; }
.destination-card:nth-child(2) { background:#4f6752; }
.destination-card:nth-child(3) { background:#577f8b; }
.destination-photo { position:absolute; inset:0; width:100%; height:100%; display:var(--media,block); }
.destination-shade { position:absolute; inset:0; background:linear-gradient(180deg,rgba(20,28,20,.1),rgba(20,28,20,.64)); }
.destination-tag { position:absolute; top:17rpx; left:14rpx; right:auto; max-width:calc(100% - 28rpx); box-sizing:border-box; padding:5rpx 8rpx; border:1rpx solid rgba(255,255,255,.33); border-radius:7rpx; background:rgba(255,255,255,.08); color:#fff; font-size:calc(15rpx * var(--ui-scale)); line-height:1.4; }
.destination-copy { position:relative; min-height:310rpx; display:flex; flex-direction:column; justify-content:flex-end; gap:9rpx; padding:92rpx 15rpx 25rpx; box-sizing:border-box; }
.destination-name { font-size:calc(23rpx * var(--ui-scale)); font-weight:550; line-height:1.5; }
.destination-en { font-size:11rpx; line-height:1.5; opacity:.76; }
.destination-note { display:none; }

/* A campus pass ties identity to the outdoors without adding a bitmap asset. */
.campus-card {
  --campus-ink: #5b3b8c; --campus-muted: #766183; --campus-edge: #d6c7e9;
  --campus-pass: #fbf9ff; --campus-back: #e0d4ef; --campus-stamp: #79609c; --campus-button: #fff;
  position: relative; overflow: hidden; margin: 0 36rpx 28rpx; padding: 30rpx 28rpx;
  display: flex; align-items: center; gap: 26rpx; border: 1rpx solid #e6def0;
  background: linear-gradient(110deg, #f6f1fc, #eee6f7 62%, #e9e1f3); border-radius: 30rpx;
}
.campus-card.is-dark { --campus-ink: #d6c1f1; --campus-muted: #b3a2c5; --campus-edge: #675177; --campus-pass: #3c304b; --campus-back: #4b3a5f; --campus-stamp: #c3a3e6; --campus-button: #49385d; background: linear-gradient(110deg, #302638, #292230); border-color: #46364f; }
.campus-pressed { opacity: .78; }
.campus-ridge { position: absolute; right: -25rpx; bottom: -96rpx; width: 255rpx; height: 235rpx; border: 1rpx solid var(--campus-edge); border-radius: 44%; transform: rotate(-24deg); opacity: .5; pointer-events: none; }
.campus-ridge::before, .campus-ridge::after { content: ''; position: absolute; border: 1rpx solid var(--campus-edge); border-radius: 44%; }
.campus-ridge::before { inset: 17rpx; }
.campus-ridge::after { inset: 34rpx; }
.campus-pass { position: relative; flex: none; width: 78rpx; height: 94rpx; color: var(--campus-ink); }
.campus-pass-back { position: absolute; inset: 4rpx; border: 1rpx solid var(--campus-edge); border-radius: 12rpx; background: var(--campus-back); transform: rotate(-15deg) translate(-5rpx, 1rpx); }
.campus-pass-face { position: absolute; inset: 3rpx 0; border: 2rpx solid var(--campus-edge); border-radius: 12rpx; background: var(--campus-pass); box-shadow: 0 8rpx 16rpx rgba(69,41,103,.06); transform: rotate(8deg); }
.campus-pass-mountain { position: absolute; left: 16rpx; top: 17rpx; width: 23rpx; height: 23rpx; border-left: 2rpx solid; border-top: 2rpx solid; border-radius: 2rpx; transform: rotate(45deg); }
.campus-pass-mountain::after { content: ''; position: absolute; left: 15rpx; top: -7rpx; width: 14rpx; height: 14rpx; border-right: 2rpx solid; border-top: 2rpx solid; }
.campus-pass-lines { position: absolute; left: 13rpx; bottom: 20rpx; width: 25rpx; height: 2rpx; border-radius: 2rpx; background: var(--campus-edge); box-shadow: 0 8rpx 0 var(--campus-edge); }
.campus-pass-stamp { position: absolute; right: -9rpx; bottom: 7rpx; width: 28rpx; height: 28rpx; background: var(--campus-stamp); border: 3rpx solid var(--campus-pass); border-radius: 50%; }
.campus-pass-stamp::after { content: ''; position: absolute; left: 7rpx; top: 7rpx; width: 12rpx; height: 6rpx; border-left: 2rpx solid #fff; border-bottom: 2rpx solid #fff; transform: rotate(-45deg); }
.campus-card-copy { position: relative; flex: 1; min-width: 0; }
.campus-eyebrow { display: flex; align-items: center; gap: 12rpx; color: var(--campus-muted); font-size: calc(17rpx * var(--ui-scale)); line-height: 1.4; letter-spacing: 0; }
.campus-eyebrow > view { width: 32rpx; height: 1rpx; background: var(--campus-edge); }
.campus-title { margin-top: 7rpx; font-size: calc(29rpx * var(--ui-scale)); font-weight: 600; line-height: 1.5; color: var(--campus-ink); }
.campus-card-footer { margin-top: 10rpx; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; }
.campus-note { min-width: 0; color: var(--campus-muted); font-size: calc(19rpx * var(--ui-scale)); line-height: 1.6; }
.campus-cta { display: flex; align-items: center; gap: 10rpx; flex: none; padding: 8rpx 16rpx; border: 1rpx solid var(--campus-edge); border-radius: 99rpx; background: var(--campus-button); color: var(--campus-ink); font-size: calc(20rpx * var(--ui-scale)); line-height: 1.4; }
.campus-cta > text { font-size: 25rpx; font-weight: 400; line-height: 1; }

.trip-hint { display:flex; justify-content:space-between; align-items:center; gap:20rpx; margin:0 36rpx 28rpx; padding:23rpx 26rpx; border:1rpx solid var(--line,#e8e6eb); border-radius:16rpx; background:var(--card,#fff); }
.trip-hint .muted { color:var(--muted,#85828a); font-size:calc(20rpx * var(--ui-scale)); line-height:1.6; }
.trip-hint-title { margin-top:6rpx; font-size:calc(24rpx * var(--ui-scale)); line-height:1.5; font-weight:550; }
.trip-hint-arrow { flex:none; color:var(--home-primary); font-size:40rpx; }
.home-seg { display:flex; margin:0 36rpx 26rpx; padding:0; gap:42rpx; border:0; border-bottom:1rpx solid var(--line,#e8e6eb); border-radius:0; background:transparent; }
.home-seg-btn { position:relative; flex:none; padding:16rpx 0 22rpx; border-radius:0; color:var(--muted,#85828a); font-size:calc(27rpx * var(--ui-scale)); line-height:1.5; font-weight:500; }
.home-seg-btn.on { color:var(--home-primary); background:transparent; border:0; box-shadow:none; font-weight:650; }
.home-seg-btn.on::after { content:''; position:absolute; left:0; right:0; bottom:-1rpx; height:4rpx; border-radius:4rpx; background:var(--home-primary); }
.departure-bar-heading { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx 22rpx; margin:0 0 16rpx; }
.departure-bar-heading > view { color:var(--ink,#29262e); font-size:calc(24rpx * var(--ui-scale)); line-height:1.5; font-weight:600; }
.departure-bar-heading > text { color:var(--muted,#85828a); font-size:calc(19rpx * var(--ui-scale)); line-height:1.5; }
.city-bar { display:block; width:100%; max-width:100%; min-width:0; box-sizing:border-box; white-space:nowrap; padding:0 28rpx; }
.city-bar .chip { min-height:58rpx; margin:6rpx; padding:0 20rpx; border:1rpx solid var(--line,#e8e6eb); border-radius:12rpx; color:var(--ink,#29262e); background:var(--card,#fff); font-size:calc(22rpx * var(--ui-scale)); }
.city-bar .chip.on { border-color:var(--home-primary); background:var(--home-primary); color:var(--card,#fff); }
.feed-toolbar { gap:14rpx; margin:17rpx 36rpx 5rpx; padding:21rpx 0 12rpx; border-top:1rpx solid var(--line,#e8e6eb); }
.feed-toolbar .hint { color:var(--muted,#85828a); font-size:calc(22rpx * var(--ui-scale)); line-height:1.5; font-weight:400; }
.feed-toolbar .tools { flex-wrap:wrap; gap:20rpx; }
.feed-toolbar .tool-btn { color:var(--muted,#85828a); font-size:calc(21rpx * var(--ui-scale)); line-height:1.5; }
.filter-options { padding-top:0; padding-bottom:8rpx; }
.picked { display:flex; flex-wrap:wrap; gap:10rpx; margin:12rpx 36rpx 18rpx; }
.picked-chip { padding:7rpx 14rpx; border-radius:10rpx; background:var(--home-soft); color:var(--home-primary); font-size:calc(20rpx * var(--ui-scale)); line-height:1.5; }
.home-page .feed-card { display:flex; align-items:stretch; gap:20rpx; margin:18rpx 36rpx; padding:17rpx; border:1rpx solid var(--line,#e8e6eb); border-radius:16rpx; background:var(--card,#fff); box-shadow:none; }
.home-page .feed-cover { flex:none; width:200rpx; height:auto; min-height:242rpx; border-radius:12rpx; background:var(--home-soft); }
.home-page .feed-cover image { position:absolute; inset:0; display:block; width:100%; height:100%; }
.home-page .feed-ph { display:flex; align-items:center; justify-content:center; min-height:242rpx; padding:20rpx; box-sizing:border-box; color:var(--home-primary); font-size:calc(26rpx * var(--ui-scale)); }
.home-page .feed-boarded { left:10rpx; right:auto; bottom:10rpx; max-width:calc(100% - 20rpx); padding:6rpx 9rpx; box-sizing:border-box; border-radius:7rpx; color:#fff; background:rgba(35,29,41,.68); font-size:calc(17rpx * var(--ui-scale)); line-height:1.4; font-weight:400; }
.home-page .feed-body { display:flex; flex-direction:column; min-width:0; padding:3rpx 0; }
.home-page .feed-when { color:var(--muted,#85828a); font-size:calc(19rpx * var(--ui-scale)); line-height:1.5; }
.home-page .feed-title { margin-top:8rpx; color:var(--ink,#29262e); font-size:calc(28rpx * var(--ui-scale)); line-height:1.5; font-weight:650; }
.feed-badges { display:flex; flex-wrap:wrap; align-items:center; gap:6rpx; margin-top:9rpx; }
.home-page .trip-kind { min-height:30rpx; height:auto; margin:0; padding:3rpx 9rpx; border-radius:6rpx; background:var(--home-soft); color:var(--home-primary); font-size:calc(17rpx * var(--ui-scale)); line-height:1.5; font-weight:500; }
.home-page .trip-kind-ico { width:15rpx; height:15rpx; }
.home-page .feed-host { margin-top:9rpx; color:var(--muted,#85828a); font-size:calc(19rpx * var(--ui-scale)); line-height:1.5; }
.home-page .feed-tagline { margin-top:8rpx; padding:0; color:var(--home-primary); background:transparent; font-size:calc(19rpx * var(--ui-scale)); line-height:1.5; }
.home-page .feed-price { display:flex; align-items:baseline; flex-wrap:wrap; gap:4rpx 8rpx; margin-top:auto; padding-top:13rpx; color:var(--home-accent); font-size:calc(24rpx * var(--ui-scale)); line-height:1.5; }
.home-page .feed-price .strong { margin:0; color:var(--home-accent); font-size:calc(31rpx * var(--ui-scale)); font-weight:650; }
.home-page .feed-price > text + text { padding:3rpx 7rpx; border-radius:6rpx; color:var(--home-primary); background:var(--home-soft); font-size:calc(17rpx * var(--ui-scale)); }
.home-page > .card { margin-left:36rpx; margin-right:36rpx; border:1rpx solid var(--line,#e8e6eb); border-radius:16rpx; background:var(--card,#fff); }
.organizer-section { padding:32rpx 36rpx 0; }
.organizer-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:18rpx; }
.organizer-link { display:flex; align-items:center; gap:13rpx; min-width:0; min-height:138rpx; padding:18rpx 15rpx; border:1rpx solid var(--line,#e8e6eb); border-radius:16rpx; box-sizing:border-box; background:var(--card,#fff); }
.organizer-icon { display:flex; align-items:center; justify-content:center; flex:none; width:58rpx; height:65rpx; border-radius:13rpx; background:#eaf0e5; }
.organizer-icon.company { background:#f4eee4; }
.organizer-icon image { width:38rpx; height:38rpx; }
.organizer-copy { flex:1; min-width:0; }
.organizer-copy > view { color:var(--ink,#29262e); font-size:calc(23rpx * var(--ui-scale)); font-weight:600; line-height:1.5; }
.organizer-copy > text { display:block; margin-top:5rpx; color:var(--muted,#85828a); font-size:calc(17rpx * var(--ui-scale)); line-height:1.5; }
.organizer-arrow { flex:none; color:var(--muted,#aaa5af); font-size:30rpx; }
.publish-entry { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-top:18rpx; padding:24rpx; border:1rpx solid var(--line,#e9e4ee); border-radius:16rpx; background:var(--home-soft); }
.publish-entry-copy { flex:1; min-width:0; }
.publish-entry-title { color:var(--home-primary); font-size:calc(25rpx * var(--ui-scale)); font-weight:600; line-height:1.5; }
.publish-entry-sub { margin-top:6rpx; color:var(--muted,#77737d); font-size:calc(18rpx * var(--ui-scale)); line-height:1.6; }
.publish-entry-go { display:flex; align-items:center; gap:9rpx; flex:none; padding:12rpx 16rpx; border-radius:12rpx; color:var(--home-primary); background:var(--card,#fff); font-size:calc(21rpx * var(--ui-scale)); line-height:1.5; }
.publish-entry-go text { font-size:25rpx; }
.home-foot { padding:34rpx; text-align:center; color:var(--home-primary); font-size:calc(21rpx * var(--ui-scale)); line-height:1.5; }

/* Keep the next departure in sight; the full calendar opens only on request. */
.departure-time-bar, .departure-mask { --dt-purple:#5b3b8c; --dt-ink:#332b3e; --dt-muted:#9b8ca8; --dt-paper:#fff; --dt-soft:#eee6f6; --dt-line:#e8e0ef; }
.departure-time-bar.is-dark, .departure-mask.is-dark { --dt-purple:#d6b9f2; --dt-ink:#eee6f5; --dt-muted:#b6a5c3; --dt-paper:#251e2e; --dt-soft:#3b2c4a; --dt-line:#493753; }
.departure-time-bar { min-width:0; margin:2rpx 28rpx 18rpx; color:var(--dt-ink); }
.departure-shortcut-scroll { display:block; width:100%; max-width:100%; min-width:0; box-sizing:border-box; white-space:nowrap; }
.departure-shortcut-row { display:inline-flex; align-items:center; gap:12rpx; padding:3rpx 1rpx; vertical-align:top; }
.departure-time-bar button, .departure-mask button { margin:0; min-width:0; font-family:inherit; line-height:1.5; box-sizing:border-box; border:0; border-radius:0; font-weight:400; }
.departure-time-bar button::after, .departure-mask button::after { border:0; }
/* style:v2 gives native buttons a default width; filter chips size to their text. */
.departure-time-bar .departure-time-chip { flex:none; width:auto; max-width:none; display:flex; align-items:center; justify-content:center; gap:10rpx; min-height:65rpx; padding:13rpx 20rpx; border:1rpx solid var(--dt-line); border-radius:14rpx; background:var(--dt-paper); color:#8e7b9c; font-size:calc(22rpx * var(--ui-scale)); white-space:nowrap; }
.departure-time-bar .departure-time-chip.on { color:var(--dt-purple); background:var(--dt-soft); border-color:#d9c8e8; font-weight:550; }
.departure-time-bar .departure-calendar-trigger { padding-left:17rpx; padding-right:16rpx; }
.departure-calendar-icon { flex:none; position:relative; width:22rpx; height:21rpx; margin-top:3rpx; border:2rpx solid currentColor; border-radius:4rpx; box-sizing:border-box; }
.departure-calendar-icon::before { content:''; position:absolute; left:-2rpx; right:-2rpx; top:5rpx; border-top:2rpx solid currentColor; }
.departure-calendar-icon::after { content:''; position:absolute; left:4rpx; top:-5rpx; width:8rpx; height:6rpx; border-left:2rpx solid currentColor; border-right:2rpx solid currentColor; }
.departure-down { width:8rpx; height:8rpx; border-right:2rpx solid currentColor; border-bottom:2rpx solid currentColor; transform:rotate(45deg); margin:0 1rpx 4rpx 3rpx; flex:none; }
.departure-extra-panel { margin:0 28rpx 20rpx; padding:20rpx 0 10rpx; border:1rpx solid var(--line,#e8e0ef); border-radius:22rpx; background:var(--card,#fff); }
.departure-extra-title { padding:0 24rpx 13rpx; color:#8d789e; font-size:calc(22rpx * var(--ui-scale)); }
.departure-extra-panel .city-bar { padding-left:18rpx; padding-right:18rpx; }
.departure-extra-panel .filter-options { padding-left:18rpx; padding-right:18rpx; }
.departure-clear-empty { display:inline-flex; align-items:center; justify-content:center; margin:20rpx 0 0; min-height:60rpx; padding:12rpx 25rpx; border:1rpx solid #d9c8e8; border-radius:99rpx; background:var(--card,#fff); color:#6b4c8e; font-size:calc(23rpx * var(--ui-scale)); line-height:1.5; }
.departure-clear-empty::after { border:0; }
.departure-mask { position:fixed; z-index:120; inset:0; display:flex; align-items:flex-end; background:rgba(35,22,48,.38); color:var(--dt-ink); }
.departure-sheet { width:100%; max-height:91vh; display:flex; flex-direction:column; border-radius:40rpx 40rpx 0 0; background:var(--dt-paper); box-sizing:border-box; padding:16rpx 34rpx calc(24rpx + env(safe-area-inset-bottom)); overflow:hidden; }
.departure-sheet-handle { width:62rpx; height:6rpx; background:var(--dt-line); border-radius:8rpx; margin:0 auto 26rpx; }
.departure-sheet-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; }
.departure-eyebrow { font-size:16rpx; line-height:1.7; letter-spacing:3rpx; color:#a38ab7; }
.departure-sheet-title { margin-top:7rpx; color:var(--dt-purple); font-size:calc(36rpx * var(--ui-scale)); line-height:1.5; font-weight:550; }
.departure-mask .departure-close { flex:none; align-self:flex-start; display:flex; align-items:center; justify-content:center; width:56rpx; height:56rpx; padding:0; background:transparent; color:var(--dt-muted); font-size:43rpx; line-height:1; }
.departure-sheet-sub { color:var(--dt-muted); font-size:calc(21rpx * var(--ui-scale)); line-height:1.7; margin:12rpx 0 14rpx; }
.departure-sheet-body { height:690rpx; max-height:51vh; min-height:0; flex-shrink:1; }
.departure-month-head { display:flex; justify-content:space-between; align-items:center; padding:12rpx 0 19rpx; }
.departure-month-label { color:var(--dt-ink); font-size:calc(30rpx * var(--ui-scale)); font-weight:550; letter-spacing:1rpx; }
.departure-mask .departure-month-arrow { display:flex; align-items:center; justify-content:center; width:66rpx; height:60rpx; padding:0; border:1rpx solid var(--dt-line); border-radius:16rpx; color:var(--dt-purple); background:var(--dt-paper); }
.departure-month-arrow view { width:12rpx; height:12rpx; border-top:2rpx solid currentColor; border-right:2rpx solid currentColor; transform:rotate(45deg); margin-right:5rpx; }
.departure-month-arrow.prev view { transform:rotate(-135deg); margin-right:0; margin-left:5rpx; }
.departure-mask .departure-month-arrow[disabled] { opacity:.28; color:var(--dt-muted); }
.departure-weekdays { display:flex; margin-bottom:8rpx; color:var(--dt-muted); font-size:calc(20rpx * var(--ui-scale)); line-height:1.6; }
.departure-weekdays text { width:14.2857%; text-align:center; }
.departure-calendar-grid { display:flex; flex-wrap:wrap; }
.departure-day-wrap { width:14.2857%; padding:4rpx; box-sizing:border-box; min-height:92rpx; }
.departure-mask .departure-day { width:100%; min-height:86rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:8rpx 1rpx 5rpx; border:1rpx solid transparent; border-radius:16rpx; background:var(--dt-paper); color:var(--dt-ink); }
.departure-day > view { font-size:calc(27rpx * var(--ui-scale)); line-height:1.3; font-weight:500; }
.departure-day > text { margin-top:4rpx; font-size:calc(18rpx * var(--ui-scale)); line-height:1.3; color:var(--dt-purple); }
.departure-mask .departure-day.in-month { background:var(--dt-soft); }
.departure-mask .departure-day.on { background:var(--dt-purple); color:var(--dt-paper); }
.departure-day.on > text { color:inherit; opacity:.8; }
.departure-mask .departure-day.past { color:var(--dt-muted); opacity:.33; }
.departure-day .departure-day-empty { color:var(--dt-muted); opacity:.4; }
.departure-mask .departure-full-month { display:flex; align-items:center; gap:14rpx; width:100%; margin-top:16rpx; padding:18rpx 20rpx; border:1rpx solid var(--dt-line); border-radius:17rpx; background:var(--dt-paper); color:var(--dt-muted); font-size:calc(23rpx * var(--ui-scale)); text-align:left; }
.departure-option-dot { width:25rpx; height:25rpx; border:1rpx solid var(--dt-line); border-radius:50%; flex:none; box-sizing:border-box; }
.departure-full-month.on .departure-option-dot { border:7rpx solid var(--dt-purple); }
.departure-mask .departure-full-month.on { border-color:var(--dt-purple); color:var(--dt-purple); background:var(--dt-soft); }
.departure-full-month-count { margin-left:auto; color:var(--dt-muted); font-size:calc(20rpx * var(--ui-scale)); }
.departure-festivals { margin:25rpx 0 12rpx; }
.departure-festival-title { margin-bottom:14rpx; color:var(--dt-muted); font-size:calc(21rpx * var(--ui-scale)); }
.departure-festival-row { display:flex; flex-wrap:wrap; gap:12rpx; }
.departure-mask .departure-festival { padding:10rpx 20rpx; border:1rpx solid var(--dt-line); border-radius:12rpx; color:var(--dt-muted); background:var(--dt-paper); font-size:calc(22rpx * var(--ui-scale)); }
.departure-mask .departure-festival.on { border-color:var(--dt-purple); color:var(--dt-purple); background:var(--dt-soft); }
.departure-sheet-foot { padding-top:22rpx; border-top:1rpx solid var(--dt-line); flex-shrink:0; }
.departure-draft-label { color:var(--dt-muted); font-size:calc(21rpx * var(--ui-scale)); line-height:1.7; margin-bottom:14rpx; }
.departure-sheet-actions { display:flex; gap:18rpx; }
.departure-mask .departure-reset, .departure-mask .departure-apply { min-height:78rpx; display:flex; align-items:center; justify-content:center; gap:12rpx; padding:18rpx 16rpx; border-radius:99rpx; font-size:calc(26rpx * var(--ui-scale)); line-height:1.5; }
.departure-mask .departure-reset { flex:1; border:1rpx solid var(--dt-line); background:var(--dt-paper); color:var(--dt-muted); }
.departure-mask .departure-apply { flex:2; color:var(--dt-paper); background:var(--dt-purple); }
.departure-apply text { font-size:30rpx; }
.departure-time-bar.is-dark .departure-time-chip { color:var(--dt-muted); }.departure-time-bar.is-dark .departure-time-chip.on { color:var(--dt-purple); border-color:#6b4d80; }
@media(max-width:350px) { .departure-time-bar { margin-left:24rpx; margin-right:24rpx; }.departure-shortcut-row { gap:9rpx; }.departure-time-bar .departure-time-chip { padding-left:16rpx; padding-right:16rpx; }.departure-sheet { padding-left:26rpx; padding-right:26rpx; }.departure-mask .departure-day { min-height:88rpx; }.departure-day > view { font-size:calc(26rpx * var(--ui-scale)); } }


/* Keep navigation and useful copy available when large photos are hidden. */
.home-page.is-text-mode .brand-box { height:auto; min-height:355rpx; background:var(--home-soft); }
.is-text-mode .brand-hero,.is-text-mode .hero-shade,.is-text-mode .hero-side-fade,.is-text-mode .hero-dots { display:none; }
.is-text-mode .home-brand-name { color:var(--ink,#29262e); text-shadow:none; }
.is-text-mode .home-brand-en { color:var(--muted,#85828a); text-shadow:none; }
.is-text-mode .brand-cap { position:relative; inset:auto; padding:calc(var(--home-nav-height,68px) + 32rpx) 38rpx 92rpx; color:var(--ink,#29262e); text-shadow:none; }
.is-text-mode .home-eyebrow,.is-text-mode .home-lead { color:var(--muted,#85828a); }
.is-text-mode .home-kicker { font-size:calc(48rpx * var(--ui-scale)); }
.is-text-mode .hero-discover { color:var(--home-primary); }
.home-page.is-text-mode .discovery-card { margin-top:-50rpx; }
.is-text-mode .destination-card { min-height:230rpx; color:var(--ink,#29262e); background:var(--card,#fff); border:1rpx solid var(--line,#e8e6eb); }
.is-text-mode .destination-photo,.is-text-mode .destination-shade { display:none; }
.is-text-mode .destination-tag { color:var(--home-primary); border-color:var(--line,#e8e6eb); background:var(--home-soft); }
.is-text-mode .destination-copy { min-height:230rpx; padding-top:85rpx; }
.is-text-mode .destination-en { color:var(--muted,#85828a); opacity:1; }
.is-text-mode .feed-cover { display:none; }
.is-text-mode .feed-body { width:100%; }
@media(max-width:350px) {
  .home-brand { gap:10rpx; padding-left:28rpx; }
  .home-brand-logo { width:58rpx; height:58rpx; }
  .home-brand-name { font-size:27rpx; }
  .home-brand-en { font-size:17rpx; }
  .home-section-heading { align-items:flex-start; }
  .destination-caption { padding-top:5rpx; }
  .organizer-link { flex-wrap:wrap; gap:10rpx; }
  .organizer-icon { width:48rpx; height:51rpx; }
  .organizer-arrow { display:none; }
}
