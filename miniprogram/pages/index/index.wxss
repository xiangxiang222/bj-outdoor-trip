.home-hero {
  margin: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1b4332, #40916c);
  color: #fff;
}
.home-kicker { font-size: 36rpx; font-weight: 700; }
.home-lead { margin-top: 12rpx; font-size: 26rpx; opacity: .88; line-height: 1.5; }
.home-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 8rpx;
}
.home-tile {
  width: 46%;
  margin: 8rpx 2%;
  background: #fffdf8;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.home-tile-title { font-size: 32rpx; font-weight: 700; color: #1b4332; }
.home-member {
  margin: 16rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff6d6, #ffe08a);
}
