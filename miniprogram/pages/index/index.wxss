.home-hero {
  margin: 16rpx;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1b4332, #40916c);
  color: #fff;
}
.brand-box {
  height: 360rpx;
  margin: 16rpx 16rpx 0;
  border-radius: 24rpx;
  overflow: hidden;
  position: relative;
  z-index: 0;
  background: #1b4332;
}
.brand-hero {
  width: 100%;
  height: 360rpx;
  margin: 0;
  overflow: hidden;
  background: #1b4332;
}
.brand-hero swiper-item { height: 360rpx; overflow: hidden; }
.brand-img { width: 100%; height: 360rpx; display: block; }
.brand-cap {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 24rpx;
  z-index: 2;
  margin: 0;
  color: #fff;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.45);
}
.city-bar { white-space: nowrap; padding: 8rpx 8rpx 0; }
.city-swipe { width: 100%; height: 280rpx; margin: 0 16rpx 16rpx; border-radius: 16rpx; overflow: hidden; position: relative; }
.city-swipe swiper-item { height: 280rpx; }
.city-swipe .brand-img { height: 280rpx; }
.swipe-cap {
  position: absolute;
  left: 16rpx;
  bottom: 16rpx;
  color: #fff;
  font-weight: 700;
  text-shadow: 0 2rpx 8rpx rgba(0,0,0,.5);
}
.month-grid { display: flex; flex-wrap: wrap; padding: 0 12rpx 12rpx; }
.month-cell { width: 13%; margin: 4rpx 0.5%; background: #fff; border-radius: 8rpx; padding: 8rpx 0; text-align: center; font-size: calc(22rpx * var(--ui-scale)); }
.month-cell.on { background: #d8f3dc; }
.play-tag { display: inline-block; color: #fff; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: calc(24rpx * var(--ui-scale)); margin: 8rpx; }
.offer-chip { display: inline-block; color: #fff; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: calc(24rpx * var(--ui-scale)); margin: 8rpx; }
.offer-chip.inline { margin-right: 8rpx; font-size: calc(20rpx * var(--ui-scale)); padding: 2rpx 10rpx; }
.offer-chip.publish { background: #c9a227; color: #1b4332; }
.price-origin { color: #6b705c; text-decoration: line-through; margin-right: 8rpx; font-weight: 400; }
.tile-thumbs { display: flex; gap: 8rpx; margin-top: 12rpx; }
.tile-thumbs image { width: 72rpx; height: 72rpx; border-radius: 12rpx; }
.fold { padding: 12rpx 24rpx; color: #1b4332; font-weight: 650; }
.picked { padding: 8rpx 16rpx; }
.picked-chip { display: inline-block; background: #d8f3dc; border-radius: 999rpx; padding: 6rpx 16rpx; margin: 6rpx; font-size: calc(24rpx * var(--ui-scale)); }
.cta { margin: 16rpx; padding: 24rpx; background: #fff; border-radius: 16rpx; }
.prices { display: flex; gap: 16rpx; margin-top: 8rpx; font-size: calc(24rpx * var(--ui-scale)); color: #bc4749; }
.kicker-row { display: flex; align-items: center; gap: 12rpx; margin-bottom: 12rpx; }
.enamel {
  font-size: calc(20rpx * var(--ui-scale));
  font-weight: 650;
  letter-spacing: 6rpx;
  padding: 6rpx 16rpx 6rpx 20rpx;
  border-radius: 999rpx;
  color: #fff;
}
.enamel.thu { background: rgba(107, 33, 120, .94); }
.enamel.pku { background: rgba(130, 26, 42, .94); }
.enamel-x { font-size: calc(22rpx * var(--ui-scale)); opacity: .8; }
.campus-card,
.trip-hint,
.feed-search,
.home-seg,
.city-bar,
.feed-toolbar {
  position: relative;
  z-index: 2;
}
.campus-card {
  margin: 16rpx;
  padding: 20rpx 24rpx 20rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  position: relative;
  overflow: hidden;
}
.campus-card::before {
  content: "";
  position: absolute;
  left: 0; top: 0; bottom: 0;
  width: 8rpx;
  background: linear-gradient(180deg, #6b2178, #821a2a);
}
.qb-seals { display: flex; gap: 10rpx; margin-bottom: 10rpx; }
.qb-seal {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  color: #fff; font-size: calc(24rpx * var(--ui-scale)); font-weight: 700;
  text-align: center; line-height: 48rpx;
}
.qb-seal.thu { background: #6b2178; }
.qb-seal.pku { background: #821a2a; }
.campus-title { font-size: calc(28rpx * var(--ui-scale)); font-weight: 700; }
.campus-cta {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #6b2178, #821a2a);
  color: #fff;
  font-size: calc(24rpx * var(--ui-scale));
  font-weight: 650;
}
.home-kicker { font-size: calc(36rpx * var(--ui-scale)); font-weight: 700; }
.home-lead { margin-top: 12rpx; font-size: calc(26rpx * var(--ui-scale)); opacity: .88; line-height: 1.5; }
.home-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 8rpx;
}
.home-tile {
  width: 46%;
  margin: 8rpx 2%;
  background: #fffdf8;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}
.home-tile-title { font-size: calc(32rpx * var(--ui-scale)); font-weight: 700; color: #1b4332; }
.home-foot { text-align: center; padding: 16rpx; color: #2d6a4f; }
