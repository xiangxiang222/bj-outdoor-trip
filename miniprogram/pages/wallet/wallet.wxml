<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="cash-card">
  <view class="cash-safe">{{tr.t('账户安全保障中', lang)}}</view>
  <view class="cash-label">{{tr.t('余额（元）', lang)}}</view>
  <view class="cash-num">{{tr.t(data.balance || 0, lang)}}</view>
  <view class="cash-sub">{{tr.t('可付团费，充值走微信支付，提现到微信零钱。不支持银行卡。', lang)}}</view>
  <view class="cash-actions">
    <view class="cash-btn" bindtap="showTopup">{{tr.t('充值', lang)}}</view>
    <view class="cash-btn ghost" bindtap="showWithdraw">{{tr.t('提现', lang)}}</view>
  </view>
</view>

<view class="sheet" wx:if="{{mode=='topup'}}" id="wallet-form">
  <view class="sheet-label">{{tr.t('充值金额（元）', lang)}}</view>
  <input class="sheet-input" type="number" value="{{topupAmount}}" bindinput="setTopup" />
  <view class="chips">
    <view class="chip {{topupAmount==item ? 'on' : ''}}" wx:for="{{quick}}" wx:key="*this" bindtap="pickTopup" data-n="{{item}}">{{tr.t(item, lang)}}</view>
  </view>
  <view class="sheet-note">{{tr.t('单笔 1～5000 元。支付成功后立即进入余额。请确认金额后再支付。', lang)}}</view>
  <view class="cash-btn block" bindtap="topup">{{tr.t('确认微信支付', lang)}}</view>
</view>

<view class="sheet" wx:if="{{mode=='withdraw'}}" id="wallet-form">
  <view class="sheet-note" wx:if="{{!data.realNamed}}">{{tr.t('提现前请先完成实名。', lang)}}</view>
  <view class="sheet-note" wx:if="{{data.realNamed && !data.pinSet}}">{{tr.t('提现前请先设置 6 位支付密码。', lang)}}</view>
  <view class="sheet-label">{{tr.t('提现金额（元）', lang)}}</view>
  <input class="sheet-input" type="number" value="{{withdrawAmount}}" bindinput="setWithdraw" />
  <view class="chips" wx:if="{{rule.available > 0}}">
    <view class="chip on" bindtap="fillAll">{{tr.t('全部', lang)}} {{tr.t(rule.available, lang)}} {{tr.t('元', lang)}}</view>
  </view>
  <view class="sheet-note">{{tr.t('当前余额全部可提，不设最低金额。单笔上限 2000 元，超出可立即再提。提交后请在微信里确认收款，确认后实时到账。', lang)}}</view>
  <view class="sheet-label">{{tr.t('支付密码', lang)}}</view>
  <input class="sheet-input" password value="{{pin}}" maxlength="6" bindinput="setPin" />
  <view class="cash-btn block" bindtap="withdraw">{{tr.t('确认提现', lang)}}</view>
</view>

<view class="list">
  <view class="row" bindtap="go" data-url="/pages/profile/profile">
    <text>{{tr.t('实名信息', lang)}}</text>
    <text class="hint">{{tr.t(data.realNamed ? '已实名' : '待完善', lang)}} ›</text>
  </view>
  <view class="row" bindtap="go" data-url="/pages/wallet-pin/wallet-pin">
    <text>{{tr.t('支付密码', lang)}}</text>
    <text class="hint">{{tr.t(data.pinSet ? '已设置' : '未设置', lang)}} ›</text>
  </view>
</view>

<view class="sec">{{tr.t('零钱明细', lang)}}</view>
<view class="list" wx:if="{{data.bills.length}}">
  <view class="row" wx:for="{{data.bills}}" wx:key="id">
    <view>
      <view>{{tr.t(item.reason, lang)}}</view>
      <view class="hint">{{tr.t(item.createdAt, lang)}}</view>
    </view>
    <text class="amt {{item.delta > 0 ? 'in' : ''}}">{{tr.t(item.delta > 0 ? '+' : '', lang)}}{{tr.t(item.delta, lang)}}</text>
  </view>
</view>
<view class="empty" wx:else>{{tr.t('还没有零钱明细', lang)}}</view>

<view class="sec">{{tr.t('零钱规则', lang)}}</view>
<view class="rules">
  <view class="rule-h">{{tr.t('可提现额度', lang)}}</view>
  <view class="rule-p">{{tr.t('当前账户余额全部可提现，不设最低提现金额。微信零钱按整数元记账。因微信商家转账到零钱单笔上限 2000 元，超过 2000 元时可连续分笔，每笔提交后立即处理。当前可提现', lang)}} {{tr.t(rule.available, lang)}} {{tr.t('元。', lang)}}</view>
  <view class="rule-h">{{tr.t('每日提现次数', lang)}}</view>
  <view class="rule-p">{{tr.t('不限制次数，可随时申请。', lang)}}</view>
  <view class="rule-h">{{tr.t('提现时间', lang)}}</view>
  <view class="rule-p">{{tr.t('每天 00:00–23:59（北京时间），全天可申请。', lang)}}</view>
  <view class="rule-h">{{tr.t('到账时间', lang)}}</view>
  <view class="rule-p">{{tr.t('提交成功后实时转入微信零钱。如遇系统延迟，最迟 24 小时内到账。', lang)}}</view>
  <view class="rule-p">{{tr.t('微信支付转到零钱须完成实名并验证 6 位支付密码。仅支持提到本人微信零钱，不支持银行卡。充值进入的余额可按本规则全额提现。', lang)}}</view>
  <view class="rule-h">{{tr.t('充值', lang)}}</view>
  <view class="rule-p">{{tr.t('单笔 1～5000 元，须为整数元。微信支付成功后立即进入余额，用于支付团费。', lang)}}</view>
</view>
<view class="pad" wx:if="{{msg}}" style="color:#e85d4c">{{tr.t(msg, lang)}}</view>
