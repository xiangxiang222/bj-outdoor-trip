<view class="wallet-hero">
  <view class="muted">账户安全保障中</view>
  <view class="wallet-balance">{{data.balance || 0}}<text class="muted"> 元</text></view>
  <view class="muted">返点、成团奖励会进这里。充值走微信支付，提现到微信零钱。不支持银行卡。</view>
  <view class="row" style="margin-top:24rpx">
    <view class="btn" style="flex:1;margin:0 8rpx 0 0" bindtap="showTopup">微信支付充值</view>
    <view class="btn ghost" style="flex:1;margin:0" bindtap="showWithdraw">提现到微信</view>
  </view>
</view>

<view class="card" wx:if="{{mode=='topup'}}">
  <view class="pad muted">充值金额（元）</view>
  <input class="input" type="number" value="{{topupAmount}}" bindinput="setTopup" />
  <view class="chips">
    <view class="chip {{topupAmount==item ? 'on' : ''}}" wx:for="{{quick}}" wx:key="*this" bindtap="pickTopup" data-n="{{item}}">{{item}}</view>
  </view>
  <view class="btn" bindtap="topup">确认微信支付</view>
</view>

<view class="card" wx:if="{{mode=='withdraw'}}">
  <view class="pad muted" wx:if="{{!data.realNamed}}">提现前请先完成实名</view>
  <view class="pad muted" wx:elif="{{!data.pinSet}}">请先设置支付密码</view>
  <block wx:else>
    <view class="pad muted">提现金额（元）</view>
    <input class="input" type="number" value="{{withdrawAmount}}" bindinput="setWithdraw" />
    <view class="pad muted">到账微信零钱。演示环境立即记账。</view>
    <view class="pad muted">支付密码</view>
    <input class="input" password value="{{pin}}" maxlength="6" bindinput="setPin" />
    <view class="btn" bindtap="withdraw">确认提现到微信</view>
  </block>
</view>

<view class="cell-group">
  <view class="cell" bindtap="go" data-url="/pages/wallet-pin/wallet-pin"><text>支付密码</text><text class="muted">{{data.pinSet ? '已设置' : '未设置'}} ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/profile/profile"><text>实名信息</text><text class="muted">{{data.realNamed ? '已实名' : '待完善'}} ›</text></view>
</view>

<view class="cell-label">账单</view>
<view class="cell-group" wx:if="{{data.bills.length}}">
  <view class="cell" wx:for="{{data.bills}}" wx:key="id">
    <view>
      <view>{{item.reason}}</view>
      <view class="muted">{{item.createdAt}}</view>
    </view>
    <text class="muted">{{item.delta > 0 ? '+' : ''}}{{item.delta}}</text>
  </view>
</view>
<view class="pad muted" wx:else>还没有钱包流水。</view>
<view class="pad" wx:if="{{msg}}" style="color:#bc4749">{{msg}}</view>
