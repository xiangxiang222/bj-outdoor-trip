<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view wx:if="{{err}}" class="muted pad">{{tr.t(err, lang)}}</view>
<view wx:elif="{{g}}">
  <view class="card">
    <view class="pad guide-row">
      <view class="guide-face" style="width:128rpx;height:128rpx;font-size: calc(44rpx * var(--ui-scale));line-height:128rpx">{{tr.t(g.initial, lang)}}</view>
      <view class="guide-body">
        <view class="row"><text class="title">{{tr.t(g.name, lang)}}</text><text class="tag">{{tr.t(g.rating, lang)}} {{tr.t('分', lang)}}</text></view>
        <view class="muted">{{tr.t(g.genderText, lang)}} {{tr.t('· 从业', lang)}} {{tr.t(g.years, lang)}} {{tr.t('年 · 已带团', lang)}} {{tr.t(g.tripCount, lang)}} {{tr.t('次', lang)}}</view>
      </view>
    </view>
  </view>
  <view class="chips" wx:if="{{g.specialtyList.length}}">
    <view class="chip on" wx:for="{{g.specialtyList}}" wx:key="*this">{{tr.t(item, lang)}}</view>
  </view>
  <view class="pad title">{{tr.t('个人简介', lang)}}</view>
  <view class="card"><view class="pad">
    <view>{{tr.t(g.bio || "暂无简介", lang)}}</view>
    <view class="muted" wx:if="{{g.languages}}" style="margin-top:12rpx">{{tr.t('语言：', lang)}}{{tr.t(g.languages, lang)}}</view>
  </view></view>
  <view class="pad title">{{tr.t('近期带团', lang)}}</view>
  <view class="card" wx:for="{{g.upcoming}}" wx:key="id" bindtap="goSch" data-id="{{item.id}}">
    <view class="pad">
      <view class="row"><text class="title">{{tr.t(item.title, lang)}}</text><text class="tag">{{tr.t(item.startDate, lang)}}</text></view>
      <view class="muted">{{tr.t(item.region, lang)}}</view>
    </view>
  </view>
  <view wx:if="{{!g.upcoming.length}}" class="pad muted">{{tr.t('暂时没有即将出发的行程。', lang)}}</view>
</view>
