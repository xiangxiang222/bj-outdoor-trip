.guide-row { padding: 40rpx 28rpx; gap: 24rpx; }
.guide-face { color: #fff; background: #8a70a4; border: 6rpx solid #eee7f6; font-weight: 400; }
.guide-body { flex: 1; min-width: 0; }
.guide-body .title { font-size: calc(39rpx * var(--ui-scale)); }
.guide-body .muted { margin-top: 12rpx; line-height: 1.6; font-size: calc(22rpx * var(--ui-scale)); }
.chips { padding: 0 24rpx; }
.chip { background: #efeaf7; color: #806293; border: 0; border-radius: 12rpx; }
.pad.title { padding: 30rpx 34rpx 12rpx; color: #6c577d; font-size: calc(30rpx * var(--ui-scale)); }
.card .pad { line-height: 1.75; }
