<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="card" wx:if="{{!loggedIn}}">
  <view class="pad">
    <view class="title">{{tr.t('登录后看出行计划', lang)}}</view>
    <view class="muted">{{tr.t('山野团和同城局都会出现在这里。', lang)}}</view>
    <view class="btn" bindtap="goLogin">{{tr.t('登录查看行程', lang)}}</view>
  </view>
</view>

<block wx:else>
  <view class="chips">
    <view class="chip {{tab=='unpaid'?'on':''}}" bindtap="setTab" data-tab="unpaid">{{tr.t('待支付', lang)}} {{tr.t(unpaid.length, lang)}}</view>
    <view class="chip {{tab=='waitlist'?'on':''}}" bindtap="setTab" data-tab="waitlist">{{tr.t('候补', lang)}} {{tr.t(waitlist.length, lang)}}</view>
    <view class="chip {{tab=='depart'?'on':''}}" bindtap="setTab" data-tab="depart">{{tr.t('待出发', lang)}} {{tr.t(upcoming.length, lang)}}</view>
    <view class="chip {{tab=='review'?'on':''}}" bindtap="setTab" data-tab="review">{{tr.t('待评价', lang)}} {{tr.t(review.length, lang)}}</view>
    <view class="chip {{tab=='refund'?'on':''}}" bindtap="setTab" data-tab="refund">{{tr.t('退款', lang)}} {{tr.t(refund.length, lang)}}</view>
    <view class="chip {{tab=='past'?'on':''}}" bindtap="setTab" data-tab="past">{{tr.t('历史', lang)}} {{tr.t(past.length, lang)}}</view>
  </view>

  <block wx:if="{{tab=='depart'}}">
    <view class="card" wx:if="{{nextTrip}}" bindtap="goSchedule" data-id="{{nextTrip.schedule_id}}">
      <view class="pad">
        <view class="muted">{{tr.t('下一趟 ·', lang)}} {{tr.t(nextTrip.kindLabel, lang)}}</view>
        <view class="title">{{tr.t(nextTrip.title, lang)}}</view>
        <view class="muted">{{tr.t(nextTrip.start_date, lang)}} {{tr.t(nextTrip.meetup_time, lang)}} · {{tr.t(nextTrip.meetup_point, lang)}}</view>
      </view>
      <view wx:if="{{nextTrip.canPay}}" class="cancel-link" catchtap="goPay" data-token="{{nextTrip.payShareToken}}" data-sid="{{nextTrip.schedule_id}}">{{tr.t('去支付', lang)}}</view>
      <view wx:if="{{nextTrip.canCancel}}" class="cancel-link" catchtap="cancel" data-id="{{nextTrip.id}}">{{tr.t('取消报名', lang)}}</view>
    </view>
    <view class="card" wx:for="{{restUpcoming}}" wx:key="id">
      <view class="pad" bindtap="goSchedule" data-id="{{item.schedule_id}}">
        <view class="row">
          <view class="title">{{tr.t(item.title, lang)}}</view>
          <view class="tag">{{tr.t(item.kindLabel, lang)}}</view>
        </view>
        <view class="muted">{{tr.t(item.meetup_time, lang)}} {{tr.t(item.meetup_point, lang)}}</view>
        <view class="muted">{{tr.t(item.statusText, lang)}} · {{tr.t(item.moneyText, lang)}}</view>
      </view>
      <view wx:if="{{item.canPay}}" class="cancel-link" catchtap="goPay" data-token="{{item.payShareToken}}" data-sid="{{item.schedule_id}}">{{tr.t('去支付', lang)}}</view>
      <view wx:if="{{item.canCancel}}" class="cancel-link" catchtap="cancel" data-id="{{item.id}}">{{tr.t('取消报名', lang)}}</view>
    </view>

    <view class="card" wx:if="{{!upcoming.length && !waitlist.length && !past.length}}">
      <view class="pad">
        <view class="title">{{tr.t('还没有行程', lang)}}</view>
        <view class="muted">{{tr.t('去首页报团，或去活动页约一局。', lang)}}</view>
        <view class="btn" bindtap="goHomeTab">{{tr.t('去首页', lang)}}</view>
        <view class="btn ghost" bindtap="goActTab">{{tr.t('去同城局', lang)}}</view>
      </view>
    </view>
    <view class="pad muted" wx:elif="{{!upcoming.length}}">{{tr.t(waitlist.length ? '没有已占座的行程。候补在「候补」里。' : '最近没有待出行。点「历史」看过往报名。', lang)}}</view>
  </block>

  <block wx:elif="{{tab=='waitlist'}}">
    <view class="card" wx:for="{{waitlist}}" wx:key="id">
      <view class="pad" bindtap="goSchedule" data-id="{{item.schedule_id}}">
        <view class="row">
          <view class="title">{{tr.t(item.title, lang)}}</view>
          <view class="tag">{{tr.t('候补', lang)}}</view>
        </view>
        <view class="muted">{{tr.t(item.start_date, lang)}} {{tr.t(item.meetup_time, lang)}} · {{tr.t(item.meetup_point, lang)}}</view>
        <view class="muted">{{tr.t(item.statusText, lang)}} · {{tr.t(item.moneyText, lang)}}</view>
      </view>
      <view wx:if="{{item.canCancel}}" class="cancel-link" catchtap="cancel" data-id="{{item.id}}">{{tr.t('取消候补', lang)}}</view>
    </view>
    <view class="pad muted" wx:if="{{!waitlist.length}}">{{tr.t('还没有候补。满员团仍可报名进候补。', lang)}}</view>
  </block>

  <block wx:elif="{{tab=='unpaid'}}">
    <view class="card" wx:for="{{unpaid}}" wx:key="id">
      <view class="pad" bindtap="goSchedule" data-id="{{item.schedule_id}}">
        <view class="title">{{tr.t(item.title, lang)}}</view>
        <view class="muted">{{tr.t(item.start_date, lang)}} · {{tr.t(item.moneyText, lang)}}</view>
      </view>
      <view wx:if="{{item.canPay}}" class="cancel-link" catchtap="goPay" data-token="{{item.payShareToken}}" data-sid="{{item.schedule_id}}">{{tr.t('去支付', lang)}}</view>
    </view>
    <view class="pad muted" wx:if="{{!unpaid.length}}">{{tr.t('没有待支付的报名。', lang)}}</view>
  </block>

  <block wx:elif="{{tab=='review'}}">
    <view class="card" wx:for="{{review}}" wx:key="id">
      <view class="pad" bindtap="goSchedule" data-id="{{item.schedule_id}}">
        <view class="title">{{tr.t(item.title, lang)}}</view>
        <view class="muted">{{tr.t(item.start_date, lang)}} · {{tr.t('待评价', lang)}}</view>
      </view>
      <view wx:if="{{reviewingId != item.id}}" class="btn ghost" catchtap="openReview" data-id="{{item.id}}">{{tr.t('去评价', lang)}}</view>
      <view wx:else class="pad">
        <view class="star-pick">
          <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="n" wx:key="*this" class="star {{rating >= n ? 'on' : ''}}" catchtap="pickStar" data-n="{{n}}">★</text>
        </view>
        <textarea class="input" placeholder="{{tr.t('这次出行怎么样（选填）', lang)}}" value="{{content}}" bindinput="setContent" />
        <view class="btn" catchtap="submitReview" data-id="{{item.id}}">{{tr.t('提交评价', lang)}}</view>
      </view>
    </view>
    <view class="pad muted" wx:if="{{!review.length}}">{{tr.t('回来的行程都评过了。', lang)}}</view>
  </block>

  <block wx:elif="{{tab=='refund'}}">
    <view class="card" wx:for="{{refund}}" wx:key="id">
      <view class="pad" bindtap="goSchedule" data-id="{{item.schedule_id}}">
        <view class="title">{{tr.t(item.title, lang)}}</view>
        <view class="muted">{{tr.t(item.refundProgress.text, lang)}}</view>
      </view>
    </view>
    <view class="pad muted" wx:if="{{!refund.length}}">{{tr.t('还没有退款记录。', lang)}}</view>
  </block>

  <block wx:else>
    <view class="card" wx:for="{{past}}" wx:key="id">
      <view class="pad" bindtap="goSchedule" data-id="{{item.schedule_id}}">
        <view class="row">
          <view class="title">{{tr.t(item.title, lang)}}</view>
          <view class="tag">{{tr.t(item.status=='cancelled'?'已取消':item.kindLabel, lang)}}</view>
        </view>
        <view class="muted">{{tr.t(item.start_date, lang)}} · {{tr.t(item.statusText, lang)}} · {{tr.t(item.moneyText, lang)}}</view>
        <view class="muted" wx:if="{{item.refundProgress}}">{{tr.t(item.refundProgress.text, lang)}}</view>
      </view>
      <view wx:if="{{item.canComplete || item.completed}}" class="btn" catchtap="goAfter" data-sid="{{item.schedule_id}}">{{tr.t(item.completed ? '评价 / 评选' : '完成活动', lang)}}</view>
      <view wx:if="{{item.canReview}}">
        <view wx:if="{{reviewingId != item.id}}" class="btn ghost" catchtap="openReview" data-id="{{item.id}}">{{tr.t('去评价', lang)}}</view>
        <view wx:else class="pad">
          <view class="star-pick">
            <text wx:for="{{[1,2,3,4,5]}}" wx:for-item="n" wx:key="*this" class="star {{rating >= n ? 'on' : ''}}" catchtap="pickStar" data-n="{{n}}">★</text>
          </view>
          <textarea class="input" placeholder="{{tr.t('这次出行怎么样（选填）', lang)}}" value="{{content}}" bindinput="setContent" />
          <view class="row">
            <view class="btn ghost" style="flex:1;margin:0 8rpx 0 0" catchtap="closeReview">{{tr.t('取消', lang)}}</view>
            <view class="btn" style="flex:1;margin:0 0 0 8rpx" catchtap="submitReview" data-id="{{item.id}}">{{tr.t('提交评价', lang)}}</view>
          </view>
        </view>
      </view>
      <view wx:elif="{{item.reviewed}}" class="pad muted">{{tr.t('已评价', lang)}}</view>
    </view>
    <view class="pad muted" wx:if="{{!past.length}}">{{tr.t('还没有历史报名。', lang)}}</view>
  </block>
</block>
