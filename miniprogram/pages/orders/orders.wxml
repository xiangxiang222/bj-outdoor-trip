<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="page-heading"><view class="section-kicker">YOUR NEXT CHAPTER</view><view class="section-title">{{tr.t('我的每一程', lang)}}</view><view class="muted">{{tr.t('从期待出发，到回味山野，所有同行都在这里。', lang)}}</view></view>
<view class="card" wx:if="{{!loggedIn}}">
  <view class="pad">
    <view class="title">{{tr.t('登录后看出行计划', lang)}}</view>
    <view class="muted">{{tr.t('山野团和同城局都会出现在这里，出发前能看到集合时间和地点。', lang)}}</view>
    <view class="btn" bindtap="goLogin">{{tr.t('登录查看行程', lang)}}</view>
  </view>
</view>

<block wx:else>
  <view class="od-bar">
    <input class="od-search" placeholder="{{tr.t('搜索我的订单', lang)}}" value="{{keyword}}" bindinput="setKeyword" />
    <view class="od-tools">
      <view class="od-tabs-wrap">
      <scroll-view class="od-tabs" scroll-x enhanced show-scrollbar="{{false}}" scroll-into-view="{{tabInto}}" scroll-with-animation>
        <view class="od-tab-row">
          <view id="tab-all" class="od-tab {{tab=='all'?'on':''}}" bindtap="setTab" data-tab="all">{{tr.t('全部', lang)}}</view>
          <view id="tab-unpaid" class="od-tab {{tab=='unpaid'?'on':''}}" bindtap="setTab" data-tab="unpaid">{{tr.t('待付款', lang)}}</view>
          <view id="tab-recruiting" class="od-tab {{tab=='recruiting'?'on':''}}" bindtap="setTab" data-tab="recruiting">{{tr.t('招募中', lang)}}</view>
          <view id="tab-depart" class="od-tab {{tab=='depart'?'on':''}}" bindtap="setTab" data-tab="depart">{{tr.t('待出发', lang)}}</view>
          <view id="tab-review" class="od-tab {{tab=='review'?'on':''}}" bindtap="setTab" data-tab="review">{{tr.t('待评价', lang)}}</view>
          <view id="tab-waitlist" class="od-tab {{tab=='waitlist'?'on':''}}" bindtap="setTab" data-tab="waitlist">{{tr.t('候补中', lang)}}</view>
          <view id="tab-refund" class="od-tab {{tab=='refund'?'on':''}}" bindtap="setTab" data-tab="refund">{{tr.t('已退款', lang)}}</view>
        </view>
      </scroll-view>
      <view class="od-fade"></view>
      </view>
      <view class="od-filter {{filterOn?'on':''}}" bindtap="openFilter">
        <view class="od-funnel"></view>
        <text>{{tr.t('筛选', lang)}}</text>
      </view>
    </view>
  </view>
  <view class="od-list">

  <view class="od-card" wx:for="{{shown}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
    <view class="od-head">
      <view class="od-shop">{{tr.t(item.shop, lang)}}</view>
      <view class="od-status {{item.hot?'is-hot':''}}">{{tr.t(item.badge, lang)}}</view>
    </view>
    <view class="od-goods">
      <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
      <view wx:else class="od-ph"></view>
      <view class="od-main">
        <view class="od-title">{{tr.t(item.title, lang)}}</view>
        <view class="od-spec">{{tr.t(item.spec, lang)}}</view>
      </view>
      <view class="od-price">
        <view>{{tr.t(item.moneyText, lang)}}</view>
        <view class="od-qty">{{tr.t('共1人', lang)}}</view>
      </view>
    </view>
    <view class="od-help" wx:if="{{item.helperCount}}">{{tr.t('帮忙支付', lang)}} {{item.helperCount}} {{tr.t('人', lang)}}</view>
    <view class="od-actions" wx:if="{{item.canCancel || item.canPay || item.reviewable || (item.canAfter && item.completed) || item.again}}" catchtap="noop">
      <view wx:if="{{item.canCancel}}" class="od-btn" catchtap="cancel" data-id="{{item.id}}">{{tr.t(item.status=='waitlist'?'取消候补':'取消报名', lang)}}</view>
      <view wx:if="{{item.canPay}}" class="od-btn solid" catchtap="goPay" data-token="{{item.payShareToken}}" data-id="{{item.id}}">{{tr.t('去支付', lang)}}</view>
      <view wx:if="{{item.reviewable}}" class="od-btn solid" catchtap="goDetail" data-id="{{item.id}}" data-review="1">{{tr.t('去评价', lang)}}</view>
      <view wx:if="{{item.canAfter && item.completed}}" class="od-btn" catchtap="goAfter" data-sid="{{item.schedule_id}}">{{tr.t('评价 / 评选', lang)}}</view>
      <view wx:if="{{item.again}}" class="od-btn {{item.reviewable ? '' : 'solid'}}" catchtap="goRoute" data-rid="{{item.route_id}}">{{tr.t('再次报名', lang)}}</view>
    </view>
  </view>

  <load-row wx:if="{{loading}}" />
  <view class="card" wx:elif="{{emptyAll}}">
    <view class="pad">
      <view class="title">{{tr.t('还没有报名。', lang)}}</view>
      <view class="muted">{{tr.t('去首页报一个山野团，或去活动页约一局。', lang)}}</view>
      <view class="btn" bindtap="goHomeTab">{{tr.t('去首页', lang)}}</view>
      <view class="btn ghost" bindtap="goActTab">{{tr.t('去同城局', lang)}}</view>
    </view>
  </view>
  <view class="pad muted" wx:elif="{{!shown.length}}">{{tr.t('没有符合条件的订单', lang)}}</view>
  <view class="od-end" wx:else>{{tr.t('没有更多订单', lang)}}</view>
  <view class="tab-pad"></view>
  </view>
</block>

<view class="od-mask" wx:if="{{sheet}}" bindtap="closeFilter">
  <view class="od-sheet" catchtap="noop">
    <view class="od-x" bindtap="closeFilter">×</view>
    <view class="od-sheet-title">{{tr.t('订单筛选', lang)}}</view>
    <view class="od-label">{{tr.t('下单时间', lang)}}</view>
    <view class="od-presets">
      <view wx:for="{{quick}}" wx:key="key" class="od-preset {{draftPreset==item.key?'on':''}}" data-key="{{item.key}}" bindtap="pickPreset">{{tr.t(item.label, lang)}}</view>
      <view wx:for="{{years}}" wx:key="key" class="od-preset {{draftPreset==item.key?'on':''}}" data-key="{{item.key}}" bindtap="pickPreset">{{item.label}}</view>
      <block wx:if="{{moreYears}}">
        <view wx:for="{{extra}}" wx:key="key" class="od-preset {{draftPreset==item.key?'on':''}}" data-key="{{item.key}}" bindtap="pickPreset">{{item.label}}</view>
      </block>
      <view wx:if="{{!moreYears && extra.length}}" class="od-preset" bindtap="showYears">{{tr.t('展开', lang)}}</view>
    </view>
    <view class="od-range">
      <picker mode="date" value="{{draftStart}}" bindchange="setStart">
        <view class="od-date">{{draftStart || tr.t('起始时间', lang)}}</view>
      </picker>
      <view class="od-dash">—</view>
      <picker mode="date" value="{{draftEnd}}" bindchange="setEnd">
        <view class="od-date">{{draftEnd || tr.t('终止时间', lang)}}</view>
      </picker>
    </view>
    <view class="od-sheet-bar">
      <view class="od-btn" bindtap="resetDraft">{{tr.t('重置', lang)}}</view>
      <view class="od-btn solid" bindtap="applyFilter">{{tr.t('确定', lang)}}</view>
    </view>
  </view>
</view>
