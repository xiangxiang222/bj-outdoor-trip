@import "../../styles/account.wxss";

.od-bar { background: #fff; padding: 16rpx 24rpx 4rpx; }
.od-search {
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 12rpx 24rpx;
  margin: 0 0 4rpx;
  font-size: calc(26rpx * var(--ui-scale));
}
.od-tools { display: flex; align-items: center; }
.od-tabs-wrap { position: relative; flex: 1; width: 0; min-width: 0; }
.od-tabs { width: 100%; white-space: nowrap; }
.od-fade { position: absolute; right: 0; top: 0; bottom: 0; width: 48rpx; background: linear-gradient(90deg, rgba(255,255,255,0), #fff); pointer-events: none; }
.od-tab-row { display: inline-flex; align-items: center; white-space: nowrap; }
.od-tab {
  display: inline-block;
  color: #8d8d8d;
  font-size: calc(26rpx * var(--ui-scale));
  font-weight: 400;
  padding: 16rpx 0;
  margin-right: 32rpx;
}
.od-tab.on { color: #1a1a1a; font-weight: 650; }
.od-filter {
  flex: none;
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
  padding: 16rpx 0 16rpx 16rpx;
  margin: 0;
  border-left: 1rpx solid #eee;
}
.od-filter.on { color: #bc4749; font-weight: 650; }
.od-funnel {
  width: 22rpx;
  height: 22rpx;
  background: currentColor;
  clip-path: polygon(0 0, 100% 0, 68% 42%, 68% 100%, 32% 100%, 32% 42%);
}
.od-list { padding: 16rpx 16rpx 0; }
.od-card { background: #fff; border-radius: 16rpx; margin: 0 0 12rpx; overflow: hidden; }
.od-end { text-align: center; color: #b5b5b5; font-size: calc(22rpx * var(--ui-scale)); padding: 12rpx 0 8rpx; }
.od-head { display: flex; justify-content: space-between; align-items: center; padding: 20rpx 20rpx 8rpx; font-size: calc(26rpx * var(--ui-scale)); }
.od-shop { font-weight: 650; color: #1a1a1a; }
.od-status { color: #8d8d8d; font-size: calc(24rpx * var(--ui-scale)); font-weight: 400; }
.od-status.is-hot { color: #e23d3d; }
.od-goods { display: flex; align-items: flex-start; gap: 16rpx; padding: 4rpx 20rpx 8rpx; }
.od-goods image, .od-ph { width: 160rpx; height: 160rpx; border-radius: 8rpx; background: #f3f4f6; flex: none; }
.od-main { flex: 1; min-width: 0; }
.od-title {
  font-size: calc(28rpx * var(--ui-scale));
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.od-spec, .od-help, .od-qty { color: #999; font-size: calc(22rpx * var(--ui-scale)); margin-top: 8rpx; font-weight: 400; }
.od-spec { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.od-price { text-align: right; font-weight: 700; font-size: calc(30rpx * var(--ui-scale)); color: #1a1a1a; line-height: 1.2; }
.od-help { padding: 0 20rpx 8rpx; }
.od-actions { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 12rpx; padding: 8rpx 20rpx 20rpx; }
.od-btn {
  border: 1rpx solid #e6e6e6;
  background: #fff;
  color: #333;
  border-radius: 999rpx;
  padding: 10rpx 22rpx;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.2;
}
.od-btn.solid { background: #bc4749; border-color: #bc4749; color: #fff; }
.od-actions .od-btn.solid,
.od-dock .od-btn.solid { background: #fff1f0; border-color: #fff1f0; color: #bc4749; }
.od-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 40; display: flex; align-items: flex-end; }
.od-sheet { position: relative; width: 100%; background: #fff; border-radius: 32rpx 32rpx 0 0; padding: 32rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.od-sheet-title { text-align: center; font-size: calc(32rpx * var(--ui-scale)); font-weight: 650; margin-bottom: 28rpx; }
.od-x { position: absolute; right: 28rpx; top: 20rpx; color: #8a8a8a; font-size: 40rpx; }
.od-label { font-weight: 650; margin-bottom: 16rpx; }
.od-presets { display: flex; flex-wrap: wrap; gap: 16rpx; }
.od-preset, .od-date { width: 30%; background: #f5f5f5; border-radius: 16rpx; text-align: center; padding: 18rpx 0; font-size: calc(26rpx * var(--ui-scale)); box-sizing: border-box; }
.od-preset.on { background: #fff; color: #bc4749; box-shadow: inset 0 0 0 1rpx #bc4749; }
.od-range { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; }
.od-range picker { flex: 1; }
.od-date { width: auto; color: #8a8a8a; }
.od-dash { color: #bbb; }
.od-sheet-bar { display: flex; gap: 16rpx; margin-top: 36rpx; }
.od-sheet-bar .od-btn { flex: 1; text-align: center; padding: 20rpx 0; font-size: calc(30rpx * var(--ui-scale)); }
