<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="card" wx:for="{{list}}" wx:key="id">
  <view class="pad">
    <view class="row">
      <view class="title">{{tr.t(item.name, lang)}}</view>
      <view class="btn ghost" data-id="{{item.id}}" catchtap="remove">{{tr.t('删除', lang)}}</view>
    </view>
    <view class="muted">{{item.phone}}</view>
    <view class="muted" wx:if="{{item.emergencyName || item.emergencyPhone}}">{{tr.t('紧急联系人', lang)}} {{tr.t(item.emergencyName, lang)}} {{item.emergencyPhone}}</view>
  </view>
</view>
<view class="pad muted" wx:if="{{!list.length}}">{{tr.t('报名时点「存为常用」，下次可以点一下带入。', lang)}}</view>
<view class="card">
  <view class="pad">
    <view class="label">{{tr.t('姓名', lang)}}</view>
    <input class="input" placeholder="{{tr.t('称呼', lang)}}" value="{{name}}" bindinput="setName" />
    <view class="field-error" wx:if="{{errors.name}}">{{tr.t(errors.name, lang)}}</view>
    <view class="label">{{tr.t('手机号', lang)}}</view>
    <input class="input" placeholder="{{tr.t('手机号', lang)}}" type="number" maxlength="11" value="{{phone}}" bindinput="setPhone" />
    <view class="field-error" wx:if="{{errors.phone}}">{{tr.t(errors.phone, lang)}}</view>
    <view class="label">{{tr.t('紧急联系人', lang)}}</view>
    <input class="input" placeholder="{{tr.t('紧急联系人（选填）', lang)}}" value="{{emergencyName}}" bindinput="setEmergencyName" />
    <view class="label">{{tr.t('紧急联系人手机', lang)}}</view>
    <input class="input" placeholder="{{tr.t('紧急联系人手机（选填）', lang)}}" type="number" maxlength="11" value="{{emergencyPhone}}" bindinput="setEmergencyPhone" />
    <view class="btn" bindtap="save">{{tr.t('保存', lang)}}</view>
    <view class="muted" wx:if="{{msg}}">{{tr.t(msg, lang)}}</view>
  </view>
</view>
