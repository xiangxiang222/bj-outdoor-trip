<view class="notice">将跳到微信授权页，核对姓名和身份证是否与这张微信的支付实名一致。证件号仅本人可见，展示时脱敏。</view>
<view class="list">
  <view class="row"><text>昵称</text><text class="val">{{user.nickname || '未填'}}</text></view>
  <view class="row"><text>真实姓名</text><text class="val">{{user.realName || '待核验'}}</text></view>
  <view class="row"><text>性别</text><text class="val {{gender=='待补充' ? 'todo' : ''}}">{{gender}}</text></view>
  <view class="row"><text>手机</text><text class="val">{{phone || '未绑定'}}</text></view>
  <view class="row"><text>证件类型</text><text class="val">身份证</text></view>
  <view class="row"><text>证件号码</text><text class="val {{user.idCardMasked ? '' : 'todo'}}">{{user.idCardMasked || '待补充'}}</text></view>
  <view class="row"><text>核验状态</text><text class="val {{user.realNamed ? '' : 'todo'}}">{{user.realNamed ? '已通过微信实名' : '待核验'}}</text></view>
</view>
<view class="list form">
  <view class="row input-row">
    <text>真实姓名</text>
    <input placeholder="与身份证一致" value="{{realName}}" maxlength="20" bindinput="setName" />
  </view>
  <view class="row input-row">
    <text>身份证号</text>
    <input placeholder="请输入身份证号" value="{{idCard}}" maxlength="18" bindinput="setId" />
  </view>
</view>
<view class="save" bindtap="save">去微信核验</view>
