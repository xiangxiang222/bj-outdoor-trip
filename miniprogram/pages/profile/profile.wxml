<view class="pad muted">出行报名和提现需要核验身份。证件号仅本人可见，展示时脱敏。</view>
<view class="cell-group">
  <view class="cell"><text>姓名</text><text class="muted">{{user.nickname || '未填'}}</text></view>
  <view class="cell"><text>性别</text><text class="muted">{{gender}}</text></view>
  <view class="cell"><text>手机</text><text class="muted">{{phone}}</text></view>
  <view class="cell"><text>证件类型</text><text class="muted">身份证</text></view>
  <view class="cell"><text>证件号码</text><text class="muted">{{user.idCardMasked || '待补充'}}</text></view>
</view>
<view class="pad muted">身份证号</view>
<input class="input" value="{{idCard}}" maxlength="18" bindinput="setId" />
<view class="btn" bindtap="save">保存实名信息</view>
