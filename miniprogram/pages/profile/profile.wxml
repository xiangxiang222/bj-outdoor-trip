<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="notice">{{tr.t('将跳到微信授权页，核对姓名和身份证是否与这张微信的支付实名一致。证件号仅本人可见，展示时脱敏。', lang)}}</view>
<view class="list">
  <view class="row"><text>{{tr.t('昵称', lang)}}</text><text class="val">{{tr.t(user.nickname || '未填', lang)}}</text></view>
  <view class="row"><text>{{tr.t('真实姓名', lang)}}</text><text class="val">{{tr.t(user.realName || '待核验', lang)}}</text></view>
  <view class="row"><text>{{tr.t('性别', lang)}}</text><text class="val {{gender=='待补充' ? 'todo' : ''}}">{{tr.t(gender, lang)}}</text></view>
  <view class="row"><text>{{tr.t('手机', lang)}}</text><text class="val">{{tr.t(phone || '未绑定', lang)}}</text></view>
  <view class="row"><text>{{tr.t('证件类型', lang)}}</text><text class="val">{{tr.t('身份证', lang)}}</text></view>
  <view class="row"><text>{{tr.t('证件号码', lang)}}</text><text class="val {{user.idCardMasked ? '' : 'todo'}}">{{tr.t(user.idCardMasked || '待补充', lang)}}</text></view>
  <view class="row"><text>{{tr.t('核验状态', lang)}}</text><text class="val {{user.realNamed ? '' : 'todo'}}">{{tr.t(user.realNamed ? '已通过微信实名' : '待核验', lang)}}</text></view>
</view>
<view class="list form">
  <view class="row input-row">
    <text>{{tr.t('真实姓名', lang)}}</text>
    <input placeholder="{{tr.t('与身份证一致', lang)}}" value="{{realName}}" maxlength="20" bindinput="setName" />
  </view>
  <view class="row input-row">
    <text>{{tr.t('身份证号', lang)}}</text>
    <input placeholder="{{tr.t('请输入身份证号', lang)}}" value="{{idCard}}" maxlength="18" bindinput="setId" />
  </view>
</view>
<view class="save" bindtap="save">{{tr.t('去微信核验', lang)}}</view>
