<view class="notice">出行报名和提现需要核验身份。证件号仅本人可见，展示时脱敏。</view>
<view class="list">
  <view class="row"><text>姓名</text><text class="val">{{user.nickname || '未填'}}</text></view>
  <view class="row"><text>性别</text><text class="val {{gender=='待补充' ? 'todo' : ''}}">{{gender}}</text></view>
  <view class="row"><text>手机</text><text class="val">{{phone || '未绑定'}}</text></view>
  <view class="row"><text>证件类型</text><text class="val">身份证</text></view>
  <view class="row"><text>证件号码</text><text class="val {{user.idCardMasked ? '' : 'todo'}}">{{user.idCardMasked || '待补充'}}</text></view>
</view>
<view class="list form">
  <view class="row input-row">
    <text>身份证号</text>
    <input placeholder="请输入身份证号" value="{{idCard}}" maxlength="18" bindinput="setId" />
  </view>
</view>
<view class="save" bindtap="save">保存实名信息</view>
