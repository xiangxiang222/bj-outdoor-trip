@import "../../styles/account.wxss";
page { background: #f5f6f8; }
.notice { margin: 24rpx; padding: 20rpx 24rpx; background: #fff7f0; color: #8a5a2a; font-size: 24rpx; line-height: 1.5; border-radius: 16rpx; }
.list { margin: 0 24rpx 24rpx; background: #fff; border-radius: 24rpx; overflow: hidden; }
.row { display: flex; justify-content: space-between; align-items: center; padding: 32rpx; border-bottom: 1rpx solid #f0f1f3; font-size: 30rpx; }
.row:last-child { border-bottom: 0; }
.val { color: #333; }
.todo { color: #e85d4c; }
.input-row input { flex: 1; text-align: right; margin-left: 24rpx; }
.save { margin: 12rpx 24rpx; background: #ff7d1a; color: #fff; text-align: center; border-radius: 999rpx; padding: 26rpx 0; font-weight: 600; }
