<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="svc-hero">
  <image class="logo" src="/images/logo.jpg" mode="aspectFit" />
  <view class="title">{{tr.t('需要人时，先加官方微信', lang)}}</view>
  <view class="muted light">{{tr.t('账号、规则和常见问题都在这页。', lang)}}</view>
</view>
<view class="row-btns">
  <view class="btn" bindtap="copy" data-text="{{contacts.officialWechat}}" data-toast="已复制微信号">{{tr.t('复制官方微信', lang)}}</view>
  <view class="btn ghost" bindtap="copy" data-text="{{contacts.officialGroup}}" data-toast="已复制群名">{{tr.t('复制用户群名', lang)}}</view>
</view>
<view class="pad muted">{{tr.t(contacts.hint, lang)}}</view>
<view class="svc-grid">
  <view class="svc-tile" bindtap="go" data-url="/pages/feedback/feedback">{{tr.t('意见反馈', lang)}}</view>
  <view class="svc-tile" bindtap="go" data-url="/pages/student/student">{{tr.t('学生认证', lang)}}</view>
  <view class="svc-tile" bindtap="go" data-url="/pages/route-apply/route-apply">{{tr.t('申请收录线路', lang)}}</view>
  <view class="svc-tile" bindtap="jumpRules">{{tr.t('平台规则', lang)}}</view>
</view>
<view class="pad title">{{tr.t('关注我们', lang)}}</view>
<view class="follow-grid">
  <view class="follow-card" wx:for="{{accounts}}" wx:key="platform" bindtap="copy" data-text="{{item.id}}" data-toast="已复制">
    <view class="title">{{tr.t(item.platform, lang)}}</view>
    <view>{{tr.t(item.name, lang)}}</view>
    <view class="muted">{{tr.t(item.id, lang)}}</view>
    <view class="muted tiny">{{tr.t(item.remark, lang)}}</view>
  </view>
</view>
<view class="pad title">{{tr.t('常见问题', lang)}}</view>
<view class="card">
  <view class="acc {{openFaq==index?'on':''}}" wx:for="{{faqs}}" wx:key="q" bindtap="toggleFaq" data-index="{{index}}">
    <view class="row">
      <view class="title">{{tr.t(item.q, lang)}}</view>
      <text>{{tr.t(openFaq==index?'–':'+', lang)}}</text>
    </view>
    <view class="muted" wx:if="{{openFaq==index}}">{{tr.t(item.a, lang)}}</view>
  </view>
</view>
<view id="rules" class="pad title">{{tr.t(rules.title || '平台规则', lang)}}</view>
<view class="pad muted">{{tr.t(rules.summary, lang)}}</view>
<view class="card">
  <view class="acc {{openRule==index?'on':''}}" wx:for="{{rules.sections}}" wx:key="title" bindtap="toggleRule" data-index="{{index}}">
    <view class="row">
      <view class="title">{{tr.t(item.title, lang)}}</view>
      <text>{{tr.t(openRule==index?'–':'+', lang)}}</text>
    </view>
    <view wx:if="{{openRule==index}}">
      <view class="muted" wx:for="{{item.items}}" wx:for-item="line" wx:for-index="n" wx:key="n">{{tr.t(n + 1, lang)}}. {{tr.t(line, lang)}}</view>
    </view>
  </view>
</view>
