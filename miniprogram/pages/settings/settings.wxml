<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<view class="sec">{{copy.look}}</view>
<view class="list">
  <view class="row">
    <text>{{copy.textMode}}</text>
    <switch checked="{{look.textMode}}" color="#34c759" bindchange="toggleText" />
  </view>
  <view class="row" bindtap="go" data-url="/pages/look-font/look-font">
    <text>{{copy.font}}</text>
    <text class="hint">›</text>
  </view>
  <view class="row" bindtap="go" data-url="/pages/look-night/look-night">
    <text>{{copy.night}}</text>
    <text class="hint">{{nightText}} ›</text>
  </view>
  <view class="row" bindtap="go" data-url="/pages/look-lang/look-lang">
    <text>{{copy.lang}}</text>
    <text class="hint">{{langText}} ›</text>
  </view>
</view>
<view class="sec">当前账号</view>
<view class="account">
  <view class="avatar">
    <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
    <text wx:else>{{nickHead}}</text>
  </view>
  <view>
    <view class="name">{{user.nickname || '未设置昵称'}}</view>
    <view class="phone">{{phone || '未绑定手机'}}</view>
  </view>
</view>
<view class="list">
  <view class="row" bindtap="go" data-url="/pages/profile/profile">
    <text>实名信息</text>
    <text class="hint">{{user.realNamed ? '已实名' : '待完善'}} ›</text>
  </view>
  <view class="row" bindtap="go" data-url="/pages/wallet-pin/wallet-pin">
    <text>支付密码</text>
    <text class="hint">{{user.walletPinSet ? '已设置' : '未设置'}} ›</text>
  </view>
  <view class="row" bindtap="go" data-url="/pages/wallet/wallet">
    <text>我的钱包</text>
    <text class="hint">余额 ¥{{user.walletBalance || 0}} ›</text>
  </view>
</view>
<view class="list actions">
  <view class="row center" bindtap="out">退出登录</view>
  <view class="row center danger" bindtap="closeAccount">注销账号</view>
</view>
