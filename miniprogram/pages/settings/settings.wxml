<view class="cell-group">
  <view class="cell" bindtap="go" data-url="/pages/profile/profile"><text>实名信息</text><text class="muted">{{user.realNamed ? '已实名' : '待完善'}} ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/wallet-pin/wallet-pin"><text>支付密码管理</text><text class="muted">{{user.walletPinSet ? '已设置' : '未设置'}} ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/wallet-cards/wallet-cards"><text>银行卡</text><text class="muted">提现到账 ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/wallet/wallet"><text>我的钱包</text><text class="muted">余额 ¥{{user.walletBalance || 0}} ›</text></view>
</view>
<view class="btn ghost" bindtap="out">退出登录</view>
<view class="btn ghost" bindtap="closeAccount" style="color:#bc4749">注销账号</view>
