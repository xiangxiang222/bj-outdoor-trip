<view class="pad muted">把想收录的线路交给平台审。通过后会出现在「线路」里。审过且该线首次成团后奖励 ¥{{bounty}}。这和首页「发团」不是同一件事。</view>

<view class="card" wx:if="{{done}}">
  <view class="pad">
    <view style="color:#2d6a4f">{{done}}</view>
    <view class="muted">客服微信 {{contacts.officialWechat}} · {{contacts.officialWechatName}}</view>
  </view>
</view>
<view class="btn" wx:if="{{done}}" bindtap="copyWechat">{{copied ? '已复制微信号' : '复制客服微信'}}</view>

<view class="pad">线路标题</view>
<input class="input" value="{{form.title}}" placeholder="例如：慕田峪长城缆车一日" bindinput="onField" data-key="title" />
<view class="pad">副标题</view>
<input class="input" value="{{form.subtitle}}" placeholder="一句话卖点，可空" bindinput="onField" data-key="subtitle" />
<view class="pad">地区</view>
<input class="input" value="{{form.region}}" placeholder="例如：北京市 / 怀柔区" bindinput="onField" data-key="region" />
<view class="pad">天数</view>
<picker range="{{dayLabels}}" value="{{dayIndex}}" bindchange="onDays">
  <view class="input">{{dayLabels[dayIndex]}}</view>
</picker>
<view class="pad">建议成团人数</view>
<input class="input" type="number" value="{{form.minGroupSize}}" bindinput="onNumber" data-key="minGroupSize" />
<view class="pad">参考价（元 / 人）</view>
<input class="input" type="number" value="{{form.originPrice}}" bindinput="onNumber" data-key="originPrice" />
<view class="pad">封面</view>
<view class="btn ghost" bindtap="pickCover">{{form.cover ? '更换封面' : '选择封面照片'}}</view>
<image wx:if="{{form.cover}}" class="cover" src="{{form.cover}}" mode="aspectFill" />
<view class="pad">介绍</view>
<textarea class="input" value="{{form.description}}" placeholder="走哪、看什么、适合谁" bindinput="onField" data-key="description" />
<view class="pad">手机号</view>
<input class="input" type="number" maxlength="11" value="{{form.contactPhone}}" placeholder="11 位手机，方便通过后联系你" bindinput="onField" data-key="contactPhone" />
<view class="pad">微信号</view>
<input class="input" value="{{form.contactWechat}}" maxlength="32" placeholder="通过后客服加你" bindinput="onField" data-key="contactWechat" />
<button class="btn" bindtap="submit" disabled="{{loading}}">{{loading ? '提交中…' : '提交申请'}}</button>

<view class="pad title" wx:if="{{apps.length}}">我的申请</view>
<view class="card" wx:for="{{apps}}" wx:key="id">
  <view class="pad">
    <view class="row">
      <view class="title">{{item.title}}</view>
      <view class="tag">{{item.statusText}}</view>
    </view>
    <view class="muted">{{item.region}} · {{item.bountyHint}}</view>
    <view class="muted" wx:if="{{item.reviewNote}}">{{item.reviewNote}}</view>
  </view>
</view>
