<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="wishes-page {{dark ? 'is-dark' : ''}}">
  <block wx:if="{{view == 'hub'}}">
    <view class="wish-hero">
      <view class="hero-orbit" aria-hidden="true"></view>
      <view class="hero-art" aria-hidden="true"><view class="gift-shadow"></view><view class="gift-card back"></view><view class="gift-card front"><view class="gift-heart"></view><view class="gift-lines"></view></view><view class="art-spark one"></view><view class="art-spark two"></view></view>
      <view class="eyebrow">LITTLE THINGS, BIG HEART</view>
      <view class="hero-title">{{tr.t('意思意思', lang)}}<view class="title-dot"></view></view>
      <view class="hero-copy">{{tr.t('把小心意，变成小美好', lang)}}</view>
      <view class="hero-note">{{tr.t('请一杯喜欢的，陪一程想去的。', lang)}}</view>
      <button class="primary hero-button" id="wish-create" bindtap="goNew">{{tr.t('发起一个心愿', lang)}}<text class="button-arrow">→</text></button>
      <view class="hero-footnote">{{tr.t('朋友认领安排 · 也可以只送一句祝福', lang)}}</view>
    </view>

    <view class="section-title-row"><view class="section-title">{{tr.t('今天，想对谁好一点', lang)}}</view><text class="tiny-tag">{{tr.t('无需付款', lang)}}</text></view>
    <view class="template-grid">
      <button wx:for="{{categories}}" wx:key="key" class="template-card {{item.key == 'other' ? 'template-custom' : ''}}" data-kind="{{item.key}}" bindtap="goNew"><view class="category-symbol {{item.key}}" aria-hidden="true"><view></view></view><view class="template-label">{{tr.t(item.label, lang)}}</view><text class="template-note">{{tr.t(item.key == 'trip' ? '可关联真实订单' : item.key == 'other' ? '你的小美好' : '认领安排', lang)}}</text><view class="tiny-arrow" aria-hidden="true"></view></button>
    </view>
    <view class="product-note"><view class="note-heart" aria-hidden="true"></view><text>{{tr.t('日常心愿由朋友线下安排；平台不售卖奶茶、餐饮或门票。关联行程时，付款只用于真实订单团费。', lang)}}</text></view>
    <view class="section-title-row my-heading"><view class="section-title">{{tr.t('我的心意簿', lang)}}</view><view class="record-line"></view></view>
    <view class="record-tabs" role="tablist"><button class="{{tab == 'created' ? 'selected' : ''}}" role="tab" aria-selected="{{tab == 'created'}}" bindtap="setTab" data-tab="created">{{tr.t('我发起的', lang)}}</button><button class="{{tab == 'joined' ? 'selected' : ''}}" role="tab" aria-selected="{{tab == 'joined'}}" bindtap="setTab" data-tab="joined">{{tr.t('我参与的', lang)}}</button></view>
    <view class="message-box" wx:if="{{!loggedIn}}"><view class="empty-symbol" aria-hidden="true"><view></view></view><view class="empty-title">{{tr.t('登录，收好每一份心意', lang)}}</view><view class="muted">{{tr.t('发起的心愿、认领的安排和送出的祝福，都在这里。', lang)}}</view><button class="secondary" bindtap="login">{{tr.t('登录查看', lang)}}</button></view>
    <view class="message-box loading-box" wx:elif="{{refreshing && !ready}}"><load-row /> <text>{{tr.t('正在翻开心意簿…', lang)}}</text></view>
    <view class="error-box" wx:elif="{{listError && !items.length}}" role="alert"><view>{{tr.t(listError, lang)}}</view><button class="text-button" bindtap="loadHub" disabled="{{refreshing}}">{{tr.t('重新加载', lang)}}</button></view>
    <view class="message-box" wx:elif="{{!items.length}}"><view class="empty-symbol" aria-hidden="true"><view></view></view><view class="empty-title">{{tr.t(tab == 'created' ? '第一份心意，由你开启' : '美好的小事，等你加入', lang)}}</view><view class="muted">{{tr.t(tab == 'created' ? '一杯奶茶、一次见面，都值得被认真记住。' : '通过朋友分享的心愿，认领安排或送上祝福。', lang)}}</view></view>
    <view class="wish-records" wx:else>
      <button class="wish-record" wx:for="{{items}}" wx:key="token" data-token="{{item.token}}" bindtap="goWish"><view class="record-icon category-symbol {{item.kind}}" aria-hidden="true"><view></view></view><view class="record-copy"><view class="record-title">{{item.title}}</view><view class="record-meta">{{tr.t('给', lang)}} {{item.recipientName || tr.t('自己', lang)}}<text> · {{item.dateLabel}}</text></view><view class="record-state">{{tr.t(item.stateLabel, lang)}}</view></view><view class="tiny-arrow" aria-hidden="true"></view></button>
    </view>
    <view class="error-box small" wx:if="{{items.length && listError}}"><text>{{tr.t(listError, lang)}}</text><button class="text-button" bindtap="loadMore" wx:if="{{hasMore}}">{{tr.t('重试', lang)}}</button><button class="text-button" bindtap="loadHub" wx:else>{{tr.t('重试', lang)}}</button></view>
    <button class="load-more" wx:if="{{hasMore && !listError}}" bindtap="loadMore" disabled="{{loadingMore || refreshing}}">{{tr.t(loadingMore ? '加载中…' : '查看更多心意', lang)}}</button>
    <view class="subtle-error" wx:if="{{metaError}}"><text>{{tr.t(metaError, lang)}}</text><button class="text-button" bindtap="loadHub" disabled="{{refreshing}}">{{tr.t('重试', lang)}}</button></view>
  </block>

  <block wx:elif="{{view == 'new'}}">
    <view class="create-heading"><view class="eyebrow">MAKE SOMEONE SMILE</view><view class="page-title">{{tr.t('小心意，认真送', lang)}}</view><view class="muted">{{tr.t('先写下心愿，再邀请朋友认领安排。', lang)}}</view></view>
    <view class="form-card">
      <view class="field-heading">{{tr.t('这份心意关于', lang)}}</view>
      <view class="kind-options" role="radiogroup"><button wx:for="{{categories}}" wx:key="key" class="kind-option {{kind == item.key ? 'selected' : ''}}" bindtap="selectKind" data-kind="{{item.key}}" disabled="{{busy || createUncertain}}" role="radio" aria-checked="{{kind == item.key}}"><view class="category-symbol {{item.key}}" aria-hidden="true"><view></view></view><text>{{tr.t(item.label, lang)}}</text></button></view>
      <view class="form-field"><view class="field-label"><text>{{tr.t('给心愿起个名字', lang)}}</text><text class="field-count">{{title.length}}/40</text></view><input value="{{title}}" data-field="title" bindinput="onField" maxlength="40" placeholder="{{tr.t('比如：周末一起吃顿好饭', lang)}}" disabled="{{busy || createUncertain}}" aria-label="{{tr.t('心愿名称', lang)}}" /><view class="field-error" wx:if="{{errors.title}}">{{tr.t(errors.title, lang)}}</view></view>
      <view class="order-switch" wx:if="{{kind == 'trip'}}"><view><view class="field-heading">{{tr.t('关联我的行程订单', lang)}}</view><view class="small-note">{{tr.t('选填，朋友可支付这笔真实订单的团费', lang)}}</view></view><switch color="#5b3b8c" checked="{{linkOrder}}" bindchange="toggleOrder" disabled="{{busy || createUncertain}}" aria-label="{{tr.t('关联我的行程订单', lang)}}" /></view>
      <view class="order-picker" wx:if="{{kind == 'trip' && linkOrder}}">
        <view class="small-note">{{tr.t('只能选择自己的报名，收礼人由订单确定并脱敏显示。', lang)}}</view>
        <view class="loading-box" wx:if="{{ordersLoading}}"><load-row /><text>{{tr.t('正在读取行程订单…', lang)}}</text></view>
        <view class="error-box small" wx:elif="{{ordersError}}"><view>{{tr.t(ordersError, lang)}}</view><button class="text-button" bindtap="loadOrders">{{tr.t('重试', lang)}}</button></view>
        <view class="order-empty" wx:elif="{{ordersReady && !orders.length}}">{{tr.t('暂无可关联的行程订单，关闭关联也能发起免费心愿。', lang)}}</view>
        <block wx:else><button wx:for="{{orders}}" wx:key="enrollmentId" class="order-choice {{selectedOrder.enrollmentId == item.enrollmentId ? 'selected' : ''}}" data-id="{{item.enrollmentId}}" bindtap="selectOrder" disabled="{{busy || createUncertain}}" role="radio" aria-checked="{{selectedOrder.enrollmentId == item.enrollmentId}}"><view class="choice-radio"></view><view class="choice-copy"><view class="choice-title">{{item.title}}</view><view class="small-note">{{item.dateLabel}}<text> · {{item.recipientName || tr.t('自己', lang)}}</text></view><view class="choice-price">{{tr.t('待付团费', lang)}} ¥{{item.remaining}}</view></view></button></block>
        <view class="field-error" wx:if="{{errors.enrollmentId}}">{{tr.t(errors.enrollmentId, lang)}}</view>
      </view>
      <view class="form-field"><view class="field-label"><text>{{tr.t('送给谁', lang)}}</text><text class="field-count" wx:if="{{!linkOrder}}">{{recipientName.length}}/20</text><text class="tiny-tag" wx:else>{{tr.t('来自真实订单', lang)}}</text></view><view class="recipient-fixed" wx:if="{{linkOrder}}">{{selectedOrder ? selectedOrder.recipientName : tr.t('选择行程后显示收礼人', lang)}}</view><input wx:else value="{{recipientName}}" data-field="recipientName" bindinput="onField" maxlength="20" placeholder="{{tr.t('选填，留空送给自己', lang)}}" disabled="{{busy || createUncertain}}" aria-label="{{tr.t('收礼人的称呼', lang)}}" /><view class="field-error" wx:if="{{errors.recipientName}}">{{tr.t(errors.recipientName, lang)}}</view></view>
      <view class="form-field note-field"><view class="field-label"><text>{{tr.t('想对你说', lang)}}</text><text class="field-count">{{tr.t('选填', lang)}} · {{note.length}}/240</text></view><textarea value="{{note}}" data-field="note" bindinput="onField" maxlength="240" auto-height placeholder="{{tr.t('为什么想到这份心意？写一句你想说的话。', lang)}}" disabled="{{busy || createUncertain}}" aria-label="{{tr.t('想对你说', lang)}}" /><view class="field-error" wx:if="{{errors.note}}">{{tr.t(errors.note, lang)}}</view></view>
    </view>
    <view class="create-summary"><view class="small-seal" aria-hidden="true"></view><view><view class="summary-title">{{tr.t(linkOrder ? '心意，只用于这笔团费' : '认领安排，无需付款', lang)}}</view><view class="small-note">{{tr.t(linkOrder ? '沿用现有行程的代付与分摊，付款记录和退款在原订单查看。' : '朋友认领后，你们自行约定时间与方式；不会产生收款或平台订单。', lang)}}</view></view></view>
    <view class="error-box" wx:if="{{actionError}}" role="alert">{{tr.t(actionError, lang)}}</view>
    <button class="primary submit-button" id="wish-submit" bindtap="submitWish" disabled="{{busy}}" loading="{{busy}}">{{tr.t(busy ? '正在送出…' : createUncertain ? '确认上次提交结果' : '写好啦，发起心愿', lang)}}<text class="button-arrow" wx:if="{{!busy}}">→</text></button>
    <view class="bottom-note">{{tr.t('创建后可分享给朋友，个人称呼和留言会展示在分享页，请勿填写证件或联系方式。', lang)}}</view>
  </block>

  <block wx:else>
    <view class="message-box loading-box detail-loading" wx:if="{{!ready}}"><load-row /><text>{{tr.t('正在打开这份心意…', lang)}}</text></view>
    <view class="error-box" wx:elif="{{error && !wish}}" role="alert"><view class="empty-title">{{tr.t('这份心意暂时无法打开', lang)}}</view><view>{{tr.t(error, lang)}}</view><button class="secondary" bindtap="loadWish" disabled="{{refreshing}}">{{tr.t('重新加载', lang)}}</button></view>
    <block wx:elif="{{wish}}">
      <view class="wish-letter" id="wish-detail"><view class="letter-top"><view class="eyebrow">A LITTLE SOMETHING FOR YOU</view><view class="state-tag {{wish.status == 'closed' ? 'closed' : ''}}">{{tr.t(wish.stateLabel, lang)}}</view></view><view class="letter-symbol category-symbol {{wish.kind}}" aria-hidden="true"><view></view></view><view class="letter-to">{{tr.t('送给', lang)}} {{wish.recipientName || tr.t('自己', lang)}}</view><view class="letter-title">{{wish.title}}</view><view class="letter-message" wx:if="{{wish.note}}">{{wish.note}}</view><view class="letter-signature"><view class="signature-line"></view><view>{{tr.t('来自', lang)}} {{wish.ownerName}}<text>{{wish.dateLabel}}</text></view></view><view class="letter-perforation" aria-hidden="true"></view><view class="letter-foot"><view class="tiny-heart" aria-hidden="true"></view><text>{{tr.t(wish.order ? '心意陪你，去往下一程' : '有人惦记，就是一件好事', lang)}}</text></view></view>
      <view class="error-box small" wx:if="{{error}}"><text>{{tr.t(error, lang)}}</text><button class="text-button" bindtap="loadWish" disabled="{{refreshing || busy}}">{{tr.t('重试', lang)}}</button></view>
      <view class="feedback-box" wx:if="{{feedback}}" role="status">{{tr.t(feedback, lang)}}</view>
      <view class="error-box small" wx:if="{{actionError}}" role="alert">{{tr.t(actionError, lang)}}</view>

      <view class="arrange-card" wx:if="{{!wish.order}}"><view class="section-title-row"><view class="section-title">{{tr.t('一份心意，如何发生', lang)}}</view><text class="tiny-tag">{{tr.t('无需付款', lang)}}</text></view><view class="arrange-steps"><view class="arrange-step reached"><view class="step-point">1</view><text>{{tr.t('写下心愿', lang)}}</text></view><view class="step-connector"></view><view class="arrange-step {{wish.claimStatus ? 'reached' : ''}}"><view class="step-point">2</view><text>{{tr.t('朋友认领', lang)}}</text></view><view class="step-connector"></view><view class="arrange-step {{wish.claimStatus == 'completed' ? 'reached' : ''}}"><view class="step-point">3</view><text>{{tr.t('安排完成', lang)}}</text></view></view><view class="claim-message" wx:if="{{wish.claimedByName}}"><text class="claim-mark">✓</text><view><view class="claim-name">{{wish.claimedByName}}</view><text>{{tr.t(wish.claimStatus == 'completed' ? '已经安排好这份心意' : '认领了这份心意，正在安排', lang)}}</text></view></view><view class="small-note" wx:elif="{{wish.status != 'closed'}}">{{tr.t('每份心愿由一位朋友认领，具体安排由你们自行约定。', lang)}}</view><view class="closed-note" wx:if="{{wish.status == 'closed'}}">{{tr.t('心愿已关闭，已有心意仍被好好保留。', lang)}}</view><button class="primary" wx:if="{{!loggedIn && wish.status == 'open' && !wish.claimStatus}}" bindtap="login">{{tr.t('登录，认领这份心意', lang)}}<text class="button-arrow">→</text></button><button class="primary" id="wish-claim" wx:if="{{wish.canClaim}}" bindtap="claimWish" disabled="{{busy || refreshing}}">{{tr.t('这份心意，我来安排', lang)}}<text class="button-arrow">→</text></button><button class="primary" wx:if="{{wish.canComplete}}" bindtap="completeWish" disabled="{{busy || refreshing}}">{{tr.t('已经安排好啦', lang)}}</button><button class="text-button release-button" wx:if="{{wish.canRelease}}" bindtap="releaseClaim" disabled="{{busy || refreshing}}">{{tr.t('暂时安排不了，归还心愿', lang)}}</button><view class="small-note owner-note" wx:if="{{wish.isOwner && wish.status == 'open' && !wish.claimStatus}}">{{tr.t('分享给朋友，等一个「我来安排」。', lang)}}</view></view>

      <view class="linked-order" wx:else><view class="section-title-row"><view class="section-title">{{tr.t('这份心意，陪你出发', lang)}}</view><text class="tiny-tag">{{tr.t('真实订单', lang)}}</text></view><view class="order-route"><view class="route-symbol" aria-hidden="true"></view><view><view class="choice-title">{{wish.order.title}}</view><view class="small-note">{{wish.order.dateLabel}}</view></view></view><view class="order-amounts"><view><text>{{tr.t('订单团费', lang)}}</text><view>¥{{wish.order.total}}</view></view><view><text>{{tr.t('已支付', lang)}}</text><view>¥{{wish.order.paid}}</view></view><view><text>{{tr.t('还需支付', lang)}}</text><view class="purple">¥{{wish.order.remaining}}</view></view></view><view class="payment-progress"><view style="width:{{wish.order.progress}}%"></view></view><view class="order-status-note" wx:if="{{wish.order.payStatus == 'paid'}}">{{tr.t('团费已付清，出发安排与履约状态请查看原行程。', lang)}}</view><view class="order-status-note" wx:elif="{{wish.order.payStatus == 'refunded'}}">{{tr.t('该订单已退款，退款记录请在原订单查看。', lang)}}</view><view class="order-status-note" wx:elif="{{wish.order.cancelled}}">{{tr.t('报名已取消，退款进度请在原订单查看。', lang)}}</view><view class="order-status-note" wx:elif="{{!loggedIn && wish.status == 'open' && wish.order.canPay}}">{{tr.t('登录后，可帮付这笔订单的剩余团费。', lang)}}</view><view class="order-status-note" wx:elif="{{!wish.canPay}}">{{tr.t(wish.status == 'closed' ? '心愿已关闭，本页不再接受付款；原订单仍按原规则处理。' : '当前订单暂不可付款，请以原订单状态为准。', lang)}}</view><button class="secondary" wx:if="{{!loggedIn && wish.status == 'open' && wish.order.canPay}}" bindtap="login">{{tr.t('登录，帮付这笔团费', lang)}}</button><button class="primary" id="wish-payment" wx:if="{{wish.canPay}}" bindtap="goPayment" disabled="{{busy || refreshing}}" loading="{{busy}}">{{tr.t('送一份心意，帮付团费', lang)}}<text class="button-arrow">→</text></button><view class="small-note payment-note">{{tr.t('仅支付当前真实报名订单的团费，可代付或分摊；没有个人余额、提现或额外收款。', lang)}}</view></view>

      <view class="blessings-card"><view class="section-title-row"><view class="section-title">{{tr.t('心意留言', lang)}}</view><view class="blessing-flower" aria-hidden="true">✳</view></view><view class="small-note">{{tr.t('不必认领，也可以认真说一句祝福。', lang)}}</view><view class="blessing-form" wx:if="{{wish.canBless}}"><textarea maxlength="80" auto-height value="{{blessing}}" bindinput="onBlessing" placeholder="{{tr.t('愿你被小小的美好包围。', lang)}}" disabled="{{busy || blessUncertain}}" aria-label="{{tr.t('写一句祝福', lang)}}" /><view class="blessing-send"><text class="field-count">{{blessing.length}}/80</text><button class="secondary" id="wish-bless" bindtap="sendBlessing" disabled="{{busy || refreshing}}">{{tr.t(blessUncertain ? '确认发送结果' : '送上祝福', lang)}}</button></view></view><button class="login-note" wx:elif="{{!loggedIn && wish.status == 'open'}}" bindtap="login">{{tr.t('登录后，送上你的祝福', lang)}}<text>→</text></button><view class="already-note" wx:elif="{{wish.alreadyBlessed}}">{{tr.t('你的祝福已留在这里，谢谢这份心意。', lang)}}</view><view class="blessing-list" wx:if="{{wish.blessings.length}}"><view class="blessing-row" wx:for="{{wish.blessings}}" wx:key="id"><view class="blessing-avatar" aria-hidden="true"><view class="tiny-heart"></view></view><view class="blessing-body"><view class="blessing-meta"><text>{{item.nickname}}<text class="self-tag" wx:if="{{item.self}}">{{tr.t('我', lang)}}</text></text><text>{{item.dateLabel}}</text></view><view class="blessing-message">{{item.message}}</view></view></view></view><view class="blessing-empty" wx:else>{{tr.t('心愿在这里，等一句温柔的回应。', lang)}}</view></view>

      <view class="detail-actions"><button class="primary share-button" open-type="share">{{tr.t(wish.isOwner ? '把心愿分享给朋友' : '分享这份小美好', lang)}}<view class="share-symbol" aria-hidden="true"></view></button><button class="text-button close-button" wx:if="{{wish.canClose}}" bindtap="closeWish" disabled="{{busy || refreshing}}">{{tr.t('关闭心愿', lang)}}</button></view><button class="hub-link" bindtap="goHub">{{tr.t('我也想发起一份心意', lang)}}<text>→</text></button><view class="bottom-note">{{tr.t('心愿是朋友之间的邀约。日常安排由双方约定，平台不售卖相关商品或票券。', lang)}}</view>
    </block>
  </block>
</view>
