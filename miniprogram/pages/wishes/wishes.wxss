.wishes-page{--purple:#5b3b8c;--ink:#29262f;--muted:#928b9f;--paper:#fff;--base:#f7f5fa;--line:#eee9f4;--lavender:#f0eaf8;--soft-purple:#a88bc9;--error:#a84351;min-height:100vh;box-sizing:border-box;padding:28rpx 28rpx calc(50rpx + env(safe-area-inset-bottom));background:var(--base);color:var(--ink);font-size:calc(27rpx * var(--ui-scale,1));line-height:1.6;overflow-wrap:break-word}
.wishes-page.is-dark{--purple:#c8b2e9;--ink:#f0ebf6;--muted:#b3a9bf;--paper:#28242f;--base:#1e1b24;--line:#3c3447;--lavender:#372b45;--soft-purple:#9c82bd;--error:#f1a5ac}
.wishes-page view,.wishes-page text,.wishes-page button{box-sizing:border-box}
.wishes-page button{margin:0;min-width:0;max-width:100%;padding:0;background:none;border:0;border-radius:0;line-height:1.5;font-size:inherit;color:inherit;text-align:left;white-space:normal;word-break:normal;overflow-wrap:anywhere}
.wishes-page button::after{border:0}
.wishes-page button[disabled]{opacity:.58}
.wishes-page .primary{display:flex;align-items:center;justify-content:center;gap:16rpx;width:100%;min-height:94rpx;padding:22rpx 30rpx;border-radius:25rpx;background:#5b3b8c;color:#fff;font-size:calc(29rpx * var(--ui-scale,1));font-weight:600;text-align:center;letter-spacing:.5rpx}
.wishes-page .primary .button-arrow{margin-left:auto;font-size:36rpx;font-weight:400;flex:none;line-height:1}
.wishes-page .secondary{display:inline-flex;align-items:center;justify-content:center;min-height:68rpx;padding:14rpx 28rpx;border-radius:18rpx;border:1rpx solid var(--line);background:var(--paper);color:var(--purple);font-weight:600;text-align:center}
.wishes-page .text-button{padding:12rpx 4rpx;color:var(--purple);text-align:center;font-size:calc(25rpx * var(--ui-scale,1))}
.eyebrow{font-size:calc(17rpx * var(--ui-scale,1));font-weight:600;letter-spacing:3rpx;color:var(--soft-purple);line-height:1.7}
.muted,.small-note{font-size:calc(24rpx * var(--ui-scale,1));color:var(--muted);line-height:1.7}
.small-note{font-size:calc(22rpx * var(--ui-scale,1))}
.wish-hero{position:relative;margin:-28rpx -28rpx 38rpx;padding:66rpx 42rpx 32rpx;overflow:hidden;background:linear-gradient(135deg,#f1eafb 0%,#f8f4fa 63%,#f7f5fa 100%)}
.is-dark .wish-hero{background:linear-gradient(135deg,#3c2c50,#28212f 63%,var(--base))}
.hero-orbit{position:absolute;width:470rpx;height:470rpx;right:-190rpx;top:-80rpx;border:1rpx solid rgba(140,111,181,.13);border-radius:50%;box-shadow:0 0 0 30rpx rgba(140,111,181,.035),0 0 0 65rpx rgba(140,111,181,.025)}
.hero-title{position:relative;display:flex;align-items:center;gap:10rpx;width:70%;margin:14rpx 0 12rpx;font-size:calc(61rpx * var(--ui-scale,1));font-weight:700;letter-spacing:3rpx;line-height:1.3;color:var(--purple)}
.title-dot{flex:none;width:10rpx;height:10rpx;margin-top:35rpx;border-radius:50%;background:#c1a2e4}
.hero-copy{position:relative;font-weight:600;font-size:calc(29rpx * var(--ui-scale,1));width:65%}
.hero-note{position:relative;width:65%;margin-top:9rpx;font-size:calc(23rpx * var(--ui-scale,1));color:var(--muted)}
.wishes-page .hero-button{position:relative;min-height:86rpx;margin-top:42rpx;border-radius:22rpx}
.hero-footnote{margin-top:17rpx;text-align:center;color:var(--muted);font-size:calc(20rpx * var(--ui-scale,1))}
.hero-art{position:absolute;right:19rpx;top:102rpx;width:200rpx;height:195rpx;transform:rotate(7deg)}
.gift-card{position:absolute;width:129rpx;height:157rpx;border-radius:15rpx}
.gift-card.back{top:7rpx;left:18rpx;background:#dbccec;transform:rotate(-17deg)}
.gift-card.front{top:13rpx;left:47rpx;background:linear-gradient(140deg,#fff,#f6f1fc);border:2rpx solid #dcc9f0;box-shadow:0 14rpx 35rpx rgba(89,59,137,.08);transform:rotate(8deg)}
.is-dark .gift-card.front{background:linear-gradient(140deg,#5b476f,#3c2f4c);border-color:#806499}
.is-dark .gift-card.back{background:#5d4279}
.gift-heart,.tiny-heart{position:absolute;width:36rpx;height:32rpx;background:#9676be;transform:rotate(-45deg);border-radius:5rpx;top:48rpx;left:44rpx}
.gift-heart::before,.gift-heart::after,.tiny-heart::before,.tiny-heart::after{content:"";position:absolute;width:100%;height:100%;background:inherit;border-radius:50%}
.gift-heart::before,.tiny-heart::before{top:-50%;left:0}
.gift-heart::after,.tiny-heart::after{left:50%;top:0}
.gift-lines{position:absolute;width:52rpx;height:4rpx;background:#d6c4e9;left:27rpx;bottom:30rpx;box-shadow:0 12rpx 0 #e4d9ef}
.gift-shadow{position:absolute;width:150rpx;height:15rpx;border-radius:50%;background:rgba(104,70,150,.08);bottom:3rpx;left:30rpx;filter:blur(5rpx)}
.art-spark{position:absolute;width:8rpx;height:8rpx;background:#bda1db;transform:rotate(45deg)}
.art-spark.one{top:0;right:20rpx}.art-spark.two{bottom:40rpx;left:8rpx;width:6rpx;height:6rpx}
.section-title-row{display:flex;align-items:center;justify-content:space-between;gap:18rpx;margin-bottom:22rpx}
.section-title{min-width:0;font-size:calc(31rpx * var(--ui-scale,1));font-weight:600;line-height:1.5}
.tiny-tag{flex:none;border:1rpx solid var(--line);border-radius:20rpx;padding:3rpx 14rpx;font-size:calc(20rpx * var(--ui-scale,1));font-weight:400;color:var(--purple);line-height:1.6;background:var(--paper)}
.template-grid{display:flex;gap:16rpx;flex-wrap:wrap}
.wishes-page .template-card{position:relative;flex:0 0 calc((100% - 32rpx)/3);min-width:0;min-height:188rpx;padding:25rpx 18rpx;background:var(--paper);border-radius:25rpx;border:1rpx solid rgba(145,118,180,.05)}
.wishes-page .template-custom{flex-basis:100%;min-height:90rpx;display:flex;align-items:center;gap:17rpx;padding:17rpx 24rpx}
.template-label{font-size:calc(24rpx * var(--ui-scale,1));font-weight:600;line-height:1.5;margin-top:21rpx}
.template-note{display:block;margin-top:5rpx;font-size:calc(19rpx * var(--ui-scale,1));color:var(--muted);line-height:1.5}
.template-custom .template-label{margin:0}.template-custom .template-note{margin:0 0 0 auto}.template-custom .tiny-arrow{margin-left:12rpx}
.tiny-arrow{flex:none;width:12rpx;height:12rpx;border-top:2rpx solid var(--soft-purple);border-right:2rpx solid var(--soft-purple);transform:rotate(45deg)}
.category-symbol{position:relative;width:44rpx;height:42rpx;color:var(--purple);flex:none}
.category-symbol::before,.category-symbol::after,.category-symbol>view,.category-symbol>view::before,.category-symbol>view::after{position:absolute;box-sizing:border-box;content:""}
.category-symbol.drink::before{width:29rpx;height:27rpx;bottom:1rpx;left:3rpx;border:2rpx solid currentColor;border-radius:3rpx 3rpx 10rpx 10rpx}
.category-symbol.drink::after{width:12rpx;height:15rpx;bottom:10rpx;left:30rpx;border:2rpx solid currentColor;border-left:0;border-radius:0 8rpx 8rpx 0}
.category-symbol.drink>view{left:10rpx;top:0;height:9rpx;width:2rpx;background:currentColor;box-shadow:10rpx 0 0 currentColor}
.category-symbol.meal::before{width:16rpx;height:36rpx;top:3rpx;left:3rpx;border:2rpx solid currentColor;border-top:0;border-radius:0 0 7rpx 7rpx}
.category-symbol.meal::after{width:2rpx;height:25rpx;left:10rpx;bottom:-2rpx;background:currentColor}
.category-symbol.meal>view{width:2rpx;height:15rpx;top:3rpx;left:10rpx;background:currentColor}
.category-symbol.meal>view::before{height:25rpx;width:12rpx;left:20rpx;top:0;border:2rpx solid currentColor;border-radius:12rpx}
.category-symbol.meal>view::after{height:18rpx;width:2rpx;left:25rpx;top:22rpx;background:currentColor}
.category-symbol.outing::before{width:29rpx;height:29rpx;left:2rpx;top:11rpx;border-left:2rpx solid currentColor;border-top:2rpx solid currentColor;transform:rotate(45deg)}
.category-symbol.outing::after{width:18rpx;height:18rpx;left:22rpx;top:20rpx;border-top:2rpx solid currentColor;border-right:2rpx solid currentColor;transform:rotate(-45deg)}
.category-symbol.show::before{width:42rpx;height:30rpx;top:8rpx;left:0;border:2rpx solid currentColor;border-radius:5rpx;transform:rotate(-9deg)}
.category-symbol.show::after{height:26rpx;top:9rpx;left:29rpx;border-left:2rpx dashed currentColor;transform:rotate(-9deg)}
.category-symbol.show>view{width:6rpx;height:6rpx;border:1.5rpx solid currentColor;transform:rotate(45deg);left:12rpx;top:18rpx}
.category-symbol.transport::before{width:32rpx;height:34rpx;top:0;left:6rpx;border:2rpx solid currentColor;border-radius:9rpx 9rpx 6rpx 6rpx}
.category-symbol.transport::after{height:11rpx;width:20rpx;border-top:2rpx solid currentColor;border-bottom:2rpx solid currentColor;left:12rpx;top:8rpx}
.category-symbol.transport>view{width:3rpx;height:3rpx;border-radius:50%;background:currentColor;left:12rpx;top:26rpx;box-shadow:17rpx 0 0 currentColor}
.category-symbol.transport>view::before{width:5rpx;height:10rpx;border-left:2rpx solid currentColor;left:0;top:5rpx;transform:rotate(30deg)}
.category-symbol.transport>view::after{width:5rpx;height:10rpx;border-right:2rpx solid currentColor;left:15rpx;top:5rpx;transform:rotate(-30deg)}
.category-symbol.trip::before{width:38rpx;height:29rpx;bottom:0;left:2rpx;border:2rpx solid currentColor;border-radius:5rpx}
.category-symbol.trip::after{width:17rpx;height:10rpx;left:12rpx;top:2rpx;border:2rpx solid currentColor;border-bottom:0;border-radius:5rpx 5rpx 0 0}
.category-symbol.trip>view{height:25rpx;width:2rpx;background:currentColor;bottom:2rpx;left:12rpx;box-shadow:17rpx 0 0 currentColor;opacity:.65}
.category-symbol.other::before{width:33rpx;height:33rpx;left:5rpx;top:4rpx;border:2rpx solid currentColor;border-radius:50%}
.category-symbol.other::after{width:15rpx;height:2rpx;left:14rpx;top:20rpx;background:currentColor}
.category-symbol.other>view{height:15rpx;width:2rpx;left:20rpx;top:14rpx;background:currentColor}
.product-note{display:flex;align-items:flex-start;gap:15rpx;padding:23rpx 4rpx 0;font-size:calc(20rpx * var(--ui-scale,1));color:var(--muted);line-height:1.75}
.note-heart{width:16rpx;height:16rpx;border:1.5rpx solid #b39acb;transform:rotate(45deg);border-radius:4rpx;flex:none;margin:8rpx 3rpx 0}
.my-heading{margin-top:43rpx}.record-line{flex:1;height:1rpx;background:var(--line);margin-left:15rpx}
.record-tabs{display:flex;gap:33rpx;border-bottom:1rpx solid var(--line);margin-bottom:20rpx}
.wishes-page .record-tabs button{padding:5rpx 0 19rpx;position:relative;color:var(--muted);font-weight:500}
.wishes-page .record-tabs button.selected{color:var(--purple);font-weight:600}
.record-tabs .selected::before{content:"";position:absolute;height:4rpx;width:34rpx;border-radius:4rpx;background:var(--purple);bottom:-1rpx;left:50%;transform:translateX(-50%)}
.message-box{padding:35rpx 25rpx;text-align:center;background:var(--paper);border-radius:26rpx}
.message-box .secondary{margin-top:24rpx}.empty-title{font-size:calc(28rpx * var(--ui-scale,1));font-weight:600;margin-bottom:11rpx}
.empty-symbol{position:relative;width:68rpx;height:60rpx;margin:0 auto 22rpx;border:2rpx solid var(--soft-purple);border-radius:10rpx;transform:rotate(-5deg);opacity:.7}
.empty-symbol::before{content:"";position:absolute;width:28rpx;height:28rpx;top:5rpx;left:17rpx;border-right:1.5rpx solid var(--soft-purple);border-bottom:1.5rpx solid var(--soft-purple);transform:rotate(45deg)}
.empty-symbol>view{position:absolute;width:20rpx;height:3rpx;background:var(--soft-purple);left:11rpx;bottom:11rpx;opacity:.6}
.loading-box{display:flex;align-items:center;justify-content:center;gap:15rpx;padding:30rpx 0;color:var(--muted);font-size:calc(24rpx * var(--ui-scale,1))}
.error-box{padding:24rpx;margin:20rpx 0;border-radius:20rpx;border:1rpx solid var(--line);background:var(--paper);color:var(--error);font-size:calc(24rpx * var(--ui-scale,1));line-height:1.7;overflow-wrap:anywhere}
.error-box.small{padding:17rpx 22rpx}.error-box .secondary{margin-top:20rpx}.error-box .text-button{display:inline-block;margin-left:14rpx}
.subtle-error{display:flex;align-items:center;justify-content:center;gap:15rpx;margin-top:18rpx;font-size:calc(22rpx * var(--ui-scale,1));color:var(--muted)}
.wish-records{display:flex;flex-direction:column;gap:16rpx}
.wishes-page .wish-record{width:100%;display:flex;align-items:center;gap:24rpx;padding:25rpx;background:var(--paper);border-radius:24rpx}
.record-icon{transform:scale(.85)}.record-copy{flex:1;min-width:0}.record-title{font-size:calc(27rpx * var(--ui-scale,1));font-weight:600;line-height:1.5}
.record-meta{font-size:calc(21rpx * var(--ui-scale,1));color:var(--muted);margin-top:7rpx}.record-meta>text{color:var(--muted)}.record-state{display:inline-block;margin-top:12rpx;font-size:calc(20rpx * var(--ui-scale,1));color:var(--purple)}
.wishes-page .load-more{padding:25rpx 10rpx;text-align:center;width:100%;color:var(--purple);font-size:calc(24rpx * var(--ui-scale,1))}
.create-heading{padding:29rpx 6rpx 34rpx}.page-title{font-weight:600;font-size:calc(46rpx * var(--ui-scale,1));margin:13rpx 0 12rpx;line-height:1.4;letter-spacing:1rpx}
.form-card{background:var(--paper);padding:30rpx 28rpx;border-radius:30rpx}.field-heading{font-size:calc(27rpx * var(--ui-scale,1));font-weight:600}
.kind-options{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0 10rpx}
.wishes-page .kind-option{display:flex;flex:0 0 calc((100% - 24rpx)/3);align-items:center;flex-direction:column;gap:13rpx;text-align:center;padding:18rpx 8rpx 16rpx;border:1rpx solid var(--line);border-radius:20rpx;color:var(--muted);font-size:calc(21rpx * var(--ui-scale,1));line-height:1.5}
.kind-option .category-symbol{transform:scale(.78)}.wishes-page .kind-option.selected{background:var(--lavender);color:var(--purple);border-color:var(--soft-purple)}
.form-field{padding-top:29rpx;margin-top:6rpx;border-top:1rpx solid var(--line)}.kind-options+.form-field{margin-top:28rpx}
.field-label{display:flex;align-items:center;justify-content:space-between;gap:15rpx;font-weight:600;font-size:calc(26rpx * var(--ui-scale,1));margin-bottom:14rpx}.field-count{color:var(--muted);font-size:calc(20rpx * var(--ui-scale,1));font-weight:400;flex:none}
.wishes-page input{display:block;min-height:72rpx;width:100%;font-size:calc(26rpx * var(--ui-scale,1));line-height:1.6;background:var(--base);border-radius:16rpx;padding:15rpx 18rpx;color:var(--ink);box-sizing:border-box}
.wishes-page textarea{display:block;width:100%;font-size:calc(26rpx * var(--ui-scale,1));line-height:1.75;min-height:150rpx;padding:20rpx 18rpx;box-sizing:border-box;border-radius:17rpx;background:var(--base);color:var(--ink)}
.field-error{margin-top:12rpx;color:var(--error);font-size:calc(22rpx * var(--ui-scale,1))}.form-field{padding-bottom:26rpx}.note-field{padding-bottom:0}
.order-switch{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:20rpx 0 26rpx}.order-switch>view{flex:1;min-width:0}.order-switch switch{flex:none;transform:scale(.8);transform-origin:right center}.order-switch .small-note{margin-top:8rpx}
.order-picker{margin-bottom:26rpx;padding:20rpx 20rpx 0;background:var(--base);border-radius:19rpx}.order-empty{padding:20rpx 0 24rpx;font-size:calc(23rpx * var(--ui-scale,1));color:var(--muted)}
.wishes-page .order-choice{display:flex;gap:16rpx;align-items:flex-start;margin-top:17rpx;padding:20rpx 0;border-top:1rpx solid var(--line);width:100%}.choice-radio{flex:none;height:27rpx;width:27rpx;border:1.5rpx solid var(--soft-purple);border-radius:50%;margin-top:5rpx}.order-choice.selected .choice-radio{border:7rpx solid var(--purple);background:var(--paper)}
.choice-copy{min-width:0;flex:1}.choice-title{font-size:calc(27rpx * var(--ui-scale,1));font-weight:600;line-height:1.5}.choice-price{color:var(--purple);font-size:calc(23rpx * var(--ui-scale,1));margin-top:12rpx}.recipient-fixed{padding:17rpx 18rpx;min-height:73rpx;border-radius:16rpx;background:var(--base);color:var(--purple);font-size:calc(25rpx * var(--ui-scale,1))}
.create-summary{display:flex;gap:20rpx;align-items:flex-start;padding:30rpx 9rpx}.summary-title{font-size:calc(25rpx * var(--ui-scale,1));font-weight:600;margin-bottom:8rpx}.small-seal{width:30rpx;height:34rpx;border:1.5rpx solid var(--soft-purple);border-radius:12rpx 12rpx 18rpx 18rpx;margin-top:4rpx;flex:none;position:relative}.small-seal::before{content:"";position:absolute;width:13rpx;height:7rpx;border-left:2rpx solid var(--soft-purple);border-bottom:2rpx solid var(--soft-purple);transform:rotate(-45deg);left:7rpx;top:10rpx}
.bottom-note{font-size:calc(20rpx * var(--ui-scale,1));line-height:1.85;color:var(--muted);padding:20rpx 10rpx;text-align:center}.submit-button{margin-top:0}
.detail-loading{min-height:420rpx}.wish-letter{position:relative;padding:34rpx 34rpx 0;border-radius:30rpx;background:linear-gradient(145deg,#f1e9fb 0%,#fff 70%);border:1rpx solid rgba(163,130,198,.15);overflow:hidden}
.is-dark .wish-letter{background:linear-gradient(145deg,#433151,var(--paper) 70%)}
.letter-top{display:flex;align-items:flex-start;gap:15rpx;justify-content:space-between}.letter-top .eyebrow{max-width:65%;font-size:calc(14rpx * var(--ui-scale,1));letter-spacing:2rpx}.state-tag{font-size:calc(20rpx * var(--ui-scale,1));padding:4rpx 13rpx;border-radius:14rpx;background:rgba(142,104,180,.09);color:var(--purple);max-width:45%;text-align:center}.state-tag.closed{color:var(--muted)}
.letter-symbol{margin:40rpx auto 31rpx;transform:scale(1.4);color:var(--purple)}.letter-to{text-align:center;color:var(--purple);font-size:calc(25rpx * var(--ui-scale,1));margin-top:9rpx}.letter-title{font-size:calc(42rpx * var(--ui-scale,1));font-weight:600;letter-spacing:1rpx;line-height:1.5;text-align:center;margin:17rpx 0 22rpx;word-break:break-word}.letter-message{text-align:center;white-space:pre-wrap;font-size:calc(26rpx * var(--ui-scale,1));line-height:1.9;color:var(--muted);padding:0 5rpx;overflow-wrap:anywhere}
.letter-signature{display:flex;justify-content:flex-end;align-items:flex-start;gap:14rpx;margin:37rpx 0 28rpx;color:var(--muted);font-size:calc(22rpx * var(--ui-scale,1))}.signature-line{width:31rpx;height:1rpx;background:var(--soft-purple);margin-top:19rpx}.letter-signature>view:last-child{max-width:80%;text-align:right}.letter-signature text{display:block;font-size:calc(18rpx * var(--ui-scale,1));margin-top:6rpx;color:var(--soft-purple)}
.letter-perforation{position:relative;border-top:2rpx dashed var(--line);margin:0 -34rpx}.letter-perforation::before,.letter-perforation::after{content:"";position:absolute;width:28rpx;height:28rpx;border-radius:50%;top:-15rpx;background:var(--base);border:1rpx solid var(--line)}.letter-perforation::before{left:-15rpx}.letter-perforation::after{right:-15rpx}.letter-foot{display:flex;align-items:center;justify-content:center;gap:19rpx;padding:22rpx 0;color:var(--soft-purple);font-size:calc(20rpx * var(--ui-scale,1))}
.tiny-heart{position:relative;width:10rpx;height:10rpx;top:auto;left:auto;flex:none;border-radius:1rpx;background:var(--soft-purple);margin-right:4rpx}.letter-foot .tiny-heart{transform:rotate(-45deg) scale(.9)}
.arrange-card,.linked-order,.blessings-card{background:var(--paper);border-radius:28rpx;padding:29rpx 27rpx;margin-top:22rpx}.arrange-card .section-title,.linked-order .section-title,.blessings-card .section-title{font-size:calc(28rpx * var(--ui-scale,1))}.arrange-card .primary,.linked-order .primary{margin-top:25rpx;min-height:85rpx;font-size:calc(27rpx * var(--ui-scale,1));border-radius:20rpx}.arrange-steps{display:flex;align-items:flex-start;padding:12rpx 0 30rpx;gap:7rpx}.arrange-step{flex:1;min-width:0;text-align:center;font-size:calc(21rpx * var(--ui-scale,1));color:var(--muted);line-height:1.5}.step-point{height:38rpx;width:38rpx;line-height:38rpx;margin:0 auto 13rpx;border-radius:50%;border:1rpx solid var(--line);color:var(--soft-purple);font-size:calc(19rpx * var(--ui-scale,1));background:var(--base)}.arrange-step.reached{color:var(--purple)}.reached .step-point{color:var(--purple);background:var(--lavender);border-color:var(--lavender)}.step-connector{width:32rpx;flex:none;height:1rpx;background:var(--line);margin-top:20rpx}
.claim-message{display:flex;gap:18rpx;align-items:center;border-radius:18rpx;background:var(--base);padding:18rpx;font-size:calc(22rpx * var(--ui-scale,1));color:var(--muted)}.claim-mark{flex:none;color:var(--purple);border-radius:50%;background:var(--lavender);width:45rpx;height:45rpx;text-align:center;line-height:45rpx;font-size:25rpx}.claim-name{color:var(--purple);font-size:calc(25rpx * var(--ui-scale,1));font-weight:600}.owner-note{text-align:center;margin-top:20rpx}.release-button{width:100%;margin-top:10rpx!important}.closed-note{margin-top:15rpx;font-size:calc(23rpx * var(--ui-scale,1));color:var(--muted)}
.feedback-box{margin:20rpx 0;padding:19rpx 23rpx;border-radius:18rpx;background:var(--lavender);color:var(--purple);font-size:calc(24rpx * var(--ui-scale,1))}.order-route{display:flex;align-items:flex-start;gap:21rpx;margin:26rpx 0}.order-route>view:last-child{flex:1;min-width:0}.order-route .small-note{margin-top:6rpx}.route-symbol{flex:none;width:30rpx;height:30rpx;transform:rotate(45deg);border-left:2rpx solid var(--soft-purple);border-top:2rpx solid var(--soft-purple);margin:11rpx 6rpx 0}
.order-amounts{display:flex;justify-content:space-between;gap:12rpx;margin-top:25rpx}.order-amounts>view{flex:1;min-width:0;font-size:calc(25rpx * var(--ui-scale,1));font-weight:600;overflow-wrap:anywhere}.order-amounts text{display:block;font-size:calc(20rpx * var(--ui-scale,1));font-weight:400;color:var(--muted);margin-bottom:8rpx}.purple{color:var(--purple)}.payment-progress{background:var(--lavender);height:7rpx;border-radius:7rpx;overflow:hidden;margin-top:25rpx}.payment-progress>view{height:100%;border-radius:7rpx;background:#a88bc9}.order-status-note{font-size:calc(23rpx * var(--ui-scale,1));color:var(--purple);margin-top:18rpx}.payment-note{margin-top:19rpx}
.blessing-flower{color:var(--soft-purple);font-size:40rpx;line-height:1}.blessing-form{background:var(--base);border:1rpx solid var(--line);border-radius:20rpx;margin-top:22rpx;padding:8rpx 5rpx 13rpx}.blessing-form textarea{min-height:120rpx;background:none;padding:17rpx 15rpx;font-size:calc(25rpx * var(--ui-scale,1))}.blessing-send{display:flex;align-items:center;justify-content:space-between;gap:20rpx;padding:0 15rpx}.blessing-send .secondary{padding:10rpx 23rpx;min-height:62rpx;font-size:calc(23rpx * var(--ui-scale,1));border:0;color:var(--purple);background:var(--lavender)}.wishes-page .login-note{display:flex;align-items:center;justify-content:space-between;gap:20rpx;width:100%;background:var(--lavender);color:var(--purple);border-radius:17rpx;padding:20rpx;margin-top:21rpx;font-size:calc(24rpx * var(--ui-scale,1))}.already-note{font-size:calc(22rpx * var(--ui-scale,1));color:var(--purple);margin-top:23rpx}.blessing-list{margin-top:24rpx}.blessing-row{display:flex;align-items:flex-start;gap:17rpx;border-top:1rpx solid var(--line);padding:25rpx 0}.blessing-row:last-child{padding-bottom:0}.blessing-avatar{width:46rpx;height:46rpx;border-radius:50%;background:var(--lavender);display:flex;align-items:center;justify-content:center;flex:none}.blessing-body{flex:1;min-width:0}.blessing-meta{display:flex;justify-content:space-between;align-items:flex-start;gap:15rpx;font-size:calc(22rpx * var(--ui-scale,1));color:var(--muted)}.blessing-meta>text:first-child{color:var(--purple);min-width:0}.blessing-meta>text:last-child{flex:none;font-size:calc(19rpx * var(--ui-scale,1))}.self-tag{margin-left:10rpx;padding:1rpx 6rpx;background:var(--lavender);border-radius:5rpx;font-size:calc(17rpx * var(--ui-scale,1));color:var(--purple)}.blessing-message{font-size:calc(25rpx * var(--ui-scale,1));white-space:pre-wrap;margin-top:8rpx;line-height:1.75;overflow-wrap:anywhere}.blessing-empty{margin:25rpx 0 0;font-size:calc(22rpx * var(--ui-scale,1));color:var(--muted);text-align:center;padding:15rpx}
.detail-actions{margin-top:27rpx}.wishes-page .share-button{border-radius:23rpx;min-height:88rpx}.share-symbol{position:relative;flex:none;height:27rpx;width:24rpx;border:1.5rpx solid #fff;border-top:0;border-radius:4rpx;margin-left:6rpx;margin-top:6rpx}.share-symbol::before{content:"";position:absolute;width:12rpx;height:12rpx;top:-8rpx;left:4rpx;border-left:1.5rpx solid #fff;border-top:1.5rpx solid #fff;transform:rotate(45deg)}.share-symbol::after{content:"";position:absolute;width:1.5rpx;height:22rpx;background:#fff;top:-8rpx;left:10rpx}.wishes-page .close-button{width:100%;margin-top:13rpx;color:var(--muted)}.wishes-page .hub-link{display:flex;align-items:center;justify-content:center;gap:20rpx;width:100%;text-align:center;color:var(--purple);font-size:calc(24rpx * var(--ui-scale,1));margin-top:23rpx;padding:10rpx}
@media(min-width:600px){.wishes-page{max-width:900rpx;margin:0 auto}.hero-art{right:50rpx}}
