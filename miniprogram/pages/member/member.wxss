page { background: #f7f2fc; }
.hero { margin: 24rpx; padding: 28rpx 28rpx 32rpx; border-radius: 28rpx; background: linear-gradient(180deg, #f3e9ff, #fbf9fe); color: #3a1848; position: relative; overflow: hidden; min-height: 300rpx; }
.codes { display: flex; justify-content: space-between; font-size: 26rpx; color: #b7a8c6; padding-right: 36rpx; }
.code.on { color: #5c2d82; font-weight: 800; }
.next { position: absolute; right: 8rpx; top: 150rpx; z-index: 2; color: #b9a8c8; font-size: 40rpx; line-height: 1; padding: 8rpx; }
.now { margin-top: 36rpx; font-size: 22rpx; color: #8d7a9e; position: relative; z-index: 2; }
.title { margin-top: 4rpx; font-size: 56rpx; font-weight: 800; position: relative; z-index: 2; }
.mark { position: absolute; right: 0; top: 20rpx; width: 280rpx; height: 230rpx; z-index: 0; }
.meter { margin-top: 20rpx; display: flex; align-items: center; font-size: 26rpx; position: relative; z-index: 2; }
.num { font-size: 32rpx; font-weight: 800; }
.track { position: relative; width: 200rpx; height: 16rpx; margin-left: 12rpx; border-radius: 99rpx; background: #eadcf6; }
.track-in { height: 16rpx; border-radius: 99rpx; background: #7a3d9a; }
.pill { position: absolute; right: 0; top: 50%; transform: translateY(-50%); background: #7a3d9a; color: #fff; font-size: 20rpx; line-height: 1; padding: 6rpx 10rpx; border-radius: 12rpx; }
.month { margin-top: 18rpx; font-size: 24rpx; color: #6d6278; position: relative; z-index: 1; }
.perk-head { margin: 8rpx 32rpx; text-align: center; color: #6b2178; font-size: 26rpx; }
.perk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 0 24rpx 24rpx; }
.perk { background: #fff; border-radius: 20rpx; padding: 28rpx 20rpx; }
.perk-name { font-size: 28rpx; font-weight: 650; color: #3a1848; }
.note { margin: 0 32rpx 32rpx; color: #8a8f99; font-size: 22rpx; line-height: 1.5; }
