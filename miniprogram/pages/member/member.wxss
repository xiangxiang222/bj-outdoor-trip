@import "../../styles/account.wxss";
page { background-color: #f3f4f6; color: #1a1a1a; font-family: "PingFang SC", "Helvetica Neue", sans-serif; }
.hero { margin: 24rpx; padding: 28rpx 28rpx 28rpx; border-radius: 32rpx; background: linear-gradient(180deg, #f6edff, #fff); color: #1a1a1a; position: relative; overflow: hidden; min-height: 340rpx; }
.codes { display: flex; justify-content: space-between; font-size: calc(28rpx * var(--ui-scale)); color: #c4bccb; }
.code.on { color: #1a1a1a; font-weight: 700; }
.next { position: absolute; right: 8rpx; bottom: 88rpx; z-index: 2; color: #b9a8c8; font-size: calc(40rpx * var(--ui-scale)); line-height: 1; padding: 8rpx; }
.now { margin-top: 32rpx; font-size: calc(24rpx * var(--ui-scale)); color: #9a9a9a; position: relative; z-index: 2; }
.title { margin-top: 4rpx; font-size: calc(56rpx * var(--ui-scale)); font-weight: 700; color: #1c1228; position: relative; z-index: 2; }
.mark { position: absolute; right: 64rpx; bottom: 40rpx; width: 280rpx; height: 230rpx; z-index: 0; }
.meter { margin-top: 20rpx; display: flex; align-items: center; font-size: calc(26rpx * var(--ui-scale)); position: relative; z-index: 2; }
.num { font-size: calc(32rpx * var(--ui-scale)); font-weight: 800; }
.track { position: relative; width: 200rpx; height: 16rpx; margin-left: 12rpx; border-radius: 99rpx; background: #eadcf6; }
.track-in { height: 16rpx; border-radius: 99rpx; background: #7a3d9a; }
.pill { position: absolute; right: 0; top: 50%; transform: translateY(-50%); background: #7a3d9a; color: #fff; font-size: calc(20rpx * var(--ui-scale)); line-height: 1; padding: 6rpx 10rpx; border-radius: 12rpx; }
.month { margin-top: 18rpx; font-size: calc(24rpx * var(--ui-scale)); color: #6d6278; position: relative; z-index: 1; }
.perk-head { margin: 8rpx 32rpx; text-align: center; color: #70508f; font-size: calc(26rpx * var(--ui-scale)); }
.perk-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; margin: 0 24rpx 24rpx; }
.perk { background: #fff; border-radius: 20rpx; padding: 28rpx 20rpx; }
.perk-name { font-size: calc(28rpx * var(--ui-scale)); font-weight: 650; color: #3a1848; }
.note { margin: 0 32rpx 32rpx; color: #8a8f99; font-size: calc(22rpx * var(--ui-scale)); line-height: 1.5; }

page { background: #ede6f7; }
.hero { margin: 0; padding: 32rpx 34rpx 44rpx; border-radius: 0 0 40rpx 40rpx; background: linear-gradient(150deg, #ded2f0, #f0eafa 70%, #e4daf2); min-height: 440rpx; color: #5b3b8c; }
.codes { color: #a596b9; font-size: calc(24rpx * var(--ui-scale)); padding-bottom: 16rpx; border-bottom: 1rpx solid rgba(117,84,149,.12); }
.code { padding: 8rpx 18rpx; border-radius: 99rpx; }
.code.on { background: #5b3b8c; color: #fff; font-weight: 500; }
.now { color: #8b749f; margin-top: 35rpx; font-size: calc(25rpx * var(--ui-scale)); }
.title { font-size: calc(45rpx * var(--ui-scale)); margin-top: 12rpx; color: #5b3b8c; }
.mark { width: 230rpx; height: 220rpx; right: 34rpx; bottom: 65rpx; opacity: .85; }
.meter { margin-top: 36rpx; font-size: calc(23rpx * var(--ui-scale)); color: #7b5b98; }
.track { width: 180rpx; height: 8rpx; background: #d8c9e8; }
.track-in { height: 8rpx; background: #9872bd; }
.pill { font-size: calc(17rpx * var(--ui-scale)); padding: 6rpx 12rpx; background: #9872bd; }
.month { margin-top: 22rpx; font-size: calc(22rpx * var(--ui-scale)); color: #9b87ad; }
.perk-head { padding: 30rpx 0 16rpx; font-size: calc(30rpx * var(--ui-scale)); color: #71508f; text-align: left; font-weight: 600; }
.perk-grid { margin: 0 28rpx 28rpx; gap: 20rpx; }
.perk { border-radius: 26rpx; padding: 38rpx 24rpx; border: 1rpx solid #fff; color: #6d4f87; }
.perk::before { content: '✧'; display: block; font-size: 42rpx; color: #ad8fd0; margin-bottom: 12rpx; }
.perk-name { font-size: calc(29rpx * var(--ui-scale)); color: #6b4c86; font-weight: 500; }
.note { color: #9a89aa; font-size: calc(23rpx * var(--ui-scale)); padding: 4rpx 0 40rpx; }
