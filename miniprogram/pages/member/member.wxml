<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<load-row wx:if="{{!card}}" />
<view wx:else class="member-page {{dark ? 'is-dark' : ''}}">
  <view class="member-hero">
    <view class="hero-main">
      <image class="member-mark" src="{{mark}}" mode="aspectFit" />
      <view class="member-identity">
        <view class="eyebrow">{{tr.t('同行者众会员', lang)}}</view>
        <view class="member-title">{{tr.t(card.name, lang)}}</view>
        <view class="member-code">{{tr.t(card.code, lang)}} · {{tr.t('当前等级', lang)}}</view>
      </view>
    </view>
    <view class="growth-label">
      <text>{{tr.t('累计成长值', lang)}}</text>
      <text class="growth-value">{{tr.t(card.growth, lang)}}</text>
    </view>
    <view class="track">
      <view class="track-in" style="width: {{card.progress * 100}}%"></view>
    </view>
    <view class="growth-foot" wx:if="{{card.nextCode}}">
      <text>{{tr.t('距离下一级还需', lang)}}</text>
      <text>{{tr.t(card.nextGrowth - card.growth > 0 ? card.nextGrowth - card.growth : 0, lang)}} {{tr.t('成长值', lang)}}</text>
    </view>
    <view class="growth-foot" wx:else>{{tr.t('已达到最高等级', lang)}}</view>
    <view class="month-growth">{{tr.t('本月新增', lang)}} <text>{{tr.t(card.monthGrowth, lang)}}</text> {{tr.t('成长值', lang)}}</view>
  </view>

  <view class="section-head">
    <view class="section-title">{{tr.t('会员等级', lang)}}</view>
    <view class="section-note">{{tr.t('点击等级查看对应权益', lang)}}</view>
  </view>
  <scroll-view scroll-x class="level-scroll">
    <view class="level-row">
      <view wx:for="{{card.levels}}" wx:key="level" class="level {{focus.level === item.level ? 'selected' : ''}} {{item.level === card.level ? 'current' : ''}}" data-level="{{item.level}}" bindtap="focusLevel">
        <text class="level-code">{{tr.t(item.code, lang)}}</text>
        <text class="level-name">{{tr.t(item.name, lang)}}</text>
        <text class="level-status" wx:if="{{item.level === card.level}}">{{tr.t('当前', lang)}}</text>
        <text class="level-status" wx:elif="{{item.reached}}">{{tr.t('已达', lang)}}</text>
        <text class="level-status" wx:else>{{tr.t('预览', lang)}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="benefits-section">
    <view class="benefits-head">
      <view>
        <view class="benefits-title">{{focus.level === card.level ? tr.t('当前等级权益', lang) : tr.t('等级权益预览', lang)}}</view>
        <view class="benefits-subtitle">{{focus.level === card.level ? tr.t('本等级可享内容', lang) : tr.t('仅供预览，不代表已获得', lang)}}</view>
      </view>
      <view class="benefits-count">{{tr.t(focus.perks.length, lang)}} {{tr.t('项权益', lang)}}</view>
    </view>
    <view class="benefit-row">
        <view class="benefit" wx:for="{{perkItems}}" wx:key="label">
          <view class="benefit-mark"></view>
          <view class="benefit-copy">{{tr.t(item.label, lang)}}</view>
        </view>
    </view>
  </view>
  <view class="member-note">{{tr.t('成长值与会员等级依据当前账户信息展示。', lang)}}</view>
</view>
