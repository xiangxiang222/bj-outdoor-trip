<view class="hero" wx:if="{{card}}">
  <view class="codes">
    <text wx:for="{{card.levels}}" wx:key="level" class="code {{focus.level === item.level ? 'on' : ''}}" data-level="{{item.level}}" bindtap="focusLevel">{{item.code}}</text>
  </view>
  <view class="next" wx:if="{{hasNext}}" data-level="{{focus.level + 1}}" bindtap="focusLevel">›</view>
  <view class="now">{{nowLine}}</view>
  <view class="title">同行者众会员</view>
  <view class="mark">{{focus.code}}</view>
  <view class="meter">
    <text>成长值 </text><text class="num">{{into}}</text><text>/{{span}}</text>
    <view class="track">
      <view class="track-in" style="width: {{bar}}%"></view>
      <text class="pill">{{pill}}</text>
    </view>
  </view>
  <view class="month">本月累计新增 {{card.monthGrowth}} 成长值 ›</view>
</view>
<view class="perk-head" wx:if="{{focus}}">可享 {{focus.perks.length}} 项权益</view>
<view class="perk-grid" wx:if="{{focus}}">
  <view class="perk" wx:for="{{focus.perks}}" wx:key="*this">
    <view class="perk-name">{{item}}</view>
  </view>
</view>
<view class="note">等级按出行获得的成长值自动升级，不单独售卖。后台可调整当前等级。</view>
