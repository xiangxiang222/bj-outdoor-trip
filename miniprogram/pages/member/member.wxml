<view class="card" wx:if="{{user && user.isMember}}" style="background:#1b4332;color:#fff">
  <view class="pad">
    <view class="row">
      <view class="title" style="color:#fff">{{user.nickname}}</view>
      <view class="tag" style="background:#ffd166;color:#1b4332">会员</view>
    </view>
    <view>积分 {{user.points}} · 到期 {{user.memberExpireAt}}</view>
  </view>
</view>
<view class="card">
  <view class="pad">
    <view class="title">{{user && user.isMember ? '会员权益' : '开通北野行会员'}}</view>
    <view class="muted">年费 ¥99，线路额外 95 折，赠送一次 100 元以内的团。</view>
    <view class="muted">· 会员价自动计算</view>
    <view class="muted">· 100 积分抵 1 元</view>
    <view class="muted">· 开团、报名、分享不受限</view>
  </view>
</view>
<view class="btn" bindtap="buy">{{user && user.isMember ? '续费会员' : '开通会员'}}</view>
