<view class="pad" wx:if="{{s}}">{{s.route.title}} {{s.startDate}}</view>
<view class="pad muted" wx:if="{{s.status=='cancelled'}}" style="color:#bc4749">本团已解散，无法报名。理由：{{s.cancelReason}}</view>
<view class="pad muted" wx:elif="{{s.remain<=0}}">本车已满，仍可加入候补，有人取消后按顺序递补。</view>
<view class="pad muted" wx:else>{{s.organizerType=='company'?'公司团：先报名，公司统一支付':'个人拼团：先报名占座，出行前付款'}}</view>
<input class="input" placeholder="姓名（与身份证一致）" value="{{form.travelerName}}" bindinput="setName" />
<input class="input" placeholder="手机号" type="number" maxlength="11" value="{{form.travelerPhone}}" bindinput="setPhone" />
<input class="input" placeholder="18位身份证号" maxlength="18" value="{{form.idCard}}" bindinput="setId" />
<view class="pad" style="color:{{idOk ? '#6b705c' : '#bc4749'}};font-size:24rpx" wx:if="{{idHint}}">{{idHint}}</view>
<input class="input" placeholder="紧急联系人姓名" value="{{form.emergencyName}}" bindinput="setEmergencyName" />
<input class="input" placeholder="紧急联系人手机（不能与出行人相同）" type="number" maxlength="11" value="{{form.emergencyPhone}}" bindinput="setEmergencyPhone" />
<view class="card" wx:if="{{s.remain>0 && seatRows.length}}">
  <view class="pad">选座位（不选则自动分配）</view>
  <view class="seat-map">
    <view class="seat-front">车头</view>
    <view class="seat-row" wx:for="{{seatRows}}" wx:key="row">
      <block wx:for="{{item.seats}}" wx:for-item="seat" wx:key="no">
        <view class="seat {{seat.taken ? 'taken' : ''}} {{seat.locked ? 'locked' : ''}} {{form.seatNo==seat.no ? 'on' : ''}}" bindtap="pickSeat" data-no="{{seat.no}}" data-taken="{{seat.taken}}">{{seat.locked ? '锁' : seat.col}}</view>
        <view wx:if="{{seat.aisleAfter}}" class="seat-aisle"></view>
      </block>
    </view>
  </view>
</view>
<view class="card" wx:if="{{plans.length}}">
  <view class="pad">出行保险</view>
  <view class="pad" wx:for="{{plans}}" wx:key="code" bindtap="pickIns" data-code="{{item.code}}">
    <view>{{form.insuranceCode==item.code ? '●' : '○'}} {{item.name}}{{item.fee ? ' +¥' + item.fee : ''}}</view>
    <view class="muted">{{item.cover}}</view>
  </view>
</view>
<view class="card">
  <view class="pad">行前确认</view>
  <view class="pad muted" style="white-space:pre-wrap">{{waiver}}</view>
  <view class="pad" bindtap="toggleHealth">{{form.healthOk ? '☑' : '☐'}} 本人健康状况适合本次活动</view>
  <view class="pad" bindtap="toggleWaiver">{{form.waiverAccepted ? '☑' : '☐'}} 已阅读风险告知与退改说明，自愿参加</view>
  <view class="pad muted">{{cancelSummary}}</view>
</view>
<view class="btn" wx:if="{{s.status!='cancelled'}}" bindtap="submit">{{s.remain<=0?'加入候补':'确认报名'}}</view>
