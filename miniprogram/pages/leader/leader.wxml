<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="pad muted">{{tr.t('个人通过领队申请后，才能在团详情页报名领队。', lang)}}</view>
<view class="pad" wx:if="{{certified}}" style="color:#2d6a4f">{{tr.t('已是领队', lang)}}{{tr.t(name ? ' · ' + name : '', lang)}}</view>
<view class="pad muted" wx:elif="{{pending}}">{{tr.t('审核中', lang)}}{{tr.t(name ? ' · ' + name : '', lang)}}</view>
<view class="pad muted" wx:elif="{{rejected}}">{{tr.t('上次未通过，可修改后再次提交。', lang)}}</view>
<view class="pad">{{tr.t('真实姓名', lang)}}</view>
<input class="input" value="{{name}}" placeholder="{{tr.t('带队时展示给团友', lang)}}" disabled="{{certified}}" bindinput="onName" />
<view class="pad">{{tr.t('带队年限', lang)}}</view>
<input class="input" type="number" value="{{years}}" placeholder="{{tr.t('没有带过可填 0', lang)}}" disabled="{{certified}}" bindinput="onYears" />
<view class="pad">{{tr.t('带队经历', lang)}}</view>
<textarea class="input" value="{{intro}}" placeholder="{{tr.t('走过哪些线、怎么带队、能照顾到什么', lang)}}" disabled="{{certified}}" bindinput="onIntro" />
<button bindtap="submit" disabled="{{loading || certified}}">{{tr.t(loading ? '提交中…' : '提交申请', lang)}}</button>
<button class="ghost" wx:if="{{redirect}}" bindtap="goBack">{{tr.t('返回团详情', lang)}}</button>
