<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="card" wx:if="{{!list.length}}"><view class="pad muted">{{tr.t('还没有优惠券', lang)}}</view></view>
<view class="card" wx:for="{{list}}" wx:key="id" bindtap="open" data-code="{{item.campaignCode}}" data-status="{{item.status}}" data-schedule="{{item.scheduleId}}">
  <view class="pad">
    <view class="title">{{tr.t(item.label, lang)}}</view>
    <view>{{tr.t(item.name, lang)}}</view>
    <view class="muted">{{tr.t(item.routeTitle, lang)}}<text wx:if="{{item.startDate}}"> · {{tr.t(item.startDate, lang)}}</text></view>
    <view wx:if="{{item.status=='unused' && item.ttl}}">
      <view class="progress {{item.ttl.percent < 20 ? 'low' : ''}}"><view class="bar" style="width: {{item.ttl.percent}}%;"></view></view>
      <view class="muted">{{tr.t(item.ttl.label, lang)}}</view>
    </view>
  </view>
</view>
