<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="card" wx:for="{{list}}" wx:key="id" bindtap="go" data-id="{{item.id}}">
  <image class="cover" src="{{item.cover}}" mode="aspectFill" />
  <view class="pad">
    <view class="title">{{tr.t(item.title, lang)}}</view>
    <view class="muted">{{tr.t(item.subtitle, lang)}}</view>
  </view>
</view>
<view class="card" wx:if="{{!list.length}}">
  <view class="pad">
    <view>{{tr.t('还没有收藏，去线路详情点收藏', lang)}}</view>
    <view class="muted">{{tr.t('已经下架的线路不会留在这里。', lang)}}</view>
  </view>
</view>
