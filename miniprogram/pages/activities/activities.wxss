.act-hero {
  margin: 16rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #5b3b8c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.act-hero .muted.light { color: rgba(255,255,255,.85); }
.btn.gold { margin: 0; padding: 16rpx 24rpx; }
.kind-grid { display: flex; gap: 12rpx; padding: 0 16rpx 16rpx; }
.act-kind {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e9e4ee;
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: calc(24rpx * var(--ui-scale));
}
.act-kind .emoji { font-size: calc(36rpx * var(--ui-scale)); }
.tiny { font-size: calc(20rpx * var(--ui-scale)); }
.act-card {
  margin: 0 16rpx 16rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.act-date {
  width: 96rpx;
  text-align: center;
  background: #efeaf7;
  border-radius: 16rpx;
  padding: 12rpx 0;
  color: #5b3b8c;
}
.act-date .day { font-size: calc(40rpx * var(--ui-scale)); font-weight: 700; }
.act-main { flex: 1; }
.meta { margin-top: 8rpx; color: #5b3b8c; font-size: calc(24rpx * var(--ui-scale)); font-weight: 650; }
.meta text { margin-right: 16rpx; }

.act-hero { margin: 24rpx 28rpx; padding: 32rpx; border-radius: 28rpx; }
.act-card { margin: 0 28rpx 20rpx; padding: 24rpx; border-radius: 26rpx; }
.kind-grid { padding: 0 28rpx 22rpx; }
.act-kind.on { background: #efeaf7; color: #5b3b8c; border-color: #ded2ec; }
