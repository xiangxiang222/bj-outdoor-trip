.act-hero {
  margin: 16rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(118deg, #3a1848 0%, #161218 48%, #4a1420 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.act-hero .muted.light { color: rgba(255,255,255,.85); }
.btn.gold { background: #c6f24a; color: #141414; margin: 0; padding: 16rpx 24rpx; }
.kind-grid { display: flex; gap: 12rpx; padding: 0 16rpx 16rpx; }
.act-kind {
  flex: 1;
  background: #fff;
  border: 1rpx solid #e6dfd2;
  border-radius: 20rpx;
  padding: 16rpx 8rpx;
  text-align: center;
  font-size: calc(24rpx * var(--ui-scale));
}
.act-kind.on { border-color: #c6f24a; background: #c6f24a; }
.act-kind .emoji { font-size: calc(36rpx * var(--ui-scale)); }
.tiny { font-size: calc(20rpx * var(--ui-scale)); }
.act-card {
  margin: 0 16rpx 16rpx;
  padding: 20rpx;
  background: #fffdf8;
  border-radius: 24rpx;
  display: flex;
  gap: 20rpx;
  align-items: center;
}
.act-date {
  width: 96rpx;
  text-align: center;
  background: #d8f3dc;
  border-radius: 16rpx;
  padding: 12rpx 0;
  color: #1b4332;
}
.act-date .day { font-size: calc(40rpx * var(--ui-scale)); font-weight: 700; }
.act-main { flex: 1; }
.meta { margin-top: 8rpx; color: #1b4332; font-size: calc(24rpx * var(--ui-scale)); font-weight: 650; }
.meta text { margin-right: 16rpx; }
