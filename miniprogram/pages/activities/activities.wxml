<view class="act-hero">
  <view class="act-hero-text">
    <view class="title">同城也能约</view>
    <view class="muted light">掼蛋、跑步、看电影。山野线路请回首页。</view>
  </view>
  <view class="btn gold" bindtap="goPublish">发起一局</view>
</view>
<view class="pad muted" wx:if="{{rows.length}}">本周 {{weekCount}} 场 · 共 {{rows.length}} 场可报</view>
<view class="kind-grid">
  <view class="act-kind {{kind==item.key?'on':''}}" wx:for="{{kinds}}" wx:key="key" bindtap="setKind" data-key="{{item.key}}">
    <view class="emoji">{{item.emoji}}</view>
    <view>{{item.label}}</view>
    <view class="muted tiny">{{item.hint}}</view>
  </view>
</view>
<view class="act-card" wx:for="{{list}}" wx:key="id" bindtap="go" data-id="{{item.id}}">
  <view class="act-date">
    <view class="day">{{item.dateBlock.day}}</view>
    <view class="muted tiny">{{item.dateBlock.weekday}}</view>
  </view>
  <view class="act-main">
    <view class="title">{{item.route.title}}</view>
    <view class="muted">{{item.meetupTime}} {{item.city}} · {{item.organizerName}}</view>
    <view class="meta">
      <text wx:if="{{item.free}}">免费</text>
      <text wx:else>¥{{item.price}} 起</text>
      <text>余 {{item.remain}} 人</text>
    </view>
  </view>
</view>
<view class="card" wx:if="{{!list.length}}">
  <view class="pad">
    <view class="title">{{kind ? '还没有这类局' : '还没有同城局'}}</view>
    <view class="muted">发起一局，审核通过后出现在这里。</view>
    <view class="btn ghost" bindtap="goPublish">去发起</view>
  </view>
</view>
