<view class="chips">
  <view class="offer-chip publish" bindtap="goPublish">发团</view>
</view>
<view class="card" wx:for="{{list}}" wx:key="id" bindtap="go" data-id="{{item.id}}">
  <view class="pad">
    <view class="row">
      <view>
        <text class="offer-chip inline" style="background:{{item.offerColor}}">{{item.offerLabel}}</text>
        <text class="title">{{item.route.title}}</text>
      </view>
      <text class="tag">{{item.startDate}}</text>
    </view>
    <view class="muted">{{item.organizerType=='company'?item.companyName:item.organizerName}} · {{item.bus.name}}<text wx:if="{{item.guaranteed}}"> · 铁定出发</text></view>
    <view wx:if="{{item.guide}}" class="guide-hit" catchtap="goGuide" data-id="{{item.guide.id}}">导游 {{item.guide.name}} · 查看详情</view>
    <view wx:else class="muted guide-hit" catchtap="goGuides">成团后匹配导游 · 先看看领队</view>
    <view class="progress"><view class="bar" style="width:{{item.enrolled/item.maxSeats*100}}%"></view></view>
    <view class="row muted">
      <text>{{item.enrolled}}/{{item.maxSeats}}</text>
      <view>
        <text wx:if="{{item.quote.originPrice > item.quote.price}}" class="price-origin">¥{{item.quote.originPrice}}</text>
        <text>¥{{item.quote.price}}</text>
      </view>
    </view>
  </view>
</view>
