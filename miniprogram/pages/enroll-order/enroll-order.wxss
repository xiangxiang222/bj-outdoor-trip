@import "../orders/orders.wxss";

.od-hero { padding: 8rpx 8rpx 20rpx; }
.od-hero-title { font-size: calc(44rpx * var(--ui-scale)); font-weight: 700; }
.od-hero-sub { color: #8a8a8a; margin-top: 8rpx; font-size: calc(26rpx * var(--ui-scale)); }
.od-block { padding: 24rpx; }
.od-who { font-size: calc(30rpx * var(--ui-scale)); font-weight: 650; }
.od-lines { padding: 8rpx 24rpx; }
.od-line { display: flex; justify-content: space-between; gap: 24rpx; padding: 16rpx 0; font-size: calc(26rpx * var(--ui-scale)); }
.od-line text:first-child { color: #8a8a8a; }
.od-val { font-weight: 650; }
.od-copy { color: #5b7f9a; font-weight: 400; margin-left: 8rpx; }
.od-no { font-variant-numeric: tabular-nums; }
.od-jump { color: #8a8a8a; }
.od-line.is-due .od-val { color: #bc4749; }
.od-dock {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: 12rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-top: 8rpx;
}
.od-wish-entry{display:flex;align-items:center;gap:20rpx;padding:26rpx;color:var(--primary,#5b3b8c)}
.od-wish-entry>view:nth-child(2){flex:1;min-width:0;overflow-wrap:anywhere}.od-wish-title{font-weight:600;font-size:calc(27rpx * var(--ui-scale));line-height:1.5}.od-wish-note{margin-top:8rpx;font-size:calc(21rpx * var(--ui-scale));line-height:1.7;color:var(--muted,#8a8692)}.od-wish-entry>text{font-size:33rpx;flex:none}.od-wish-art{position:relative;flex:none;width:39rpx;height:42rpx;border:2rpx solid var(--primary,#5b3b8c);border-radius:7rpx;transform:rotate(-7deg)}.od-wish-art::before{content:'';position:absolute;left:11rpx;top:11rpx;width:12rpx;height:12rpx;border-left:2rpx solid currentColor;border-bottom:2rpx solid currentColor;transform:rotate(-45deg)}
