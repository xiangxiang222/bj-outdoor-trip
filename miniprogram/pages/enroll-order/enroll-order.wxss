.enroll-detail { --ed-purple:#5b3b8c; --ed-ink:#2d2834; --ed-muted:#8c8297; --ed-paper:#fff; --ed-soft:#f3eef8; --ed-line:#eee8f3; min-height:100vh; padding:28rpx 28rpx calc(190rpx + env(safe-area-inset-bottom)); background:var(--bg,#f7f6f9); color:var(--ed-ink); box-sizing:border-box; overflow-wrap:break-word; }
.enroll-detail.is-dark { --ed-purple:#d2b5ef; --ed-ink:#eee7f5; --ed-muted:#b3a4c0; --ed-paper:#211c2a; --ed-soft:#30263d; --ed-line:#3c3047; }
.enroll-detail button { width:auto; margin:0; padding:0; border:0; background:transparent; color:inherit; font-size:inherit; line-height:inherit; font-weight:inherit; box-sizing:border-box; }.enroll-detail button::after { border:0; }.enroll-detail text { min-width:0; }
.ed-status { display:flex; align-items:flex-start; gap:24rpx; padding:24rpx 12rpx 36rpx; }.ed-state-mark { position:relative; flex:none; width:74rpx; height:74rpx; margin-top:15rpx; border:2rpx solid #d9cae8; border-radius:50%; background:var(--ed-soft); color:var(--ed-purple); box-sizing:border-box; }.ed-state-mark > view { position:absolute; left:22rpx; top:20rpx; width:25rpx; height:15rpx; border-left:3rpx solid currentColor; border-bottom:3rpx solid currentColor; transform:rotate(-45deg); }.state-unpaid .ed-state-mark > view,.state-waitlist .ed-state-mark > view,.state-applied .ed-state-mark > view,.state-recruiting .ed-state-mark > view,.state-overdue .ed-state-mark > view { top:17rpx; left:34rpx; width:12rpx; height:23rpx; border-left:3rpx solid currentColor; border-bottom:3rpx solid currentColor; transform:none; }.ed-status-copy { flex:1; min-width:0; }.ed-eyebrow { color:var(--ed-muted); font-size:21rpx; line-height:1.6; }.ed-status-title { margin:6rpx 0 10rpx; font-size:calc(43rpx * var(--ui-scale)); line-height:1.3; font-weight:600; letter-spacing:1rpx; }.ed-status-hint { color:var(--ed-muted); font-size:calc(24rpx * var(--ui-scale)); line-height:1.7; }
.ed-card { padding:28rpx; margin-bottom:22rpx; border:1rpx solid var(--ed-line); border-radius:26rpx; background:var(--ed-paper); }.ed-section-head { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:25rpx; }.ed-tag { color:var(--ed-purple); background:var(--ed-soft); padding:6rpx 13rpx; border-radius:8rpx; font-size:21rpx; line-height:1.5; }.ed-link { display:flex; align-items:center; gap:10rpx; color:var(--ed-muted); font-size:22rpx; }.ed-link > text { font-size:32rpx; }.ed-event-main { display:flex; gap:23rpx; align-items:center; }.ed-event-main image,.ed-placeholder { display:var(--media,block); flex:none; width:142rpx; height:142rpx; border-radius:18rpx; object-fit:cover; background:var(--ed-soft); }.ed-event-title { flex:1; min-width:0; }.ed-event-title > view { font-size:calc(30rpx * var(--ui-scale)); font-weight:600; line-height:1.6; }.ed-event-title > text { display:block; margin-top:13rpx; color:var(--ed-muted); font-size:22rpx; line-height:1.6; }.ed-arrangement { margin-top:28rpx; padding-top:12rpx; border-top:1rpx solid var(--ed-line); }.ed-arrangement > view { display:flex; gap:22rpx; align-items:flex-start; padding-top:17rpx; font-size:calc(24rpx * var(--ui-scale)); line-height:1.7; }.ed-field-label { flex:none; color:var(--ed-muted); min-width:96rpx; }.ed-field-value { flex:1; color:var(--ed-ink); }
.ed-section-title { display:flex; justify-content:space-between; gap:20rpx; font-size:calc(27rpx * var(--ui-scale)); font-weight:600; line-height:1.6; margin-bottom:20rpx; }.ed-section-title > text { color:var(--ed-muted); font-size:22rpx; font-weight:400; }.ed-person-row { display:flex; align-items:center; gap:20rpx; padding-top:3rpx; }.ed-person-row > view + view { flex:1; }.ed-person-name { font-size:calc(27rpx * var(--ui-scale)); line-height:1.6; }.ed-person-row text { color:var(--ed-muted); font-size:24rpx; line-height:1.7; }.ed-person-mark { position:relative; width:64rpx; height:64rpx; flex:none; border-radius:50%; background:var(--ed-soft); overflow:hidden; }.ed-person-mark::before { content:''; position:absolute; top:12rpx; left:24rpx; width:17rpx; height:17rpx; border:2rpx solid #ac91c3; border-radius:50%; box-sizing:border-box; }.ed-person-mark > view { position:absolute; top:34rpx; left:15rpx; width:34rpx; height:23rpx; border:2rpx solid #ac91c3; border-radius:22rpx 22rpx 0 0; border-bottom:0; box-sizing:border-box; }
.ed-row { display:flex; justify-content:space-between; align-items:flex-start; gap:22rpx; padding:13rpx 0; font-size:calc(24rpx * var(--ui-scale)); line-height:1.7; }.ed-row > text:first-child { flex:none; color:var(--ed-muted); }.ed-row > text + text { text-align:right; min-width:0; }.ed-total { display:flex; justify-content:space-between; align-items:baseline; gap:22rpx; border-top:1rpx solid var(--ed-line); margin-top:15rpx; padding-top:25rpx; font-size:24rpx; }.ed-total > view { color:var(--ed-purple); font-size:calc(39rpx * var(--ui-scale)); font-weight:600; line-height:1.3; }.ed-helper { color:var(--ed-muted); font-size:21rpx; margin-top:18rpx; line-height:1.7; }.ed-order-no { display:flex; flex-wrap:wrap; gap:14rpx; justify-content:flex-end; min-width:0; font-variant-numeric:tabular-nums; }.ed-order-no button { color:var(--ed-purple); padding:0 6rpx; font-size:22rpx; }
.ed-wish { display:flex; align-items:center; gap:20rpx; padding:26rpx; margin-bottom:22rpx; color:var(--ed-purple); background:var(--ed-soft); border-radius:24rpx; }.ed-wish > view:nth-child(2) { flex:1; min-width:0; font-size:calc(25rpx * var(--ui-scale)); font-weight:500; line-height:1.6; }.ed-wish text { display:block; color:var(--ed-muted); font-size:21rpx; line-height:1.7; margin-top:5rpx; font-weight:400; }.ed-wish > text { font-size:35rpx; margin:0; }.ed-wish-art { width:35rpx; height:39rpx; border:2rpx solid currentColor; border-radius:7rpx; flex:none; transform:rotate(-6deg); position:relative; }.ed-wish-art::before { content:''; position:absolute; left:10rpx; top:12rpx; width:13rpx; height:8rpx; border-left:2rpx solid currentColor; border-bottom:2rpx solid currentColor; transform:rotate(-45deg); }
.enroll-detail .ed-button { display:flex; justify-content:center; align-items:center; gap:10rpx; border:1rpx solid var(--ed-line); border-radius:999rpx; min-height:76rpx; padding:18rpx 25rpx; color:var(--ed-purple); background:var(--ed-paper); font-size:calc(25rpx * var(--ui-scale)); line-height:1.5; }.enroll-detail .ed-button.primary { background:var(--ed-purple); color:var(--ed-paper); border-color:var(--ed-purple); font-weight:500; }.enroll-detail .ed-button[disabled] { opacity:.5; }.ed-dock { position:fixed; z-index:20; left:0; right:0; bottom:0; background:var(--ed-paper); padding:22rpx 28rpx calc(22rpx + env(safe-area-inset-bottom)); border-top:1rpx solid var(--ed-line); }.ed-dock-content { display:flex; flex-wrap:wrap; gap:20rpx; align-items:center; justify-content:flex-end; }.ed-dock-price { margin-right:auto; }.ed-dock-price > text { color:var(--ed-muted); font-size:20rpx; }.ed-dock-price > view { color:var(--ed-purple); font-size:calc(34rpx * var(--ui-scale)); font-weight:600; margin-top:5rpx; }.ed-dock-actions { display:flex; flex-wrap:wrap; justify-content:flex-end; gap:12rpx; }.ed-dock-actions .ed-button { flex:1; white-space:nowrap; }.ed-record-note { padding:18rpx; color:var(--ed-muted); font-size:22rpx; text-align:center; }.ed-error { text-align:center; line-height:1.8; font-size:26rpx; }.ed-error .ed-button { margin-top:24rpx; }.ed-review textarea { width:100%; box-sizing:border-box; min-height:150rpx; padding:22rpx; margin:20rpx 0; background:var(--ed-soft); color:var(--ed-ink); border-radius:15rpx; font-size:24rpx; }.ed-stars { display:flex; gap:15rpx; }.ed-stars button { font-size:45rpx; color:#ddd2e8; }.ed-stars button.on { color:#9b77ba; }
.ed-placeholder { position:relative; color:#a087b8; overflow:hidden; }.ed-placeholder.icon-trip > view { position:absolute; width:48rpx; height:48rpx; left:23rpx; top:50rpx; border-top:2rpx solid currentColor; border-left:2rpx solid currentColor; transform:rotate(45deg); }.ed-placeholder.icon-trip > view + view { width:34rpx; height:34rpx; left:78rpx; top:65rpx; }.ed-placeholder:not(.icon-trip) > view { position:absolute; width:49rpx; height:70rpx; border:2rpx solid currentColor; border-radius:7rpx; left:34rpx; top:34rpx; transform:rotate(-13deg); }.ed-placeholder:not(.icon-trip) > view + view { left:56rpx; top:39rpx; transform:rotate(10deg); background:var(--ed-soft); }.ed-placeholder text { position:absolute; top:52rpx; left:57rpx; width:49rpx; font-size:30rpx; text-align:center; }.ed-placeholder.icon-movie > view,.ed-placeholder.icon-club > view,.ed-placeholder.icon-run > view { width:73rpx; height:58rpx; left:34rpx; top:42rpx; transform:none; }.ed-placeholder.icon-movie > view + view { width:73rpx; height:1rpx; left:34rpx; top:53rpx; transform:none; border:0; border-top:2rpx dashed currentColor; }.ed-placeholder.icon-movie text { left:45rpx; top:57rpx; }.ed-placeholder.icon-club > view { width:25rpx; height:25rpx; left:39rpx; top:38rpx; border-radius:50%; }.ed-placeholder.icon-club > view + view { width:25rpx; height:25rpx; left:79rpx; top:48rpx; border-radius:50%; }.ed-placeholder.icon-club text { top:75rpx; left:49rpx; }.ed-placeholder.icon-run > view { width:15rpx; height:15rpx; left:84rpx; top:30rpx; border-radius:50%; }.ed-placeholder.icon-run > view + view { border-top:0; border-right:0; width:33rpx; height:44rpx; left:65rpx; top:56rpx; transform:rotate(25deg); border-radius:0; }.ed-placeholder.icon-run text { left:20rpx; top:74rpx; }
