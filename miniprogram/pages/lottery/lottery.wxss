.lw-stage { position: relative; width: 560rpx; height: 560rpx; margin: 16rpx auto 24rpx; }
.lw-pointer {
  position: absolute;
  left: 50%;
  top: -8rpx;
  z-index: 3;
  width: 0;
  height: 0;
  margin-left: -16rpx;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-top: 36rpx solid #e1251b;
}
.lw-disc {
  width: 560rpx;
  height: 560rpx;
  border-radius: 50%;
  box-shadow: 0 0 0 12rpx #fff, 0 0 0 20rpx #e8c56b, 0 16rpx 32rpx rgba(0,0,0,.12);
  position: relative;
  overflow: hidden;
}
.lw-label {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 160rpx;
  margin-left: -80rpx;
  margin-top: -20rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 1px 2px rgba(0,0,0,.35);
}
.lw-hub {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 120rpx;
  height: 120rpx;
  margin: -60rpx 0 0 -60rpx;
  border-radius: 50%;
  background: #f6e7a8;
}
.lw-go {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 4;
  width: 112rpx;
  height: 112rpx;
  margin: -56rpx 0 0 -56rpx;
  border-radius: 50%;
  background: #e1251b;
  color: #fff;
  font-weight: 800;
  font-size: 28rpx;
  text-align: center;
  line-height: 112rpx;
}
.lw-go.off { opacity: .55; }
.lw-legend { display: flex; flex-wrap: wrap; gap: 12rpx 20rpx; justify-content: center; }
.lw-chip { display: flex; align-items: center; gap: 8rpx; font-size: 22rpx; color: #5c5f56; }
.lw-dot { width: 14rpx; height: 14rpx; border-radius: 50%; }
.lw-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  background: rgba(10, 8, 12, .55);
  display: flex;
  align-items: center;
  justify-content: center;
}
.lw-burst {
  position: absolute;
  width: 400rpx;
  height: 400rpx;
  border-radius: 50%;
}
.lw-burst.lv1 { background: radial-gradient(circle, rgba(255,214,80,.55) 0%, rgba(225,37,27,0) 70%); }
.lw-card {
  position: relative;
  width: 560rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 36rpx 28rpx 20rpx;
  text-align: center;
}
.lw-card.lv1 { background: linear-gradient(180deg, #fff8e4 0%, #fff 46%); }
.lw-em { color: #c77d3a; font-size: 24rpx; margin-bottom: 8rpx; }
.lw-card.lv1 .lw-em { color: #e1251b; font-weight: 800; }
