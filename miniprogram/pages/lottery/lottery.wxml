<block wx:if="{{!scheduleId && trips.length}}">
  <view class="pad title">本团抽奖</view>
  <view class="card" wx:for="{{trips}}" wx:key="scheduleId" bindtap="goTrip" data-id="{{item.scheduleId}}">
    <view class="pad row">
      <view>
        <view class="title">{{item.routeTitle || item.title}}</view>
        <view class="muted">{{item.startDate}}{{item.drawLabel ? ' · ' + item.drawLabel : ''}}</view>
        <view>{{item.resultLabel || ((item.canPre || item.canPost) ? '还没抽' : '已抽完')}}</view>
      </view>
      <view class="nav-link">去转盘 ›</view>
    </view>
  </view>
  <view class="pad title">平台抽奖</view>
</block>
<view class="card"><view class="pad">
  <view class="title">{{scheduleId ? (state.title || '本团抽奖') : '平台抽奖'}}</view>
  <view class="muted">{{blurb}}</view>
</view></view>

<view class="card"><view class="pad">
  <view class="lw-stage">
    <view class="lw-pointer"></view>
    <view class="lw-disc {{spinning ? 'spinning' : ''}}" style="background:{{conic}};transform:rotate({{deg}}deg);transition:{{spinning ? 'transform ' + spinSec + 's cubic-bezier(0.12, 0.7, 0.12, 1)' : 'none'}}">
      <view class="lw-label" wx:for="{{labels}}" wx:key="key" style="transform:rotate({{item.angle}}deg) translateY(-200rpx) rotate({{item.back}}deg)">{{item.text}}</view>
      <view class="lw-hub"></view>
    </view>
    <view class="lw-go {{(spinning || !canDraw) ? 'off' : ''}}" bindtap="draw">{{spinning ? '…' : (canDraw ? '抽奖' : (hasResult ? '已抽' : '抽奖'))}}</view>
  </view>
  <view class="lw-legend">
    <view class="lw-chip" wx:for="{{state.prizes}}" wx:key="key">
      <view class="lw-dot" style="background:{{item.color}}"></view>{{item.label}}
    </view>
  </view>
</view></view>

<view class="card" wx:if="{{state.pre}}"><view class="pad">
  <view class="muted">报名前</view>
  <view class="title">{{state.pre.prizeLabel}}</view>
  <view class="muted" wx:if="{{state.pre.prizeInfo && state.pre.level < 9}}">{{state.pre.prizeInfo}}{{state.pre.rate != null ? ' · 中奖率 ' + state.pre.rate + '%' : ''}}</view>
  <view class="muted" wx:if="{{state.pre.claimHint}}">{{state.pre.claimHint}}</view>
</view></view>
<view class="card" wx:if="{{state.post}}"><view class="pad">
  <view class="muted">报名后{{state.post.doubled ? ' · 两次一致' : ''}}</view>
  <view class="title">{{state.post.prizeLabel}}</view>
  <view class="muted" wx:if="{{state.post.prizeInfo && state.post.level < 9}}">{{state.post.prizeInfo}}{{state.post.rate != null ? ' · 中奖率 ' + state.post.rate + '%' : ''}}</view>
  <view class="muted" wx:if="{{state.post.claimHint}}">{{state.post.claimHint}}</view>
</view></view>
<view class="btn" wx:if="{{state.canClaim}}" bindtap="claim">{{claiming ? '领取中…' : '跟团结束，领取奖品'}}</view>
<view class="pad" wx:if="{{msg}}">{{msg}}</view>
<view class="pad muted" wx:if="{{!canLogin}}">登录后才能转动圆盘。</view>
<view class="pad muted" wx:elif="{{hint}}">{{hint}}</view>

<view class="lw-mask" wx:if="{{fx}}" bindtap="closeFx">
  <view class="lw-burst lv{{fx.level || 9}}"></view>
  <view class="lw-card lv{{fx.level || 9}}" catchtap="noop">
    <view class="lw-em">{{fxTitle}}</view>
    <view class="title">{{fx.prizeLabel}}</view>
    <view class="muted" wx:if="{{fx.prizeInfo && fx.level < 9}}">奖品：{{fx.prizeInfo}}</view>
    <view class="muted" wx:if="{{fx.rate != null && fx.level < 9}}">这档中奖率 {{fx.rate}}%</view>
    <view class="muted" wx:if="{{fx.doubled}}">两次奖品一致，领取时翻倍</view>
    <view class="muted" wx:elif="{{fx.level >= 9}}">下次再来</view>
    <view class="muted" wx:elif="{{fx.claimHint}}">{{fx.claimHint}}</view>
    <view class="btn" bindtap="closeFx">好的</view>
  </view>
</view>
