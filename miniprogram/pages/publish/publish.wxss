@import "../../styles/account.wxss";

.pub-page-head { padding: 34rpx 32rpx 22rpx; }
.pub-page-head .section-title { margin-top: 10rpx; font-size: calc(42rpx * var(--ui-scale)); }
.pub-lead { color: #8a8390; font-size: calc(23rpx * var(--ui-scale)); margin-top: 12rpx; line-height: 1.55; }
.pub-steps { display: flex; align-items: center; justify-content: space-between; margin-top: 28rpx; }
.pub-step { display: flex; align-items: center; gap: 8rpx; color: #a29ba9; font-size: calc(19rpx * var(--ui-scale)); white-space: nowrap; }
.pub-step text { display: flex; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border-radius: 50%; color: #928d98; background: #ece9f0; font-size: 17rpx; }
.pub-step.on { color: #5b3b8c; font-weight: 600; }
.pub-step.on text { color: #fff; background: #5b3b8c; }
.pub-step-line { flex: 1; min-width: 14rpx; height: 1rpx; background: #e6e2ea; margin: 0 8rpx; }
.pub-intro { margin: 20rpx 28rpx 14rpx; color: #82778d; padding: 18rpx 22rpx; border-radius: 16rpx; background: #efeaf7; font-size: calc(23rpx * var(--ui-scale)); line-height: 1.55; }


.pub-card {
  margin: 18rpx 28rpx 26rpx;
  padding: 8rpx 8rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 1px solid #f0f0f0;
}
.pub-h {
  padding: 20rpx 16rpx 4rpx;
  font-size: calc(32rpx * var(--ui-scale));
  font-weight: 700;
}
.pub-label {
  margin: 16rpx 16rpx 0;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
}
.pub-field,
.pub-pick {
  margin: 10rpx 16rpx 0;
  padding: 20rpx 22rpx;
  background: #f7f7f8;
  border-radius: 16rpx;
  color: #1a1a1a;
  font-size: calc(28rpx * var(--ui-scale));
}
.pub-area { min-height: 140rpx; width: auto; }
.pub-note {
  margin: 10rpx 16rpx 0;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
}
.pub-row { display: flex; gap: 8rpx; }
.pub-col { flex: 1; min-width: 0; }
.pub-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 16rpx 0;
  padding: 18rpx 8rpx;
  font-size: calc(28rpx * var(--ui-scale));
}
.pub-mark {
  flex: none;
  min-width: 72rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f4f6;
  color: #8d8d8d;
  text-align: center;
  font-size: calc(24rpx * var(--ui-scale));
  font-weight: 700;
}
.pub-mark.on { background: #5b3b8c; color: #fff; }
.target-card {
  margin: 12rpx 16rpx 0;
  padding: 8rpx 0 12rpx;
  border: 1px solid #e8e1f0;
  border-radius: 18rpx;
  background: #fff;
}
.pub-link {
  margin: 12rpx 16rpx 0;
  color: #5b3b8c;
  font-size: calc(26rpx * var(--ui-scale));
  font-weight: 700;
}
.pub-link.add { display: inline-block; }
.ratio-block { background: #fff; }
.ratio-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 16rpx 0;
  font-size: calc(26rpx * var(--ui-scale));
}
.ratio-name { font-weight: 700; margin-right: 8rpx; }
.ratio-num { min-width: 36rpx; text-align: center; font-weight: 700; }
.ratio-step {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f7f7f8;
  color: #1a1a1a;
  font-weight: 700;
}
.kind-grid { display: flex; flex-wrap: wrap; }
.sheet {
  margin: 16rpx 28rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  border: 1px solid #eeebf1;
  overflow: hidden;
}
.line {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 28rpx;
  border-bottom: 1px solid #f4f4f5;
}
.k {
  width: 168rpx;
  flex: none;
  color: #3a3a3a;
  font-size: calc(28rpx * var(--ui-scale));
}
.k.wide { width: auto; flex: 1; }
.grow { flex: 1; min-width: 0; }
.v {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-height: 100rpx;
  color: #1a1a1a;
  font-size: calc(28rpx * var(--ui-scale));
  text-align: right;
}
.v.ph, .sv.ph { color: #b0b0b6; }
.field {
  height: 100rpx;
  text-align: right;
  font-size: calc(28rpx * var(--ui-scale));
}
.chev { color: #c8c8cc; font-size: 40rpx; line-height: 1; }
.hint {
  padding: 8rpx 28rpx 16rpx;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
  background: #fff;
}
.hint.flat { padding-top: 0; }
.field-error.in { margin: 0 28rpx 12rpx; }
.sw {
  width: 92rpx;
  height: 54rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #e7e7ec;
  flex: none;
}
.sw.on { background: #725495; }
.sw.locked { opacity: 0.35; }
.knob {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.16);
}
.sw.on .knob { margin-left: 38rpx; }
.scope { padding: 8rpx 0 12rpx; background: #fff; }
.scope-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 0;
  font-size: calc(28rpx * var(--ui-scale));
  font-weight: 700;
}
.add { color: #5b3b8c; font-weight: 600; font-size: calc(24rpx * var(--ui-scale)); }
.scope-card {
  margin: 16rpx 28rpx 0;
  border: 1px solid #e5e0e9;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
}
.scope-line {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-bottom: 1px solid #eeeeee;
}
.sk { width: 88rpx; color: #8d8d8d; font-size: calc(26rpx * var(--ui-scale)); }
.ratio-label { width: auto; color: #1c1c1e; font-weight: 600; }
.scope-line .sw { margin-left: auto; }
.scope-slider { padding: 4rpx 20rpx 8rpx; }
.sv { flex: 1; text-align: right; font-size: calc(28rpx * var(--ui-scale)); }
.scope-del {
  padding: 18rpx 20rpx;
  color: #7f638e;
  text-align: right;
  font-size: calc(26rpx * var(--ui-scale));
  font-weight: 700;
}
.ratio-copy { flex: 1; min-width: 0; display: flex; flex-direction: column; justify-content: center; padding: 16rpx 0; }
.ratio-title { color: #3a3a3a; font-size: calc(28rpx * var(--ui-scale)); }
.ratio-sub { margin-top: 4rpx; color: #8e8e93; font-size: calc(22rpx * var(--ui-scale)); line-height: 1.3; }
.ratio-panel { padding: 4rpx 28rpx 16rpx; border-bottom: 1px solid #f4f4f5; }
.ratio-foot {
  display: block;
  margin-top: 4rpx;
  color: #8e8e93;
  font-size: calc(22rpx * var(--ui-scale));
  line-height: 1.4;
}
.ratio-figures { display: flex; justify-content: space-between; margin-top: 8rpx; }
.ratio-fig { display: flex; flex-direction: column; }
.ratio-fig.end { align-items: flex-end; }
.ratio-unit { color: #8e8e93; font-size: calc(22rpx * var(--ui-scale)); }
.ratio-num {
  margin-top: 2rpx;
  color: #1c1c1e;
  font-size: calc(44rpx * var(--ui-scale));
  font-weight: 600;
  line-height: 1.1;
}
.ratio.dim { opacity: 0.45; }
.ratio-name { font-weight: 700; }
.colon { font-weight: 700; }
.stepper {
  display: flex;
  align-items: center;
  height: 64rpx;
  border: 1px solid #eadfe0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}
.step {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #5b3b8c;
  font-size: 36rpx;
  font-weight: 600;
}
.num { min-width: 48rpx; text-align: center; font-weight: 700; }
.note-block { padding: 20rpx 28rpx 24rpx; }
.note {
  width: auto;
  min-height: 120rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  background: #f7f7f8;
  border-radius: 16rpx;
  font-size: calc(28rpx * var(--ui-scale));
}
.scope-empty { margin: 0 28rpx 20rpx; padding: 20rpx; border-radius: 12rpx; background: #f7f5f9; color: #62576c; font-size: calc(24rpx * var(--ui-scale)); }
.scope-empty text { display: block; margin-top: 4rpx; color: #a099a7; font-size: calc(21rpx * var(--ui-scale)); }
.btn { margin: 8rpx 28rpx 36rpx; }

.pub-confirm { margin: 0 28rpx 24rpx; padding: 26rpx; border: 1rpx solid #e9e1f1; border-radius: 24rpx; background: #f0ebf7; color: #5b3b8c; font-size: calc(25rpx * var(--ui-scale)); }
.pub-confirm > view { font-weight: 600; margin-bottom: 12rpx; }
.pub-confirm text { display: block; color: #8b7b9b; font-size: calc(23rpx * var(--ui-scale)); line-height: 1.7; }
.pub-review-note { text-align: center; font-size: calc(22rpx * var(--ui-scale)); color: #a095aa; margin: 0 32rpx 18rpx; }


/* Activity publish uses the same fine pen as the discovery page. */
.pub-activity { --pub-purple:#5b3b8c; --pub-ink:#2c2635; --pub-muted:#8f839b; --pub-card:#fff; --pub-soft:#f7f2fc; --pub-line:#ece5f3; --pub-edge:#e2d6ed; --pub-field:#f8f6fa; }
.pub-activity.is-dark { --pub-purple:#cfb5ee; --pub-ink:#eee8f4; --pub-muted:#b1a0bf; --pub-card:#211d28; --pub-soft:#302439; --pub-line:#3a2d45; --pub-edge:#584169; --pub-field:#29212f; }
.pub-activity .pub-card { border-color:var(--pub-line); background:var(--pub-card); padding:10rpx 12rpx 26rpx; }
.pub-activity .pub-h { padding-top:23rpx; font-size:calc(29rpx * var(--ui-scale)); font-weight:600; color:var(--pub-ink); line-height:1.6; }
.pub-activity .pub-label { color:var(--pub-muted); font-size:calc(23rpx * var(--ui-scale)); }
.pub-activity .pub-field,.pub-activity .pub-pick { color:var(--pub-ink); background:var(--pub-field); padding:21rpx; border:1rpx solid var(--pub-line); }
.pub-activity .pub-note { color:var(--pub-muted); font-size:calc(22rpx * var(--ui-scale)); line-height:1.7; margin-top:14rpx; }
.pub-activity .field-error { color:#ac536a; margin-left:16rpx; margin-right:16rpx; line-height:1.6; }
.pub-activity.is-dark .field-error { color:#f1a5b8; }
.pub-kind-guide { margin:20rpx 16rpx; padding:22rpx; border:1rpx solid var(--pub-edge); border-radius:20rpx; background:var(--pub-soft); color:var(--pub-purple); line-height:1.6; }
.pub-kind-guide > view { font-size:calc(26rpx * var(--ui-scale)); font-weight:550; }
.pub-kind-guide > text { display:block; margin-top:8rpx; font-size:calc(22rpx * var(--ui-scale)); color:var(--pub-muted); }
.pub-interest-icon { position:relative; margin:0 auto 17rpx; width:56rpx; height:56rpx; color:var(--pub-purple); }
.pub-art-card { position:absolute; width:31rpx; height:43rpx; box-sizing:border-box; border:2rpx solid; border-radius:6rpx; }
.pub-art-card.back { top:5rpx; left:7rpx; transform:rotate(-19deg); }
.pub-art-card.front { top:8rpx; left:20rpx; background:var(--pub-card); transform:rotate(12deg); }
.act-kind.on .pub-art-card.front { background:var(--pub-soft); }
.pub-art-diamond { position:absolute; width:12rpx; height:12rpx; border:2rpx solid; box-sizing:border-box; left:8rpx; top:14rpx; transform:rotate(45deg) skew(6deg,6deg); }
.pub-art-head { position:absolute; width:10rpx; height:10rpx; border:2rpx solid; border-radius:50%; left:30rpx; top:3rpx; box-sizing:border-box; }
.pub-art-body { position:absolute; left:26rpx; top:17rpx; height:22rpx; width:0; border-left:2rpx solid; transform:rotate(25deg); }
.pub-art-arm { position:absolute; left:17rpx; top:18rpx; width:23rpx; height:13rpx; border-left:2rpx solid; border-bottom:2rpx solid; transform:rotate(24deg); border-radius:0 0 0 3rpx; }
.pub-art-leg { position:absolute; width:20rpx; height:14rpx; border-bottom:2rpx solid; border-left:2rpx solid; border-radius:0 0 0 3rpx; }
.pub-art-leg.first { top:35rpx; left:13rpx; transform:rotate(-32deg); }
.pub-art-leg.second { top:31rpx; left:27rpx; transform:rotate(205deg); }
.pub-art-speed { position:absolute; left:2rpx; top:19rpx; height:2rpx; width:10rpx; border-radius:4rpx; background:currentColor; box-shadow:-3rpx 8rpx 0 currentColor; }
.pub-art-film { position:absolute; inset:9rpx 2rpx; border:2rpx solid; border-radius:7rpx; }
.pub-art-film-hole { position:absolute; top:4rpx; bottom:4rpx; left:5rpx; width:5rpx; border-top:5rpx solid; border-bottom:5rpx solid; box-sizing:border-box; }
.pub-art-film-hole::after { content:''; position:absolute; left:31rpx; top:-5rpx; height:26rpx; width:5rpx; border-top:5rpx solid; border-bottom:5rpx solid; box-sizing:border-box; }
.pub-art-play { position:absolute; top:9rpx; left:20rpx; width:0; height:0; border-top:8rpx solid transparent; border-bottom:8rpx solid transparent; border-left:10rpx solid; }
.pub-art-person { position:absolute; width:15rpx; height:15rpx; border:2rpx solid; border-radius:50%; box-sizing:border-box; top:7rpx; }
.pub-art-person.one { left:10rpx; }
.pub-art-person.two { left:34rpx; top:13rpx; width:12rpx; height:12rpx; }
.pub-art-shoulder { position:absolute; height:20rpx; border:2rpx solid; border-bottom:0; border-radius:20rpx 20rpx 0 0; bottom:7rpx; box-sizing:border-box; }
.pub-art-shoulder.one { width:29rpx; left:3rpx; }
.pub-art-shoulder.two { width:20rpx; left:33rpx; height:15rpx; }
.pub-art-star { position:absolute; left:35rpx; top:1rpx; width:10rpx; height:2rpx; background:currentColor; }
.pub-art-star::after { content:''; position:absolute; left:4rpx; top:-4rpx; height:10rpx; width:2rpx; background:currentColor; }
.pub-card .kind-grid { display:flex; gap:12rpx; padding:20rpx 16rpx 6rpx; }
.pub-card .act-kind { flex:1; min-width:0; padding:24rpx 4rpx 18rpx; border:1rpx solid var(--pub-line); border-radius:18rpx; text-align:center; font-size:calc(24rpx * var(--ui-scale)); line-height:1.6; color:var(--pub-muted); }
.pub-card .act-kind.on { background:var(--pub-soft); border-color:var(--pub-edge); color:var(--pub-purple); }
