@import "../../styles/account.wxss";

.pub-intro {
  margin: 16rpx 24rpx 0;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
}
.pub-card {
  margin: 16rpx;
  padding: 8rpx 8rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 1px solid #f0f0f0;
}
.pub-h {
  padding: 20rpx 16rpx 4rpx;
  font-size: calc(32rpx * var(--ui-scale));
  font-weight: 700;
}
.pub-label {
  margin: 16rpx 16rpx 0;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
}
.pub-field,
.pub-pick {
  margin: 10rpx 16rpx 0;
  padding: 20rpx 22rpx;
  background: #f7f7f8;
  border-radius: 16rpx;
  color: #1a1a1a;
  font-size: calc(28rpx * var(--ui-scale));
}
.pub-area { min-height: 140rpx; width: auto; }
.pub-note {
  margin: 10rpx 16rpx 0;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
}
.pub-row { display: flex; gap: 8rpx; }
.pub-col { flex: 1; min-width: 0; }
.pub-switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 16rpx 0;
  padding: 18rpx 8rpx;
  font-size: calc(28rpx * var(--ui-scale));
}
.pub-mark {
  flex: none;
  min-width: 72rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f4f6;
  color: #8d8d8d;
  text-align: center;
  font-size: calc(24rpx * var(--ui-scale));
  font-weight: 700;
}
.pub-mark.on { background: #8c3038; color: #fff; }
.target-card {
  margin: 12rpx 16rpx 0;
  padding: 8rpx 0 12rpx;
  border: 1px solid #f0d4d6;
  border-radius: 18rpx;
  background: #fffdfd;
}
.pub-link {
  margin: 12rpx 16rpx 0;
  color: #8c3038;
  font-size: calc(26rpx * var(--ui-scale));
  font-weight: 700;
}
.pub-link.add { display: inline-block; }
.ratio-block {
  margin: 12rpx 16rpx 0;
  padding: 4rpx 0 12rpx;
  border: 1px solid #d9d9d9;
  border-radius: 18rpx;
}
.ratio-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 8rpx 16rpx 0;
  font-size: calc(26rpx * var(--ui-scale));
}
.ratio-name { font-weight: 700; margin-right: 8rpx; }
.ratio-num { min-width: 36rpx; text-align: center; font-weight: 700; }
.ratio-step {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 12rpx;
  background: #f7f7f8;
  color: #1a1a1a;
  font-weight: 700;
}
.kind-grid { display: flex; flex-wrap: wrap; }
.sheet {
  margin: 16rpx;
  background: #fff;
  border-radius: 28rpx;
  border: 1px solid #f0e8e8;
  overflow: hidden;
}
.line {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  padding: 0 28rpx;
  border-bottom: 1px solid #f4f4f5;
}
.k {
  width: 168rpx;
  flex: none;
  color: #3a3a3a;
  font-size: calc(28rpx * var(--ui-scale));
}
.k.wide { width: auto; flex: 1; }
.grow { flex: 1; min-width: 0; }
.v {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  min-height: 100rpx;
  color: #1a1a1a;
  font-size: calc(28rpx * var(--ui-scale));
  text-align: right;
}
.v.ph, .sv.ph { color: #b0b0b6; }
.field {
  height: 100rpx;
  text-align: right;
  font-size: calc(28rpx * var(--ui-scale));
}
.chev { color: #c8c8cc; font-size: 40rpx; line-height: 1; }
.hint {
  padding: 8rpx 28rpx 16rpx;
  color: #8d8d8d;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
  background: #fff;
}
.hint.flat { padding-top: 0; }
.field-error.in { margin: 0 28rpx 12rpx; }
.sw {
  width: 92rpx;
  height: 54rpx;
  padding: 4rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #e7e7ec;
  flex: none;
}
.sw.on { background: #8c3038; }
.knob {
  width: 46rpx;
  height: 46rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.16);
}
.sw.on .knob { margin-left: 38rpx; }
.scope { padding: 8rpx 0 12rpx; background: #fff; }
.scope-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 0;
  font-size: calc(28rpx * var(--ui-scale));
  font-weight: 700;
}
.add { color: #8c3038; font-weight: 700; font-size: calc(26rpx * var(--ui-scale)); }
.scope-card {
  margin: 16rpx 28rpx 0;
  border: 1px solid #d9d9d9;
  border-radius: 20rpx;
  overflow: hidden;
  background: #fff;
}
.scope-line {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-bottom: 1px solid #eeeeee;
}
.sk { width: 88rpx; color: #8d8d8d; font-size: calc(26rpx * var(--ui-scale)); }
.sv { flex: 1; text-align: right; font-size: calc(28rpx * var(--ui-scale)); }
.scope-del {
  padding: 18rpx 20rpx;
  color: #8c3038;
  text-align: right;
  font-size: calc(26rpx * var(--ui-scale));
  font-weight: 700;
}
.ratio-lead {
  padding: 0 28rpx 16rpx;
  color: #8e8e93;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.45;
}
.ratio-lead.foot { padding-top: 4rpx; }
.ratio-card {
  margin: 0 28rpx 16rpx;
  padding: 22rpx 24rpx 4rpx;
  border: 1px solid #d9d9d9;
  border-radius: 20rpx;
  background: rgba(0, 0, 0, 0.03);
}
.ratio-card.dim { opacity: 0.45; }
.ratio-kicker {
  display: block;
  color: #1c1c1e;
  font-size: calc(28rpx * var(--ui-scale));
  font-weight: 600;
  line-height: 1.3;
}
.ratio-meta {
  display: block;
  margin-top: 4rpx;
  color: #8e8e93;
  font-size: calc(22rpx * var(--ui-scale));
}
.ratio-figures { display: flex; justify-content: space-between; margin-top: 16rpx; }
.ratio-fig { display: flex; flex-direction: column; }
.ratio-fig.end { align-items: flex-end; }
.ratio-unit { color: #8e8e93; font-size: calc(22rpx * var(--ui-scale)); }
.ratio-num {
  margin-top: 2rpx;
  color: #1c1c1e;
  font-size: calc(44rpx * var(--ui-scale));
  font-weight: 600;
  line-height: 1.1;
}
.ratio.dim { opacity: 0.45; }
.ratio-name { font-weight: 700; }
.colon { font-weight: 700; }
.stepper {
  display: flex;
  align-items: center;
  height: 64rpx;
  border: 1px solid #eadfe0;
  border-radius: 16rpx;
  overflow: hidden;
  background: #fff;
}
.step {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  color: #8c3038;
  font-size: 36rpx;
  font-weight: 600;
}
.num { min-width: 48rpx; text-align: center; font-weight: 700; }
.note-block { padding: 20rpx 28rpx 24rpx; }
.note {
  width: auto;
  min-height: 120rpx;
  margin-top: 12rpx;
  padding: 16rpx 18rpx;
  background: #f7f7f8;
  border-radius: 16rpx;
  font-size: calc(28rpx * var(--ui-scale));
}
.btn { margin: 8rpx 16rpx 32rpx; }
