<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="pub-page-head" wx:if="{{form.channel!='activity'}}">
  <view class="section-kicker">PLAN A TRIP, BRING PEOPLE TOGETHER</view>
  <view class="section-title">{{tr.t('发起一场同行', lang)}}</view>
  <view class="pub-lead">{{tr.t('选好线路与出发时间，再决定由谁发起、谁可以报名。', lang)}}</view>
</view>
<view class="pub-page-head" wx:if="{{form.channel=='activity'}}"><view class="section-kicker">CREATE A CITY MOMENT</view><view class="section-title">{{tr.t('好时光，由你发起', lang)}}</view><view class="pub-lead">{{tr.t('把兴趣、时间和地点说清楚，让同好放心加入。', lang)}}</view></view>
<view class="pub-intro" wx:if="{{form.channel=='activity'}}">{{tr.t('提交后需审核，通过后出现在活动 Tab。', lang)}}</view>

<view class="pub-activity {{dark?'is-dark':''}}" wx:if="{{form.channel=='activity'}}">
  <view class="pub-card">
    <view class="pub-h">{{tr.t('01 选一种共同的喜欢', lang)}}</view>
    <view class="kind-grid">
      <view class="act-kind {{form.activityKind==item.key?'on':''}}" wx:for="{{kinds}}" wx:key="key" bindtap="pickKind" data-key="{{item.key}}">
        <view class="pub-interest-icon {{item.slug}}" aria-hidden="true">
          <block wx:if="{{item.slug=='cards'}}"><view class="pub-art-card back"></view><view class="pub-art-card front"><view class="pub-art-diamond"></view></view></block>
          <block wx:elif="{{item.slug=='run'}}"><view class="pub-art-head"></view><view class="pub-art-body"></view><view class="pub-art-arm"></view><view class="pub-art-leg first"></view><view class="pub-art-leg second"></view><view class="pub-art-speed"></view></block>
          <block wx:elif="{{item.slug=='movie'}}"><view class="pub-art-film"><view class="pub-art-film-hole"></view><view class="pub-art-play"></view></view></block>
          <block wx:else><view class="pub-art-person one"></view><view class="pub-art-person two"></view><view class="pub-art-shoulder one"></view><view class="pub-art-shoulder two"></view><view class="pub-art-star"></view></block>
        </view>
        <view>{{tr.t(item.label, lang)}}</view>
      </view>
    </view>
    <view class="pub-kind-guide"><view>{{tr.t(selectedActivityKind.title, lang)}}</view><text>{{tr.t(selectedActivityKind.description, lang)}}</text></view>
    <view class="pub-label">{{tr.t('活动名称', lang)}}</view>
    <input class="pub-field" placeholder="{{tr.t(selectedActivityKind.titlePlaceholder, lang)}}" maxlength="60" value="{{form.title}}" bindinput="setField" data-k="title" />
    <view class="field-error" wx:if="{{errors.title}}">{{tr.t(errors.title, lang)}}</view>
  </view>
  <view class="pub-card">
    <view class="pub-h">{{tr.t('02 把见面的细节定下来', lang)}}</view>
    <view class="pub-label">{{tr.t('具体集合地点', lang)}}</view>
    <input class="pub-field" placeholder="{{tr.t('地点，例如三里屯太古里', lang)}}" value="{{form.meetupPoint}}" bindinput="setField" data-k="meetupPoint" />
    <view class="field-error" wx:if="{{errors.meetupPoint}}">{{tr.t(errors.meetupPoint, lang)}}</view>
    <view class="pub-label">{{tr.t('城区', lang)}}</view>
    <picker mode="selector" range="{{cityNames}}" value="{{cityIndex}}" bindchange="setCityPick">
      <view class="pub-pick">{{tr.t(form.city || '选择城区', lang)}}</view>
    </picker>
    <view class="field-error" wx:if="{{errors.city}}">{{tr.t(errors.city, lang)}}</view>
    <view class="pub-row">
      <view class="pub-col">
        <view class="pub-label">{{tr.t('日期', lang)}}</view>
        <picker mode="selector" range="{{dateLabels}}" value="{{dateIndex}}" bindchange="setDate">
          <view class="pub-pick">{{tr.t(dateLabels[dateIndex], lang)}}</view>
        </picker>
        <view class="field-error" wx:if="{{errors.startDate}}">{{tr.t(errors.startDate, lang)}}</view>
      </view>
      <view class="pub-col">
        <view class="pub-label">{{tr.t('时间', lang)}}</view>
        <picker mode="time" value="{{form.meetupTime}}" bindchange="setMeetupTime">
          <view class="pub-pick">{{form.meetupTime}}</view>
        </picker>
        <view class="field-error" wx:if="{{errors.meetupTime}}">{{tr.t(errors.meetupTime, lang)}}</view>
      </view>
    </view>
    <view class="pub-row">
      <view class="pub-col">
        <view class="pub-label">{{tr.t('最少几人成局', lang)}}</view>
        <input class="pub-field" type="number" placeholder="{{tr.t('最少几人成局', lang)}}" value="{{form.minGroupSize}}" bindinput="setField" data-k="minGroupSize" />
        <view class="field-error" wx:if="{{errors.minGroupSize}}">{{tr.t(errors.minGroupSize, lang)}}</view>
      </view>
      <view class="pub-col">
        <view class="pub-label">{{tr.t('人数上限', lang)}}</view>
        <input class="pub-field" type="number" placeholder="{{tr.t('人数上限', lang)}}" value="{{form.maxSeats}}" bindinput="setField" data-k="maxSeats" />
        <view class="field-error" wx:if="{{errors.maxSeats}}">{{tr.t(errors.maxSeats, lang)}}</view>
      </view>
    </view>
    <view class="pub-label">{{tr.t('费用（元，0 为免费）', lang)}}</view>
    <input class="pub-field" type="digit" placeholder="{{tr.t('费用（元，0 为免费）', lang)}}" value="{{form.originPrice}}" bindinput="setField" data-k="originPrice" />
    <view class="field-error" wx:if="{{errors.originPrice}}">{{tr.t(errors.originPrice, lang)}}</view>
    <view class="pub-note">{{tr.t('费用填 0 为免费；如有场地、茶位或票款，请在下面说明。', lang)}}</view>
  </view>
  <view class="pub-card">
    <view class="pub-h">{{tr.t('03 让大家报名前就了解', lang)}}</view>
    <view class="pub-kind-guide"><view>{{tr.t(selectedActivityKind.title, lang)}}</view><text>{{tr.t(selectedActivityKind.notice, lang)}}</text></view>
    <block wx:for="{{activityFields}}" wx:key="key">
      <view class="pub-label">{{tr.t(item.label, lang)}}<text wx:if="{{!item.required}}"> · {{tr.t('选填', lang)}}</text></view>
      <input class="pub-field" placeholder="{{tr.t(item.placeholder, lang)}}" value="{{form.activityDetails[item.key]}}" maxlength="120" bindinput="setActivityField" data-key="{{item.key}}" />
    </block>
    <view class="field-error" wx:if="{{errors.activityDetails}}">{{tr.t(errors.activityDetails, lang)}}</view>
    <view class="pub-label">{{tr.t('补充介绍 · 选填', lang)}}</view>
    <textarea class="pub-field pub-area" placeholder="{{tr.t(selectedActivityKind.descriptionPlaceholder, lang)}}" value="{{form.description}}" bindinput="setField" data-k="description" maxlength="1200" />

  </view>
</view>

<view class="sheet" wx:else>
  <view class="line">
    <text class="k">{{tr.t('线路', lang)}}</text>
    <picker class="grow" mode="selector" range="{{routeTitles}}" value="{{routeIndex}}" bindchange="setRoute" disabled="{{!routeTitles.length}}">
      <view class="v {{form.routeId ? '' : 'ph'}}">{{routeLabel}}<text class="chev">›</text></view>
    </picker>
  </view>
  <view class="field-error in" wx:if="{{errors.routeId}}">{{tr.t(errors.routeId, lang)}}</view>

  <view class="line">
    <text class="k">{{tr.t('日期', lang)}}</text>
    <picker class="grow" mode="selector" range="{{dateLabels}}" value="{{dateIndex}}" bindchange="setDate">
      <view class="v">{{dateLabels[dateIndex]}}<text class="chev">›</text></view>
    </picker>
  </view>

  <view class="line">
    <text class="k">{{tr.t('类型', lang)}}</text>
    <picker class="grow" mode="selector" range="{{organizerLabels}}" value="{{organizerIndex}}" bindchange="setOrganizer">
      <view class="v">{{tr.t(organizerLabels[organizerIndex], lang)}}<text class="chev">›</text></view>
    </picker>
  </view>
  <view class="hint host-hint">{{tr.t('个人轻松拼团，公司统一组织出行，高校可自定义跨校、跨学院招募范围。', lang)}}</view>

  <view class="line" wx:if="{{form.organizerType=='company'}}">
    <text class="k">{{tr.t('公司名称', lang)}}</text>
    <input class="grow field" placeholder="{{tr.t('公司全称', lang)}}" value="{{form.companyName}}" bindinput="setCompanyName" />
  </view>
  <view class="line" wx:if="{{form.organizerType=='campus'}}" bindtap="pickCompanySchool">
    <text class="k">{{tr.t('发起学校', lang)}}</text>
    <view class="v {{form.companyName ? '' : 'ph'}}">{{tr.t(form.companyName || '选择学校', lang)}}<text class="chev">›</text></view>
  </view>
  <view class="hint" wx:if="{{form.organizerType=='company'}}">{{tr.t('团上会显示公司名称，方便同事识别。报名人数与结算由发起方统一安排。', lang)}}</view>
  <view class="hint" wx:if="{{form.organizerType=='campus'}}">{{tr.t('这里填写组织方学校。招募对象可来自本校、其他学校，也可以按学院设置。', lang)}}</view>
  <view class="field-error in" wx:if="{{errors.companyName}}">{{tr.t(errors.companyName, lang)}}</view>

  <view class="line">
    <text class="k">{{tr.t('车型', lang)}}</text>
    <picker class="grow" mode="selector" range="{{busNames}}" value="{{busIndex}}" bindchange="setBus">
      <view class="v">{{busNames[busIndex] || tr.t('请选择', lang)}}<text class="chev">›</text></view>
    </picker>
  </view>

  <view class="line">
    <text class="k">{{tr.t('成团人数', lang)}}</text>
    <input class="grow field" type="number" value="{{form.minGroupSize}}" bindinput="setField" data-k="minGroupSize" />
  </view>

  <view class="line">
    <text class="k">{{tr.t('集合点', lang)}}</text>
    <picker class="grow" mode="selector" range="{{meetupNames}}" value="{{meetupIndex}}" bindchange="setMeetup">
      <view class="v">{{tr.t(meetupNames[meetupIndex], lang)}}<text class="chev">›</text></view>
    </picker>
  </view>

  <view class="line">
    <text class="k">{{tr.t('集合时间', lang)}}</text>
    <picker class="grow" mode="time" value="{{form.meetupTime}}" bindchange="setMeetupTime">
      <view class="v">{{form.meetupTime}}<text class="chev">›</text></view>
    </picker>
  </view>

  <view class="line">
    <text class="k">{{tr.t('团型', lang)}}</text>
    <picker class="grow" mode="selector" range="{{offerLabels}}" value="{{offerIndex}}" bindchange="setOffer">
      <view class="v">{{tr.t(offerLabels[offerIndex], lang)}}<text class="chev">›</text></view>
    </picker>
  </view>
  <block wx:if="{{form.offerType=='combo'}}">
    <view class="hint">{{tr.t('组合团只对学生或已认证学生组织开放。', lang)}}</view>
    <view class="line">
      <text class="k">{{tr.t('另一半身份', lang)}}</text>
      <picker class="grow" mode="selector" range="{{comboRequireLabels}}" value="{{comboRequireIndex}}" bindchange="setComboRequire">
        <view class="v">{{tr.t(comboRequireLabels[comboRequireIndex], lang)}}<text class="chev">›</text></view>
      </picker>
    </view>
    <view class="line" bindtap="pickComboSchool">
      <text class="k">{{tr.t('学校', lang)}}</text>
      <view class="v {{form.comboRule.school ? '' : 'ph'}}">{{form.comboRule.school || tr.t('另一半学校', lang)}}<text class="chev">›</text></view>
    </view>
  </block>

  <block wx:if="{{form.organizerType=='campus'}}">
    <view class="line" bindtap="toggleStudentOnly">
      <text class="k wide">{{tr.t('仅师生', lang)}}</text>
      <view class="sw {{form.studentOnly ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="line" bindtap="toggleAlumniOk">
      <text class="k wide">{{tr.t('允许校友', lang)}}</text>
      <view class="sw {{form.alumniOk ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="line" bindtap="toggleOversub">
      <text class="k wide">{{tr.t('超额抽签', lang)}}</text>
      <view class="sw {{form.oversub ? 'on' : ''}}"><view class="knob"></view></view>
    </view>
    <view class="hint">{{tr.t('报名超过座位时抽签确认出行人，没超过就全部确认。', lang)}}</view>
    <view class="hint" wx:if="{{form.offerType=='free'}}">{{tr.t('免费团如果报名范围留空，默认只让发起学校的师生报名。', lang)}}</view>

    <view class="scope">
      <view class="scope-h">
        <text>{{tr.t('报名范围', lang)}}</text>
        <text class="add" bindtap="addCampusTarget">＋ {{tr.t('添加招募范围', lang)}}</text>
      </view>
      <view class="hint flat">{{tr.t('按学校设定基础范围，还可继续细分到学院与专业。不同学校和学院可同时参与。', lang)}}<text wx:if="{{form.offerType!='free'}}">{{tr.t('留空则按团型规则开放。', lang)}}</text></view>
      <view class="scope-empty" wx:if="{{!form.campusTargets.length}}">{{tr.t('暂未限定学校或学院', lang)}}<text>{{tr.t(form.offerType=='free' ? '未填写时，默认只对发起学校的师生开放' : '可面向所有符合条件的报名者开放', lang)}}</text></view>
      <view class="scope-card" wx:for="{{form.campusTargets}}" wx:key="index">
        <view class="scope-line" bindtap="pickTargetSchool" data-i="{{index}}">
          <text class="sk">{{tr.t('学校', lang)}}</text>
          <text class="sv {{item.school ? '' : 'ph'}}">{{item.school || tr.t('请选择', lang)}}</text>
          <text class="chev">›</text>
        </view>
        <view class="scope-line" bindtap="pickTargetCollege" data-i="{{index}}">
          <text class="sk">{{tr.t('学院', lang)}}</text>
          <text class="sv {{item.college ? '' : 'ph'}}">{{item.college || tr.t(item.school ? '学院，可空' : '请先选学校', lang)}}</text>
          <text class="chev">›</text>
        </view>
        <view class="scope-line" bindtap="pickTargetMajor" data-i="{{index}}">
          <text class="sk">{{tr.t('专业', lang)}}</text>
          <text class="sv {{item.major ? '' : 'ph'}}">{{item.major || tr.t(item.college ? '专业，可空' : '请先选学院', lang)}}</text>
          <text class="chev">›</text>
        </view>
        <block wx:if="{{item.school}}">
          <view class="scope-line" catchtap="toggleSchoolRatio" data-school="{{item.school}}">
            <text class="sk ratio-label">{{tr.t('男女比例', lang)}}</text>
            <view class="sw {{form.genderRows[index].on && !form.genderRatioOn ? 'on' : ''}} {{form.genderRatioOn ? 'locked' : ''}}"><view class="knob"></view></view>
          </view>
          <view class="scope-slider" wx:if="{{form.genderRows[index].on && !form.genderRatioOn}}">
            <view class="ratio-figures">
              <view class="ratio-fig">
                <text class="ratio-unit">{{tr.t('男生', lang)}}</text>
                <text class="ratio-num">{{form.genderRows[index].share}}</text>
              </view>
              <view class="ratio-fig end">
                <text class="ratio-unit">{{tr.t('女生', lang)}}</text>
                <text class="ratio-num">{{100 - form.genderRows[index].share}}</text>
              </view>
            </view>
            <slider min="0" max="100" value="{{form.genderRows[index].share}}" activeColor="#9874b7" backgroundColor="#ede6f4" block-color="#ffffff" block-size="24" bindchange="setRatio" bindchanging="setRatio" data-bucket="school" data-school="{{item.school}}" />
          </view>
        </block>
        <view class="scope-del" catchtap="removeCampusTarget" data-i="{{index}}">{{tr.t('删除', lang)}}</view>
      </view>
      <view class="field-error in" wx:if="{{errors.campus}}">{{tr.t(errors.campus, lang)}}</view>
    </view>

    <view class="ratio-block">
      <view class="line" bindtap="toggleGender">
        <view class="ratio-copy">
          <text class="ratio-title">{{tr.t('男女比例', lang)}}</text>
          <text class="ratio-sub">{{tr.t(form.schoolRatioOn ? '已按学校设置' : (form.genderRatioOn ? '按全团计算' : '不限制'), lang)}}</text>
        </view>
        <view class="sw {{form.genderRatioOn && !form.schoolRatioOn ? 'on' : ''}} {{form.schoolRatioOn ? 'locked' : ''}}"><view class="knob"></view></view>
      </view>
      <view class="ratio-panel" wx:if="{{form.genderRatioOn && !form.schoolRatioOn}}">
        <view class="ratio-figures">
          <view class="ratio-fig">
            <text class="ratio-unit">{{tr.t('男生', lang)}}</text>
            <text class="ratio-num">{{form.overallMale}}</text>
          </view>
          <view class="ratio-fig end">
            <text class="ratio-unit">{{tr.t('女生', lang)}}</text>
            <text class="ratio-num">{{100 - form.overallMale}}</text>
          </view>
        </view>
        <slider min="0" max="100" value="{{form.overallMale}}" activeColor="#9874b7" backgroundColor="#ede6f4" block-color="#ffffff" block-size="24" bindchange="setRatio" bindchanging="setRatio" data-bucket="overall" />
        <text class="ratio-foot">{{tr.t('男生和女生合计 100。学校不再单独设置。', lang)}}</text>
      </view>
    </view>
  </block>

  <view class="line" bindtap="togglePrivateJoin">
    <text class="k wide">{{tr.t('口令团', lang)}}</text>
    <view class="sw {{form.privateJoin ? 'on' : ''}}"><view class="knob"></view></view>
  </view>
  <view class="line" wx:if="{{form.privateJoin}}">
    <text class="k">{{tr.t('入团口令', lang)}}</text>
    <input class="grow field" maxlength="16" placeholder="{{tr.t('4～16 个字，可空则自动生成', lang)}}" value="{{form.joinCode}}" bindinput="setField" data-k="joinCode" />
  </view>

  <view class="note-block">
    <text class="k">{{tr.t('备注', lang)}}</text>
    <textarea class="note" placeholder="{{tr.t('选填', lang)}}" value="{{form.notes}}" bindinput="setField" data-k="notes" />
  </view>
</view>

<view id="submit-error" class="field-error" wx:if="{{errors.form}}">{{tr.t(errors.form, lang)}}</view>
<view class="pub-confirm" wx:if="{{form.channel!='activity' && form.routeId}}"><view>{{tr.t('出发前，再确认一下', lang)}}</view><text>{{routeLabel}}</text><text>{{form.startDate}} · {{form.meetupTime}} · {{form.meetupPoint}}</text><text>{{tr.t(organizerLabels[organizerIndex], lang)}} · {{form.minGroupSize}}{{tr.t('人成团', lang)}}</text></view>
<view class="pub-review-note">{{tr.t(form.channel=='activity' ? '提交后由平台审核，审核通过后开放报名。' : '发布后即可报名，可分享给同行', lang)}}</view>
<button class="btn clay" bindtap="submit" loading="{{submitting}}" disabled="{{submitting}}">{{tr.t(submitting ? '正在提交' : (form.channel=='activity' ? '提交审核' : '确认发布'), lang)}}</button>
