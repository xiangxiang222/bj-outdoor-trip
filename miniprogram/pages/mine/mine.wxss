@import "../../styles/account.wxss";
page { background: #f7f8fa; color: #25242a; }
.mine-nav { background: #fcf9ff; }
.mine-nav.is-dark { background: #26212e; }
.mine-page { --account-card: #fff; --account-ink: #25242a; --account-muted: #76737d; --account-line: #f2f1f5; --account-soft: #faf7ff; --account-purple: #5b3b8c; --account-accent: #8658d6; --account-benefit-bg: linear-gradient(110deg, #f4e9ff, #fff2e9); --account-benefit-note: #87718e; --account-cta: #fff; --account-create-a: #fff7ef; --account-create-b: #f6efff; box-sizing: border-box; padding: 8rpx 24rpx 4rpx; background: radial-gradient(ellipse at 15% 0, #fff3f5 0, transparent 48%), linear-gradient(180deg, #fcf9ff 0, #f7f8fa 560rpx); color: var(--account-ink); }
.mine-page.is-dark { --account-card: #1c1c20; --account-ink: #eeeaf4; --account-muted: #aaa4b4; --account-line: #353039; --account-soft: #30283d; --account-purple: #c9b2ec; --account-accent: #9869df; --account-benefit-bg: linear-gradient(110deg, #35283f, #3b2d32); --account-benefit-note: #c5b3cf; --account-cta: #493555; --account-create-a: #352b25; --account-create-b: #30283d; background: linear-gradient(180deg, #26212e 0, #121214 600rpx); }
.account-tap { opacity: .65; }
.account-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; padding: 8rpx 4rpx 36rpx; }
.account-member-pill { min-height: 68rpx; display: flex; align-items: center; gap: 10rpx; padding: 0 16rpx; border-radius: 40rpx; background: rgba(255,255,255,.9); color: var(--account-purple); font-size: calc(24rpx * var(--ui-scale)); white-space: nowrap; }
.account-member-pill image { width: 32rpx; height: 32rpx; }
.account-member-pill .account-chevron { width: 20rpx; height: 20rpx; }
.account-tools { display: flex; gap: 6rpx; }
.account-tools > view { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 9rpx; min-width: 84rpx; min-height: 92rpx; font-size: calc(23rpx * var(--ui-scale)); line-height: 1.25; }
.account-tools image { width: 46rpx; height: 46rpx; display: block; }
.account-card { background: var(--account-card); border-radius: 36rpx; margin-bottom: 24rpx; }
.account-overview { padding: 0 28rpx 28rpx; }
.account-profile-row { display: flex; align-items: center; gap: 20rpx; min-height: 168rpx; }
.account-avatar { flex: none; position: relative; align-self: flex-start; margin-top: -16rpx; width: 128rpx; height: 128rpx; box-sizing: border-box; border: 6rpx solid var(--account-card); border-radius: 50%; background: #f2e8ff; color: #5b3b8c; font-weight: 650; font-size: calc(48rpx * var(--ui-scale)); line-height: 116rpx; text-align: center; overflow: hidden; }
.account-avatar image { display: block; width: 100%; height: 100%; }
.account-identity { flex: 1; min-width: 0; padding: 12rpx 0; }
.account-name { font-size: calc(40rpx * var(--ui-scale)); font-weight: 650; line-height: 1.4; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; padding: 4rpx 0; }
.account-tier { display: flex; align-items: center; gap: 6rpx; color: var(--account-purple); font-size: calc(24rpx * var(--ui-scale)); min-height: 44rpx; flex-wrap: wrap; line-height: 1.35; }
.account-tier image { width: 26rpx; height: 26rpx; flex: none; }
.account-tier-code { font-size: calc(18rpx * var(--ui-scale)); padding: 1rpx 7rpx; border-radius: 6rpx; background: var(--account-soft); }
.account-stats { display: flex; align-items: stretch; padding: 8rpx 0 30rpx; }
.account-stats > view { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10rpx; min-height: 116rpx; }
.account-stat-value { display: flex; align-items: center; justify-content: center; min-height: 64rpx; font-size: calc(52rpx * var(--ui-scale)); font-weight: 650; line-height: 1.25; font-variant-numeric: tabular-nums; max-width: 100%; overflow-wrap: anywhere; }
.account-stat-value.account-sign { font-size: calc(32rpx * var(--ui-scale)); color: var(--account-purple); }
.account-stat-label { font-size: calc(26rpx * var(--ui-scale)); color: var(--account-muted); line-height: 1.4; }
.account-unit { font-size: calc(20rpx * var(--ui-scale)); }
.account-benefits, .account-expiring { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; font-size: calc(22rpx * var(--ui-scale)); color: var(--account-purple); line-height: 1.5; }
.account-benefits { padding: 22rpx 20rpx; min-height: 136rpx; border-radius: 24rpx; background: var(--account-benefit-bg); box-sizing: border-box; }
.account-benefits-copy { display: flex; flex-direction: column; align-items: flex-start; gap: 6rpx; flex: 1; min-width: 0; }
.account-benefits-title { display: flex; align-items: center; gap: 8rpx; font-size: calc(28rpx * var(--ui-scale)); font-weight: 600; }
.account-benefits-title > image { width: 32rpx; height: 32rpx; flex: none; }
.account-benefits-detail { display: flex; flex-wrap: wrap; gap: 4rpx 16rpx; font-size: calc(22rpx * var(--ui-scale)); color: var(--account-benefit-note); line-height: 1.5; }
.account-perk { white-space: nowrap; }
.account-benefits-more { display: flex; align-items: center; gap: 2rpx; flex: none; padding: 12rpx 14rpx; border-radius: 40rpx; background: var(--account-cta); }
.account-benefits-more image, .account-expiring image { width: 20rpx; height: 20rpx; flex: none; }
.account-expiring { padding: 0 4rpx 16rpx; }
.account-history { display: flex; align-items: stretch; margin: 0 24rpx; padding: 8rpx 0; border-bottom: 1rpx solid var(--account-line); }
.account-history > view { flex: 1; min-width: 0; display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10rpx; min-height: 88rpx; font-size: calc(28rpx * var(--ui-scale)); }
.account-count { padding: 0 10rpx; border-radius: 22rpx; background: #f8f7fa; color: #67616e; line-height: 1.5; font-size: calc(27rpx * var(--ui-scale)); font-variant-numeric: tabular-nums; }
.account-order-row { display: flex; align-items: center; padding: 32rpx 16rpx 32rpx; }
.account-shortcuts { display: flex; align-items: stretch; flex: 1; min-width: 0; }
.account-shortcuts > view { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 15rpx; min-height: 118rpx; font-size: calc(26rpx * var(--ui-scale)); text-align: center; line-height: 1.4; }
.account-icon { position: relative; width: 56rpx; height: 56rpx; flex: none; }
.account-tools .account-icon { width: 46rpx; height: 46rpx; }
.account-icon image { display: block; width: 100%; height: 100%; }
.account-badge { position: absolute; right: -16rpx; top: -10rpx; min-width: 26rpx; height: 28rpx; line-height: 28rpx; padding: 0 6rpx; border: 3rpx solid var(--account-card); border-radius: 22rpx; background: var(--account-accent); color: #fff; font-size: 19rpx; font-weight: 500; font-style: normal; text-align: center; }
.account-all { flex: none; width: 82rpx; min-height: 100rpx; margin-left: 12rpx; padding-left: 12rpx; border-left: 1rpx solid var(--account-line); display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 12rpx; font-size: calc(28rpx * var(--ui-scale)); font-weight: 600; }
.account-all > text { white-space: nowrap; }
.account-circle-arrow { width: 32rpx; height: 32rpx; border: 1.5rpx solid #96929c; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.account-circle-arrow image { width: 24rpx; height: 24rpx; }
.account-services { padding: 28rpx 24rpx 0; }
.account-section-title { font-size: calc(34rpx * var(--ui-scale)); font-weight: 600; line-height: 1.4; margin-bottom: 24rpx; }
.account-create { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.account-create > view { display: flex; align-items: center; gap: 12rpx; min-height: 120rpx; padding: 14rpx; box-sizing: border-box; border-radius: 22rpx; background: var(--account-create-a); }
.account-create > view:nth-child(2) { background: var(--account-create-b); }
.account-create-icon { width: 44rpx; height: 44rpx; flex: none; color: var(--account-purple); }
.account-create-icon image { width: 100%; height: 100%; display: block; }
.account-create-copy { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 5rpx; line-height: 1.4; }
.account-create-copy > text:first-child { font-size: calc(28rpx * var(--ui-scale)); font-weight: 600; }
.account-create-copy > text:last-child { font-size: calc(19rpx * var(--ui-scale)); color: var(--account-muted); }
.account-chevron { width: 20rpx; height: 20rpx; flex: none; }
.account-service-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); padding: 26rpx 0 22rpx; gap: 4rpx; }
.account-service-grid > view { min-width: 0; min-height: 148rpx; display: flex; flex-direction: column; align-items: center; justify-content: flex-start; gap: 14rpx; padding-top: 6rpx; font-size: calc(26rpx * var(--ui-scale)); text-align: center; line-height: 1.4; }
.account-service-icon { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 26rpx; background: #f3edff; }
.account-service-grid > view:nth-child(2) .account-service-icon { background: #fff4e9; }
.account-service-grid > view:nth-child(3) .account-service-icon { background: #edf7f3; }
.account-service-grid > view:nth-child(4) .account-service-icon { background: #eef3ff; }
.account-service-grid image { width: 50rpx; height: 50rpx; flex: none; }
.account-service-grid text { max-width: 100%; }
.account-feedback { display: flex; align-items: center; gap: 14rpx; border-top: 1rpx solid var(--account-line); min-height: 102rpx; font-size: calc(26rpx * var(--ui-scale)); }
.account-feedback > image:first-child { width: 40rpx; height: 40rpx; flex: none; }
.account-feedback-note { color: var(--account-muted); font-size: calc(21rpx * var(--ui-scale)); flex: 1; text-align: right; }
.mine-page.is-dark .account-member-pill { background: #352c42; }
.mine-page.is-dark .account-count { background: #302d35; color: #beb8c7; }
.mine-page.is-dark .account-service-grid .account-service-icon { background: #302b37; }
@media (max-width: 359px) {
  .account-profile-row { flex-wrap: wrap; padding-top: 8rpx; gap: 8rpx 16rpx; }
  .account-identity { flex-basis: calc(100% - 148rpx); }
  .account-benefits { gap: 8rpx; padding: 20rpx 16rpx; }
  .account-benefits-more { padding: 10rpx; }
  .account-create > view { gap: 10rpx; padding: 20rpx 14rpx; }
  .account-create > view > .account-chevron { display: none; }
  .account-stat-label { font-size: calc(24rpx * var(--ui-scale)); }
  .account-all { width: 92rpx; }
}
.avatar-mask { position: fixed; inset: 0; background: rgba(0,0,0,.45); z-index: 210; display: flex; align-items: flex-end; }
.avatar-sheet { width: 100%; box-sizing: border-box; background: var(--account-card); color: var(--account-ink); border-radius: 28rpx 28rpx 0 0; padding: 28rpx 24rpx calc(32rpx + env(safe-area-inset-bottom)); }
.avatar-title { text-align: center; font-size: calc(28rpx * var(--ui-scale)); margin-bottom: 24rpx; }
.avatar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.avatar-grid image { width: 120rpx; height: 120rpx; border-radius: 50%; margin: 0 auto; }
.avatar-action { text-align: center; padding: 28rpx 0; border-top: 1rpx solid var(--account-line); font-size: calc(30rpx * var(--ui-scale)); }
.avatar-action.cancel { color: var(--account-muted); }
.cell-label { margin: 24rpx 32rpx 16rpx; font-size: calc(30rpx * var(--ui-scale)); color: var(--ink, #242229); font-weight: 650; }
.mine-rec { display: flex; flex-wrap: wrap; margin: 0 24rpx 20rpx; gap: 16rpx; }
.mine-rec > view { width: calc(50% - 8rpx); background: var(--card, #fff); border-radius: 22rpx; overflow: hidden; padding-bottom: 16rpx; }
.mine-rec image, .mine-rec-ph { width: 100%; height: 260rpx; display: block; background: #eee; }
.mine-rec-ph { display: flex; align-items: center; justify-content: center; color: #8d8d8d; font-size: 48rpx; }
.mine-rec-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; margin: 12rpx 16rpx 0; font-size: calc(26rpx * var(--ui-scale)); line-height: 1.45; color: var(--ink, #242229); min-height: 76rpx; }
.mine-rec-price { display: block; margin: 8rpx 16rpx 0; color: var(--purple, #5b3b8c); font-size: calc(32rpx * var(--ui-scale)); font-weight: 650; }
.guest-welcome { margin: 20rpx 24rpx 28rpx; border-radius: 28rpx; overflow: hidden; position: relative; min-height: 420rpx; background: #3d354b; color: #fff; }
.guest-welcome > image { position: absolute; width: 100%; height: 100%; opacity: .65; }
.guest-welcome-copy { position: relative; padding: 180rpx 28rpx 32rpx; background: linear-gradient(transparent, rgba(22,18,30,.6)); }
.guest-welcome-copy > view:nth-child(2) { font-size: calc(38rpx * var(--ui-scale)); font-weight: 650; margin: 10rpx 0; }
.guest-welcome-copy > text { font-size: calc(25rpx * var(--ui-scale)); }
.guest-welcome-copy .section-kicker { color: #e1d3f0; font-size: 20rpx; letter-spacing: 2rpx; }
.moments-offscreen { position: fixed; left: -4000px; top: 0; width: 750px; height: 1600px; }
.moments-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 200; background: rgba(0,0,0,0.55); display: flex; align-items: flex-end; justify-content: center; }
.moments-sheet { width: 100%; overflow: hidden; display: flex; flex-direction: column; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 24rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.moments-sheet.above-tab { height: calc(100vh - 100rpx - env(safe-area-inset-bottom) - 24rpx); margin-bottom: calc(100rpx + env(safe-area-inset-bottom)); }
.moments-sheet.cover-bar { height: calc(100vh - 24rpx); padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.moments-scroll { flex: 1; height: 0; min-height: 0; }
.moments-img { width: 100%; display: block; border-radius: 16rpx; }
.moments-hint { margin: 12rpx 8rpx 0; flex: none; }
.moments-sheet .btn { margin: 16rpx 0 0; flex: none; }
.poster-head { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.poster-pick-title { flex: 1; min-width: 0; font-size: calc(32rpx * var(--ui-scale)); font-weight: 650; color: #1a1a1a; }
.poster-count { flex: none; padding: 6rpx 16rpx; border-radius: 999rpx; background: #f3eaf5; color: #642470; font-size: calc(22rpx * var(--ui-scale)); font-weight: 650; }
.poster-count.on { background: #5b3b8c; color: #fff; }
.poster-pick-hint { flex: none; margin: 8rpx 0 12rpx; font-size: calc(24rpx * var(--ui-scale)); }
.poster-pick-empty { flex: none; margin: 24rpx 0 8rpx; }
.poster-tools { display: flex; flex: none; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.poster-chip { padding: 8rpx 20rpx; border: 0; border-radius: 999rpx; background: #f4f4f6; font-size: calc(24rpx * var(--ui-scale)); color: #1a1a1a; line-height: 1.4; }
.poster-chip.on { background: #1a1a1a; color: #fff; }
.poster-search, .poster-date { width: 100%; height: 80rpx; min-height: 80rpx; line-height: 80rpx; box-sizing: border-box; border: 0; border-radius: 16rpx; padding: 0 24rpx; margin: 0 0 16rpx; font-size: calc(28rpx * var(--ui-scale)); background: #f4f4f6; color: #1a1a1a; flex: none; }
.poster-ph { color: #8d8d8d; line-height: 80rpx; }
.poster-picked { flex: none; display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.poster-picked-chip { display: flex; align-items: center; gap: 8rpx; padding: 8rpx 16rpx; border-radius: 999rpx; background: #f3eaf5; color: #642470; }
.poster-picked-name { font-size: calc(22rpx * var(--ui-scale)); font-weight: 650; }
.poster-picked-x { flex: none; color: #5b3b8c; font-size: calc(26rpx * var(--ui-scale)); line-height: 1; }
.poster-pick-list { flex: 1; height: 0; min-height: 0; }
.poster-pick-row { display: flex; align-items: center; gap: 16rpx; background: #f7f7f8; border: 2rpx solid transparent; border-radius: 20rpx; padding: 16rpx 20rpx; margin-bottom: 12rpx; }
.poster-pick-row.on { background: #fdf6f6; border-color: #e7c8cb; }
.poster-date-mark { width: 84rpx; height: 84rpx; border-radius: 18rpx; background: #f3eaf5; color: #642470; display: flex; flex-direction: column; align-items: center; justify-content: center; flex: none; }
.poster-pick-row.on .poster-date-mark { background: #5b3b8c; color: #fff; }
.poster-date-day { font-size: calc(32rpx * var(--ui-scale)); font-weight: 700; line-height: 1.05; }
.poster-date-md { font-size: calc(18rpx * var(--ui-scale)); line-height: 1.2; }
.poster-pick-mark { width: 40rpx; height: 40rpx; border: 2rpx solid #d0d0d4; border-radius: 50%; box-sizing: border-box; flex: none; position: relative; background: #fff; }
.poster-pick-row.on .poster-pick-mark { background: #5b3b8c; border-color: #5b3b8c; }
.poster-pick-row.on .poster-pick-mark::after { content: ""; position: absolute; left: 12rpx; top: 8rpx; width: 10rpx; height: 16rpx; border-right: 3rpx solid #fff; border-bottom: 3rpx solid #fff; transform: rotate(45deg); }
.poster-pick-copy { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 6rpx; }
.poster-pick-name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: calc(28rpx * var(--ui-scale)); font-weight: 650; color: #1a1a1a; }
.poster-pick-when { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: calc(22rpx * var(--ui-scale)); color: #8d8d8d; }
.poster-pager { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; margin-top: 4rpx; }
.poster-page-btn { min-width: 160rpx; text-align: center; padding: 12rpx 20rpx; border-radius: 999rpx; background: #fff; border: 1rpx solid #ececef; color: #1a1a1a; font-size: calc(26rpx * var(--ui-scale)); }
.poster-page-btn.off { color: #c4c4c8; background: #f6f6f7; }
.poster-page-num { font-weight: 650; color: #1a1a1a; font-size: calc(26rpx * var(--ui-scale)); }
.poster-pick.is-dark { background: #1c1c1e; }
.moments-sheet.is-dark { background: #1c1c20; color: #eeeaf4; }
.poster-pick.is-dark .poster-pick-title,
.poster-pick.is-dark .poster-pick-name,
.poster-pick.is-dark .poster-page-num,
.poster-pick.is-dark .poster-page-btn { color: #f2f2f2; }
.poster-pick.is-dark .poster-chip,
.poster-pick.is-dark .poster-search,
.poster-pick.is-dark .poster-date,
.poster-pick.is-dark .poster-pick-row { background: #2c2c2e; color: #f2f2f2; }
.poster-pick.is-dark .poster-pick-row.on { background: #3a2428; border-color: #5b3b8c; }
.poster-pick.is-dark .poster-page-btn { background: #2c2c2e; border-color: #3a3a3c; }
.poster-pick.is-dark .poster-page-btn.off { color: #6e6e76; background: #1c1c1e; }
