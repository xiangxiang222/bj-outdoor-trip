@import "../../styles/account.wxss";
page { background: #f3f4f6; color: #1a1a1a; font-family: "PingFang SC", "Helvetica Neue", sans-serif; }
.cell-label { margin: 24rpx 32rpx 8rpx; font-size: calc(24rpx * var(--ui-scale)); color: #9a9a9a; font-weight: 400; }
.cell-group { background: #fff; border-radius: 24rpx; margin: 0 24rpx 8rpx; overflow: hidden; }
.cell { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f1f3; }
.cell:last-child { border-bottom: 0; }
.mine-hero-card { background: transparent; margin: 8rpx 24rpx 0; padding: 16rpx 8rpx 8rpx; display: flex; align-items: center; gap: 16rpx; }
.mine-user { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.mine-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #f3eaf5; color: #642470; text-align: center; line-height: 96rpx; font-weight: 700; overflow: hidden; }
.mine-avatar image { width: 96rpx; height: 96rpx; }
.avatar-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 20; display: flex; align-items: flex-end; }
.avatar-sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 28rpx 24rpx 48rpx; }
.avatar-title { text-align: center; font-size: calc(28rpx * var(--ui-scale)); color: #6b705c; margin-bottom: 16rpx; }
.avatar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.avatar-grid image { width: 120rpx; height: 120rpx; border-radius: 50%; margin: 0 auto; }
.avatar-action { text-align: center; padding: 28rpx 0; border-top: 1rpx solid #f0f1f3; font-size: calc(32rpx * var(--ui-scale)); }
.avatar-action.cancel { color: #7a7d74; }
.mine-tools { display: flex; align-items: flex-start; gap: 4rpx; flex: none; }
.mine-tool { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; min-width: 88rpx; min-height: 88rpx; padding: 8rpx 4rpx; box-sizing: border-box; color: #333; font-size: calc(20rpx * var(--ui-scale)); line-height: 1.15; }
.mine-tool-ico { position: relative; width: 44rpx; height: 44rpx; }
.mine-tool-ico image { width: 44rpx; height: 44rpx; }
.mine-tools.is-dark .mine-tool { color: #f2f2f2; }
.mine-tools.is-dark .mine-tool-ico image { filter: invert(1); }
.mine-badge { position: absolute; top: -8rpx; right: -16rpx; min-width: 28rpx; height: 28rpx; line-height: 28rpx; padding: 0 6rpx; border-radius: 99rpx; background: #e23d3d; color: #fff; font-size: 18rpx; text-align: center; }
.mine-expire { color: #c45c26; font-size: calc(20rpx * var(--ui-scale)); }
.mine-member { margin: 8rpx 24rpx 16rpx; padding: 28rpx 32rpx; border-radius: 24rpx; background: #f3eaf5; display: flex; justify-content: space-between; align-items: center; color: #1a1a1a; }
.mine-level { font-size: calc(34rpx * var(--ui-scale)); font-weight: 700; color: #642470; text-decoration: underline; text-underline-offset: 8rpx; }
.mine-em { font-style: italic; font-weight: 800; }
.mine-pill { background: #642470; color: #fff; border-radius: 999rpx; padding: 10rpx 20rpx; font-size: calc(24rpx * var(--ui-scale)); font-weight: 600; }
.mine-orders { background: #fff; margin: 0 24rpx 16rpx; border-radius: 24rpx; padding: 28rpx 0 24rpx; font-family: "PingFang SC", "Helvetica Neue", sans-serif; }
.mine-traces { display: flex; align-items: center; padding: 0 16rpx 24rpx; }
.mine-traces > view { flex: 1; text-align: center; font-size: 28rpx; font-weight: 400; line-height: 40rpx; color: #1a1a1a; }
.mine-trace-num { margin-left: 8rpx; font-weight: 600; font-size: 28rpx; color: #1a1a1a; }
.mine-order-row { display: flex; align-items: stretch; }
.mine-shortcuts { display: flex; flex: 1; overflow: hidden; background: transparent; margin: 0; border-radius: 0; padding: 0 4rpx; text-align: center; }
.mine-shortcuts > view { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.mine-order-name { font-size: 24rpx; font-weight: 400; line-height: 1.2; color: #1a1a1a; }
.mine-order-ico { position: relative; width: 56rpx; height: 56rpx; }
.mine-order-ico image { width: 56rpx; height: 56rpx; display: block; }
.mine-order-ico .mine-badge { top: -8rpx; right: -18rpx; box-shadow: 0 0 0 2rpx #fff; }
.mine-all { flex: none; width: 104rpx; margin: 4rpx 0; border-left: 1rpx solid #e6e6e6; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12rpx; font-size: 24rpx; font-weight: 400; line-height: 1.2; color: #1a1a1a; }
.mine-all-arrow { width: 14rpx; height: 14rpx; border-right: 3rpx solid #1a1a1a; border-bottom: 3rpx solid #1a1a1a; transform: rotate(45deg) translate(-2rpx, -2rpx); }
.mine-wallet { display: grid; grid-template-columns: repeat(4, 1fr); align-items: start; background: #fff; margin: 0 24rpx 8rpx; border-radius: 24rpx; padding: 24rpx 8rpx 20rpx; text-align: center; }
.mine-wallet-item { display: flex; flex-direction: column; align-items: center; }
.wal-ico { width: 64rpx; height: 64rpx; }
.wal-ico-wrap { position: relative; width: 64rpx; height: 64rpx; }
.wal-dot { position: absolute; top: -4rpx; right: -4rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #8c3038; box-shadow: 0 0 0 4rpx #fff; }
.wal-num { margin-top: 6rpx; font-size: calc(32rpx * var(--ui-scale)); font-weight: 650; color: #1a1a1a; line-height: 1.2; }
.wal-name { margin-top: 2rpx; font-size: calc(22rpx * var(--ui-scale)); color: #8d8d8d; line-height: 1.2; }
.wal-entry { margin-top: calc(6rpx + 32rpx * var(--ui-scale) * 1.2 + 2rpx); font-size: calc(22rpx * var(--ui-scale)); font-weight: 400; color: #8d8d8d; line-height: 1.2; }
.mine-grid { display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; margin: 0 24rpx 8rpx; border-radius: 24rpx; padding: 20rpx 8rpx 16rpx; text-align: center; font-size: calc(22rpx * var(--ui-scale)); color: #333; }
.mine-grid .ico { width: 64rpx; height: 64rpx; margin: 8rpx auto 8rpx; display: block; background: transparent; }
