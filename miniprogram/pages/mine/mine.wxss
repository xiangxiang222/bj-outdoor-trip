@import "../../styles/account.wxss";
page { background-color: #f3f4f6; color: #1a1a1a; font-family: "PingFang SC", "Helvetica Neue", sans-serif; }
.mine-nav { background: #c045ab; color: #fff; padding-bottom: 8rpx; }
.mine-nav-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(34rpx * var(--ui-scale));
  font-weight: 650;
  line-height: 1;
}
.mine-nav.is-dark { background: #9a4584; }
.mine-page {
  background-color: #f3f4f6;
  background-image: linear-gradient(180deg, #c045ab 0, #c045ab 160rpx, #f3f4f6 760rpx);
  background-repeat: no-repeat;
  padding-bottom: 24rpx;
  margin-top: -8rpx;
}
.mine-page.is-dark {
  background-color: #121214;
  background-image: linear-gradient(180deg, #9a4584 0, #9a4584 160rpx, #121214 760rpx);
  background-repeat: no-repeat;
  color: #f2f2f2;
}
.cell-label { margin: 24rpx 32rpx 8rpx; font-size: calc(24rpx * var(--ui-scale)); color: #9a9a9a; font-weight: 400; }
.cell-group { background: #fff; border-radius: 24rpx; margin: 0 24rpx 8rpx; overflow: hidden; }
.cell { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 24rpx; border-bottom: 1rpx solid #f0f1f3; }
.cell:last-child { border-bottom: 0; }
.mine-head { display: flex; align-items: center; gap: 16rpx; margin: 0; padding: 16rpx 32rpx 20rpx; background: transparent; }
.mine-user-main { flex: 1; min-width: 0; }
.mine-tags { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.mine-lv { background: #1a1a1a; color: #f6e7c1; border-radius: 6rpx; padding: 2rpx 10rpx; font-size: calc(20rpx * var(--ui-scale)); font-weight: 700; }
.mine-chip { color: #fff; font-size: calc(22rpx * var(--ui-scale)); font-weight: 600; }
.mine-hero-card { background: transparent; margin: 0; padding: 24rpx 16rpx 12rpx; display: flex; align-items: center; gap: 16rpx; }
.mine-user { display: flex; align-items: center; gap: 16rpx; flex: 1; }
.mine-avatar { width: 96rpx; height: 96rpx; border-radius: 50%; background: #f3eaf5; color: #642470; text-align: center; line-height: 96rpx; font-weight: 700; overflow: hidden; }
.mine-avatar image { width: 96rpx; height: 96rpx; }
.avatar-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; background: rgba(0,0,0,.45); z-index: 20; display: flex; align-items: flex-end; }
.avatar-sheet { width: 100%; background: #fff; border-radius: 24rpx 24rpx 0 0; padding: 28rpx 24rpx 48rpx; }
.avatar-title { text-align: center; font-size: calc(28rpx * var(--ui-scale)); color: #6b705c; margin-bottom: 16rpx; }
.avatar-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16rpx; margin-bottom: 20rpx; }
.avatar-grid image { width: 120rpx; height: 120rpx; border-radius: 50%; margin: 0 auto; }
.avatar-action { text-align: center; padding: 28rpx 0; border-top: 1rpx solid #f0f1f3; font-size: calc(32rpx * var(--ui-scale)); }
.avatar-action.cancel { color: #7a7d74; }
.mine-tools { display: flex; align-items: flex-start; gap: 4rpx; flex: none; }
.mine-hero-card .title, .mine-head .title { color: #fff; font-size: calc(34rpx * var(--ui-scale)); font-weight: 700; }
.mine-hero-card .muted, .mine-head .muted { color: rgba(255, 255, 255, 0.72); }
.mine-tool { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 4rpx; min-width: 88rpx; min-height: 88rpx; padding: 8rpx 4rpx; box-sizing: border-box; color: #fff; font-size: calc(20rpx * var(--ui-scale)); line-height: 1.15; }
.mine-tool-ico { position: relative; width: 44rpx; height: 44rpx; }
.mine-tool-ico image { width: 44rpx; height: 44rpx; filter: invert(1); }
.mine-tools.is-dark .mine-tool { color: #f2f2f2; }
.mine-tools.is-dark .mine-tool-ico image { filter: invert(1); }
.mine-badge { position: absolute; top: -8rpx; right: -16rpx; min-width: 28rpx; height: 28rpx; line-height: 28rpx; padding: 0 6rpx; border-radius: 99rpx; background: #e23d3d; color: #fff; font-size: 18rpx; text-align: center; }
.mine-expire { color: #c45c26; font-size: calc(20rpx * var(--ui-scale)); }
.mine-sheet { background: #fff; margin: 0 24rpx 16rpx; border-radius: 24rpx; padding: 24rpx 8rpx 16rpx; }
.mine-page.is-dark .mine-nav,
.mine-page.is-dark .title { color: #f2f2f2; }
.mine-page.is-dark .mine-chip { color: #fff; }
.mine-page.is-dark .mine-sheet,
.mine-page.is-dark .mine-orders,
.mine-page.is-dark .mine-links,
.mine-page.is-dark .mine-play { background: #1c1c1e; }
.mine-page.is-dark .mine-sheet-head,
.mine-page.is-dark .mine-stat-num,
.mine-page.is-dark .mine-links,
.mine-page.is-dark .mine-order-name,
.mine-page.is-dark .mine-all { color: #f2f2f2; }
.mine-page.is-dark .mine-order-ico image,
.mine-page.is-dark .mine-links image,
.mine-page.is-dark .mine-play image { filter: invert(1); }
.mine-page.is-dark .mine-all { border-left-color: #3a3a3c; }
.mine-page.is-dark .mine-all-ico,
.mine-page.is-dark .mine-all-ico::before,
.mine-page.is-dark .mine-all-ico::after { border-color: #f2f2f2; }
.mine-page.is-dark .mine-all-ico::before,
.mine-page.is-dark .mine-all-ico::after { background: #f2f2f2; }
.mine-page.is-dark .mine-order-ico .mine-badge { box-shadow: 0 0 0 2rpx #1c1c1e; }
.mine-page.is-dark .mine-sign-ico { border-color: #f2f2f2; }
.mine-page.is-dark .mine-sign-ico::before { background: #f2f2f2; }
.mine-page.is-dark .mine-order-row { border-top-color: #3a3a3c; }
.mine-sheet-head { display: flex; align-items: center; justify-content: space-between; padding: 0 16rpx 16rpx; font-size: calc(30rpx * var(--ui-scale)); font-weight: 650; color: #1a1a1a; }
.mine-stats { display: flex; align-items: stretch; padding: 0 8rpx 12rpx; }
.mine-stats > view { flex: 1; text-align: center; }
.mine-stats > .mine-more { flex: none; width: 64rpx; }
.mine-stat-num { font-size: calc(34rpx * var(--ui-scale)); font-weight: 700; color: #1a1a1a; line-height: 1.2; }
.mine-stat-name { margin-top: 4rpx; font-size: calc(22rpx * var(--ui-scale)); color: #8d8d8d; }
.mine-links { display: flex; background: #fff; margin: 0 24rpx 16rpx; border-radius: 24rpx; padding: 24rpx 8rpx 20rpx; }
.mine-links > view { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: calc(22rpx * var(--ui-scale)); color: #1a1a1a; }
.mine-links image { width: 56rpx; height: 56rpx; }
.mine-link-num { color: #8d8d8d; font-size: calc(22rpx * var(--ui-scale)); font-weight: 600; }
.mine-sign-ico { width: 56rpx; height: 56rpx; border: 3rpx solid #1a1a1a; border-radius: 12rpx; position: relative; box-sizing: border-box; }
.mine-sign-ico::before { content: ""; position: absolute; left: 8rpx; right: 8rpx; top: 16rpx; height: 3rpx; background: #1a1a1a; }
.mine-sign-ico::after { content: ""; position: absolute; left: 16rpx; top: 28rpx; width: 16rpx; height: 8rpx; border-left: 3rpx solid #bc4749; border-bottom: 3rpx solid #bc4749; transform: rotate(-45deg); }
.mine-member { margin: 0; padding: 8rpx 24rpx 28rpx; border-radius: 0; background: transparent; box-shadow: none; display: flex; justify-content: space-between; align-items: center; color: #1a1a1a; }
.mine-level { font-size: calc(34rpx * var(--ui-scale)); font-weight: 700; color: #642470; text-decoration: underline; text-underline-offset: 8rpx; }
.mine-em { font-style: italic; font-weight: 800; }
.mine-member-banner { background: #f3e2c8; color: #8a5a2a; border-radius: 999rpx; padding: 8rpx 18rpx; font-size: calc(22rpx * var(--ui-scale)); font-weight: 650; }
.mine-page.is-dark .mine-member-banner { background: #3a2a22; color: #f6e7c1; }
.mine-more { flex: none; width: 64rpx; border-left: 1rpx solid #eee; color: #8d8d8d; font-size: calc(20rpx * var(--ui-scale)); display: flex; align-items: center; justify-content: center; }
.mine-orders { background: #fff; margin: 0 24rpx 16rpx; border-radius: 24rpx; padding: 8rpx 0 24rpx; font-family: "PingFang SC", "Helvetica Neue", sans-serif; }
.mine-order-row { display: flex; align-items: stretch; position: relative; z-index: 1; padding-top: 16rpx; }
.mine-shortcuts { display: flex; flex: 5; overflow: visible; background: transparent; margin: 0; border-radius: 0; padding: 0 4rpx; text-align: center; }
.mine-shortcuts > view { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 12rpx; }
.mine-order-name { white-space: nowrap; font-size: calc(20rpx * var(--ui-scale)); font-weight: 400; line-height: 1.2; color: #1a1a1a; }
.mine-order-ico { position: relative; width: 56rpx; height: 56rpx; }
.mine-order-ico image { width: 56rpx; height: 56rpx; display: block; }
.mine-order-ico .mine-badge { top: -8rpx; right: -18rpx; z-index: 2; box-shadow: 0 0 0 2rpx #fff; }
.mine-all { flex: 1; margin: 0; border-left: 1rpx solid #eee; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; font-size: 24rpx; font-weight: 400; line-height: 1.2; color: #1a1a1a; }
.mine-all-ico { width: 44rpx; height: 44rpx; border: 3rpx solid #1a1a1a; border-radius: 8rpx; position: relative; box-sizing: border-box; }
.mine-all-ico::before, .mine-all-ico::after { content: ""; position: absolute; left: 8rpx; right: 8rpx; height: 3rpx; background: #1a1a1a; }
.mine-all-ico::before { top: 14rpx; }
.mine-all-ico::after { top: 24rpx; }
.mine-play { display: flex; background: #fff; margin: 0 24rpx 16rpx; border-radius: 24rpx; padding: 24rpx 8rpx 20rpx; }
.mine-play > view { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; font-size: calc(22rpx * var(--ui-scale)); color: #1a1a1a; }
.mine-play image { width: 56rpx; height: 56rpx; }
.mine-page.is-dark .mine-play { color: #f2f2f2; }
.mine-wallet { display: grid; grid-template-columns: repeat(4, 1fr); align-items: start; background: #fff; margin: 0 24rpx 8rpx; border-radius: 24rpx; padding: 24rpx 8rpx 20rpx; text-align: center; }
.mine-wallet-item { display: flex; flex-direction: column; align-items: center; }
.wal-ico { width: 64rpx; height: 64rpx; }
.wal-ico-wrap { position: relative; width: 64rpx; height: 64rpx; }
.wal-dot { position: absolute; top: -4rpx; right: -4rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #8c3038; box-shadow: 0 0 0 4rpx #fff; }
.wal-num { margin-top: 6rpx; font-size: calc(32rpx * var(--ui-scale)); font-weight: 650; color: #1a1a1a; line-height: 1.2; }
.wal-name { margin-top: 2rpx; font-size: calc(22rpx * var(--ui-scale)); color: #8d8d8d; line-height: 1.2; }
.wal-entry { margin-top: calc(6rpx + 32rpx * var(--ui-scale) * 1.2 + 2rpx); font-size: calc(22rpx * var(--ui-scale)); font-weight: 400; color: #8d8d8d; line-height: 1.2; }
.mine-grid { display: grid; grid-template-columns: repeat(4, 1fr); background: #fff; margin: 0 24rpx 8rpx; border-radius: 24rpx; padding: 20rpx 8rpx 16rpx; text-align: center; font-size: calc(22rpx * var(--ui-scale)); color: #333; }
.mine-grid .ico { width: 64rpx; height: 64rpx; margin: 8rpx auto 8rpx; display: block; background: transparent; }
