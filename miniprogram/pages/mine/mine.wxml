<view class="card mine-hero" wx:if="{{user}}">
  <view class="pad">
    <view class="title">{{user.nickname}}</view>
    <view class="muted">{{user.phone}}</view>
    <view>{{user.isMember ? '会员' : '普通用户'}} · 积分 {{user.points}}</view>
  </view>
</view>
<view class="btn" wx:if="{{!user}}" bindtap="login">登录</view>
<view class="btn ghost" wx:if="{{!user}}" bindtap="register">注册</view>

<view class="cell-label">出行</view>
<view class="cell-group">
  <view class="cell" wx:if="{{user}}" bindtap="goHome"><text>个人主页</text><text class="muted">相册与过往 ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/favorites/favorites"><text>我的收藏</text><text class="muted">›</text></view>
</view>

<view class="cell-label">权益</view>
<view class="cell-group">
  <view class="cell" bindtap="go" data-url="/pages/coupons/coupons"><text>优惠券</text><text class="muted">{{coupon ? coupon.label : ''}} ›</text></view>
  <view class="cell" bindtap="openMember"><text>{{user.isMember ? '会员中心' : '开通会员'}}</text><text class="muted">年费 99 ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/lottery/lottery"><text>抽奖</text><text class="muted">›</text></view>
</view>

<view class="cell-label">服务</view>
<view class="cell-group">
  <view class="cell" bindtap="goOfficial"><text>客服与规则</text><text class="muted">加微信、FAQ ›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/feedback/feedback"><text>功能建议与找 BUG</text><text class="muted">›</text></view>
  <view class="cell" bindtap="go" data-url="/pages/publish/publish"><text>去发团 / 发起一局</text><text class="muted">›</text></view>
</view>

<view class="btn ghost" wx:if="{{user}}" bindtap="out">退出</view>
<view class="btn ghost" wx:if="{{user}}" bindtap="closeAccount" style="color:#bc4749">注销账号</view>
