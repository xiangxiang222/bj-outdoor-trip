<view class="card" wx:if="{{user}}">
  <view class="pad">
    <view class="title">{{user.nickname}}</view>
    <view class="muted">{{user.phone}}</view>
    <view>{{user.isMember ? '会员' : '普通用户'}} · 积分 {{user.points}}</view>
  </view>
</view>
<view class="btn" wx:if="{{!user}}" bindtap="login">登录</view>
<view class="btn ghost" wx:if="{{!user}}" bindtap="register">注册</view>
<view class="card" wx:if="{{upcoming}}" bindtap="goUpcoming">
  <view class="pad">
    <view class="muted">即将出行</view>
    <view class="title">{{upcoming.title}}</view>
    <view class="muted">{{upcoming.startDate}} · {{upcoming.meetupPoint}} {{upcoming.meetupTime}}</view>
  </view>
</view>
<view class="card" bindtap="go" data-url="/pages/orders/orders"><view class="pad">我的报名</view></view>
<view class="card" bindtap="go" data-url="/pages/coupons/coupons">
  <view class="pad">我的优惠券<text wx:if="{{coupon}}"> {{coupon.label}}</text></view>
</view>
<view class="card" wx:if="{{user}}" bindtap="goHome"><view class="pad">个人主页 · 相册与行程</view></view>
<view class="card" bindtap="goOfficial"><view class="pad">客服与规则 · 加微信、FAQ</view></view>
<view class="card" bindtap="go" data-url="/pages/favorites/favorites"><view class="pad">我的收藏</view></view>
<view class="card" bindtap="openMember"><view class="pad">{{user.isMember ? '会员中心' : '开通会员'}}</view></view>
<view class="btn ghost" wx:if="{{user}}" bindtap="out">退出</view>
<view class="btn ghost" wx:if="{{user}}" bindtap="closeAccount" style="color:#bc4749">注销账号</view>
