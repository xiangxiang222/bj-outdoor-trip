<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="mine-nav {{dark ? 'is-dark' : ''}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="mine-nav-bar" style="height: {{navBarHeight}}px;"></view>
</view>
<view class="mine-page {{dark ? 'is-dark' : ''}}" wx:if="{{user}}">
  <view class="mine-head">
  <view class="mine-user">
    <view class="mine-avatar" catchtap="openAvatar">
      <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
      <text wx:else>{{tr.t(nickHead, lang)}}</text>
    </view>
    <view class="mine-user-main">
      <view bindtap="goHome">
        <view class="title">{{tr.t(user.nickname, lang)}}</view>
      </view>
      <view class="mine-tags">
        <view wx:if="{{user.membership}}" class="mine-lv" catchtap="openMember">{{tr.t(user.membership.code, lang)}}</view>
        <view class="mine-chip" catchtap="openMember">{{tr.t('会员 ›', lang)}}</view>
      </view>
    </view>
  </view>
  <view class="mine-tools {{dark ? 'is-dark' : ''}}">
    <view class="mine-tool" bindtap="goOfficial">
      <view class="mine-tool-ico"><image src="{{iconBase}}tool-help.png?v=10" mode="aspectFit" /></view>
      <text>{{tr.t('客服', lang)}}</text>
    </view>
    <view class="mine-tool" bindtap="go" data-url="/pages/settings/settings">
      <view class="mine-tool-ico"><image src="{{iconBase}}tool-set.png?v=10" mode="aspectFit" /></view>
      <text>{{tr.t('设置', lang)}}</text>
    </view>
    <view class="mine-tool" bindtap="go" data-url="/pages/notices/notices">
      <view class="mine-tool-ico">
        <image src="{{iconBase}}tool-msg.png?v=10" mode="aspectFit" />
        <text wx:if="{{hub.unreadCount}}" class="mine-badge">{{hub.unreadCount > 9 ? '9+' : hub.unreadCount}}</text>
      </view>
      <text>{{tr.t('消息', lang)}}</text>
    </view>
  </view>
  </view>
  <view class="avatar-mask" wx:if="{{picker}}" catchtap="closeAvatar">
    <view class="avatar-sheet" catchtap="noop">
      <view class="avatar-title">{{tr.t('选择默认头像', lang)}}</view>
      <view class="avatar-grid">
        <image wx:for="{{defaults}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" catchtap="pickDefault" />
      </view>
      <view class="avatar-action" bindtap="shoot">{{tr.t('拍照', lang)}}</view>
      <view class="avatar-action" bindtap="album">{{tr.t('从手机相册选择', lang)}}</view>
      <view class="avatar-action cancel" bindtap="closeAvatar">{{tr.t('取消', lang)}}</view>
    </view>
  </view>

  <view class="mine-sheet">
    <view class="mine-sheet-head">
      <view bindtap="go" data-url="/pages/wallet/wallet">{{tr.t('我的钱包', lang)}} ›</view>
      <view class="mine-member-banner" bindtap="openMember">{{tr.t('会员中心 ›', lang)}}</view>
    </view>
    <view class="mine-stats">
      <view bindtap="go" data-url="/pages/wallet/wallet">
        <view class="mine-stat-num">{{tr.t(hub.balance, lang)}}</view>
        <view class="mine-stat-name">{{tr.t('余额', lang)}}</view>
      </view>
      <view bindtap="go" data-url="/pages/coupons/coupons">
        <view class="mine-stat-num">{{tr.t(hub.couponCount, lang)}}</view>
        <view class="mine-stat-name">{{tr.t('优惠券', lang)}}</view>
        <view class="mine-expire" wx:if="{{hub.couponExpireHint}}">{{tr.t(hub.couponExpireHint, lang)}}</view>
      </view>
      <view bindtap="go" data-url="/pages/signin/signin">
        <view class="mine-stat-num">{{tr.t(hub.points != null ? hub.points : user.points, lang)}}</view>
        <view class="mine-stat-name">{{tr.t('积分', lang)}}</view>
      </view>
      <view class="mine-more" bindtap="go" data-url="/pages/wallet/wallet">{{tr.t('更多', lang)}}</view>
    </view>
  </view>

  <view class="mine-orders">
    <view class="mine-order-row">
      <view class="mine-shortcuts">
        <view bindtap="goOrders" data-tab="unpaid">
          <view class="mine-order-ico">
            <image src="{{iconBase}}order-pay.png?v=10" mode="aspectFit" />
            <text wx:if="{{hub.unpaidCount}}" class="mine-badge">{{hub.unpaidCount > 99 ? '99+' : hub.unpaidCount}}</text>
          </view>
          <view class="mine-order-name">{{tr.t('待付款', lang)}}</view>
        </view>
        <view bindtap="goOrders" data-tab="recruiting">
          <view class="mine-order-ico">
            <image src="/images/order-recruit.png" mode="aspectFit" />
            <text wx:if="{{hub.recruitingCount}}" class="mine-badge">{{hub.recruitingCount > 99 ? '99+' : hub.recruitingCount}}</text>
          </view>
          <view class="mine-order-name">{{tr.t('待成团', lang)}}</view>
        </view>
        <view bindtap="goOrders" data-tab="depart">
          <view class="mine-order-ico">
            <image src="{{iconBase}}order-go.png?v=10" mode="aspectFit" />
            <text wx:if="{{hub.departCount}}" class="mine-badge">{{hub.departCount > 99 ? '99+' : hub.departCount}}</text>
          </view>
          <view class="mine-order-name">{{tr.t('待出行', lang)}}</view>
        </view>
        <view bindtap="goOrders" data-tab="review">
          <view class="mine-order-ico">
            <image src="{{iconBase}}order-review.png?v=10" mode="aspectFit" />
            <text wx:if="{{hub.reviewCount}}" class="mine-badge">{{hub.reviewCount > 99 ? '99+' : hub.reviewCount}}</text>
          </view>
          <view class="mine-order-name">{{tr.t('待评价', lang)}}</view>
        </view>
        <view bindtap="goOrders" data-tab="refund">
          <view class="mine-order-ico">
            <image src="{{iconBase}}order-refund.png?v=10" mode="aspectFit" />
            <text wx:if="{{hub.refundCount}}" class="mine-badge">{{hub.refundCount > 99 ? '99+' : hub.refundCount}}</text>
          </view>
          <view class="mine-order-name">{{tr.t('已退款', lang)}}</view>
        </view>
      </view>
      <view class="mine-all" bindtap="goOrders" data-tab="all">
        <view class="mine-all-ico"></view>
        <text>{{tr.t('全部', lang)}}</text>
      </view>
    </view>
  </view>

  <view class="mine-links">
    <view bindtap="go" data-url="/pages/views/views">
      <image src="{{iconBase}}views.png?v=10" mode="aspectFit" />
      <text>{{tr.t('足迹', lang)}}</text>
    </view>
    <view bindtap="go" data-url="/pages/favorites/favorites">
      <image src="{{iconBase}}fav.png?v=10" mode="aspectFit" />
      <text>{{tr.t('收藏', lang)}}</text>
    </view>
    <view bindtap="go" data-url="/pages/follows/follows">
      <image src="{{iconBase}}follow.png?v=10" mode="aspectFit" />
      <text>{{tr.t('关注', lang)}}</text>
    </view>
  </view>

  <view class="mine-play">
    <view bindtap="go" data-url="/pages/signin/signin">
      <view class="mine-sign-ico"></view>
      <text>{{hub.signedToday ? tr.t('已签到', lang) : tr.t('签到', lang)}}</text>
    </view>
    <view bindtap="go" data-url="/pages/lottery/lottery">
      <image src="{{iconBase}}lottery.png?v=10" mode="aspectFit" />
      <text>{{tr.t('抽奖', lang)}}</text>
    </view>
    <view bindtap="go" data-url="/pages/publish/publish">
      <image src="{{iconBase}}publish.png?v=10" mode="aspectFit" />
      <text>{{tr.t('去发团', lang)}}</text>
    </view>
    <view bindtap="go" data-url="/pages/coupons/coupons">
      <image src="{{iconBase}}wal-coupon.png?v=11" mode="aspectFit" />
      <text>{{tr.t('优惠券', lang)}}</text>
    </view>
    <view bindtap="go" data-url="/pages/feedback/feedback">
      <image src="{{iconBase}}feedback.png?v=10" mode="aspectFit" />
      <text>{{tr.t('反馈', lang)}}</text>
    </view>
  </view>
</view>

<view class="btn" wx:if="{{!user}}" bindtap="login">{{tr.t('登录', lang)}}</view>
<view class="btn ghost" wx:if="{{!user}}" bindtap="register">{{tr.t('注册', lang)}}</view>

<view class="cell-label">{{tr.t('常用', lang)}}</view>
<view class="mine-grid">
  <view bindtap="go" data-url="/pages/favorites/favorites"><image class="ico" src="{{iconBase}}fav.png?v=10" mode="aspectFit" />{{tr.t('收藏', lang)}}</view>
  <view bindtap="go" data-url="/pages/views/views"><image class="ico" src="{{iconBase}}views.png?v=10" mode="aspectFit" />{{tr.t('最近看过', lang)}}</view>
  <view bindtap="go" data-url="/pages/companions/companions"><image class="ico" src="{{iconBase}}people.png?v=10" mode="aspectFit" />{{tr.t('报名人', lang)}}</view>
  <view bindtap="go" data-url="/pages/follows/follows"><image class="ico" src="{{iconBase}}follow.png?v=10" mode="aspectFit" />{{tr.t('关注领队', lang)}}</view>
  <view bindtap="go" data-url="/pages/student/student"><image class="ico" src="{{iconBase}}campus.png?v=10" mode="aspectFit" />{{tr.t(campusLabel, lang)}}</view>
  <view bindtap="go" data-url="/pages/leader/leader"><image class="ico" src="{{iconBase}}leader.png?v=10" mode="aspectFit" />{{tr.t(leaderLabel, lang)}}</view>
  <view bindtap="go" data-url="/pages/publish/publish"><image class="ico" src="{{iconBase}}publish.png?v=10" mode="aspectFit" />{{tr.t('发团', lang)}}</view>
  <view bindtap="go" data-url="/pages/route-apply/route-apply"><image class="ico" src="{{iconBase}}route.png?v=10" mode="aspectFit" />{{tr.t('收录线路', lang)}}</view>
  <view bindtap="go" data-url="/pages/feedback/feedback"><image class="ico" src="{{iconBase}}feedback.png?v=10" mode="aspectFit" />{{tr.t('建议', lang)}}</view>
  <view bindtap="goRoutes"><image class="ico" src="{{iconBase}}trails.png?v=10" mode="aspectFit" />{{tr.t('看线路', lang)}}</view>
</view>
