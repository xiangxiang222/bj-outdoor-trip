<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="mine-page" wx:if="{{user}}">
  <view class="mine-hero-card">
    <view class="mine-user" bindtap="goHome">
      <view class="mine-avatar" catchtap="openAvatar">
        <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
        <text wx:else>{{tr.t(nickHead, lang)}}</text>
      </view>
      <view>
        <view class="title">{{tr.t(user.nickname, lang)}}</view>
        <view class="muted">{{tr.t(phone, lang)}}</view>
      </view>
    </view>
    <view class="mine-tools {{dark ? 'is-dark' : ''}}">
      <view class="mine-tool" bindtap="goOfficial">
        <view class="mine-tool-ico"><image src="{{iconBase}}tool-help.png" mode="aspectFit" /></view>
        <text>{{tr.t('客服', lang)}}</text>
      </view>
      <view class="mine-tool" bindtap="go" data-url="/pages/settings/settings">
        <view class="mine-tool-ico"><image src="{{iconBase}}tool-set.png" mode="aspectFit" /></view>
        <text>{{tr.t('设置', lang)}}</text>
      </view>
      <view class="mine-tool" bindtap="go" data-url="/pages/notices/notices">
        <view class="mine-tool-ico">
          <image src="{{iconBase}}tool-msg.png" mode="aspectFit" />
          <text wx:if="{{hub.unreadCount}}" class="mine-badge">{{hub.unreadCount > 9 ? '9+' : hub.unreadCount}}</text>
        </view>
        <text>{{tr.t('消息', lang)}}</text>
      </view>
    </view>
  </view>
  <view class="avatar-mask" wx:if="{{picker}}" catchtap="closeAvatar">
    <view class="avatar-sheet" catchtap="noop">
      <view class="avatar-title">{{tr.t('选择默认头像', lang)}}</view>
      <view class="avatar-grid">
        <image wx:for="{{defaults}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" catchtap="pickDefault" />
      </view>
      <view class="avatar-action" bindtap="shoot">{{tr.t('拍照', lang)}}</view>
      <view class="avatar-action" bindtap="album">{{tr.t('从手机相册选择', lang)}}</view>
      <view class="avatar-action cancel" bindtap="closeAvatar">{{tr.t('取消', lang)}}</view>
    </view>
  </view>

  <view class="mine-member" wx:if="{{user.membership}}" bindtap="openMember">
    <view>
      <view class="mine-level"><text class="mine-em">{{tr.t(user.membership.code, lang)}}</text>{{tr.t('会员', lang)}}</view>
      <view class="muted">{{tr.t('本月累计新增', lang)}} {{tr.t(user.membership.monthGrowth, lang)}} {{tr.t('成长值', lang)}}</view>
    </view>
    <view class="mine-pill">{{tr.t('会员中心 ›', lang)}}</view>
  </view>

  <view class="mine-shortcuts">
    <view bindtap="goOrders" data-tab="unpaid">
      <view class="mine-order-ico">
        <image src="{{iconBase}}order-pay.png" mode="aspectFit" />
        <text wx:if="{{hub.unpaidCount}}" class="mine-badge">{{hub.unpaidCount > 99 ? '99+' : hub.unpaidCount}}</text>
      </view>
      <view class="muted">{{tr.t('待支付', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="waitlist">
      <view class="mine-order-ico">
        <image src="{{iconBase}}order-wait.png" mode="aspectFit" />
        <text wx:if="{{hub.waitlistCount}}" class="mine-badge">{{hub.waitlistCount > 99 ? '99+' : hub.waitlistCount}}</text>
      </view>
      <view class="muted">{{tr.t('候补', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="depart">
      <view class="mine-order-ico">
        <image src="{{iconBase}}order-go.png" mode="aspectFit" />
        <text wx:if="{{hub.departCount}}" class="mine-badge">{{hub.departCount > 99 ? '99+' : hub.departCount}}</text>
      </view>
      <view class="muted">{{tr.t('待出发', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="review">
      <view class="mine-order-ico">
        <image src="{{iconBase}}order-review.png" mode="aspectFit" />
        <text wx:if="{{hub.reviewCount}}" class="mine-badge">{{hub.reviewCount > 99 ? '99+' : hub.reviewCount}}</text>
      </view>
      <view class="muted">{{tr.t('待评价', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="refund">
      <view class="mine-order-ico">
        <image src="{{iconBase}}order-refund.png" mode="aspectFit" />
        <text wx:if="{{hub.refundCount}}" class="mine-badge">{{hub.refundCount > 99 ? '99+' : hub.refundCount}}</text>
      </view>
      <view class="muted">{{tr.t('退款', lang)}}</view>
    </view>
  </view>

  <view class="mine-wallet" bindtap="go" data-url="/pages/wallet/wallet">
    <view class="mine-wallet-item">
      <image class="wal-ico" src="{{iconBase}}wal-coin.png" mode="aspectFit" />
      <view class="wal-num">{{tr.t(hub.balance, lang)}}</view>
      <view class="wal-name">{{tr.t('余额', lang)}}</view>
    </view>
    <view class="mine-wallet-item">
      <view class="wal-ico-wrap">
        <image class="wal-ico" src="{{iconBase}}wal-coupon.png" mode="aspectFit" />
        <view wx:if="{{hub.couponCount}}" class="wal-dot"></view>
      </view>
      <view class="wal-num">{{tr.t(hub.couponCount, lang)}}</view>
      <view class="wal-name">{{tr.t('优惠券', lang)}}</view>
      <view class="mine-expire" wx:if="{{hub.couponExpireHint}}">{{tr.t(hub.couponExpireHint, lang)}}</view>
    </view>
    <view class="mine-wallet-item">
      <image class="wal-ico" src="{{iconBase}}wal-point.png" mode="aspectFit" />
      <view class="wal-num">{{tr.t(user.points, lang)}}</view>
      <view class="wal-name">{{tr.t('积分', lang)}}</view>
    </view>
    <view class="mine-wallet-item">
      <image class="wal-ico" src="{{iconBase}}wal-purse.png" mode="aspectFit" />
      <view class="wal-entry">{{tr.t('钱包', lang)}}</view>
      <view class="wal-bar"></view>
    </view>
  </view>
</view>

<view class="btn" wx:if="{{!user}}" bindtap="login">{{tr.t('登录', lang)}}</view>
<view class="btn ghost" wx:if="{{!user}}" bindtap="register">{{tr.t('注册', lang)}}</view>

<view class="cell-label">{{tr.t('常用', lang)}}</view>
<view class="mine-grid">
  <view bindtap="go" data-url="/pages/favorites/favorites"><image class="ico" src="{{iconBase}}fav.png" mode="aspectFit" />{{tr.t('收藏', lang)}}</view>
  <view bindtap="go" data-url="/pages/views/views"><image class="ico" src="{{iconBase}}views.png?v=2" mode="aspectFit" />{{tr.t('最近看过', lang)}}</view>
  <view bindtap="go" data-url="/pages/companions/companions"><image class="ico" src="{{iconBase}}people.png" mode="aspectFit" />{{tr.t('报名人', lang)}}</view>
  <view bindtap="go" data-url="/pages/follows/follows"><image class="ico" src="{{iconBase}}follow.png" mode="aspectFit" />{{tr.t('关注领队', lang)}}</view>
  <view bindtap="go" data-url="/pages/student/student"><image class="ico" src="{{iconBase}}campus.png" mode="aspectFit" />{{tr.t(campusLabel, lang)}}</view>
  <view bindtap="go" data-url="/pages/leader/leader"><image class="ico" src="{{iconBase}}leader.png?v=2" mode="aspectFit" />{{tr.t(leaderLabel, lang)}}</view>
  <view bindtap="go" data-url="/pages/publish/publish"><image class="ico" src="{{iconBase}}publish.png?v=2" mode="aspectFit" />{{tr.t('发团', lang)}}</view>
  <view bindtap="go" data-url="/pages/route-apply/route-apply"><image class="ico" src="{{iconBase}}route.png" mode="aspectFit" />{{tr.t('收录线路', lang)}}</view>
  <view bindtap="go" data-url="/pages/feedback/feedback"><image class="ico" src="{{iconBase}}feedback.png" mode="aspectFit" />{{tr.t('建议', lang)}}</view>
  <view bindtap="goRoutes"><image class="ico" src="{{iconBase}}trails.png?v=2" mode="aspectFit" />{{tr.t('看线路', lang)}}</view>
</view>
