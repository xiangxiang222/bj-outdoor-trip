<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="mine-page" wx:if="{{user}}">
  <view class="mine-hero-card">
    <view class="mine-user" bindtap="goHome">
      <view class="mine-avatar" catchtap="openAvatar">
        <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" />
        <text wx:else>{{tr.t(nickHead, lang)}}</text>
      </view>
      <view>
        <view class="title">{{tr.t(user.nickname, lang)}}</view>
        <view class="muted">{{tr.t(phone, lang)}}</view>
      </view>
    </view>
    <view class="mine-tools">
      <view class="mine-gear" bindtap="go" data-url="/pages/notices/notices">{{tr.t('消息', lang)}}<text wx:if="{{hub.unreadCount}}" class="mine-badge">{{hub.unreadCount > 9 ? '9+' : hub.unreadCount}}</text></view>
      <view class="mine-gear" bindtap="go" data-url="/pages/settings/settings">{{tr.t('设置', lang)}}</view>
    </view>
  </view>
  <view class="avatar-mask" wx:if="{{picker}}" catchtap="closeAvatar">
    <view class="avatar-sheet" catchtap="noop">
      <view class="avatar-title">{{tr.t('选择默认头像', lang)}}</view>
      <view class="avatar-grid">
        <image wx:for="{{defaults}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" catchtap="pickDefault" />
      </view>
      <view class="avatar-action" bindtap="shoot">{{tr.t('拍照', lang)}}</view>
      <view class="avatar-action" bindtap="album">{{tr.t('从手机相册选择', lang)}}</view>
      <view class="avatar-action cancel" bindtap="closeAvatar">{{tr.t('取消', lang)}}</view>
    </view>
  </view>

  <view class="mine-member" wx:if="{{user.membership}}" bindtap="openMember">
    <view>
      <view class="mine-level"><text class="mine-em">{{tr.t(user.membership.code, lang)}}</text>{{tr.t('会员', lang)}}</view>
      <view class="muted">{{tr.t('本月累计新增', lang)}} {{tr.t(user.membership.monthGrowth, lang)}} {{tr.t('成长值', lang)}}</view>
    </view>
    <view class="mine-pill">{{tr.t('会员中心 ›', lang)}}</view>
  </view>

  <view class="mine-shortcuts">
    <view bindtap="goOrders" data-tab="unpaid">
      <view class="title">{{tr.t(hub.unpaidCount, lang)}}</view>
      <view class="muted">{{tr.t('待支付', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="waitlist">
      <view class="title">{{tr.t(hub.waitlistCount, lang)}}</view>
      <view class="muted">{{tr.t('候补', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="depart">
      <view class="title">{{tr.t(hub.departCount, lang)}}</view>
      <view class="muted">{{tr.t('待出发', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="review">
      <view class="title">{{tr.t(hub.reviewCount, lang)}}</view>
      <view class="muted">{{tr.t('待评价', lang)}}</view>
    </view>
    <view bindtap="goOrders" data-tab="refund">
      <view class="title">{{tr.t(hub.refundCount, lang)}}</view>
      <view class="muted">{{tr.t('退款', lang)}}</view>
    </view>
  </view>

  <view class="mine-wallet" bindtap="go" data-url="/pages/wallet/wallet">
    <view>
      <view class="title">{{tr.t(hub.balance, lang)}}</view>
      <view class="muted">{{tr.t('余额（元）', lang)}}</view>
    </view>
    <view>
      <view class="title">{{tr.t(hub.couponCount, lang)}}</view>
      <view class="muted">{{tr.t('优惠券', lang)}}</view>
      <view class="mine-expire" wx:if="{{hub.couponExpireHint}}">{{tr.t(hub.couponExpireHint, lang)}}</view>
    </view>
    <view>
      <view class="title">{{tr.t(user.points, lang)}}</view>
      <view class="muted">{{tr.t('积分', lang)}}</view>
    </view>
    <view class="muted">{{tr.t('钱包 ›', lang)}}</view>
  </view>
</view>

<view class="btn" wx:if="{{!user}}" bindtap="login">{{tr.t('登录', lang)}}</view>
<view class="btn ghost" wx:if="{{!user}}" bindtap="register">{{tr.t('注册', lang)}}</view>

<view class="cell-label">{{tr.t('常用', lang)}}</view>
<view class="mine-grid">
  <view bindtap="go" data-url="/pages/favorites/favorites"><view class="ico">★</view>{{tr.t('收藏', lang)}}</view>
  <view bindtap="go" data-url="/pages/views/views"><view class="ico">看</view>{{tr.t('最近看过', lang)}}</view>
  <view bindtap="go" data-url="/pages/companions/companions"><view class="ico">人</view>{{tr.t('报名人', lang)}}</view>
  <view bindtap="go" data-url="/pages/follows/follows"><view class="ico">注</view>{{tr.t('关注领队', lang)}}</view>
  <view bindtap="go" data-url="/pages/student/student"><view class="ico">学</view>{{tr.t(campusLabel, lang)}}</view>
  <view bindtap="go" data-url="/pages/leader/leader"><view class="ico">队</view>{{tr.t(leaderLabel, lang)}}</view>
  <view bindtap="go" data-url="/pages/publish/publish"><view class="ico">团</view>{{tr.t('发团', lang)}}</view>
  <view bindtap="go" data-url="/pages/route-apply/route-apply"><view class="ico">线</view>{{tr.t('收录线路', lang)}}</view>
  <view bindtap="go" data-url="/pages/feedback/feedback"><view class="ico">问</view>{{tr.t('建议', lang)}}</view>
  <view bindtap="goRoutes"><view class="ico">目</view>{{tr.t('看线路', lang)}}</view>
</view>

<view class="cell-label">{{tr.t('服务', lang)}}</view>
<view class="cell-group">
  <view class="cell" bindtap="goOfficial"><text>{{tr.t('客服与规则', lang)}}</text><text class="muted">{{tr.t('加微信、FAQ ›', lang)}}</text></view>
</view>
