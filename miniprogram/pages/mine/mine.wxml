<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}{{posterPick || momentsOpen ? 'overflow:hidden;' : ''}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="mine-nav {{dark ? 'is-dark' : ''}}" style="padding-top: {{statusBarHeight}}px;">
  <view class="mine-nav-bar" style="height: {{navBarHeight}}px;"></view>
</view>
<view class="mine-page {{dark ? 'is-dark' : ''}}" wx:if="{{user}}">
  <view class="account-toolbar">
    <view class="account-heading">
      <view class="account-page-title">{{tr.t('我的', lang)}}</view>
      <text class="account-page-note">{{tr.t('每一程，都值得期待', lang)}}</text>
    </view>
    <view class="account-tools">
      <view bindtap="goOfficial" hover-class="account-tap"><image src="{{iconBase}}headset{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text>{{tr.t('客服', lang)}}</text></view>
      <view bindtap="go" data-url="/pages/notices/notices" hover-class="account-tap"><view class="account-icon"><image src="{{iconBase}}message{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text wx:if="{{hub.unreadCount}}" class="account-badge">{{hub.unreadCount > 9 ? '9+' : hub.unreadCount}}</text></view><text>{{tr.t('消息', lang)}}</text></view>
      <view bindtap="go" data-url="/pages/settings/settings" hover-class="account-tap"><image src="{{iconBase}}settings{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text>{{tr.t('设置', lang)}}</text></view>
    </view>
  </view>

  <view class="account-card account-overview">
    <view class="account-profile-row">
      <view class="account-avatar" catchtap="openAvatar" hover-class="account-tap">
        <image wx:if="{{user.avatar}}" src="{{user.avatar}}" mode="aspectFill" /><text wx:else>{{tr.t(nickHead, lang)}}</text>
      </view>
      <view class="account-identity">
        <view class="account-name" bindtap="goHome" hover-class="account-tap">{{tr.t(user.nickname, lang)}}</view>
        <view class="account-tier" bindtap="openMember" hover-class="account-tap"><image src="{{iconBase}}crown{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /><text>{{tr.t(user.membership.name || '注册会员', lang)}}</text><text class="account-tier-code">{{user.membership.code || 'V1'}}</text></view>
      </view>
    </view>
    <view class="account-stats">
      <view bindtap="go" data-url="/pages/wallet/wallet" hover-class="account-tap">
        <view class="account-stat-value" wx:if="{{hubReady}}">{{hub.balance != null ? hub.balance : user.walletBalance || 0}}</view><view class="account-stat-value" wx:else><view class="spinner"></view></view>
        <text class="account-stat-label">{{tr.t('余额', lang)}}<text class="account-unit"> / {{tr.t('元', lang)}}</text></text>
      </view>
      <view bindtap="go" data-url="/pages/coupons/coupons" hover-class="account-tap">
        <view class="account-stat-value" wx:if="{{hubReady}}">{{hub.couponCount || 0}}</view><view class="account-stat-value" wx:else><view class="spinner"></view></view>
        <text class="account-stat-label">{{tr.t('优惠券', lang)}}</text>
      </view>
      <view bindtap="go" data-url="/pages/signin/signin" hover-class="account-tap">
        <view class="account-stat-value" wx:if="{{hubReady}}">{{hub.points != null ? hub.points : user.points || 0}}</view><view class="account-stat-value" wx:else><view class="spinner"></view></view>
        <text class="account-stat-label">{{tr.t('积分', lang)}}</text>
      </view>
      <view bindtap="go" data-url="/pages/signin/signin" hover-class="account-tap">
        <view class="account-stat-value account-sign" wx:if="{{hubReady}}">{{hub.signedToday ? tr.t('已签到', lang) : tr.t('未签到', lang)}}</view><view class="account-stat-value" wx:else><view class="spinner"></view></view>
        <text class="account-stat-label">{{tr.t('每日签到', lang)}}</text>
      </view>
    </view>
    <view wx:if="{{hub.couponExpireHint}}" class="account-expiring" bindtap="go" data-url="/pages/coupons/coupons" hover-class="account-tap"><text>{{tr.t(hub.couponExpireHint, lang)}}</text><image src="{{iconBase}}chevron{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view>
    <view class="account-benefits" bindtap="openMember" hover-class="account-tap">
      <view class="account-benefits-copy"><view class="account-benefits-title"><image src="{{iconBase}}crown{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /><text>{{tr.t('同行会员', lang)}}</text></view><view class="account-benefits-detail" wx:if="{{user.membership.perks.length}}"><text class="account-perk">{{tr.t(user.membership.perks[0], lang)}}</text><text class="account-perk" wx:if="{{user.membership.perks[1]}}">{{tr.t(user.membership.perks[1], lang)}}</text></view><text class="account-benefits-detail" wx:else>{{tr.t('出行积累成长，解锁更多权益', lang)}}</text></view>
      <view class="account-benefits-more"><text>{{tr.t('会员中心', lang)}}</text><image src="{{iconBase}}chevron{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view>
    </view>
  </view>

  <view class="account-card account-orders">
    <view class="account-section-head">
      <view class="account-section-title">{{tr.t('我的行程', lang)}}</view>
      <view class="account-all" bindtap="goOrders" data-tab="all" hover-class="account-tap"><text>{{tr.t('全部订单', lang)}}</text><image class="account-chevron" src="{{iconBase}}chevron{{dark ? '-dark' : ''}}.png" mode="aspectFit" /></view>
    </view>
    <view class="account-order-row">
      <view class="account-shortcuts">
        <view bindtap="goOrders" data-tab="unpaid" hover-class="account-tap"><view class="account-icon"><image src="{{iconBase}}card{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text wx:if="{{hub.unpaidCount}}" class="account-badge">{{hub.unpaidCount > 99 ? '99+' : hub.unpaidCount}}</text></view><text>{{tr.t('待付款', lang)}}</text></view>
        <view bindtap="goOrders" data-tab="recruiting" hover-class="account-tap"><view class="account-icon"><image src="{{iconBase}}people{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text wx:if="{{hub.recruitingCount}}" class="account-badge">{{hub.recruitingCount > 99 ? '99+' : hub.recruitingCount}}</text></view><text>{{tr.t('待成团', lang)}}</text></view>
        <view bindtap="goOrders" data-tab="depart" hover-class="account-tap"><view class="account-icon"><image src="{{iconBase}}backpack{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text wx:if="{{hub.departCount}}" class="account-badge">{{hub.departCount > 99 ? '99+' : hub.departCount}}</text></view><text>{{tr.t('待出行', lang)}}</text></view>
        <view bindtap="goOrders" data-tab="review" hover-class="account-tap"><view class="account-icon"><image src="{{iconBase}}review{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text wx:if="{{hub.reviewCount}}" class="account-badge">{{hub.reviewCount > 99 ? '99+' : hub.reviewCount}}</text></view><text>{{tr.t('待评价', lang)}}</text></view>
      </view>
    </view>
    <view class="account-history">
      <view bindtap="go" data-url="/pages/views/views" hover-class="account-tap"><text>{{tr.t('足迹', lang)}}</text><text class="account-count" wx:if="{{hubReady}}">{{hub.viewCount || 0}}</text><view class="spinner" wx:else></view></view>
      <view bindtap="go" data-url="/pages/favorites/favorites" hover-class="account-tap"><text>{{tr.t('收藏', lang)}}</text><text class="account-count" wx:if="{{hubReady}}">{{hub.favoriteCount || 0}}</text><view class="spinner" wx:else></view></view>
      <view bindtap="go" data-url="/pages/follows/follows" hover-class="account-tap"><text>{{tr.t('关注', lang)}}</text><text class="account-count" wx:if="{{hubReady}}">{{hub.followCount || 0}}</text><view class="spinner" wx:else></view></view>
    </view>
  </view>

  <view class="account-card account-wishes" id="mine-wishes" bindtap="go" data-url="/pages/wishes/wishes" hover-class="account-tap" role="button" aria-label="{{tr.t('我的心意簿', lang)}}"><view class="account-wish-art" aria-hidden="true"><view></view></view><view class="account-wish-copy"><view>{{tr.t('我的心意簿', lang)}}<text>{{tr.t('意思意思', lang)}}</text></view><text>{{tr.t('发起的心愿，认领的安排，都好好收着。', lang)}}</text></view><text class="account-wish-arrow" aria-hidden="true">→</text></view>

  <view class="account-card account-services">
    <view class="account-section-title">{{tr.t('出行与服务', lang)}}</view>
    <view class="account-create">
      <view bindtap="go" data-url="/pages/route-apply/route-apply" hover-class="account-tap"><view class="account-create-icon"><image src="{{iconBase}}route{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view><view class="account-create-copy"><text>{{tr.t('线路收录', lang)}}</text><text>{{tr.t('申请审核后上线', lang)}}</text></view><image class="account-chevron" src="{{iconBase}}chevron{{dark ? '-dark' : ''}}.png" mode="aspectFit" /></view>
      <view bindtap="go" data-url="/pages/publish/publish" hover-class="account-tap"><view class="account-create-icon"><image src="{{iconBase}}publish{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view><view class="account-create-copy"><text>{{tr.t('发起行程', lang)}}</text><text>{{tr.t('高校 · 企业 · 好友', lang)}}</text></view><image class="account-chevron" src="{{iconBase}}chevron{{dark ? '-dark' : ''}}.png" mode="aspectFit" /></view>
    </view>
    <view class="account-service-grid">
      <view bindtap="go" data-url="/pages/student/student" hover-class="account-tap"><view class="account-service-icon"><image src="{{iconBase}}cap{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view><text>{{tr.t(campusLabel, lang)}}</text></view>
      <view bindtap="go" data-url="/pages/leader/leader" hover-class="account-tap"><view class="account-service-icon"><image src="{{iconBase}}compass{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view><text>{{tr.t(leaderLabel, lang)}}</text></view>
      <view bindtap="go" data-url="/pages/photo-apply/photo-apply" hover-class="account-tap"><view class="account-service-icon"><image src="{{iconBase}}camera{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view><text>{{tr.t('摄影师申请', lang)}}</text></view>
      <view bindtap="openPoster" hover-class="account-tap"><view class="account-service-icon"><image src="{{iconBase}}poster{{dark ? '-dark' : '-purple'}}.png" mode="aspectFit" /></view><text>{{tr.t('生成海报', lang)}}</text></view>
    </view>
    <view class="account-feedback" bindtap="go" data-url="/pages/feedback/feedback" hover-class="account-tap"><image src="{{iconBase}}feedback{{dark ? '-dark' : ''}}.png" mode="aspectFit" /><text>{{tr.t('意见反馈', lang)}}</text><text class="account-feedback-note">{{tr.t('让下一次出行更好', lang)}}</text><image class="account-chevron" src="{{iconBase}}chevron{{dark ? '-dark' : ''}}.png" mode="aspectFit" /></view>
  </view>
  <view class="avatar-mask" wx:if="{{picker}}" catchtap="closeAvatar">
    <view class="avatar-sheet" catchtap="noop">
      <view class="avatar-title">{{tr.t('选择默认头像', lang)}}</view>
      <view class="avatar-grid"><image wx:for="{{defaults}}" wx:key="id" src="{{item.url}}" mode="aspectFill" data-url="{{item.url}}" catchtap="pickDefault" /></view>
      <view class="avatar-action" bindtap="shoot">{{tr.t('拍照', lang)}}</view>
      <view class="avatar-action" bindtap="album">{{tr.t('从手机相册选择', lang)}}</view>
      <view class="avatar-action cancel" bindtap="closeAvatar">{{tr.t('取消', lang)}}</view>
    </view>
  </view>
</view>

<view class="guest-welcome" wx:if="{{!user}}"><image src="{{mediaBase}}/covers/R01.jpg" mode="aspectFill" /><view class="guest-welcome-copy"><view class="section-kicker">YOUR JOURNEY STARTS HERE</view><view>{{tr.t('每一程，都值得期待', lang)}}</view><text>{{tr.t('登录后管理行程，解锁你的同行权益', lang)}}</text></view></view>
<view class="btn" wx:if="{{!user}}" bindtap="login">{{tr.t('登录', lang)}}</view>
<view class="btn ghost" wx:if="{{!user}}" bindtap="register">{{tr.t('注册', lang)}}</view>

<view class="cell-label" wx:if="{{picks.length}}">{{tr.t('路线推荐', lang)}}</view>
<view class="mine-rec" wx:if="{{picks.length}}">
  <view wx:for="{{picks}}" wx:key="id" bindtap="openRoute" data-id="{{item.id}}">
    <image wx:if="{{item.cover}}" src="{{item.cover}}" mode="aspectFill" />
    <view wx:else class="mine-rec-ph">{{item.mark}}</view>
    <text class="mine-rec-title">{{tr.t(item.title, lang)}}</text>
    <text class="mine-rec-price" wx:if="{{item.fromPrice != null}}">¥{{item.fromPrice}}</text>
  </view>
</view>
<canvas type="2d" id="momentsCanvas" class="moments-offscreen"></canvas>
<view class="moments-mask" wx:if="{{posterPick}}" catchtap="closePosterPick">
  <view class="moments-sheet poster-pick {{posterCoverBar ? 'cover-bar' : 'above-tab'}} {{dark ? 'is-dark' : ''}}" catchtap="noop">
    <view class="poster-head">
      <view class="poster-pick-title">{{tr.t('选择要放进海报的团', lang)}}</view>
      <view class="poster-count {{posterCount ? 'on' : ''}}">{{tr.t('已选', lang)}} {{posterCount}}/6</view>
    </view>
    <view class="muted poster-pick-hint">{{tr.t('最多选 6 个团', lang)}}</view>
    <view class="poster-tools">
      <view class="poster-chip {{posterRange=='all' ? 'on' : ''}}" data-range="all" bindtap="setPosterRange">{{tr.t('全部', lang)}}</view>
      <view class="poster-chip {{posterRange=='week' ? 'on' : ''}}" data-range="week" bindtap="setPosterRange">{{tr.t('最近一周', lang)}}</view>
      <view class="poster-chip {{posterRange=='month' ? 'on' : ''}}" data-range="month" bindtap="setPosterRange">{{tr.t('最近一个月', lang)}}</view>
      <view class="poster-chip {{posterRange=='date' ? 'on' : ''}}" data-range="date" bindtap="setPosterRange">{{tr.t('指定日期', lang)}}</view>
    </view>
    <picker wx:if="{{posterRange=='date'}}" mode="date" value="{{posterDate}}" bindchange="onPosterDate">
      <view class="poster-date">{{posterDate || tr.t('选一个出发日期', lang)}}</view>
    </picker>
    <input class="poster-search" style="height:80rpx;" placeholder-class="poster-ph" placeholder-style="color:#8d8d8d;font-size:28rpx;" placeholder="{{tr.t('搜索团名、集合点', lang)}}" value="{{posterQuery}}" bindinput="onPosterQuery" confirm-type="search" />
    <view wx:if="{{posterPicked.length}}" class="poster-picked">
      <view class="poster-picked-chip" wx:for="{{posterPicked}}" wx:key="id" bindtap="togglePoster" data-id="{{item.id}}">
        <text class="poster-picked-name">{{item.md}}</text>
        <text class="poster-picked-x">×</text>
      </view>
    </view>
    <view class="muted poster-pick-empty" wx:if="{{!posterReady}}">{{tr.t('正在加载', lang)}}</view>
    <view class="muted poster-pick-empty" wx:elif="{{!posterTrips.length}}">{{tr.t('还没有可以做成海报的团', lang)}}</view>
    <view class="muted poster-pick-empty" wx:elif="{{posterRange=='date' && !posterDate}}">{{tr.t('选一个出发日期', lang)}}</view>
    <view class="muted poster-pick-empty" wx:elif="{{!posterTotal}}">{{tr.t('没有符合条件的团', lang)}}</view>
    <scroll-view wx:else scroll-y class="poster-pick-list" enhanced show-scrollbar="{{false}}">
      <view class="poster-pick-row{{item.on ? ' on' : ''}}" wx:for="{{posterShown}}" wx:key="id" bindtap="togglePoster" data-id="{{item.id}}">
        <view class="poster-date-mark">
          <text class="poster-date-day">{{item.day}}</text>
          <text class="poster-date-md">{{item.md}}</text>
        </view>
        <view class="poster-pick-copy">
          <text class="poster-pick-name">{{tr.t(item.title, lang)}}</text>
          <text class="poster-pick-when">{{tr.t(item.week, lang)}}<text wx:if="{{item.meet}}"> · {{tr.t(item.meet, lang)}}</text></text>
        </view>
        <view class="poster-pick-mark"></view>
      </view>
    </scroll-view>
    <view class="poster-pager" wx:if="{{posterPages > 1}}">
      <view class="poster-page-btn {{posterPage<=1 ? 'off' : ''}}" data-dir="-1" bindtap="shiftPosterPage">{{tr.t('上一页', lang)}}</view>
      <text class="poster-page-num">{{posterPage}} / {{posterPages}}</text>
      <view class="poster-page-btn {{posterPage>=posterPages ? 'off' : ''}}" data-dir="1" bindtap="shiftPosterPage">{{tr.t('下一页', lang)}}</view>
    </view>
    <view class="btn" bindtap="makePoster">{{tr.t('生成海报', lang)}}{{posterCount ? ' · ' + posterCount : ''}}</view>
    <view class="btn ghost" bindtap="closePosterPick">{{tr.t('关闭', lang)}}</view>
  </view>
</view>
<view class="moments-mask" wx:if="{{momentsOpen}}" catchtap="closeMoments">
  <view class="moments-sheet {{posterCoverBar ? 'cover-bar' : 'above-tab'}} {{dark ? 'is-dark' : ''}}" catchtap="noop">
    <scroll-view scroll-y class="moments-scroll" enhanced show-scrollbar="{{false}}">
      <image class="moments-img" src="{{momentsPath}}" mode="widthFix" show-menu-by-longpress />
    </scroll-view>
    <view class="muted moments-hint">{{tr.t('长按图片保存，再发到朋友圈', lang)}}</view>
    <view class="btn" bindtap="shareMoments">{{tr.t('发到朋友圈', lang)}}</view>
    <view class="btn ghost" bindtap="saveMoments">{{tr.t('保存图片', lang)}}</view>
    <view class="btn ghost" bindtap="closeMoments">{{tr.t('关闭', lang)}}</view>
  </view>
</view>
<view class="tab-pad"></view>
