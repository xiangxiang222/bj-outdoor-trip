page { background: var(--bg, #f5f6f8); }
.sec { margin: 28rpx 32rpx 12rpx; color: var(--muted, #8a8f99); font-size: calc(24rpx * var(--ui-scale)); }
.preview { margin: 0 24rpx; padding: 28rpx; background: #8e8e93; border-radius: 24rpx; }
.sample { background: var(--card, #fff); color: var(--ink, #141414); border-radius: 16rpx; padding: 28rpx; font-size: calc(32rpx * var(--ui-scale)); }
.pt { font-size: calc(34rpx * var(--ui-scale)); font-weight: 650; line-height: 1.45; }
.pb { margin-top: 16rpx; color: var(--muted, #666); font-size: calc(28rpx * var(--ui-scale)); line-height: 1.5; }
.pn { margin-top: 18rpx; color: #8a8f99; font-size: calc(22rpx * var(--ui-scale)); }
.fonts { display: flex; gap: 16rpx; margin: 0 24rpx; }
.font { flex: 1; background: var(--card, #fff); border-radius: 16rpx; padding: 28rpx 8rpx; text-align: center; border: 2rpx solid transparent; }
.font.on { background: #f2f2f4; }
.fn { font-size: calc(32rpx * var(--ui-scale)); }
.fs { margin-top: 12rpx; color: #8a8f99; font-size: calc(22rpx * var(--ui-scale)); font-family: "PingFang SC", sans-serif; }
.size { margin: 0 24rpx; padding: 24rpx 28rpx 32rpx; background: var(--card, #fff); border-radius: 24rpx; }
.scale { display: flex; justify-content: space-between; align-items: flex-end; color: var(--ink, #141414); }
.mid { font-size: calc(26rpx * var(--ui-scale)); color: var(--muted, #8a8f99); }
.big { font-size: calc(44rpx * var(--ui-scale)); }
.hint { margin-top: 8rpx; text-align: center; color: #8a8f99; font-size: calc(22rpx * var(--ui-scale)); background: #f3f4f6; border-radius: 8rpx; padding: 8rpx; }
