page { background: var(--bg, #f5f6f8); }
.sec { margin: 28rpx 32rpx 12rpx; color: var(--muted, #8a8f99); font-size: 24rpx; }
.preview { margin: 0 24rpx; padding: 28rpx; background: #8e8e93; border-radius: 24rpx; }
.sample { background: var(--card, #fff); color: var(--ink, #141414); border-radius: 16rpx; padding: 28rpx; }
.pt { font-size: 34rpx; font-weight: 650; line-height: 1.45; }
.pb { margin-top: 16rpx; color: var(--muted, #666); font-size: 28rpx; line-height: 1.5; }
.pn { margin-top: 18rpx; color: #8a8f99; font-size: 22rpx; }
.fonts { display: flex; gap: 16rpx; margin: 0 24rpx; }
.font { flex: 1; background: var(--card, #fff); border-radius: 16rpx; padding: 28rpx 8rpx; text-align: center; border: 2rpx solid transparent; }
.font.on { background: #f2f2f4; }
.fn { font-size: 32rpx; }
.fs { margin-top: 12rpx; color: #8a8f99; font-size: 22rpx; font-family: "PingFang SC", sans-serif; }
.size { margin: 0 24rpx; padding: 24rpx 28rpx 32rpx; background: var(--card, #fff); border-radius: 24rpx; }
.scale { display: flex; justify-content: space-between; align-items: flex-end; color: var(--ink, #141414); }
.mid { font-size: 26rpx; color: var(--muted, #8a8f99); }
.big { font-size: 44rpx; }
.hint { margin-top: 8rpx; text-align: center; color: #8a8f99; font-size: 22rpx; background: #f3f4f6; border-radius: 8rpx; padding: 8rpx; }
