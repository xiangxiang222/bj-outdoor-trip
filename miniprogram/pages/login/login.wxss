.login-nav {
  display: flex;
  align-items: center;
  padding-right: 180rpx;
  box-sizing: border-box;
}
.login-back {
  min-width: 120rpx;
  min-height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  color: #2d6a4f;
}
.login-nav-title {
  flex: 1;
  min-height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: calc(34rpx * var(--ui-scale));
  font-weight: 650;
}
.auth-page {
  min-height: 100vh;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.auth-dialog {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.auth-title {
  padding: 48rpx 32rpx 12rpx;
  text-align: center;
  font-size: calc(34rpx * var(--ui-scale));
  font-weight: 650;
}
.auth-text {
  padding: 8rpx 40rpx 40rpx;
  text-align: center;
  color: #666;
  font-size: calc(30rpx * var(--ui-scale));
}
.auth-actions {
  display: flex;
  border-top: 1px solid #eee;
}
.auth-cancel,
.auth-go {
  flex: 1;
  text-align: center;
  font-size: calc(34rpx * var(--ui-scale));
  line-height: 1.2;
  padding: 28rpx 0;
  margin: 0;
  background: #fff;
  border-radius: 0;
}
.auth-cancel { color: #333; }
.auth-go { color: #1677ff; border-left: 1px solid #eee; }
.auth-go::after { border: none; }
.auth-alt {
  margin-top: 28rpx;
  color: #fff;
  font-size: calc(26rpx * var(--ui-scale));
}
.captcha-box {
  margin: 12rpx 16rpx;
  height: 128rpx;
  border: 1px solid #e6dfd2;
  border-radius: 12rpx;
  background: #f4efe6;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.sms-row { display: flex; align-items: center; gap: 16rpx; margin: 0 16rpx 12rpx; }
.sms-row .sms-input { flex: 1; margin: 0; }
.sms-btn {
  min-width: 180rpx;
  min-height: 88rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1px solid #e6dfd2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: calc(26rpx * var(--ui-scale));
  font-weight: 700;
}
.sms-btn.off { color: #7a7d74; }
.captcha-full {
  width: 100%;
  height: 120rpx;
  display: block;
}
