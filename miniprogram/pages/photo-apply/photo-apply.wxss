.pad { padding: 24rpx 32rpx; }
.muted { color: #8d8d8d; font-size: 26rpx; }
.photo-trip { display: flex; gap: 16rpx; margin: 0 24rpx 16rpx; padding: 16rpx; background: #fff; border-radius: 16rpx; align-items: center; }
.photo-trip image { width: 144rpx; height: 144rpx; border-radius: 12rpx; flex: none; background: #eee; }
.photo-title { font-size: 28rpx; line-height: 1.35; color: #1a1a1a; }
