.pie {
  width: 100%;
  height: 420rpx;
  display: block;
}
.legend {
  display: flex;
  flex-wrap: wrap;
  padding: 0 24rpx 12rpx;
  gap: 16rpx 28rpx;
}
.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #1a1a1a;
}
.dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
