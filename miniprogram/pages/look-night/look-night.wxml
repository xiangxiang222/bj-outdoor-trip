<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<view class="list">
  <view class="row" data-night="system" bindtap="pick">
    <view>
      <view>{{copy.systemNight}}</view>
      <view class="sub">{{copy.systemNightSub}}</view>
    </view>
    <text class="mark" wx:if="{{look.night==='system'}}">✓</text>
  </view>
  <view class="row" data-night="day" bindtap="pick">
    <text>{{copy.day}}</text>
    <text class="mark" wx:if="{{look.night==='day'}}">✓</text>
  </view>
  <view class="row" data-night="dark" bindtap="pick">
    <text>{{copy.dark}}</text>
    <text class="mark" wx:if="{{look.night==='dark'}}">✓</text>
  </view>
</view>
