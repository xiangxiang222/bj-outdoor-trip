<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="card">
  <view class="pad">
    <view class="title">{{tr.t(rules.title, lang)}}</view>
    <view class="muted">{{tr.t(rules.summary, lang)}}</view>
  </view>
</view>
<view class="card" wx:for="{{rules.sections}}" wx:key="title">
  <view class="pad">
    <view class="title">{{tr.t(item.title, lang)}}</view>
    <view class="muted" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">{{tr.t(index + 1, lang)}}. {{tr.t(line, lang)}}</view>
  </view>
</view>
<view class="card" wx:if="{{faqs.length}}">
  <view class="pad title">{{tr.t('常见问题', lang)}}</view>
  <view class="pad faq-item" wx:for="{{faqs}}" wx:key="q">
    <view>{{tr.t(item.q, lang)}}</view>
    <view class="muted">{{tr.t(item.a, lang)}}</view>
  </view>
</view>
