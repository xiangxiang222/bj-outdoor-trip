.trip-head { margin-top: 0; border-radius: 0; }
.schedule-page { --detail-accent:#785498; }
.schedule-page.detail-dark { --detail-accent:#c6addf; }
.schedule-page button.btn { width:auto; min-width:0; }
.role-board { margin-top:28rpx; padding-top:28rpx; border-top:1rpx solid var(--line,#eeecf2); }
.role-heading { display:flex; align-items:center; justify-content:space-between; gap:16rpx; margin-bottom:6rpx; color:var(--ink,#24222a); font-size:calc(28rpx * var(--ui-scale)); font-weight:600; }
.role-kicker { flex:none; padding:4rpx 14rpx; border-radius:999rpx; background:rgba(129,98,166,.09); color:var(--detail-accent,#785498); font-size:calc(20rpx * var(--ui-scale)); font-weight:400; }
.role-row { display:flex; align-items:center; gap:20rpx; min-height:120rpx; padding:22rpx 0; box-sizing:border-box; }
.role-row + .role-row { border-top:1rpx solid var(--line,#eeecf2); }
.role-icon { position:relative; flex:none; width:72rpx; height:72rpx; border-radius:22rpx; background:rgba(129,98,166,.08); color:var(--detail-accent,#785498); }
.role-icon-leader::before { content:""; position:absolute; left:26rpx; top:20rpx; width:2rpx; height:34rpx; border-radius:2rpx; background:currentColor; }
.role-icon-leader::after { content:""; position:absolute; left:28rpx; top:20rpx; width:23rpx; height:19rpx; border:2rpx solid currentColor; border-left:0; border-radius:2rpx 5rpx 5rpx 0; box-sizing:border-box; transform:skewY(-10deg); }
.role-icon-camera::before { content:""; position:absolute; left:18rpx; top:24rpx; width:36rpx; height:26rpx; border:2rpx solid currentColor; border-radius:6rpx; box-sizing:border-box; }
.role-icon-camera::after { content:""; position:absolute; left:29rpx; top:31rpx; width:14rpx; height:14rpx; border:2rpx solid currentColor; border-radius:50%; box-sizing:border-box; }
.role-copy { flex:1; min-width:0; }
.role-title { font-size:calc(28rpx * var(--ui-scale)); font-weight:550; color:var(--ink,#24222a); line-height:1.5; }
.role-sub { margin-top:4rpx; font-size:calc(22rpx * var(--ui-scale)); color:var(--muted,#8a8692); line-height:1.6; word-break:break-word; }
.role-person { color:var(--ink,#24222a); }
.role-action { flex:none; display:flex; align-items:center; gap:10rpx; max-width:34%; color:var(--detail-accent,#785498); font-size:calc(24rpx * var(--ui-scale)); font-weight:500; line-height:1.5; }
.role-view { color:var(--muted,#8a8692); font-weight:400; }
.role-chevron { flex:none; width:10rpx; height:10rpx; margin-right:4rpx; border-top:2rpx solid currentColor; border-right:2rpx solid currentColor; transform:rotate(45deg); }
.role-row:active { opacity:.65; }
.trip-weather-card { padding:28rpx; box-sizing:border-box; background:var(--card,#fff); }
.weather-heading { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:12rpx; font-size:calc(28rpx * var(--ui-scale)); font-weight:600; color:var(--ink,#24222a); }
.weather-day { color:var(--muted,#8a8692); font-size:calc(21rpx * var(--ui-scale)); font-weight:400; }
.weather-overview { display:flex; align-items:flex-end; justify-content:space-between; flex-wrap:wrap; gap:20rpx; margin-top:30rpx; }
.weather-location { flex:1; min-width:150rpx; }
.weather-place { color:var(--ink,#24222a); font-size:calc(30rpx * var(--ui-scale)); font-weight:550; line-height:1.5; word-break:break-word; }
.weather-summary { margin-top:6rpx; color:var(--muted,#8a8692); font-size:calc(24rpx * var(--ui-scale)); }
.weather-range { max-width:100%; color:var(--ink,#24222a); font-size:calc(44rpx * var(--ui-scale)); font-weight:550; line-height:1.3; letter-spacing:-1rpx; }
.weather-range-sep { margin:0 8rpx; color:var(--muted,#8a8692); font-size:.65em; }
.weather-unit { margin-left:4rpx; color:var(--muted,#8a8692); font-size:calc(24rpx * var(--ui-scale)); font-weight:400; }
.weather-meta { display:flex; align-items:center; flex-wrap:wrap; gap:12rpx 32rpx; margin-top:24rpx; color:var(--ink,#24222a); font-size:calc(22rpx * var(--ui-scale)); }
.weather-meta text { color:var(--muted,#8a8692); margin-right:8rpx; }
.weather-chart-legend { display:flex; justify-content:flex-end; flex-wrap:wrap; gap:24rpx; margin-top:26rpx; color:var(--muted,#8a8692); font-size:calc(20rpx * var(--ui-scale)); }
.weather-chart-legend > view { display:flex; align-items:center; gap:8rpx; }
.weather-temp-key { width:22rpx; height:3rpx; border-radius:3rpx; background:var(--detail-accent,#785498); }
.weather-rain-key { width:10rpx; height:14rpx; border-radius:3rpx; background:rgba(148,118,178,.28); }
.trip-weather-card .wx-chart { margin-top:0; height:240rpx; }
.weather-advice { display:flex; flex-wrap:wrap; align-items:baseline; gap:12rpx 20rpx; margin-top:22rpx; padding-top:22rpx; border-top:1rpx solid var(--line,#eeecf2); }
.weather-advice-label { flex:none; color:var(--detail-accent,#785498); font-size:calc(22rpx * var(--ui-scale)); font-weight:500; }
.weather-advice-copy { flex:1; min-width:260rpx; color:var(--muted,#8a8692); font-size:calc(22rpx * var(--ui-scale)); line-height:1.8; }
.weather-high { color:#b76677; }
.hero-swipe { margin: 0; }
.offer-hero .hero-swipe,
.offer-hero .cover { height: 480rpx; }
.offer-sheet { margin-top: 0; }
.offer-price-row { display: flex; align-items: flex-end; justify-content: space-between; }
.offer-price { color: #e1251b; font-size: calc(64rpx * var(--ui-scale)); font-weight: 700; line-height: 1; }
.offer-unit { color: #e1251b; font-size: calc(26rpx * var(--ui-scale)); margin-left: 4rpx; }
.offer-tiers { margin-top: 8rpx; color: #7a7d74; font-size: calc(24rpx * var(--ui-scale)); }
.offer-tiers text { margin-right: 16rpx; }
.offer-title { margin-top: 16rpx; font-size: calc(40rpx * var(--ui-scale)); font-weight: 700; line-height: 1.35; }
.offer-sell { margin-top: 8rpx; color: #595959; font-size: calc(28rpx * var(--ui-scale)); line-height: 1.5; }
.offer-chips { margin-top: 12rpx; }
.offer-quote { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff7e8; color: #8a5a12; }
.offer-quote-score { color: #d46b08; font-weight: 700; flex: none; }
.offer-quote-text { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.offer-quote-n { flex: none; color: #ad8b66; font-size: calc(24rpx * var(--ui-scale)); }
.offer-guaranteed { margin-top: 16rpx; color: #725793; }
.offer-point { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.offer-point-n { width: 36rpx; height: 36rpx; border-radius: 50%; background: #5b3b8c; color: #fff; text-align: center; line-height: 36rpx; font-size: calc(22rpx * var(--ui-scale)); flex: none; }
.day-stop { display: flex; gap: 16rpx; }
.day-time { width: 120rpx; flex: none; color: #725793; font-size: calc(24rpx * var(--ui-scale)); font-weight: 650; }
.day-body { flex: 1; border-left: 4rpx solid #e6ddf0; padding: 0 0 24rpx 16rpx; }
.day-photo { width: 100%; height: 200rpx; margin-top: 12rpx; border-radius: 12rpx; }
.fee-k { font-weight: 700; }
.goods-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.goods-tab {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: calc(30rpx * var(--ui-scale));
  color: #8c8c8c;
  position: relative;
}
.goods-tab.on {
  color: #1a1a1a;
  font-weight: 600;
}
.goods-tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 6rpx;
  background: #e1251b;
}
.story-text { white-space: pre-wrap; line-height: 1.7; margin: 12rpx 0 20rpx; }
.story-img { width: 100%; border-radius: 12rpx; margin: 8rpx 0 16rpx; display: block; }
.app-tabs-spacer { height: calc(140rpx + constant(safe-area-inset-bottom)); height: calc(140rpx + env(safe-area-inset-bottom)); }
.share-offscreen { position: fixed; left: -2000px; top: 0; width: 500px; height: 500px; }
.poster-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.55);
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.poster-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.poster-cover { width: 100%; height: 280rpx; display: block; }
.poster-body { padding: 24rpx; }
.poster-title { font-size: calc(32rpx * var(--ui-scale)); font-weight: 700; margin-bottom: 16rpx; }
.poster-split { display: flex; gap: 16rpx; align-items: flex-start; margin-bottom: 16rpx; }
.poster-facts { flex: 1; }
.poster-qr { width: 180rpx; height: 180rpx; background: #fff; flex-shrink: 0; }


.activity-detail-brief { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24rpx 28rpx; margin:20rpx 28rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:22rpx; background:var(--card); color:var(--ink); font-size:calc(25rpx * var(--ui-scale)); line-height:1.7; }
.activity-detail-brief > view { min-width:0; word-break:break-all; }
.activity-info-label { color:var(--muted); font-size:calc(22rpx * var(--ui-scale)); margin-bottom:8rpx; }
.activity-info-row { display:flex; gap:24rpx; padding:24rpx 28rpx; border-bottom:1rpx solid var(--line); font-size:calc(25rpx * var(--ui-scale)); line-height:1.8; }
.activity-info-row > text { flex:none; width:150rpx; color:var(--muted); }
.activity-info-row > view { flex:1; min-width:0; word-break:break-all; color:var(--ink); }

/* City moments use a compact identity and participation card, rather than a tour product hero. */
.schedule-page.is-activity { --city-purple:#5b3b8c; --city-soft:#f4eff9; padding:20rpx 0 0; color:var(--ink,#29232f); font-family:"PingFang SC","Hiragino Sans GB",sans-serif; }
.is-activity .card { margin:20rpx 28rpx; border:1rpx solid var(--line,#eee8f4); border-radius:28rpx; background:var(--card,#fff); overflow:hidden; }
.is-activity .card > .pad { padding:28rpx; }
.is-activity .offer-sheet { margin-top:0; }
.city-heading { display:flex; gap:24rpx; align-items:center; padding-bottom:28rpx; }
.city-cover { width:166rpx; height:166rpx; flex:none; display:block; border-radius:24rpx; background:var(--city-soft); }
.city-cover-fallback { display:flex; align-items:center; justify-content:center; color:var(--city-purple); font-size:34rpx; }
.city-heading-copy { flex:1; min-width:0; }
.city-kicker { color:var(--muted,#93859f); font-size:22rpx; letter-spacing:2rpx; }
.is-activity .city-heading .offer-title { margin:14rpx 0 14rpx; color:var(--ink,#29232f); font-size:calc(36rpx * var(--ui-scale,1)); font-weight:650; line-height:1.45; word-break:break-all; }
.city-price { color:var(--city-purple); font-size:30rpx; font-weight:650; }
.city-price text { font-size:22rpx; font-weight:400; margin-left:6rpx; }
.city-status { border-top:1rpx solid var(--line,#eee8f4); padding:24rpx 0 20rpx; }
.city-status > text { display:inline-block; padding:8rpx 18rpx; color:var(--city-purple); background:var(--city-soft); border-radius:12rpx; font-size:24rpx; font-weight:600; }
.city-status > view { color:var(--muted,#8d8198); font-size:24rpx; line-height:1.7; margin-top:12rpx; }
.city-manage { display:flex; align-items:center; justify-content:space-between; gap:20rpx; border-top:1rpx solid var(--line,#eee8f4); padding:20rpx 0 0; font-size:23rpx; color:var(--muted,#8d8198); }
.is-activity .city-manage .btn { flex:none; margin:0; padding:12rpx 24rpx; font-size:24rpx; }
.is-activity .fact-list { margin-top:0; }
.is-activity .fact-row { display:flex; align-items:flex-start; gap:20rpx; margin:0; padding:14rpx 0; font-size:calc(26rpx * var(--ui-scale,1)); line-height:1.65; }
.is-activity .fact-k { width:62rpx; flex:none; font-weight:400; color:var(--muted,#94879e); }
.is-activity .fact-v { flex:1; min-width:0; color:var(--ink,#302a36); font-weight:500; word-break:break-all; }
.is-activity .nav-link { color:var(--city-purple); font-size:inherit; }
.is-activity .activity-detail-brief { background:var(--card,#fff); margin:20rpx 28rpx; border-color:var(--line,#eee8f4); padding:26rpx 28rpx; }
.is-activity .goods-tabs { margin:24rpx 28rpx 8rpx; border-bottom:1rpx solid var(--line,#eee8f4); background:var(--bg,#f7f5fa); }
.is-activity .goods-tab { height:84rpx; line-height:84rpx; font-size:28rpx; color:var(--muted,#8f829a); }
.is-activity .goods-tab.on { color:var(--city-purple); }
.is-activity .goods-tab.on::after { background:var(--city-purple); width:40rpx; height:5rpx; bottom:5rpx; }
.is-activity .ticket-card { color:var(--city-purple); background:var(--city-soft); border:1rpx solid var(--line,#e7ddee); border-radius:22rpx; padding:26rpx; }
.is-activity .ticket-card .title { font-size:32rpx; font-weight:600; }
.is-activity .ticket-card .muted { color:var(--muted,#8d7e9b); font-size:24rpx; margin-top:8rpx; line-height:1.7; }
.is-activity .ticket-actions { display:flex; gap:16rpx; margin-top:22rpx; }
.is-activity .ticket-actions .btn { flex:1; min-width:0; margin:0; line-height:1.5; padding:18rpx 12rpx; font-size:26rpx; border-radius:999rpx; }
.is-activity .btn { background:var(--city-purple); color:#fff; border:1rpx solid var(--city-purple); border-radius:999rpx; font-size:26rpx; line-height:1.5; padding:20rpx 28rpx; margin:18rpx 28rpx; }
.is-activity .btn.ghost { background:var(--card,#fff); color:var(--city-purple); border-color:var(--line,#e6ddef); }
.is-activity .btn.clay { background:transparent; color:var(--muted,#92869a); border-color:var(--line,#e6ddef); }
.city-progress-title { display:flex; justify-content:space-between; color:var(--muted,#92869a); font-size:24rpx; margin:28rpx 0 14rpx; }
.city-progress-title text { color:var(--city-purple); font-weight:600; }
.is-activity .progress { height:8rpx; border-radius:8rpx; margin:0 0 14rpx; background:var(--city-soft); overflow:hidden; }
.is-activity .bar { background:#a98ac7; }
.is-activity .row .muted { font-size:22rpx; }
.is-activity .pad.title { font-size:32rpx; font-weight:600; color:var(--ink,#302a36); }
.is-activity .offer-quote { background:var(--city-soft); padding:14rpx 18rpx; color:var(--city-purple); font-size:24rpx; }
.is-activity .offer-quote-score { color:var(--city-purple); }
.city-group { padding:0 28rpx 28rpx; }
.city-group-heading { font-size:28rpx; font-weight:600; color:var(--ink,#302a36); }
.city-group-heading text { display:block; margin-top:8rpx; font-size:22rpx; color:var(--muted,#92869a); font-weight:400; }
.city-group-content { display:flex; align-items:center; gap:24rpx; margin-top:22rpx; font-size:25rpx; line-height:1.7; }
.city-group-content > view { min-width:0; flex:1; word-break:break-all; }
.city-group-content text { display:block; font-size:22rpx; margin-top:10rpx; color:var(--muted,#92869a); }
.city-group-qr { flex:none; width:210rpx; height:210rpx; background:#fff; border-radius:16rpx; }
.city-group-empty { margin-top:22rpx; background:var(--city-soft); border-radius:16rpx; padding:20rpx; font-size:24rpx; line-height:1.75; color:var(--muted,#92869a); }
.is-activity .activity-info-row { font-size:26rpx; padding:24rpx 28rpx; }
.is-activity .story-text { font-size:27rpx; line-height:1.85; margin:0; }
.is-activity .chain-line { font-size:26rpx; }
.is-activity .enroll-dock { border-top:1rpx solid var(--line,#eee8f4); background:var(--card,#fff); padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); }
.is-activity .enroll-dock .btn { margin:0; min-width:230rpx; }
.is-activity .enroll-dock .strong { color:var(--city-purple); font-size:32rpx; }
.dissolve-mask { position:fixed; inset:0; z-index:2000; display:flex; align-items:center; justify-content:center; padding:32rpx; box-sizing:border-box; background:rgba(29,21,39,.5); }
.dissolve-dialog { width:100%; max-height:80vh; overflow-y:auto; box-sizing:border-box; border-radius:28rpx; padding:36rpx; background:var(--card,#fff); color:var(--ink,#29232f); }
.dissolve-copy { margin-top:18rpx; line-height:1.8; }
.dissolve-reason { width:100%; min-height:160rpx; box-sizing:border-box; margin:24rpx 0 0; }
.dissolve-error { margin-top:18rpx; color:#ac536a; font-size:25rpx; }
.dissolve-actions { display:flex; gap:16rpx; margin-top:26rpx; }
.schedule-page .dissolve-actions .btn { width:auto; flex:1; min-width:0; margin:0; padding:20rpx 12rpx; font-size:25rpx; }
