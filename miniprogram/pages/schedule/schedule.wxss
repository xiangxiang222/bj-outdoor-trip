.trip-head { margin-top: 0; border-radius: 0; }
.role-kicker { margin-top: 16rpx; color: #8c8c8c; font-size: calc(24rpx * var(--ui-scale)); }
.role-open {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  border: 1px solid #725793;
  border-radius: 16rpx;
  background: #eef6f1;
  color: #5b3b8c;
}
.role-open-name { font-size: calc(30rpx * var(--ui-scale)); font-weight: 650; }
.role-open-sub { margin-top: 4rpx; color: #52796f; font-size: calc(24rpx * var(--ui-scale)); }
.role-open-go { color: #725793; font-size: calc(40rpx * var(--ui-scale)); line-height: 1; }
.hero-swipe { margin: 0; }
.offer-hero .hero-swipe,
.offer-hero .cover { height: 480rpx; }
.offer-sheet { margin-top: 0; }
.offer-price-row { display: flex; align-items: flex-end; justify-content: space-between; }
.offer-price { color: #e1251b; font-size: calc(64rpx * var(--ui-scale)); font-weight: 700; line-height: 1; }
.offer-unit { color: #e1251b; font-size: calc(26rpx * var(--ui-scale)); margin-left: 4rpx; }
.offer-tiers { margin-top: 8rpx; color: #7a7d74; font-size: calc(24rpx * var(--ui-scale)); }
.offer-tiers text { margin-right: 16rpx; }
.offer-title { margin-top: 16rpx; font-size: calc(40rpx * var(--ui-scale)); font-weight: 700; line-height: 1.35; }
.offer-sell { margin-top: 8rpx; color: #595959; font-size: calc(28rpx * var(--ui-scale)); line-height: 1.5; }
.offer-chips { margin-top: 12rpx; }
.offer-quote { display: flex; align-items: center; gap: 12rpx; margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; background: #fff7e8; color: #8a5a12; }
.offer-quote-score { color: #d46b08; font-weight: 700; flex: none; }
.offer-quote-text { flex: 1; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.offer-quote-n { flex: none; color: #ad8b66; font-size: calc(24rpx * var(--ui-scale)); }
.offer-guaranteed { margin-top: 16rpx; color: #725793; }
.offer-point { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.offer-point-n { width: 36rpx; height: 36rpx; border-radius: 50%; background: #5b3b8c; color: #fff; text-align: center; line-height: 36rpx; font-size: calc(22rpx * var(--ui-scale)); flex: none; }
.day-stop { display: flex; gap: 16rpx; }
.day-time { width: 120rpx; flex: none; color: #725793; font-size: calc(24rpx * var(--ui-scale)); font-weight: 650; }
.day-body { flex: 1; border-left: 4rpx solid #e6ddf0; padding: 0 0 24rpx 16rpx; }
.day-photo { width: 100%; height: 200rpx; margin-top: 12rpx; border-radius: 12rpx; }
.fee-k { font-weight: 700; }
.goods-tabs {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.goods-tab {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: calc(30rpx * var(--ui-scale));
  color: #8c8c8c;
  position: relative;
}
.goods-tab.on {
  color: #1a1a1a;
  font-weight: 600;
}
.goods-tab.on::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: 12rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 6rpx;
  background: #e1251b;
}
.story-text { white-space: pre-wrap; line-height: 1.7; margin: 12rpx 0 20rpx; }
.story-img { width: 100%; border-radius: 12rpx; margin: 8rpx 0 16rpx; display: block; }
.app-tabs-spacer { height: calc(140rpx + constant(safe-area-inset-bottom)); height: calc(140rpx + env(safe-area-inset-bottom)); }
.share-offscreen { position: fixed; left: -2000px; top: 0; width: 500px; height: 500px; }
.poster-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(0,0,0,.55);
  z-index: 80;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}
.poster-sheet {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}
.poster-cover { width: 100%; height: 280rpx; display: block; }
.poster-body { padding: 24rpx; }
.poster-title { font-size: calc(32rpx * var(--ui-scale)); font-weight: 700; margin-bottom: 16rpx; }
.poster-split { display: flex; gap: 16rpx; align-items: flex-start; margin-bottom: 16rpx; }
.poster-facts { flex: 1; }
.poster-qr { width: 180rpx; height: 180rpx; background: #fff; flex-shrink: 0; }


.activity-detail-brief { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:24rpx 28rpx; margin:20rpx 28rpx; padding:28rpx; border:1rpx solid var(--line); border-radius:22rpx; background:var(--card); color:var(--ink); font-size:calc(25rpx * var(--ui-scale)); line-height:1.7; }
.activity-detail-brief > view { min-width:0; word-break:break-all; }
.activity-info-label { color:var(--muted); font-size:calc(22rpx * var(--ui-scale)); margin-bottom:8rpx; }
.activity-info-row { display:flex; gap:24rpx; padding:24rpx 28rpx; border-bottom:1rpx solid var(--line); font-size:calc(25rpx * var(--ui-scale)); line-height:1.8; }
.activity-info-row > text { flex:none; width:150rpx; color:var(--muted); }
.activity-info-row > view { flex:1; min-width:0; word-break:break-all; color:var(--ink); }
