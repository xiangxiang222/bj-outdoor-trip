<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="schedule-page {{isActivity ? 'is-activity' : ''}} {{detailDark ? 'detail-dark' : ''}}">
<view class="offer-hero" wx:if="{{!isActivity && gallery.length}}">
  <swiper class="hero-swipe" autoplay circular interval="4000">
    <swiper-item wx:for="{{gallery}}" wx:key="*this">
      <image class="cover" src="{{item}}" mode="aspectFill" bindtap="previewHero" data-src="{{item}}" />
    </swiper-item>
  </swiper>
</view>
<live-pulse wx:if="{{s}}" flush scope="schedule" routeId="{{s.routeId || (s.route && s.route.id) || 0}}" scheduleId="{{s.id}}"></live-pulse>
<view class="card offer-sheet" wx:if="{{s}}">
  <view class="pad">
    <view class="city-heading" wx:if="{{isActivity}}">
      <image wx:if="{{gallery.length}}" class="city-cover" src="{{gallery[0]}}" mode="aspectFill" bindtap="previewHero" />
      <view class="city-cover city-cover-fallback" wx:else>{{tr.t(activityKind.label || '同城', lang)}}</view>
      <view class="city-heading-copy"><view class="city-kicker">{{tr.t(activityKind.label || '同城小聚', lang)}} · {{tr.t('兴趣相聚', lang)}}</view><view class="offer-title">{{tr.t(s.route.title, lang)}}</view><view class="city-price">{{isFree ? tr.t('免费参加', lang) : '¥' + s.quote.price}}<text wx:if="{{!isFree}}">{{tr.t('/人', lang)}}</text></view></view>
    </view>
    <view class="city-status" wx:if="{{isActivity}}"><text>{{tr.t(activityTitle, lang)}}</text><view>{{tr.t(activityHint, lang)}}</view></view>
    <view class="city-manage" wx:if="{{isActivity && canDissolve}}"><text>{{tr.t('你是本次活动的发起人', lang)}}</text><button class="btn ghost" bindtap="toggleDissolve">{{tr.t('取消活动', lang)}}</button></view>
    <view class="offer-price-row" wx:if="{{!isActivity}}">
      <view wx:if="{{isActivity && isFree}}" class="offer-price">{{tr.t('免费', lang)}}</view>
      <view wx:else>
        <text class="offer-price">¥{{s.quote.price}}</text>
        <text class="offer-unit">{{tr.t('/人', lang)}}</text>
      </view>
      <text class="tag">{{tr.t(statusTag, lang)}}</text>
    </view>
    <view class="offer-tiers" wx:if="{{!isActivity && !isFree}}">
      <text wx:if="{{s.quote.originPrice > s.quote.price}}" class="price-origin">¥{{s.quote.originPrice}}</text>
      <text wx:if="{{s.quote.memberPrice < s.quote.price}}">{{tr.t('会员', lang)}} ¥{{s.quote.memberPrice}}</text>
      <text wx:if="{{s.quote.studentPrice < s.quote.price}}">{{tr.t('学生', lang)}} ¥{{s.quote.studentPrice}}</text>
    </view>
    <view class="offer-title" wx:if="{{!isActivity}}">{{tr.t(s.route.title, lang)}}</view>
    <view class="offer-sell" wx:if="{{sellLine}}">{{tr.t(sellLine, lang)}}</view>
    <view class="offer-chips" wx:if="{{!isActivity}}">
      <view class="trip-kind {{s.kind || s.organizerType || 'individual'}}" wx:if="{{!isActivity}}"><view class="trip-kind-ico"></view>{{tr.t(s.kindLabel || '个人', lang)}}</view>
      <text class="offer-chip inline" wx:if="{{s.offerLabel}}" style="background:{{s.offerColor}}">{{tr.t(s.offerLabel, lang)}}</text>
      <text class="offer-chip inline" wx:if="{{s.private}}" style="background:#4c1d95">{{tr.t(s.privateLabel || '口令团', lang)}}</text>
    </view>
    <view class="trust-row" wx:if="{{!isActivity && trusts.length}}">
      <view class="trust-chip" wx:for="{{trusts}}" wx:key="*this">{{tr.t(item, lang)}}</view>
    </view>
    <view class="offer-quote" wx:if="{{reviewQuote}}" bindtap="jumpReviews">
      <text class="offer-quote-score">{{reviews.avg}}分</text>
      <text wx:if="{{reviewQuoteVirtual}}" class="review-virtual">{{tr.t('虚拟用户', lang)}}</text>
      <text class="offer-quote-text">“{{tr.t(reviewQuote, lang)}}”</text>
      <text class="offer-quote-n">{{reviews.count}}条</text>
    </view>
    <view class="fact-list">
      <view class="fact-row">
        <text class="fact-k">{{tr.t('时间', lang)}}</text>
        <text class="fact-v">{{tr.t(whenText, lang)}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-k">{{tr.t(isActivity ? '地点' : '集合', lang)}}</text>
        <text class="fact-v">{{tr.t(s.meetupPoint, lang)}}<text wx:if="{{!isActivity}}"> {{tr.t(s.meetupTime, lang)}}</text></text>
        <text class="nav-link" catchtap="openMap">{{tr.t('地图', lang)}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-k">{{tr.t('人数', lang)}}</text>
        <text class="fact-v">{{tr.t(peopleText, lang)}}</text>
      </view>
      <view class="fact-row">
        <text class="fact-k">{{tr.t('发起', lang)}}</text>
        <text class="fact-v">
          <text class="nav-link" wx:if="{{s.organizerId}}" catchtap="goUser" data-id="{{s.organizerId}}">{{tr.t(s.organizerName, lang)}}</text>
          <text wx:else>{{tr.t(s.organizerName, lang)}}</text>
        </text>
      </view>
    </view>
    <view class="offer-guaranteed" wx:if="{{s.guaranteed && !isActivity}}">{{tr.t('已成团 · 铁定出发', lang)}}</view>
  </view>
</view>

<view class="activity-detail-brief" wx:if="{{isActivity && activityHighlights.length}}"><view wx:for="{{activityHighlights}}" wx:key="label"><view class="activity-info-label">{{tr.t(item.label, lang)}}</view><view>{{tr.t(item.value, lang)}}</view></view></view>
<view class="goods-tabs">
  <view class="goods-tab {{tab=='trip'?'on':''}}" bindtap="setTab" data-tab="trip">{{tr.t(isActivity ? '本局' : '本团', lang)}}</view>
  <view class="goods-tab {{tab=='route'?'on':''}}" bindtap="setTab" data-tab="route">{{tr.t(isActivity ? '活动介绍' : '线路', lang)}}</view>
  <view class="goods-tab {{tab=='rules'?'on':''}}" bindtap="setTab" data-tab="rules">{{tr.t('须知', lang)}}</view>
</view>

<load-row wx:if="{{!s && !loadErr}}" />
<view class="pad muted" wx:elif="{{!s}}">{{tr.t(loadErr, lang)}}</view>
<block wx:elif="{{tab=='trip'}}">
<view class="pad title" wx:if="{{highlights.length}}">{{tr.t('这一天的看点', lang)}}</view>
<view class="card" wx:if="{{highlights.length}}">
  <view class="pad offer-points">
    <view class="offer-point" wx:for="{{highlights}}" wx:key="n">
      <text class="offer-point-n">{{item.n}}</text>
      <text>{{tr.t(item.line, lang)}}</text>
    </view>
  </view>
</view>
<view class="pad title" wx:if="{{itinerary.length}}">{{tr.t('这一天', lang)}}</view>
<view class="card" wx:if="{{itinerary.length}}">
  <view class="pad">
    <view class="day-stop" wx:for="{{itinerary}}" wx:key="index">
      <text class="day-time">{{item.time || '—'}}</text>
      <view class="day-body">
        <view>{{tr.t(item.title, lang)}}</view>
        <view class="muted" wx:if="{{item.detail}}">{{tr.t(item.detail, lang)}}</view>
        <image wx:if="{{item.photo}}" class="day-photo" src="{{item.photo}}" mode="aspectFill" bindtap="previewDay" data-src="{{item.photo}}" />
      </view>
    </view>
  </view>
</view>
<view class="pad title" wx:if="{{feeInclude || feeExclude || equipment}}">{{tr.t('费用', lang)}}</view>
<view class="card" wx:if="{{feeInclude}}">
  <view class="pad"><text class="fee-k">{{tr.t('包含', lang)}}</text><view class="muted">{{tr.t(feeInclude, lang)}}</view></view>
</view>
<view class="card" wx:if="{{feeExclude}}">
  <view class="pad"><text class="fee-k">{{tr.t('不含', lang)}}</text><view class="muted">{{tr.t(feeExclude, lang)}}</view></view>
</view>
<view class="pad muted" wx:if="{{equipment}}">{{tr.t('装备', lang)}}：{{tr.t(equipment, lang)}}</view>
<view class="card" wx:if="{{s}}">
  <view class="pad">
    <view class="ticket-card posted" wx:if="{{s.joinCode}}">
      <view class="title">{{tr.t('入团口令', lang)}} {{tr.t(s.joinCode, lang)}}</view>
      <view class="muted">{{tr.t('把这串口令发给要来的人。列表上会显示「口令团」，没有口令不能报名。', lang)}}</view>
    </view>
    <view class="ticket-card {{ticket.kind=='waitlist'?'wait':(ticket.kind=='posted'?'posted':'')}}" wx:if="{{ticket}}">
      <view class="title">{{tr.t(ticket.title, lang)}}</view>
      <view class="muted">{{tr.t(ticket.sub, lang)}}</view>
      <view class="ticket-actions">
        <view wx:if="{{ticket.trips}}" class="btn ghost" catchtap="goOrders">{{tr.t('看行程', lang)}}</view>
        <button wx:if="{{ticket.share}}" class="btn" open-type="share">{{tr.t('去分享', lang)}}</button>
      </view>
    </view>
    <view class="nav-link" wx:if="{{!isActivity && busPhotos.length}}" bindtap="previewBus">{{tr.t(busText, lang)}}</view>
    <view wx:elif="{{!isActivity}}">{{tr.t(busText, lang)}}</view>
    <view class="city-progress-title" wx:if="{{isActivity}}">{{tr.t('参与人数', lang)}}<text>{{s.enrolled || 0}} / {{s.maxSeats}}</text></view>
    <view class="progress" wx:if="{{!isActivity || !activityClosed}}"><view class="bar" style="width:{{s.enrolled/s.maxSeats*100}}%"></view></view>
    <view class="row">
      <text wx:if="{{s.minGroupSize && (!isActivity || !activityClosed)}}" class="muted">{{tr.t(isActivity ? '满 ' + s.minGroupSize + ' 人成局' : '最低成团 ' + s.minGroupSize, lang)}}</text>
    </view>
    <view class="muted" wx:if="{{s.oversub.enabled}}">{{tr.t(s.oversub.copy, lang)}}</view>
    <view class="muted" wx:if="{{s.eligibility.enabled}}">{{tr.t(s.eligibility.label, lang)}}{{tr.t(s.eligibility.alumniOk ? ' 已认证师生或校友可报' : ' 已认证学生可报', lang)}}</view>
    <view class="muted" wx:if="{{s.genderRatio && s.genderRatio.on}}">{{tr.t(s.genderRatio.label, lang)}}</view>
    <view class="muted" wx:if="{{s.eligibility.enabled && !s.eligibility.canEnroll}}" style="color:#bc4749">{{tr.t(s.eligibility.reason, lang)}}</view>
    <view class="btn ghost" wx:if="{{s.eligibility.enabled && !s.eligibility.canEnroll}}" bindtap="goStudent">{{tr.t('去校园认证', lang)}}</view>
    <view class="muted" wx:if="{{s.reviewStatus=='pending'}}" style="color:#c77d3a">{{tr.t('本团正在审核，通过后才会出现在', lang)}}{{tr.t(isActivity ? '活动页' : '首页', lang)}}。</view>
    <view class="muted" wx:if="{{s.status=='cancelled'}}" style="color:#bc4749">{{tr.t('本团已解散。理由：', lang)}}{{tr.t(s.cancelReason, lang)}}</view>
    <view class="muted" wx:if="{{s.notes}}">{{tr.t(s.notes, lang)}}</view>
    <view class="card" wx:if="{{s.coupon}}" bindtap="goCoupon">
      <view class="pad">{{tr.t(s.coupon.label, lang)}} {{tr.t('余', lang)}} {{tr.t(s.coupon.remain, lang)}}/{{tr.t(s.coupon.total, lang)}} {{tr.t('· 点此领取', lang)}}</view>
    </view>
    <view class="muted" wx:elif="{{s.guide}}" bindtap="goGuide">{{tr.t('已匹配导游：', lang)}}{{tr.t(s.guide.name, lang)}} <text class="nav-link">{{tr.t('查看详情', lang)}}</text></view>
    <view class="role-board" wx:if="{{!isActivity}}">
      <view class="role-heading">
        <view>{{tr.t('领队与摄影', lang)}}</view>
        <text class="role-kicker" wx:if="{{!(leaderSlots[0].leader && leaderSlots[1].leader && s.photographer)}}">{{tr.t('招募中', lang)}}</text>
      </view>
      <block wx:for="{{leaderSlots}}" wx:key="slot">
        <view class="role-row is-filled" wx:if="{{item.leader}}" bindtap="openLeader" data-kind="{{item.leader.kind}}" data-id="{{item.leader.id}}" data-userid="{{item.leader.userId}}">
          <view class="role-icon role-icon-leader"></view>
          <view class="role-copy">
            <view class="role-title">{{tr.t(item.label, lang)}}</view>
            <view class="role-sub role-person">{{tr.t(item.leader.name, lang)}}</view>
          </view>
          <view class="role-action role-view">{{tr.t('查看', lang)}}<view class="role-chevron"></view></view>
        </view>
        <view wx:else class="role-row" bindtap="applyLeader">
          <view class="role-icon role-icon-leader"></view>
          <view class="role-copy">
            <view class="role-title">{{tr.t(item.label, lang)}}</view>
            <view class="role-sub">{{tr.t('带队同行', lang)}}</view>
          </view>
          <view class="role-action">{{tr.t('报名', lang)}}<view class="role-chevron"></view></view>
        </view>
      </block>
      <view class="role-row is-filled" wx:if="{{s.photographer}}" bindtap="openLeader" data-kind="user" data-id="{{s.photographer.id}}" data-userid="{{s.photographer.userId}}">
        <view class="role-icon role-icon-camera"></view>
        <view class="role-copy">
          <view class="role-title">{{tr.t('摄影师', lang)}}</view>
          <view class="role-sub role-person">{{tr.t(s.photographer.name, lang)}}</view>
        </view>
        <view class="role-action role-view">{{tr.t('查看', lang)}}<view class="role-chevron"></view></view>
      </view>
      <view wx:else class="role-row" bindtap="applyPhotographer">
        <view class="role-icon role-icon-camera"></view>
        <view class="role-copy">
          <view class="role-title">{{tr.t('摄影师', lang)}}</view>
          <view class="role-sub">{{tr.t('免个人团费，保险另计', lang)}}</view>
        </view>
        <view class="role-action">{{tr.t('报名', lang)}}<view class="role-chevron"></view></view>
      </view>
    </view>
  </view>
</view>
<view class="card trip-weather-card" wx:if="{{!isActivity && weather}}">
  <view class="weather-heading">
    <view>{{tr.t('出行天气', lang)}}</view>
    <text class="weather-day">{{weather.date}}</text>
  </view>
  <view class="weather-overview">
    <view class="weather-location">
      <view class="weather-place">{{tr.t(weather.place, lang)}}</view>
      <view class="weather-summary">{{tr.t(weather.summary, lang)}}</view>
    </view>
    <view class="weather-range">{{weather.tmin}}<text class="weather-range-sep">~</text>{{weather.tmax}}<text class="weather-unit">°C</text></view>
  </view>
  <view class="weather-meta">
    <view><text>{{tr.t('风速', lang)}}</text> {{weather.wind}} km/h</view>
    <view wx:if="{{weather.precip != null}}"><text>{{tr.t('降水', lang)}}</text> {{weather.precip}} mm</view>
  </view>
  <block wx:if="{{weather.hourly && weather.hourly.length}}">
    <view class="weather-chart-legend"><view><text class="weather-temp-key"></text>{{tr.t('气温', lang)}}</view><view><text class="weather-rain-key"></text>{{tr.t('降水', lang)}}</view></view>
    <canvas type="2d" id="weatherChart" class="wx-chart" disable-scroll="true"></canvas>
  </block>
  <view class="weather-advice" wx:if="{{weather.alerts && weather.alerts.length}}">
    <view class="weather-advice-label">{{tr.t('出行提醒', lang)}}</view>
    <view class="weather-advice-copy"><view wx:for="{{weather.alerts}}" wx:key="text" class="{{item.level == 'high' ? 'weather-high' : ''}}">{{tr.t(item.text, lang)}}</view></view>
  </view>
</view>
<block wx:if="{{!isActivity}}">
<load-row wx:if="{{!seatsReady}}" />
<block wx:elif="{{seatRows.length}}">
<view class="pad title">{{tr.t('座位图', lang)}}</view>
<view class="seat-map">
  <view class="seat-front">{{tr.t('车头', lang)}}</view>
  <view class="seat-row" wx:for="{{seatRows}}" wx:key="row">
    <block wx:for="{{item.seats}}" wx:for-item="seat" wx:key="no">
      <view class="seat {{seat.locked ? 'locked' : (seat.taken ? 'taken' : '')}} {{seat.mine ? 'mine' : ''}}" catchtap="onSeat" data-userid="{{seat.occupant.userId}}" data-no="{{seat.no}}" data-taken="{{seat.taken}}" data-locked="{{seat.locked}}">
        <text wx:if="{{seat.occupant}}">{{tr.t(seat.occupant.initial, lang)}}{{tr.t(seat.occupant.lifeStage, lang)}}</text>
        <text wx:elif="{{seat.locked}}">{{tr.t('锁', lang)}}</text>
        <text wx:else>{{tr.t(seat.col, lang)}}</text>
      </view>
      <view wx:if="{{seat.aisleAfter}}" class="seat-aisle"></view>
    </block>
  </view>
</view>
</block>
</block>
<view class="card" wx:if="{{s.myEnrollment || (isActivity && s.isOrganizer)}}">
  <view class="pad title">{{tr.t(isActivity ? '参与安排' : '报名后', lang)}}</view>
  <block wx:if="{{isActivity}}">
    <view class="city-group">
      <view class="city-group-heading">{{tr.t('本局微信群', lang)}}<text>{{tr.t(activityGroupHint, lang)}}</text></view>
      <view wx:if="{{activityGroupQr || s.consultGroup}}" class="city-group-content"><image wx:if="{{activityGroupQr}}" class="city-group-qr" src="{{activityGroupQr}}" mode="aspectFit" show-menu-by-longpress bindtap="previewStory" data-url="{{activityGroupQr}}" binderror="groupQrError" /><view><view wx:if="{{s.consultGroup}}">{{tr.t(s.consultGroup, lang)}}</view><text wx:if="{{activityGroupQr}}">{{tr.t('点击查看，长按识别群二维码', lang)}}</text><text wx:if="{{activityGroupQr}}">{{tr.t('二维码失效时，请联系发起人。', lang)}}</text></view></view>
      <view wx:if="{{activityGroupQrError}}" class="city-group-empty">{{tr.t('群二维码暂时加载失败。', lang)}}<text class="nav-link" bindtap="retryGroupQr">{{tr.t('重新加载', lang)}}</text></view>
      <view wx:elif="{{!activityGroupQr && !s.consultGroup}}" class="city-group-empty">{{tr.t(activityGroupEmpty, lang)}}</view>
    </view>
    <view wx:if="{{showAfter}}" class="btn" bindtap="goAfter">{{tr.t('评价 / 评选', lang)}}</view>
    <view class="pad" wx:if="{{!activityClosed && s.myEnrollment.status=='joined' && s.myEnrollment.payStatus=='unpaid' && s.myEnrollment.remainAmount>0}}">{{tr.t('费用待付 ¥', lang)}}{{tr.t(s.myEnrollment.remainAmount, lang)}}{{tr.t('，点下方去支付。', lang)}}</view>
  </block>
  <block wx:else>
  <view class="pad">{{tr.t('1. 点空位可选座 · 早报名早选座', lang)}}</view>
  <view class="pad">{{tr.t('2. 本团微信群', lang)}}</view>
  <image wx:if="{{activityGroupQr}}" src="{{activityGroupQr}}" style="width:280rpx;height:280rpx;margin:16rpx" mode="aspectFit" binderror="groupQrError" />
  <view wx:if="{{s.consultGroup}}" class="pad muted">{{tr.t(s.consultGroup, lang)}}</view>
  <view wx:if="{{activityGroupQrError}}" class="pad muted">{{tr.t('群二维码暂时加载失败。', lang)}}<text class="nav-link" bindtap="retryGroupQr">{{tr.t('重新加载', lang)}}</text></view>
  <view wx:elif="{{!activityGroupQr && !s.consultGroup}}" class="pad muted">{{tr.t('发起人暂未提供本团群信息，请联系发起人确认。', lang)}}</view>
  <view class="pad">{{tr.t('3. 候选团 / 4. 替代团请在报名页勾选，不成团自动转团多退少补', lang)}}</view>
  <view wx:if="{{showAfter}}" class="btn" bindtap="goAfter">{{tr.t('评价 / 评选', lang)}}</view>
  <view class="pad" wx:if="{{s.myEnrollment.status=='joined' && s.myEnrollment.payStatus=='unpaid' && s.myEnrollment.remainAmount>0}}">{{tr.t('团费待付 ¥', lang)}}{{tr.t(s.myEnrollment.remainAmount, lang)}} / ¥{{tr.t(s.myEnrollment.payAmount, lang)}}{{tr.t('，点下方去支付。', lang)}}</view>
  </block>
  <view class="pad payer-list" wx:if="{{s.myEnrollment.helpers && s.myEnrollment.helpers.length}}">
    <view class="payer-title">{{tr.t('帮忙支付', lang)}}</view>
    <view class="payer-row" wx:for="{{s.myEnrollment.helpers}}" wx:key="index">
      <view>
        <view>{{tr.t(item.nickname, lang)}}</view>
        <view class="muted" wx:if="{{item.remark}}">{{tr.t(item.remark, lang)}}</view>
      </view>
      <view class="payer-amt">¥{{item.amount}}</view>
    </view>
  </view>
</view>
<view class="pad title" wx:if="{{s.combo.enabled}}">{{tr.t('组合团 · 另一半条件', lang)}}</view>
<view class="card" wx:if="{{s.combo.enabled}}">
  <view class="pad muted">{{tr.t('只对学生或已认证学生组织开放。', lang)}}</view>
  <view class="pad" wx:for="{{s.combo.mates}}" wx:key="index">
    <view>{{tr.t(item.name, lang)}} {{tr.t(item.school, lang)}}</view>
    <view class="muted">{{tr.t('希望', lang)}}{{tr.t(item.wantGender=='female'?'女生':(item.wantGender=='male'?'男生':'不限'), lang)}}{{tr.t(item.wantSchool ? ' · ' + item.wantSchool : '', lang)}}</view>
    <view wx:if="{{item.note}}">{{tr.t(item.note, lang)}}</view>
  </view>
</view>
<view class="pad title">{{tr.t('报名名单', lang)}}</view>
<view class="pad chain-line" wx:for="{{s.chain}}" wx:key="index">
  <text class="nav-link" wx:if="{{item.userId}}" catchtap="goUser" data-id="{{item.userId}}">{{tr.t(item.index, lang)}}. {{tr.t(item.name, lang)}}</text>
  <text wx:else>{{tr.t(item.index, lang)}}. {{tr.t(item.name, lang)}}</text>
  <text wx:if="{{!isActivity && item.lifeStage}}"> {{tr.t(item.lifeStage, lang)}}</text>
  <text wx:if="{{item.waitlisted}}" class="muted"> {{tr.t('候补', lang)}}</text>
  <text wx:elif="{{item.applied}}" class="muted"> {{tr.t('待确认', lang)}}</text>
  <text wx:elif="{{!isActivity || !isFree && item.canPay}}" class="pay-unpaid" catchtap="openPay" data-token="{{item.payShareToken}}"> {{tr.t(item.payText, lang)}}{{tr.t(item.canPay ? ' · 去支付' : '', lang)}}</text>
  <text wx:elif="{{!isActivity || !isFree}}" class="{{item.payStatus=='paid' ? 'pay-paid' : 'muted'}}"> {{tr.t(item.payText, lang)}}</text>
</view>
<view id="trip-reviews" class="pad title">{{tr.t(isActivity ? '活动评价' : '本团评价', lang)}} <text class="muted" wx:if="{{reviews.count}}">{{tr.t(reviews.avg, lang)}}{{tr.t('分 ·', lang)}} {{tr.t(reviews.count, lang)}}{{tr.t('条', lang)}}</text></view>
<load-row wx:if="{{!reviewsReady && !reviews.list.length}}" />
<view class="pad muted" wx:elif="{{reviewsReady && !reviews.list.length}}">{{tr.t('还没有评价。', lang)}}</view>
<view class="card" wx:for="{{reviews.list}}" wx:key="id">
  <view class="pad">
    <view class="row"><text>{{tr.t(item.name, lang)}}</text><text wx:if="{{item.virtual}}" class="review-virtual">{{tr.t('虚拟用户', lang)}}</text><text class="stars">{{tr.t(item.stars, lang)}}</text></view>
    <view wx:if="{{item.content}}">{{tr.t(item.content, lang)}}</view>
    <view class="muted">{{tr.t(item.createdAt, lang)}}</view>
  </view>
</view>
<view class="btn ghost" wx:if="{{!isActivity}}" bindtap="stats">{{tr.t('本团画像', lang)}}</view>
<view class="btn ghost" bindtap="openPoster">{{tr.t('生成报名海报', lang)}}</view>
<view class="card" wx:if="{{s.isOrganizer && s.status!='cancelled' && s.eligibility.schools.length}}">
  <view class="pad muted">{{tr.t('当前范围：', lang)}}{{tr.t(s.eligibility.label, lang)}}{{tr.t('。可以再开放学校-学院-专业组合，不能收窄。', lang)}}</view>
  <view class="input" bindtap="pickAddSchool">{{tr.t(addSchool || '学校', lang)}}</view>
  <view class="input" bindtap="pickAddCollege">{{tr.t(addCollege || (addSchool ? '学院可空，留空则该校各学院可报' : '请先选学校'), lang)}}</view>
  <view class="input" bindtap="pickAddMajor">{{tr.t(addMajor || (addCollege ? '专业可空' : '请先选学院'), lang)}}</view>
  <view class="btn ghost" bindtap="expandTarget">{{tr.t('开放该组合', lang)}}</view>
  <view class="btn ghost" wx:if="{{s.eligibility.colleges.length}}" bindtap="expandAllColleges">{{tr.t('已开放学校全部学院可报', lang)}}</view>
</view>
<view class="btn clay" wx:if="{{!isActivity && canDissolve}}" bindtap="toggleDissolve">{{tr.t('解散拼团', lang)}}</view>
</block>

<block wx:elif="{{tab=='route' && isActivity}}">
<view class="card"><view class="pad title">{{tr.t('活动介绍', lang)}}</view><view class="activity-info-row" wx:for="{{activityInfo}}" wx:key="label"><text>{{tr.t(item.label, lang)}}</text><view>{{tr.t(item.value, lang)}}</view></view><view class="pad story-text" wx:if="{{activityIntro}}">{{tr.t(activityIntro, lang)}}</view><view class="pad muted" wx:elif="{{!activityInfo.length}}">{{tr.t('发起人暂未填写更多介绍，请先核对上方时间与地点。', lang)}}</view><view class="pad muted" wx:if="{{s.notes}}">{{tr.t(s.notes, lang)}}</view></view>
</block>
<block wx:elif="{{tab=='route'}}">
  <load-row wx:if="{{!routeDetail.title}}" />
  <block wx:else>
  <view class="pad" wx:if="{{routeDetail.title}}">
    <view class="title">{{tr.t(routeDetail.title, lang)}}</view>
    <view class="muted">{{tr.t(routeDetail.subtitle, lang)}}</view>
    <view class="tag" wx:if="{{routeDetail.days}}">{{tr.t(routeDetail.days, lang)}}{{tr.t('日 ·', lang)}} {{tr.t(routeDetail.difficulty, lang)}}</view>
  </view>
  <view class="pad" wx:if="{{routeDetail.story && routeDetail.story.length}}">
    <view class="title">{{tr.t('线路介绍', lang)}}</view>
    <block wx:for="{{routeDetail.story}}" wx:key="index">
      <view wx:if="{{item.type==='text'}}" class="story-text">{{tr.t(item.body, lang)}}</view>
      <block wx:elif="{{item.type==='image' && item.url}}">
        <image class="story-img" src="{{item.url}}" mode="widthFix" bindtap="previewStory" data-url="{{item.url}}" />
        <view wx:if="{{item.caption}}" class="muted">{{tr.t(item.caption, lang)}}</view>
      </block>
    </block>
  </view>
  <view class="pad" wx:elif="{{routeDetail.description}}">
    <view class="title">{{tr.t('线路介绍', lang)}}</view>
    <view class="story-text">{{tr.t(routeDetail.description, lang)}}</view>
  </view>
  <view class="pad" wx:if="{{routeAlbum.length}}"><view class="title">{{tr.t('更多照片', lang)}}</view></view>
  <view class="gallery" style="display:flex;flex-wrap:wrap;padding:0 16rpx" wx:if="{{routeAlbum.length}}">
    <image wx:for="{{routeAlbum}}" wx:key="*this" src="{{item}}" mode="aspectFill" style="width:48%;height:200rpx;margin:1%;border-radius:12rpx" bindtap="previewStory" data-url="{{item}}" />
  </view>
  <view class="pad" wx:if="{{routeDetail.highlights && routeDetail.highlights.length}}">
    <view class="title">{{tr.t('亮点', lang)}}</view>
    <view wx:for="{{routeDetail.highlights}}" wx:key="*this" class="muted">{{tr.t(index + 1, lang)}}. {{tr.t(item, lang)}}</view>
  </view>
  <view class="pad" wx:if="{{routeDetail.itinerary && routeDetail.itinerary.length}}">
    <view class="title">{{tr.t('行程安排', lang)}}</view>
    <view wx:for="{{routeDetail.itinerary}}" wx:key="time">
      <view>{{tr.t(item.time, lang)}} {{tr.t(item.title, lang)}}</view>
      <view class="muted">{{tr.t(item.detail, lang)}}</view>
      <image wx:if="{{item.photo}}" class="story-img" src="{{item.photo}}" mode="widthFix" bindtap="previewStory" data-url="{{item.photo}}" />
    </view>
  </view>
  <view class="pad" wx:if="{{routeDetail.priceTiers && routeDetail.priceTiers.length}}">
    <view class="title">{{tr.t('人数阶梯价', lang)}}</view>
    <view wx:for="{{routeDetail.priceTiers}}" wx:key="minPeople" class="row">
      <text>{{tr.t(item.minPeople, lang)}}{{tr.t('人起', lang)}}</text>
      <text>¥{{tr.t(item.price, lang)}} {{tr.t('/ 会员¥', lang)}}{{tr.t(item.memberPrice, lang)}}</text>
    </view>
  </view>
  <view class="pad" wx:if="{{routeDetail.buses && routeDetail.buses.length}}">
    <view class="title">{{tr.t('可选车型', lang)}}</view>
    <view wx:for="{{routeDetail.buses}}" wx:key="id" class="row">
      <text>{{tr.t(item.name, lang)}}</text>
      <text class="muted">{{tr.t(item.seats, lang)}} {{tr.t('座', lang)}}</text>
    </view>
  </view>
  <view class="pad" wx:if="{{routeDetail.feeInclude || routeDetail.feeExclude || routeDetail.equipment || routeDetail.notices}}">
    <view class="title">{{tr.t('费用说明', lang)}}</view>
    <view wx:if="{{routeDetail.feeInclude}}"><text class="muted">{{tr.t('含：', lang)}}</text>{{tr.t(routeDetail.feeInclude, lang)}}</view>
    <view wx:if="{{routeDetail.feeExclude}}"><text class="muted">{{tr.t('不含：', lang)}}</text>{{tr.t(routeDetail.feeExclude, lang)}}</view>
    <view wx:if="{{routeDetail.equipment}}"><text class="muted">{{tr.t('装备：', lang)}}</text>{{tr.t(routeDetail.equipment, lang)}}</view>
    <view wx:if="{{routeDetail.notices}}"><text class="muted">{{tr.t('注意：', lang)}}</text>{{tr.t(routeDetail.notices, lang)}}</view>
  </view>
  <view class="pad" wx:if="{{routeDetail.refundPolicy && routeDetail.refundPolicy.lines && routeDetail.refundPolicy.lines.length}}">
    <view class="title">{{tr.t('退费规则', lang)}}</view>
    <view class="muted">{{tr.t(routeDetail.refundPolicy.summary, lang)}}</view>
    <view class="muted" wx:for="{{routeDetail.refundPolicy.lines}}" wx:key="text">{{tr.t(item.text, lang)}}</view>
  </view>
  <view class="pad">
    <view class="title">{{tr.t('装备清单', lang)}}</view>
    <view wx:for="{{routeDetail.packingList}}" wx:key="*this" class="muted">· {{tr.t(item, lang)}}</view>
    <view wx:if="{{!routeDetail.packingList || !routeDetail.packingList.length}}" class="muted">{{tr.t(routeDetail.equipment || '详见装备说明。', lang)}}</view>
  </view>
  <view class="pad title">{{tr.t('出行评价', lang)}} <text class="muted" wx:if="{{routeReviews.count}}">{{tr.t(routeReviews.avg, lang)}}{{tr.t('分 ·', lang)}} {{tr.t(routeReviews.count, lang)}}{{tr.t('条', lang)}}</text></view>
  <load-row wx:if="{{!routeReviewsReady && !routeReviews.list.length}}" />
  <view class="pad muted" wx:elif="{{routeReviewsReady && !routeReviews.list.length}}">{{tr.t('还没有评价。', lang)}}</view>
  <view class="card" wx:for="{{routeReviews.list}}" wx:key="id">
    <view class="pad">
      <view class="row"><text>{{tr.t(item.name, lang)}}</text><text wx:if="{{item.virtual}}" class="review-virtual">{{tr.t('虚拟用户', lang)}}</text><text class="stars">{{tr.t(item.stars, lang)}}</text></view>
      <view wx:if="{{item.content}}">{{tr.t(item.content, lang)}}</view>
      <view class="muted">{{tr.t(item.createdAt, lang)}}</view>
    </view>
  </view>
  </block>
</block>

<block wx:else>
  <view class="pad title">{{tr.t('退改说明', lang)}}</view>
  <view class="card">
    <view class="pad muted">{{tr.t(isActivity ? '活动开始前可取消；已支付费用按原支付渠道退回。' : cancelSummary, lang)}}</view>
    <view class="pad muted" wx:if="{{!isActivity && refundHint}}">{{tr.t(refundHint, lang)}}</view>
    <view class="pad muted" wx:if="{{!isActivity}}" wx:for="{{cancelItems}}" wx:key="*this">{{tr.t(index + 1, lang)}}. {{tr.t(item, lang)}}</view>
  </view>
  <view class="card city-rules" wx:if="{{isActivity}}"><view class="pad title">{{tr.t('参与须知', lang)}}</view><view class="pad muted">{{tr.t(activityKind.notice || '请根据自身情况参加，尊重同行者并遵守现场约定。', lang)}}</view></view>
  <view class="pad title" wx:if="{{!isActivity && commonRules.sections.length}}">{{tr.t(commonRules.title || '公共规则', lang)}}</view>
  <view class="card" wx:if="{{!isActivity && commonRules.sections.length}}">
    <view class="pad muted">{{tr.t(commonRules.summary, lang)}}</view>
    <view class="pad" wx:for="{{commonRules.sections}}" wx:key="title">
      <view>{{tr.t(item.title, lang)}}</view>
      <view class="muted" wx:for="{{item.items}}" wx:for-item="line" wx:key="*this">{{tr.t(line, lang)}}</view>
    </view>
  </view>
  <view class="pad title" wx:if="{{!isActivity && waiverText}}">{{tr.t('风险告知', lang)}}</view>
  <view class="card" wx:if="{{!isActivity && waiverText}}">
    <view class="pad muted story-text">{{tr.t(waiverText, lang)}}</view>
  </view>
  <view class="pad title" wx:if="{{!isActivity && faqs.length}}">{{tr.t('常见问题', lang)}}</view>
  <view class="card" wx:if="{{!isActivity && faqs.length}}">
    <view class="pad faq-item" wx:for="{{faqs}}" wx:key="q">
      <view>{{tr.t(item.q, lang)}}</view>
      <view class="muted">{{tr.t(item.a, lang)}}</view>
    </view>
  </view>
  <view class="pad title">{{tr.t('联系官方与本团', lang)}}</view>
  <view class="card">
    <view class="pad contact-row">{{tr.t('官方微信', lang)}} {{tr.t(contacts.officialWechatName, lang)}} {{tr.t(contacts.officialWechat, lang)}} <text class="nav-link" catchtap="copyText" data-text="{{contacts.officialWechat}}">{{tr.t('复制', lang)}}</text></view>
    <view class="pad contact-row">{{tr.t('官方用户群', lang)}} {{tr.t(contacts.officialGroup, lang)}}</view>
    <view class="pad contact-row" wx:if="{{s.consultGroup}}">{{tr.t('本团咨询群', lang)}} {{tr.t(s.consultGroup, lang)}} <text class="nav-link" catchtap="copyText" data-text="{{s.consultGroup}}">{{tr.t('复制', lang)}}</text></view>
    <view class="pad muted" wx:else>{{tr.t('本团咨询群确认后会显示。', lang)}}</view>
  </view>
</block>

<view class="enroll-dock" wx:if="{{!showDetailTabs && (!isActivity || !activityClosed)}}">
  <view class="enroll-bar" wx:if="{{showEnroll}}">
    <view class="enroll-price">
      <text class="strong">{{tr.t(priceDock.main, lang)}}</text>
      <view class="muted" wx:if="{{priceDock.sub}}">{{tr.t(priceDock.sub, lang)}}</view>
    </view>
    <view class="btn dock-cta" bindtap="enroll">{{tr.t(ctaText, lang)}}</view>
  </view>
  <view class="enroll-bar" wx:elif="{{(!isActivity || !activityClosed) && s.myEnrollment.status=='joined' && s.myEnrollment.remainAmount>0 && s.myEnrollment.payShareToken}}">
    <view class="enroll-price">
      <text class="strong">{{tr.t('待付 ¥', lang)}}{{tr.t(s.myEnrollment.remainAmount, lang)}}</text>
    </view>
    <view class="btn dock-cta" bindtap="invitePay">{{tr.t('去支付', lang)}}</view>
  </view>
  <view class="pad muted" wx:elif="{{isActivity && activityClosed && !s.myEnrollment}}" style="text-align:center">{{tr.t(activityTitle, lang)}}</view>
  <view class="pad muted" wx:elif="{{s.myEnrollment && (isActivity || s.myEnrollment.payStatus!='paid')}}" style="text-align:center">{{tr.t(isActivity ? activityTitle : (ticket.title || '已报名'), lang)}}</view>
</view>
<view class="app-tabs-spacer" wx:if="{{showDetailTabs}}"></view>
<app-tabs wx:if="{{showDetailTabs}}" id="appTabs" />

<canvas type="2d" id="shareCardCanvas" class="share-offscreen"></canvas>
<canvas type="2d" id="sharePosterCanvas" class="share-offscreen"></canvas>

<view class="dissolve-mask" wx:if="{{showDissolve}}" catchtap="toggleDissolve">
  <view class="dissolve-dialog" catchtap="stopTap">
    <view class="title">{{tr.t(isActivity ? '取消本次活动' : '解散拼团', lang)}}</view>
    <view class="muted dissolve-copy">{{tr.t(isActivity ? '取消后将关闭活动报名，已报名者会收到取消消息，已支付费用按原支付渠道退回。' : '解散后将取消全部报名，并按退费规则处理退款。', lang)}}</view>
    <textarea class="input dissolve-reason" placeholder="{{tr.t(isActivity ? '请填写取消原因' : '请填写解散理由', lang)}}" value="{{reason}}" bindinput="setReason" maxlength="200" disabled="{{dissolving}}" />
    <view class="dissolve-error" wx:if="{{dissolveErr}}">{{tr.t(dissolveErr, lang)}}</view>
    <view class="dissolve-actions"><button class="btn ghost" bindtap="toggleDissolve" disabled="{{dissolving}}">{{tr.t('暂不取消', lang)}}</button><button class="btn" bindtap="confirmDissolve" loading="{{dissolving}}" disabled="{{dissolving}}">{{tr.t(isActivity ? '确认取消活动' : '确认解散', lang)}}</button></view>
  </view>
</view>

<view class="poster-mask" wx:if="{{showPoster}}" catchtap="closePoster">
  <view class="poster-sheet" catchtap>
    <image class="poster-cover" src="{{posterCover}}" mode="aspectFill" wx:if="{{posterCover}}"/>
    <view class="poster-body">
      <view class="poster-title">
        <view class="trip-kind {{s.kind || 'individual'}}" wx:if="{{s}}"><view class="trip-kind-ico"></view>{{tr.t(s.kindLabel || '个人', lang)}}</view>
        {{tr.t(s.route.title, lang)}}
      </view>
      <view class="poster-split">
        <view class="poster-facts">
          <view class="price" wx:if="{{!isFree}}">¥{{tr.t(s.quote.originPrice, lang)}} <text class="muted">{{tr.t('会员 ¥', lang)}}{{tr.t(s.quote.memberPrice, lang)}}</text></view>
          <view class="price" wx:else>{{tr.t('免费', lang)}}</view>
          <view class="muted">{{tr.t('时间', lang)}} {{tr.t(whenText, lang)}}</view>
          <view class="muted">{{tr.t('集合', lang)}} {{tr.t(s.meetupPoint, lang)}} {{tr.t(s.meetupTime, lang)}}</view>
          <view class="muted">{{tr.t(peopleText, lang)}}</view>
        </view>
        <image class="poster-qr" src="{{posterQr}}" wx:if="{{posterQr}}" show-menu-by-longpress/>
      </view>
      <view class="muted">{{tr.t(posterHint, lang)}}</view>
      <button class="btn" open-type="share">{{tr.t('发给微信好友', lang)}}</button>
      <view class="btn ghost" bindtap="savePoster">{{tr.t('保存图片', lang)}}</view>
      <view class="btn ghost" bindtap="closePoster">{{tr.t('关闭', lang)}}</view>
    </view>
  </view>
</view>

</view>
