<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<view class="sec">{{copy.pickLang}}</view>
<view class="list">
  <view class="row" data-lang="zh" bindtap="pick">
    <text>{{copy.zh}}</text>
    <text class="mark" wx:if="{{look.lang==='zh'}}">✓</text>
  </view>
  <view class="row" data-lang="en" bindtap="pick">
    <text>English</text>
    <text class="mark" wx:if="{{look.lang==='en'}}">✓</text>
  </view>
  <view class="row" data-lang="tw" bindtap="pick">
    <text>{{copy.tw}}</text>
    <text class="mark" wx:if="{{look.lang==='tw'}}">✓</text>
  </view>
</view>
