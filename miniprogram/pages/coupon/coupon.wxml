<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../../utils/locale.wxs" module="tr" />
<view class="card" wx:if="{{data}}" style="background:#1b4332;color:#fff">
  <view class="pad">
    <view class="muted" style="color:#fff;opacity:.85">{{tr.t(data.universal ? '通用优惠券' : '本团优惠券', lang)}}</view>
    <view class="title" style="color:#fff;font-size: calc(48rpx * var(--ui-scale))">{{tr.t(data.label, lang)}}</view>
    <view>{{tr.t(data.name, lang)}}</view>
    <view>{{tr.t('余', lang)}} {{tr.t(data.remain, lang)}}/{{tr.t(data.total, lang)}}</view>
  </view>
</view>
<view class="card" wx:if="{{data && (data.schedule || data.universal)}}">
  <view class="pad">
    <view class="title">{{tr.t(data.universal ? '全部个人拼团' : data.schedule.title, lang)}}</view>
    <view class="muted">{{tr.t(data.universal ? '公司团除外，报名任一团可用' : data.schedule.startDate + ' 出发', lang)}}</view>
    <view class="price" wx:if="{{data.quote}}">{{tr.t('团价 ¥', lang)}}{{tr.t(data.quote.tripPrice, lang)}}<text wx:if="{{data.quote.applyCoupon}}"> {{tr.t('→ 券后 ¥', lang)}}{{tr.t(data.quote.couponPay, lang)}}</text></view>
    <view class="muted" wx:if="{{data.quote && data.quote.reason}}">{{tr.t(data.quote.reason, lang)}}</view>
    <view class="muted" wx:if="{{data.validHours && !ttl}}">{{tr.t('领取后', lang)}} {{tr.t(data.validHours, lang)}} {{tr.t('小时内可用', lang)}}</view>
    <view wx:if="{{ttl}}">
      <view class="progress {{ttl.percent < 20 ? 'low' : ''}}"><view class="bar" style="width: {{ttl.percent}}%;"></view></view>
      <view class="muted">{{tr.t(ttl.expired ? '这张券已过期' : ttl.label + '内可用', lang)}}</view>
    </view>
    <view class="muted">{{tr.t('保险另计。', lang)}}{{tr.t(data.stackMember || data.stackStudent ? '可与会员/学生价叠加。' : '与会员/学生价取更低，不叠加。', lang)}}</view>
  </view>
</view>
<view class="pad" wx:if="{{err}}" style="color:#bc4749">{{tr.t(err, lang)}}</view>
<view class="btn" wx:if="{{data}}" bindtap="claim">{{tr.t(data.claimedByMe ? (data.universal ? '已领取，去选团' : '已领取，去报名') : '领取并报名', lang)}}</view>
<view class="btn ghost" wx:if="{{data && data.schedule}}" bindtap="goTrip">{{tr.t('查看行程', lang)}}</view>
