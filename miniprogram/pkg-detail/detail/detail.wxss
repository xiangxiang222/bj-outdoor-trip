.pad { padding: 20rpx 24rpx; }
.route-miss {
  min-height: 70vh;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx 80rpx;
  box-sizing: border-box;
}
.route-miss-card {
  width: 100%;
  background: #fff;
  border-radius: 32rpx;
  padding: 64rpx 32rpx 36rpx;
  text-align: center;
}
.route-miss-mark {
  width: 144rpx;
  height: 144rpx;
  margin: 0 auto 28rpx;
  border-radius: 50%;
  background: #f3eaf5;
  color: #642470;
  line-height: 144rpx;
  font-size: 56rpx;
  font-weight: 700;
}
.route-miss-title {
  font-size: calc(40rpx * var(--ui-scale));
  font-weight: 700;
  color: #1a1a1a;
}
.route-miss-text {
  margin-top: 16rpx;
  color: #6e6e76;
  font-size: calc(28rpx * var(--ui-scale));
  line-height: 1.6;
}
.route-miss-card .btn { margin: 28rpx 0 0; }
.route-miss-card .btn.ghost { margin-top: 16rpx; }
.pad.tight { padding-top: 0; padding-bottom: 0; }
.hero { position: relative; height: 420rpx; margin: 0 0 12rpx; }
.hero-img { width: 100%; height: 420rpx; display: block; }
.hero-copy {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 72rpx 28rpx 24rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.66));
  color: #fff;
}
.hero-title { font-size: calc(40rpx * var(--ui-scale)); font-weight: 700; }
.hero-sub { margin-top: 6rpx; font-size: calc(24rpx * var(--ui-scale)); color: rgba(255, 255, 255, 0.9); }
.stats { display: flex; gap: 12rpx; padding: 8rpx 24rpx 0; }
.stat {
  flex: 1;
  min-width: 0;
  background: var(--card, #fff);
  border-radius: 16rpx;
  padding: 14rpx 8rpx;
  text-align: center;
}
.stat-v { font-size: calc(26rpx * var(--ui-scale)); font-weight: 700; line-height: 1.3; }
.stat-k { margin-top: 4rpx; color: var(--muted, #7a7d74); font-size: calc(20rpx * var(--ui-scale)); }
.next {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
  align-items: baseline;
  margin: 16rpx 24rpx 0;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--card, #fff);
  font-size: calc(24rpx * var(--ui-scale));
}
.next-date { color: #6e508f; font-weight: 700; }
.jumps {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  white-space: nowrap;
  margin-top: 12rpx;
  padding: 8rpx 0 8rpx 24rpx;
  background: var(--bg, #f5f6f3);
  position: sticky;
  top: 0;
  z-index: 5;
}
.jump {
  display: inline-block;
  margin-right: 12rpx;
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: var(--card, #fff);
  border: 1px solid var(--line, #eceee8);
  font-size: calc(24rpx * var(--ui-scale));
}
.hl { display: flex; flex-wrap: wrap; gap: 12rpx; }
.hl-item {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  background: var(--bg, #f5f6f3);
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.45;
}
.hl-n {
  display: inline-block;
  width: 32rpx;
  height: 32rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  background: #eee7f6;
  color: #5b3b8c;
  text-align: center;
  line-height: 32rpx;
  font-size: calc(20rpx * var(--ui-scale));
  font-weight: 700;
}
.story-text { white-space: pre-wrap; line-height: 1.7; margin: 12rpx 0 20rpx; }
.story-img { width: 100%; height: 360rpx; border-radius: 16rpx; margin: 8rpx 0 16rpx; display: block; }
.film { white-space: nowrap; width: 100%; margin: 8rpx 0 12rpx; }
.film-card { display: inline-block; width: 72%; margin-right: 16rpx; vertical-align: top; white-space: normal; }
.film-img { width: 100%; height: 280rpx; border-radius: 16rpx; display: block; }
.album-img { display: inline-block; width: 280rpx; height: 200rpx; margin-right: 12rpx; }
.film-cap { margin-top: 8rpx; color: var(--muted, #7a7d74); font-size: calc(22rpx * var(--ui-scale)); }
.stop { display: flex; gap: 16rpx; }
.stop + .stop { margin-top: 8rpx; }
.stop-rail { position: relative; width: 24rpx; flex: none; }
.stop-rail::before {
  content: "";
  position: absolute;
  left: 10rpx;
  top: 28rpx;
  bottom: -12rpx;
  width: 4rpx;
  background: #eee7f6;
}
.stop:last-child .stop-rail::before { display: none; }
.stop-dot {
  width: 20rpx;
  height: 20rpx;
  margin-top: 8rpx;
  border-radius: 50%;
  background: #6e508f;
  position: relative;
  z-index: 1;
}
.stop-main { display: flex; gap: 12rpx; flex: 1; min-width: 0; padding-bottom: 16rpx; }
.stop-copy { flex: 1; min-width: 0; }
.stop-time { color: #6e508f; font-weight: 600; font-size: calc(24rpx * var(--ui-scale)); }
.stop-photo { width: 128rpx; height: 128rpx; border-radius: 12rpx; flex: none; }
.tiers { white-space: nowrap; width: 100%; }
.tier {
  display: inline-block;
  width: 220rpx;
  margin-right: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--bg, #f5f6f3);
  vertical-align: top;
  white-space: normal;
}
.tier-p { color: #c46b4d; font-size: calc(36rpx * var(--ui-scale)); font-weight: 700; }
.fee-grid { display: flex; gap: 12rpx; }
.fee-cell {
  flex: 1;
  min-width: 0;
  background: var(--bg, #f5f6f3);
  border-radius: 16rpx;
  padding: 16rpx;
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
}
.fee-k { color: #6e508f; font-weight: 700; margin-bottom: 6rpx; }
.note {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(201, 162, 74, 0.16);
  font-size: calc(24rpx * var(--ui-scale));
  line-height: 1.5;
}
.refund-line { margin-top: 8rpx; }
.packs { display: flex; flex-wrap: wrap; gap: 12rpx; }
.pack {
  background: #eee7f6;
  color: #5b3b8c;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  font-size: calc(22rpx * var(--ui-scale));
}
.video-link {
  margin: 12rpx 0;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #141414;
  color: #e5d9f4;
  font-weight: 600;
}

.hero, .hero-img { height: 510rpx; }
.hero { margin-bottom: 24rpx; }
.hero-copy { padding: 120rpx 32rpx 32rpx; background: linear-gradient(transparent, rgba(31,25,41,.7)); }
.hero-title { font-size: calc(45rpx * var(--ui-scale)); font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { margin-top: 12rpx; font-size: calc(24rpx * var(--ui-scale)); opacity: .8; }
.stats { padding: 0 28rpx; gap: 14rpx; }
.stat { padding: 22rpx 10rpx; border-radius: 22rpx; }
.stat-v { color: #6f568b; font-size: calc(28rpx * var(--ui-scale)); font-weight: 600; }
.stat-k { font-size: calc(21rpx * var(--ui-scale)); margin-top: 9rpx; }
.next { margin: 20rpx 28rpx 0; padding: 22rpx; border-radius: 20rpx; }
.jumps { background: var(--bg, #f6f5f8); padding-top: 14rpx; padding-bottom: 14rpx; border-bottom: 1rpx solid #efebf3; }
.jump { border: none; border-radius: 10rpx; color: #826797; font-size: calc(23rpx * var(--ui-scale)); padding: 12rpx 22rpx; }
.pad { padding: 30rpx 32rpx; }
.pad .title { margin-bottom: 20rpx; font-size: calc(34rpx * var(--ui-scale)); font-weight: 600; }
.hl-item { background: #fff; border-radius: 22rpx; padding: 22rpx; color: #716579; }
.story-img, .film-img { border-radius: 24rpx; }
.stop { gap: 20rpx; padding-bottom: 10rpx; }
.stop-rail::before { background: #e4d9ef; }
.stop-dot { width: 16rpx; height: 16rpx; margin-top: 10rpx; background: #8d70a7; box-shadow: 0 0 0 6rpx #eee7f6; }
.stop-time { font-size: calc(27rpx * var(--ui-scale)); color: #5e456f; margin-bottom: 8rpx; }
.fee-cell, .tier { background: #fff; padding: 22rpx; border-radius: 22rpx; }
.note { background: #f0ebf7; color: #8c789e; border-radius: 18rpx; padding: 22rpx; }
