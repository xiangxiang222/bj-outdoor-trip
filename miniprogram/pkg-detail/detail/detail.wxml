<page-meta root-font-size="{{lookRoot}}" page-style="{{lookStyle}}" />
<wxs src="../utils/locale.wxs" module="tr" />
<view wx:if="{{err}}" class="muted pad">{{tr.t(err, lang)}}</view>
<view class="card" wx:if="{{r.reviewStatus=='pending'}}">
  <view class="pad">
    <view style="color:#2d6a4f">{{tr.t('已提交审核，通过后会出现在线路目录。', lang)}}</view>
    <view class="muted">{{tr.t('通过后会出现在线路目录。可先加客服微信。', lang)}}</view>
  </view>
</view>
<view class="card" wx:elif="{{r.reviewStatus=='rejected'}}">
  <view class="pad">
    <view style="color:#bc4749">{{tr.t('未通过', lang)}}{{tr.t(r.reviewNote ? '：' + r.reviewNote : '', lang)}}</view>
    <view class="btn ghost" bindtap="goApply">{{tr.t('改完再申请', lang)}}</view>
  </view>
</view>

<view class="hero" wx:if="{{r.cover && r.title}}">
  <image class="hero-img" src="{{r.cover}}" mode="aspectFill" bindtap="preview" data-index="0" />
  <view class="hero-copy">
    <view class="hero-title">{{tr.t(r.title, lang)}}</view>
    <view class="hero-sub" wx:if="{{r.subtitle}}">{{tr.t(r.subtitle, lang)}}</view>
  </view>
</view>
<view class="pad head" wx:elif="{{r.title}}">
  <view class="title">{{tr.t(r.title, lang)}}</view>
  <view class="muted" wx:if="{{r.subtitle}}">{{tr.t(r.subtitle, lang)}}</view>
</view>
<live-pulse wx:if="{{id && r.title}}" flush scope="route" routeId="{{id}}"></live-pulse>

<view class="stats" wx:if="{{r.stats && r.stats.length}}">
  <view class="stat" wx:for="{{r.stats}}" wx:key="label">
    <view class="stat-v">{{tr.t(item.value, lang)}}</view>
    <view class="stat-k">{{tr.t(item.label, lang)}}</view>
  </view>
</view>
<view class="pad tight" wx:if="{{r.region}}"><view class="muted">{{tr.t(r.region, lang)}}</view></view>
<view class="pad tight row" wx:if="{{r.title}}">
  <view class="price">¥{{tr.t(fromPrice, lang)}} {{tr.t('起', lang)}}</view>
  <view class="chip {{r.favored ? 'on' : ''}}" bindtap="fav">{{tr.t(r.favored ? '已收藏' : '收藏', lang)}}</view>
</view>
<view class="next" wx:if="{{r.nextTrip}}">
  <text>{{tr.t('最近出发', lang)}}</text>
  <text class="next-date">{{tr.t(r.nextTrip.startDate, lang)}}</text>
  <text class="muted">{{tr.t(r.nextTrip.meetupPoint, lang)}} {{tr.t(r.nextTrip.meetupTime, lang)}}</text>
</view>

<scroll-view wx:if="{{r.jumps && r.jumps.length}}" scroll-x class="jumps" enhanced show-scrollbar="{{false}}">
  <view class="jump" wx:for="{{r.jumps}}" wx:key="id" bindtap="jump" data-id="{{item.id}}">{{tr.t(item.label, lang)}}</view>
</scroll-view>

<view class="pad" wx:if="{{r.highlights && r.highlights.length}}">
  <view class="title">{{tr.t('亮点', lang)}}</view>
  <view class="hl">
    <view wx:for="{{r.highlights}}" wx:key="*this" class="hl-item"><text class="hl-n">{{index + 1}}</text>{{tr.t(item, lang)}}</view>
  </view>
</view>

<view id="sec-intro" class="pad" wx:if="{{r.storyGroups && r.storyGroups.length}}">
  <view class="title">{{tr.t('线路介绍', lang)}}</view>
  <block wx:for="{{r.storyGroups}}" wx:key="index">
    <view wx:if="{{item.type==='text'}}" class="story-text">{{tr.t(item.body, lang)}}</view>
    <scroll-view wx:elif="{{item.items.length > 1}}" scroll-x class="film" enhanced show-scrollbar="{{false}}">
      <view class="film-card" wx:for="{{item.items}}" wx:for-item="pic" wx:key="url">
        <image class="film-img" src="{{pic.url}}" mode="aspectFill" bindtap="previewStory" data-url="{{pic.url}}" show-menu-by-longpress="{{true}}" />
        <view wx:if="{{pic.caption}}" class="film-cap">{{tr.t(pic.caption, lang)}}</view>
      </view>
    </scroll-view>
    <block wx:else>
      <image class="story-img" src="{{item.items[0].url}}" mode="aspectFill" bindtap="previewStory" data-url="{{item.items[0].url}}" show-menu-by-longpress="{{true}}" />
      <view wx:if="{{item.items[0].caption}}" class="muted">{{tr.t(item.items[0].caption, lang)}}</view>
    </block>
  </block>
</view>
<view id="sec-intro" class="pad" wx:elif="{{r.description}}">
  <view class="title">{{tr.t('线路介绍', lang)}}</view>
  <view class="story-text">{{tr.t(r.description, lang)}}</view>
</view>

<view id="sec-itin" class="pad" wx:if="{{r.itinerary && r.itinerary.length}}">
  <view class="title">{{tr.t('行程', lang)}}</view>
  <view class="stop" wx:for="{{r.itinerary}}" wx:key="index">
    <view class="stop-rail"><view class="stop-dot"></view></view>
    <view class="stop-main">
      <view class="stop-copy">
        <view class="stop-time">{{tr.t(item.time, lang)}} · {{tr.t(item.title, lang)}}</view>
        <view class="muted">{{tr.t(item.detail, lang)}}</view>
      </view>
      <image wx:if="{{item.photo}}" class="stop-photo" src="{{item.photo}}" mode="aspectFill" bindtap="previewStory" data-url="{{item.photo}}" />
    </view>
  </view>
</view>

<view class="pad" wx:if="{{r.priceTiers && r.priceTiers.length}}">
  <view class="title">{{tr.t('阶梯价', lang)}}</view>
  <scroll-view scroll-x class="tiers" enhanced show-scrollbar="{{false}}">
    <view class="tier" wx:for="{{r.priceTiers}}" wx:key="minPeople">
      <view class="muted">{{tr.t(item.minPeople, lang)}}{{tr.t('人起', lang)}}</view>
      <view class="tier-p">¥{{item.price}}</view>
      <view class="muted">{{tr.t('会员', lang)}} ¥{{item.memberPrice}}</view>
    </view>
  </scroll-view>
</view>

<view id="sec-fee" class="pad" wx:if="{{r.feeInclude || r.feeExclude || r.notices}}">
  <view class="title">{{tr.t('费用说明', lang)}}</view>
  <view class="fee-grid">
    <view class="fee-cell" wx:if="{{r.feeInclude}}">
      <view class="fee-k">{{tr.t('包含', lang)}}</view>
      <view>{{tr.t(r.feeInclude, lang)}}</view>
    </view>
    <view class="fee-cell" wx:if="{{r.feeExclude}}">
      <view class="fee-k">{{tr.t('不含', lang)}}</view>
      <view>{{tr.t(r.feeExclude, lang)}}</view>
    </view>
  </view>
  <view wx:if="{{r.notices}}" class="note">{{tr.t(r.notices, lang)}}</view>
</view>

<view class="pad" wx:if="{{r.videos && r.videos.length}}">
  <view class="title">{{tr.t('线路视频', lang)}}</view>
  <block wx:for="{{r.videos}}" wx:key="url">
    <video wx:if="{{item.kind==='video'}}" src="{{item.embedUrl}}" controls style="width:100%;margin:12rpx 0;border-radius:16rpx;background:#000" />
    <view wx:else class="video-link" bindtap="copyVideo" data-url="{{item.url}}">{{tr.t(item.label, lang)}} {{tr.t('· 复制链接去浏览器播放', lang)}}</view>
  </block>
</view>

<view id="sec-photos" class="pad" wx:if="{{r.extraPhotos && r.extraPhotos.length}}">
  <view class="title">{{tr.t('更多照片', lang)}}</view>
  <image wx:if="{{r.extraPhotos.length === 1}}" class="story-img" src="{{r.extraPhotos[0].thumb}}" mode="aspectFill" bindtap="previewExtra" data-index="0" show-menu-by-longpress="{{true}}" />
  <scroll-view wx:else scroll-x class="film" enhanced show-scrollbar="{{false}}">
    <image wx:for="{{r.extraPhotos}}" wx:key="thumb" class="film-img album-img" src="{{item.thumb}}" mode="aspectFill" bindtap="previewExtra" data-index="{{index}}" show-menu-by-longpress="{{true}}" />
  </scroll-view>
</view>

<view class="pad" wx:if="{{r.refundPolicy && r.refundPolicy.lines && r.refundPolicy.lines.length}}">
  <view class="title">{{tr.t('退费规则', lang)}}</view>
  <view class="muted">{{tr.t(r.refundPolicy.summary, lang)}}</view>
  <view class="muted refund-line" wx:for="{{r.refundPolicy.lines}}" wx:key="text">{{tr.t(item.text, lang)}}</view>
</view>

<view id="sec-go" class="pad" wx:if="{{r.title}}">
  <view class="title">{{tr.t('排期', lang)}}</view>
  <view wx:if="{{!r.schedules || !r.schedules.length}}" class="muted">{{tr.t('暂无排期，发布后会显示在这里。', lang)}}</view>
  <view class="card" wx:for="{{r.schedules}}" wx:key="id" bindtap="goSch" data-id="{{item.id}}">
    <view class="pad">
      <view class="row"><text>{{tr.t(item.startDate, lang)}}</text><view class="trip-kind {{item.kind || item.organizerType || 'individual'}}"><view class="trip-kind-ico"></view>{{tr.t(item.kindLabel || '个人', lang)}}</view></view>
      <view class="muted">{{tr.t(item.enrolled, lang)}}/{{tr.t(item.maxSeats, lang)}} · {{tr.t(item.bus.name, lang)}}</view>
      <view wx:if="{{item.guide}}" class="guide-hit" catchtap="goGuide" data-id="{{item.guide.id}}">{{tr.t('导游', lang)}} {{tr.t(item.guide.name, lang)}} {{tr.t('· 查看详情', lang)}}</view>
      <view wx:else class="muted guide-hit" catchtap="goGuides">{{tr.t('成团后匹配导游 · 先看看领队', lang)}}</view>
    </view>
  </view>
</view>
<button class="btn" wx:if="{{r.title}}" open-type="share">{{tr.t('分享到微信', lang)}}</button>
<view class="btn ghost" wx:if="{{r.title && r.reviewStatus!='pending' && r.reviewStatus!='rejected'}}" bindtap="open">{{tr.t('发布排期', lang)}}</view>

<view class="pad" wx:if="{{r.title}}">
  <view class="title">{{tr.t('装备清单', lang)}}</view>
  <view wx:if="{{r.packingList && r.packingList.length}}" class="packs">
    <text wx:for="{{r.packingList}}" wx:key="*this" class="pack">{{tr.t(item, lang)}}</text>
  </view>
  <view wx:else class="muted">{{tr.t(r.equipment, lang)}}</view>
</view>
<view class="pad" wx:if="{{r.title && faqs.length}}">
  <view class="title">{{tr.t('常见问题', lang)}}</view>
  <view wx:for="{{faqs}}" wx:key="q" class="faq-item">
    <view>{{tr.t(item.q, lang)}}</view>
    <view class="muted">{{tr.t(item.a, lang)}}</view>
  </view>
</view>
<view class="pad" wx:if="{{r.title}}">
  <view class="title">{{tr.t('出行评价', lang)}} <text class="muted" wx:if="{{reviews.count}}">{{tr.t(reviews.avg, lang)}}{{tr.t('分 ·', lang)}} {{tr.t(reviews.count, lang)}}{{tr.t('条', lang)}}</text></view>
  <view wx:if="{{!reviews.list.length}}" class="muted">{{tr.t('还没有评价。报名后可在「我的报名」写下体验。', lang)}}</view>
  <view class="card" wx:for="{{reviews.list}}" wx:key="id">
    <view class="pad">
      <view class="row"><text>{{tr.t(item.name, lang)}}</text><text wx:if="{{item.virtual}}" class="review-virtual">{{tr.t('虚拟用户', lang)}}</text><text class="stars">{{tr.t(item.stars, lang)}}</text></view>
      <view wx:if="{{item.content}}">{{tr.t(item.content, lang)}}</view>
      <view class="muted">{{tr.t(item.createdAt, lang)}}</view>
    </view>
  </view>
</view>
