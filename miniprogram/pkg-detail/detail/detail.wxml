<view wx:if="{{err}}" class="muted pad">{{err}}</view>
<image class="cover" src="{{r.cover}}" mode="aspectFill" style="height:400rpx;margin:0" bindtap="preview" data-index="0" />
<live-pulse wx:if="{{id}}" flush scope="route" routeId="{{id}}"></live-pulse>
<view class="pad">
  <view class="title">{{r.title}}</view>
  <view class="muted">{{r.subtitle}}</view>
  <view class="row" style="align-items:center;margin-top:8rpx">
    <view class="price">¥{{fromPrice}} 起</view>
    <view class="chip {{r.favored ? 'on' : ''}}" bindtap="fav">{{r.favored ? '已收藏' : '收藏'}}</view>
  </view>
</view>
<view class="pad" wx:if="{{r.story && r.story.length}}">
  <view class="title">线路介绍</view>
  <block wx:for="{{r.story}}" wx:key="index">
    <view wx:if="{{item.type==='text'}}" class="story-text">{{item.body}}</view>
    <block wx:elif="{{item.type==='image' && item.url}}">
      <image class="story-img" src="{{item.url}}" mode="widthFix" bindtap="previewStory" data-url="{{item.url}}" show-menu-by-longpress="{{true}}" />
      <view wx:if="{{item.caption}}" class="muted">{{item.caption}}</view>
    </block>
  </block>
</view>
<view class="pad" wx:if="{{r.videos && r.videos.length}}">
  <view class="title">线路视频</view>
  <block wx:for="{{r.videos}}" wx:key="url">
    <video wx:if="{{item.kind==='video'}}" src="{{item.embedUrl}}" controls style="width:100%;margin:12rpx 0;border-radius:16rpx;background:#000" />
    <view wx:else class="video-link" bindtap="copyVideo" data-url="{{item.url}}">{{item.label}} · 复制链接去浏览器播放</view>
  </block>
</view>
<view class="pad" wx:if="{{r.gallery && r.gallery.length}}"><view class="title">线路相册</view></view>
<view class="gallery" style="display:flex;flex-wrap:wrap;padding:0 16rpx" wx:if="{{r.gallery && r.gallery.length}}">
  <image wx:for="{{r.gallery}}" wx:key="thumb" src="{{item.thumb}}" mode="aspectFill" style="width:48%;height:200rpx;margin:1%;border-radius:12rpx" bindtap="preview" data-index="{{index}}" show-menu-by-longpress="{{true}}" />
</view>
<view class="pad"><view class="title">亮点</view>
  <view wx:for="{{r.highlights}}" wx:key="*this" class="muted">· {{item}}</view>
</view>
<view class="pad"><view class="title">行程</view>
  <view wx:for="{{r.itinerary}}" wx:key="time">
    <view>{{item.time}} {{item.title}}</view>
    <view class="muted">{{item.detail}}</view>
    <image wx:if="{{item.photo}}" class="story-img" src="{{item.photo}}" mode="widthFix" bindtap="previewStory" data-url="{{item.photo}}" />
  </view>
</view>
<view class="pad"><view class="title">阶梯价</view>
  <view wx:for="{{r.priceTiers}}" wx:key="minPeople" class="row">
    <text>{{item.minPeople}}人起</text>
    <text>¥{{item.price}} / 会员¥{{item.memberPrice}}</text>
  </view>
</view>
<view class="pad"><view class="title">排期</view>
  <view wx:if="{{!r.schedules || !r.schedules.length}}" class="muted">暂无排期，发布后会显示在这里。</view>
  <view class="card" wx:for="{{r.schedules}}" wx:key="id" bindtap="goSch" data-id="{{item.id}}">
    <view class="pad">
      <view class="row"><text>{{item.startDate}}</text><text class="tag">{{item.organizerType=='company'?'公司团':'个人拼团'}}</text></view>
      <view class="muted">{{item.enrolled}}/{{item.maxSeats}} · {{item.bus.name}}</view>
      <view wx:if="{{item.guide}}" class="guide-hit" catchtap="goGuide" data-id="{{item.guide.id}}">导游 {{item.guide.name}} · 查看详情</view>
      <view wx:else class="muted guide-hit" catchtap="goGuides">成团后匹配导游 · 先看看领队</view>
    </view>
  </view>
</view>
<button class="btn" open-type="share">分享到微信</button>
<view class="btn ghost" bindtap="open">发布排期</view>
<view class="pad"><view class="title">装备清单</view>
  <view wx:for="{{r.packingList}}" wx:key="*this" class="muted">· {{item}}</view>
  <view wx:if="{{!r.packingList || !r.packingList.length}}" class="muted">{{r.equipment}}</view>
</view>
<view class="pad"><view class="title">常见问题</view>
  <view wx:for="{{faqs}}" wx:key="q" class="faq-item">
    <view>{{item.q}}</view>
    <view class="muted">{{item.a}}</view>
  </view>
</view>
<view class="pad"><view class="title">出行评价 <text class="muted" wx:if="{{reviews.count}}">{{reviews.avg}}分 · {{reviews.count}}条</text></view>
  <view wx:if="{{!reviews.list.length}}" class="muted">还没有评价。报名后可在「我的报名」写下体验。</view>
  <view class="card" wx:for="{{reviews.list}}" wx:key="id">
    <view class="pad">
      <view class="row"><text>{{item.name}}</text><text class="stars">{{item.stars}}</text></view>
      <view wx:if="{{item.content}}">{{item.content}}</view>
      <view class="muted">{{item.createdAt}}</view>
    </view>
  </view>
</view>
