PORT=3780
NODE_ENV=production
JWT_SECRET=请换成随机长字符串
WX_PAY_MOCK=1
WX_PAY_NOTIFY=https://togetherbetter.cn/api/pay/wechat/notify
WX_APPID=wx255ca387929c502a
WX_MCH_ID=1750196084
# 下面两项只放服务器 .env，不要提交、不要发到群：
# WX_APPSECRET=
# WX_MCH_KEY=
# 真实收款把 WX_PAY_MOCK 改成 0，并配好 AppSecret 与商户 APIv2 密钥。
# 并团小程序订阅消息模板 ID。不填则只记账，不调微信。
# WX_TPL_MERGE=
# 后台「AI 起草」线路，以及发布后把线路文案译成英文。不填则起草用模板，英文仍显示中文；繁体不依赖这项。
# AI_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# 身份证二要素（阿里云实人认证 Id2MetaVerify）。不填则正式环境不能核验。只放服务器 .env。
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# 短信验证码走腾讯云。密钥、应用、签名、模板都要在控制台里，模板只留一个变量放 6 位验证码。不填则仍是演示码 888888，不会真正发出。
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN=同行者众
# TENCENT_SMS_TEMPLATE_ID=
