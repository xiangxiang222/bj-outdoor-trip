PORT=3780
NODE_ENV=production
JWT_SECRET=请换成随机长字符串
WX_PAY_MOCK=1
WX_PAY_NOTIFY=https://togetherbetter.cn/api/pay/wechat/notify
WX_APPID=wx255ca387929c502a
WX_MCH_ID=1750196084
# 下面两项只放服务器 .env，不要提交、不要发到群：
# WX_APPSECRET=
# WX_MCH_KEY=
# 真实收款把 WX_PAY_MOCK 改成 0，并配好 AppSecret 与商户 APIv2 密钥。
# 并团小程序订阅消息模板 ID。不填则只记账，不调微信。
# WX_TPL_MERGE=
# 后台「AI 起草」、线路英文翻译和「一句话找团」共用；密钥只放服务器，不发往客户端。
# 未配置时，一句话找团仍可按规则整理条件；不能理解的条件会请用户确认。
# AI_API_KEY=
# OPENAI_API_KEY=
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# 一句话找团的模型调用限制；超时、达到配额或模型异常时退回规则匹配。
# AI_DISCOVERY_TIMEOUT_MS=7500
# AI_DISCOVERY_CONCURRENCY=3
# AI_DISCOVERY_DAILY_LIMIT=200
# AI_DISCOVERY_PER_MINUTE=20
# AI_DISCOVERY_GLOBAL_PER_MINUTE=120
# 采集机器人写入待审线路。不填则 POST /api/bot/routes 返回 503。只放服务器 .env，不要提交。
# BOT_INGEST_TOKEN=
# 身份证二要素（阿里云实人认证 Id2MetaVerify）。不填则正式环境不能核验。只放服务器 .env。
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# 短信验证码走腾讯云。密钥、应用、签名、模板都要在控制台里，模板只留一个变量放 6 位验证码。不填则仍是演示码 888888，不会真正发出。
# TENCENT_SECRET_ID=
# TENCENT_SECRET_KEY=
# TENCENT_SMS_SDK_APP_ID=
# TENCENT_SMS_SIGN=同行者众
# TENCENT_SMS_TEMPLATE_ID=
